<messaging:emailTemplate subject="Approval Request: Approval for {!relatedTo.Quote__r.SBQQ__Opportunity2__r.Name} have been requested "  relatedToType="sbaa__Approval__c">
    <messaging:HtmlEmailBody >
        <html>
            <body>
                <p>
                    {!relatedTo.Owner.Name} has submitted quote {!relatedTo.Quote__r.Name} for your review.<br/>
                    Please respond to this email with the word <b><apex:outputText style="color: #009600;" value="Approve"/></b> or <b><apex:outputText style="color: #FF0000;" value="Reject"/></b> in the first line.<br/>
                    Add any comments you may have on the second line.<br/>
                </p>
                <b>Opportunity Owner:</b>&nbsp;{!relatedTo.Quote__r.SBQQ__Opportunity2__r.Owner.Name}<br/>
                <b>Sales Office:</b>&nbsp; &nbsp;<apex:outputField value="{!relatedTo.Quote__r.SBQQ__Opportunity2__r.NSP_Sales_Office__c}"/><br/>
                <b>SE:</b>&nbsp;&nbsp;<apex:outputField value=" {!relatedTo.Quote__r.Owner.Name}"/> <br/>
                <apex:outputPanel rendered="{!NOT(ISBLANK(relatedTo.sbaa__Rule__r.Primary_Approver__c))}">
                    <b>Primary Approver:</b> {!relatedTo.sbaa__Rule__r.Primary_Approver__r.Name}<br/>
                </apex:outputPanel>
                <apex:outputPanel rendered="{!NOT(ISBLANK(relatedTo.sbaa__Rule__r.Backup_Approver__c))}">
                    <b>Backup Approver:</b> {!relatedTo.sbaa__Rule__r.Backup_Approver__r.Name}<br/>
                </apex:outputPanel>
                <p>
                    <b>Requestor's Comment:</b> <br/>
                    <apex:outputField value=" {!relatedTo.Quote__r.NSP_Submitter_Comment__c}" />
                </p>
                <p>
                    <apex:outputPanel rendered="{!AND((relatedTo.Quote__r.NSP_Has_WA_product__c || relatedTo.Quote__r.NSP_Has_WX_product__c), AND(relatedTo.Quote__r.WX_WA_Minimum_Fee_Discount__c != null,NOT(ISBLANK(relatedTo.Quote__r.WX_WA_Minimum_Fee_Discount__c)),relatedTo.Quote__r.WX_WA_Minimum_Fee_Discount__c > 0)) }">
                        <b>Minimum Fee:</b>&nbsp;<apex:outputField value="{!relatedTo.Quote__r.NSP_WX_Minimum_Fee__c}"/><br/>
                    </apex:outputPanel>
                </p>
                <p>
                    <apex:outputPanel rendered="{!AND((relatedTo.Quote__r.NSP_Has_WA_product__c || relatedTo.Quote__r.NSP_Has_WX_product__c), AND(relatedTo.Quote__r.NSP_Threshold_Percentage__c != null, NOT(ISBLANK(relatedTo.Quote__r.NSP_Threshold_Percentage__c)),relatedTo.Quote__r.NSP_Threshold_Percentage__c != 80)) }">
                        <b>Threshold %:</b>&nbsp;<apex:outputField value="{!relatedTo.Quote__r.NSP_Threshold_Percentage__c}"/><br/>
                    </apex:outputPanel>
                </p>
                <p>
                    <apex:outputPanel rendered="{!((relatedTo.Quote__r.NSP_Has_WA_product__c || relatedTo.Quote__r.NSP_Has_WX_product__c)&& relatedTo.Quote__r.NSP_Free_Month__c != '') }">
                        <b>1099 Monthly Minimum:</b>&nbsp;<apex:outputField value=" {!relatedTo.Quote__r.NSP_Contractor_Final_Minimum_Fee__c}"/><br/>
                    </apex:outputPanel>
                </p>
                <p>
                    <apex:outputPanel rendered="{!(relatedTo.Quote__r.NSP_Free_Month__c != '')}">
                        <b>Free Months:</b>&nbsp;<apex:outputField value=" {!relatedTo.Quote__r.NSP_Free_Month__c}"/><br/>
                    </apex:outputPanel>
                </p>
                <p>
                    <apex:outputPanel rendered="{!((relatedTo.Quote__r.NSP_Has_WA_product__c || relatedTo.Quote__r.NSP_Has_WX_product__c)&& relatedTo.Quote__r.Contract_Term__c != '') }">
                        <b>Contract Term:</b>&nbsp;<apex:outputField value=" {!relatedTo.Quote__r.Contract_Term__c}"/><br/>
                    </apex:outputPanel>
                </p>
                <p>
                    <c:NSP_DisplayQli quoteId="{!relatedTo.Quote__r.Id}" />
                </p>
                <p style="color:white"><apex:outputText value="{!relatedTo.Id}"/></p>
                <p>Alternatively you can use this link to review the transaction: <apex:outputText value=" {!LEFT($Api.Partner_Server_URL_140, FIND(".com/",$Api.Partner_Server_URL_140)+3)}/{!relatedTo.Id}"/></p>
            </body>
        </html>
    </messaging:HtmlEmailBody>
</messaging:emailTemplate>