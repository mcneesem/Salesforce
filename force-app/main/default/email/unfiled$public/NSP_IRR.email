<messaging:emailTemplate subject=" {!relatedTo.NSP_AIMS_Client_Name__c} ({!relatedTo.NSP_AIMS_ClientNo__c}) IRR Report Request  " recipientType="User" relatedToType="Implementation_Profile__c">
