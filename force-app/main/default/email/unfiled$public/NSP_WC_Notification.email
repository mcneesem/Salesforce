<messaging:emailTemplate subject="NEW CLIENT SUMMARY: {!relatedTo.NSP_AIMS_Client_Name__c} ({!relatedTo.NSP_AIMS_ClientNo__c})" recipientType="User" relatedToType="Implementation_Profile__c">
<messaging:HtmlEmailBody >
    <html>
        <body>
        <c:InsperityEmailHeader />
        <br/>
            <c:NSP_WC_Notification currentRecordId="{!relatedTo.Id}" impProfile="{!relatedTo}"/>
            
            
            <p>Regards,<br/>
            {!relatedTo.NSP_Project_Manager__r.Name}<br/>
            {!relatedTo.NSP_Project_Manager__r.NSP_Job_Title__c}</p>
            <c:InsperityEmailFooter />
        </body>
    </html>
</messaging:HtmlEmailBody>
</messaging:emailTemplate>