<messaging:emailTemplate subject="A termination order has been created for Quote. {!relatedTo.SBQQ__Quote__r.Name}" recipientType="User" relatedToType="Order">
<messaging:HtmlEmailBody >
<html>
  <body>
  
Hi Team

<p> A termination order has been created for Opportunity  <apex:outputLink value="{!LEFT($CurrentPage.URL,FIND('/',$CurrentPage.URL,9))+relatedTo.OpportunityId}" target="_parent"> Opportunity </apex:outputLink> </p>

<p>Here is the link to the quote  <apex:outputLink value="{!LEFT($CurrentPage.URL,FIND('/',$CurrentPage.URL,9))+relatedTo.SBQQ__Quote__c}" target="_parent"> Quote </apex:outputLink> </p>
  
<p> Please check for pending invoices. </p>  
  </body>
</html>
</messaging:HtmlEmailBody>
</messaging:emailTemplate>