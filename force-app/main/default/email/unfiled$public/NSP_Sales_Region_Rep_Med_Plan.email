<messaging:emailTemplate subject="Onboarding Meeting Information" recipientType="User" relatedToType="ServiceAppointment">
<messaging:htmlEmailBody >
<html>
<body>
An Orientation Meeting has been SCHEDULED for {!relatedTo.Account.Name} with the following details: <br/>

<c:NSP_SAEmail_DateTime date_time_value="{!relatedTo.SchedStartTime}" date_time_format="MM-dd-yyyy" end_date="{!relatedTo.SchedEndTime}"/> <br/>
Address: {!relatedTo.NSP_Orientation_Address__c} <br/>
Orientation Rep: {!relatedTo.Owner.Name} <br/>
Comments: {!relatedTo.Description}
</body>
</html>
</messaging:htmlEmailBody>
</messaging:emailTemplate>