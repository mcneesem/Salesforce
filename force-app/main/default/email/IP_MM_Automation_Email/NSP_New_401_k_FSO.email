<messaging:emailTemplate subject="{!relatedTo.NSP_AIMS_Client_Name__c} ({!relatedTo.NSP_AIMS_ClientNo__c}) is interested in setting up a 401(k) plan " recipientType="User" relatedToType="Implementation_Profile__c" >
<messaging:HtmlEmailBody >
<html>
<body>
<table border="0" width="550">
 <c:InsperityEmailHeader />

{!relatedTo.NSP_AIMS_Client_Name__c} ({!relatedTo.NSP_AIMS_ClientNo__c}) is interested in setting up a 401k plan.

<apex:outputPanel rendered="{!relatedTo.Client_working_with_an_NSP_RS_rep__c= 'Yes'}">
<p>The Client is already working with an NSP RS rep.</p>
</apex:outputPanel>

<apex:outputPanel rendered="{!relatedTo.Client_working_with_an_NSP_RS_rep__c= 'No'}">
<p>The client is not currently working with an NSP RS rep. Please reach out to {!relatedTo.NSP_RS_Contact__c } to start the process.</p>
</apex:outputPanel>

<apex:outputPanel >
<c:NSP_RelatedClients currentRecordId="{!relatedTo.Id}" regulatedState="{!relatedTo.Employees_work_in_the_following_states__c}"/>
</apex:outputPanel>

<apex:outputPanel rendered="{!NOT(ISBLANK(relatedTo.Retirement_services_notes__c))}">
<p>Onboarding Notes:<br/>{!relatedTo.Retirement_services_notes__c}</p>
</apex:outputPanel>

</table>
</body>
<p><span>Regards,</span><br/>
<span>{!relatedTo.NSP_Project_Manager__r.Name}</span><br/>
<span>{!relatedTo.NSP_Project_Manager__r.NSP_Job_Title__c}</span></p>
<c:InsperityEmailFooter />
</html>
</messaging:HtmlEmailBody>
</messaging:emailTemplate>