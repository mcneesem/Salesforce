<messaging:emailTemplate subject="{!relatedTo.NSP_AIMS_Client_Name__c} /({!relatedTo.NSP_AIMS_ClientNo__c}) /Employee Directory" recipientType="User" relatedToType="Implementation_Profile__c">
<messaging:HtmlEmailBody >
<html>
<body>
<c:InsperityEmailHeader />
<p>{!relatedTo.NSP_AIMS_Client_Name__c} {!relatedTo.NSP_AIMS_ClientNo__c} would like to have the employee directory removed from Premier.</p>
</body>
<br/>
<p><span>Regards,</span><br/>
<span>{!relatedTo.NSP_Project_Manager__r.Name}</span><br/>
<span>{!relatedTo.NSP_Project_Manager__r.NSP_Job_Title__c}</span><br/>
<span>{!relatedTo.NSP_Project_Manager__r.NSP_Work_email__c}</span></p>
<c:InsperityEmailFooter />
</html>
</messaging:HtmlEmailBody>
</messaging:emailTemplate>