<messaging:emailTemplate subject="EPLI Information for {!relatedTo.NSP_AIMS_Client_Name__c} ({!relatedTo.NSP_AIMS_ClientNo__c})" recipientType="User" relatedToType="Implementation_Profile__c">
<messaging:HtmlEmailBody >
<html>
<body>
<c:InsperityEmailHeader />
<p> AIMS Client Name: {!relatedTo.NSP_AIMS_Client_Name__c}  <br/>
AIMS Client Number: {!relatedTo.NSP_AIMS_ClientNo__c}  <br/>
Client Effective Date: <apex:outputText value="{0,date,MM/dd/yy}">
<apex:param value="{!relatedTo.Effective_Date_Payroll_Worker_comp_EPLI__c}" />
</apex:outputText></p>

<p><apex:outputPanel rendered="{!relatedTo.Wnt_cpy_of_Insperity_EPLI_policy_cert__c= 'Yes'}">
<b>This Client has requested a copy of Insperity’s EPLI policy and/or certificate. Please contact {!relatedTo.NSP_Project_Manager__r.Name} to determine appropriate Client contact.</b>
</apex:outputPanel></p>

<p><apex:outputPanel rendered="{!relatedTo.Client_maintaining_existing_EPLI_policy__c= 'Yes'}">
<b>This Client plans to maintain their own EPLI insurance after joining Insperity. </b>
</apex:outputPanel></p>

</body>
<p><span>Regards,</span><br/>
<span>{!relatedTo.NSP_Project_Manager__r.Name}</span><br/>
<span>{!relatedTo.NSP_Project_Manager__r.NSP_Job_Title__c}</span><br/>
<span>{!relatedTo.NSP_Project_Manager__r.NSP_Work_email__c}</span></p>

<c:InsperityEmailFooter />
</html>
</messaging:HtmlEmailBody>
</messaging:emailTemplate>