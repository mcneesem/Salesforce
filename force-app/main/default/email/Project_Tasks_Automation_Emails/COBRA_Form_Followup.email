<messaging:emailTemplate subject="{!SUBSTITUTE(SUBSTITUTE( SUBSTITUTE(relatedTo.Name, 'Need', ''), 'verify eligibility', '' ), 'collected', '')} ({!relatedTo.pse__Project__r.pse__Account__r.Name}) ({!relatedTo.pse__Project__r.pse__Account__r.NSP_AIMS_Client__c}) " recipientType="User" relatedToType="pse__Project_Task__c">
