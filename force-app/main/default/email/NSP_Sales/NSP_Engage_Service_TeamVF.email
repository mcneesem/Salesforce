<messaging:emailTemplate subject="Service Team Engagement" recipientType="User" relatedToType="Opportunity">
<messaging:htmlEmailBody >
<html>
    <head>
<style>
table, th, td {
  border: 1px solid black;
  border-collapse: collapse;
}
</style>
</head>
      <body>
        <p>We have been in communication with {!RelatedTo.Account.Name} and your service team involvement has been requested. Please see the below details to help aide in your assignment process:</p>

        <p>Primary BPA: {!RelatedTo.Owner.Name}</p>
        
        <p>BPA Office: {!RelatedTo.Owner.NSP_Sales_Office__c} </p>
        
        <p>Account Name: {!RelatedTo.Account.Name}</p>
        
        <p>Account Location: {!RelatedTo.Account.BillingStreet}, {!RelatedTo.Account.BillingCity},<br/>
        {!RelatedTo.Account.BillingState}, {!RelatedTo.Account.BillingCountry},<br/>
        {!RelatedTo.Account.BillingPostalCode}</p>
        
        <p>Number of EEs: {!TEXT(RelatedTo.NSP_Number_of_Employees__c)}</p>
        
        <p>Please contact the Primary BPA to further coordinate service meeting logistics.</p>

      </body>
      </html>
</messaging:htmlEmailBody>
</messaging:emailTemplate>