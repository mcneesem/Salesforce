<messaging:emailTemplate subject="Delivery Order created for {!relatedTo.SBQQ__Opportunity2__r.Account.Owner.Name}" recipientType="User" relatedToType="SBQQ__Quote__c">
<messaging:HtmlEmailBody >
<html>
  <body>
  
  <p>The executable delivery order is ready for you to submit. Please refer to the link below:</p>
  <apex:outputLink value="{!LEFT($CurrentPage.URL,FIND('/',$CurrentPage.URL,9))+relatedTo.SBQQ__Opportunity2__c}" target="_parent"> {!relatedTo.SBQQ__Opportunity2__r.Name} </apex:outputLink>
  
  </body>
  </html>
  </messaging:HtmlEmailBody>

</messaging:emailTemplate>