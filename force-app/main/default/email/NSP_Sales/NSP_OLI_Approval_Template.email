<messaging:emailTemplate subject="Please approve the oli ({!relatedTo.NSP_Opportunity_Product__r.Product2.Name})" relatedToType="sbaa__Approval__c">
<messaging:HtmlEmailBody >
  <html>
            <body>
             <p style="color:white"><apex:outputText value="{!relatedTo.Id}"/></p>

                <p>
                    User {!relatedTo.NSP_Opportunity_Product__r.Opportunity.Owner.name} has submitted the request for your review.
Please respond to this email with the word Approve or Reject in the first line.
Add any comments you may have on the second line.
                </p>
                </body>
                </html>
</messaging:HtmlEmailBody>
</messaging:emailTemplate>