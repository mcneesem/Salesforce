<messaging:emailTemplate subject="NEW CLIENT DOWNLOADED: MIDMARKET -{!RelatedTo.Account.Name} / {!RelatedTo.Account.Client_Number_TA__c} / {!RelatedTo.NSP_BidVersion__c}" recipientType="User" relatedToType="Opportunity">

  <messaging:htmlEmailBody >
    <html>
    <head>
<style>
table, th, td {
  border: 1px solid black;
  border-collapse: collapse;
}
</style>
</head>
      <body>
        <p> Congrats on this booking,!!</p>
        <p>{!RelatedTo.Account.Client_Number_TA__c} - {!RelatedTo.NSP_BidVersion__c}</p>
        <p># of EEs Booked:  {!RelatedTo.NSP_Number_of_Employees__c}</p>
        <p>{!RelatedTo.NSP_PrimaryProduct__c}</p>        
      
        <table>
          <tr>
            <th align="left">
              Product
            </th>
            <th align="left">
              Quantity
            </th>
            <th align="left">
              Sales Price
            </th>
          </tr>
          <apex:repeat value="{!RelatedTo.OpportunityLineItems}" var="lineItem">
            <tr>
              <td>
                {!lineItem.Product2.Name}
              </td>
              <td>
                {!lineItem.Quantity}
              </td>
              <td>
                {!lineItem.UnitPrice}
              </td>
            </tr>
          </apex:repeat>
        </table>
      </body>
    </html>
  </messaging:htmlEmailBody>
</messaging:emailTemplate>