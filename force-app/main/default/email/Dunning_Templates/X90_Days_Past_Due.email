<messaging:emailTemplate subject="Insperity Past Due Invoice(s)" recipientType="Contact" relatedToType="Case">
<messaging:htmlEmailBody >
<p>Your account has reached a 90 day past due status.  Please remit your payment promptly to avoid disruption of your service with Insperity.</p>
<p>If you would like to pay by credit card, please use the link below to access our online payment portal or contact us directly at <a href="mailto:orders@insperity.com">orders@insperity.com</a>.</p>
<p>
  <c:NSP_dunningInvoicesList caseId="{!relatedTo.Id}" caseAccId="{!relatedTo.AccountId}"> </c:NSP_dunningInvoicesList> 
</p>
<p>Thank you for your prompt attention to this matter.</p>
<c:NSP_InsperityEmailLogo ></c:NSP_InsperityEmailLogo>
</messaging:htmlEmailBody>
</messaging:emailTemplate>