<messaging:emailTemplate subject="Insperity Invoice(s)" recipientType="Contact" relatedToType="Case">
<messaging:htmlEmailBody >
<p>Your attention is needed in resolving the past due status of the attached invoice. If you have any questions regarding this invoice, please contact us at <a href="mailto:orders@insperity.com">orders@insperity.com</a> </p>
<p>If you would like to pay by credit card, please use the link below to access our online payment portal or contact us directly.</p>
<p>
  <c:NSP_dunningInvoicesList caseId="{!relatedTo.Id}" caseAccId="{!relatedTo.AccountId}"> </c:NSP_dunningInvoicesList> 
</p>
<p>Thank you for your prompt attention to this matter.</p>
</messaging:htmlEmailBody>
</messaging:emailTemplate>