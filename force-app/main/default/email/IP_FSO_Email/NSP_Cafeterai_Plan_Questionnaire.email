<messaging:emailTemplate subject="{!relatedTo.NSP_AIMS_Client_Name__c} ({!relatedTo.NSP_AIMS_ClientNo__c}) – Changes to Cafeteria Plan" recipientType="User" relatedToType="Implementation_Profile__c">

<messaging:HtmlEmailBody >
<html>
<body>
  <table border="0" width="550">
 <c:InsperityEmailHeader />
<p>{!relatedTo.NSP_AIMS_Client_Name__c} ({!relatedTo.NSP_AIMS_ClientNo__c}) made the following changes to the Cafeteria Plan Questionnaire. 
Please create a new one to be signed by the client and make the change in AIMS.<br/>
<apex:outputText value="{!SUBSTITUTE(SUBSTITUTE(JSENCODE(relatedTo.List_change_s__c), '\\r\\n', '\\n'),'\\n','<br/>')}" style="white-space:pre;" escape="false"  /></p>

<p>Regards,<br/>
{!relatedTo.NSP_Project_Manager__r.Name}<br/>
{!relatedTo.NSP_Project_Manager__r.NSP_Job_Title__c}</p>
<c:InsperityEmailFooter />
</table>
</body>
</html>
</messaging:HtmlEmailBody>
</messaging:emailTemplate>