{"filters":[],"gridLayouts":[],"layouts":[],"steps":{"saql":{"broadcastFacet":false,"groups":[],"numbers":[],"query":"q = load \"Terminations_Approved_DS\";\nq = filter q by ('RecordType.Name' != \"Client Reinstatement\" || 'RecordType.Name' is null);\nq = filter q by 'NSP_Term_Reason__c' in [\"1900 Merger with Insperity Client\", \"2700 Change in FEIN\"];\nq = filter q by 'NSP_Status__c' == \"Term Team Approved\";\nq = foreach q generate q.'CreatedDate_formula' as 'CreatedDate_formula', q.'Name' as 'Name', q.'NSP_Term_Reason__c' as 'NSP_Term_Reason__c', q.'NSP_New_Client_Name__c' as 'NSP_New_Client_Name__c', q.'NSP_New_Client_Number__c' as 'NSP_New_Client_Number__c', q.'NSP_Client_Name__c' as 'NSP_Client_Name__c', q.'NSP_Client_Number__c' as 'NSP_Client_Number__c', q.'NSP_Client_Sub_Account_Numbers__c' as 'NSP_Client_Sub_Account_Numbers__c', q.'NSP_Client_Term_Date__c_formula' as 'NSP_Client_Term_Date__c_formula', q.'NSP_Number_of_Active_Employees__c' as 'NSP_Number_of_Active_Employees__c', q.'NSP_How_many_employees_were_moved__c' as 'NSP_How_many_employees_were_moved__c', mv_to_string(q.'Join30.Transform3.PayrollSpecialist') as 'Join30.Transform3.PayrollSpecialist', mv_to_string(q.'Join30.Transform4.PayrollSupervisor') as 'Join30.Transform4.PayrollSupervisor';\nq = limit q 25000;","receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"none","strings":[],"type":"saql","useGlobal":true}},"widgets":{"saql_table":{"parameters":{"borderColor":"#a8b7c7","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#16325c","fontColor":"#ffffff","fontSize":12,"textWrap":true},"innerMajorBorderColor":"#54698d","innerMinorBorderColor":"#a8b7c7","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"showRowIndexColumn":true,"step":"saql","totals":true,"verticalPadding":8},"type":"table"}}}