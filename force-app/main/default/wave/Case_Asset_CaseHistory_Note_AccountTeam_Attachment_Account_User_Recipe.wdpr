          "formulaExpression" : "case \r\n\twhen \"JoinRecord.Asset.NSP_Sales_Office__c\" =  '301' then '0301 Phoenix 1'\r\nwhen \"JoinRecord.Asset.NSP_Sales_Office__c\" =  '302' then '0302 Phoenix 2'\r\nwhen \"JoinRecord.Asset.NSP_Sales_Office__c\" =  '501' then '0501 Los Angeles 1'\r\nwhen \"JoinRecord.Asset.NSP_Sales_Office__c\" =  '502' then '0502 Los Angeles 2'\r\nwhen \"JoinRecord.Asset.NSP_Sales_Office__c\" =  '503' then '0503 Los Angeles 3'\r\nwhen \"JoinRecord.Asset.NSP_Sales_Office__c\" =  '504' then '0504 Los Angeles 4'\r\nwhen \"JoinRecord.Asset.NSP_Sales_Office__c\" =  '505' then '0505 Los Angeles 5'\r\nwhen \"JoinRecord.Asset.NSP_Sales_Office__c\" =  '506' then '0506 Los Angeles 6'\r\nwhen \"JoinRecord.Asset.NSP_Sales_Office__c\" =  '507' then '0507 Los Angeles 7'\r\nwhen \"JoinRecord.Asset.NSP_Sales_Office__c\" =  '508' then '0508 Los Angeles 8'\r\nwhen \"JoinRecord.Asset.NSP_Sales_Office__c\" =  '520' then '0520 San Francisco 1'\r\nwhen \"JoinRecord.Asset.NSP_Sales_Office__c\" =  '522' then '0522 San Francisco 3'\r\nwhen \"JoinRecord.Asset.NSP_Sales_Office__c\" =  '521' then '0521 San Francisco 2'\r\nwhen \"JoinRecord.Asset.NSP_Sales_Office__c\" =  '523' then '0523 San Francisco 4'\r\nwhen \"JoinRecord.Asset.NSP_Sales_Office__c\" =  '540' then '0540 San Diego 1'\r\nwhen \"JoinRecord.Asset.NSP_Sales_Office__c\" =  '541' then '0541 San Diego 2'\r\nwhen \"JoinRecord.Asset.NSP_Sales_Office__c\" =  '561' then '0561 San Jose 1'\r\nwhen \"JoinRecord.Asset.NSP_Sales_Office__c\" =  '581' then '0581 Sacramento 1'\r\nwhen \"JoinRecord.Asset.NSP_Sales_Office__c\" =  '601' then '0601 Denver 1'\r\nwhen \"JoinRecord.Asset.NSP_Sales_Office__c\" =  '602' then '0602 Denver 2'\r\nwhen \"JoinRecord.Asset.NSP_Sales_Office__c\" =  '701' then '0701 Stamford 1'\r\nwhen \"JoinRecord.Asset.NSP_Sales_Office__c\" =  '801' then '801 Delaware 1'\r\nwhen \"JoinRecord.Asset.NSP_Sales_Office__c\" =  '901' then '901 Washington DC 1'\r\nwhen \"JoinRecord.Asset.NSP_Sales_Office__c\" = 