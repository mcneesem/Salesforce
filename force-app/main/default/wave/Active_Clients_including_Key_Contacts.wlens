{"filters":[],"gridLayouts":[],"layouts":[],"steps":{"saql":{"broadcastFacet":false,"groups":[],"numbers":[],"query":"q = load \"VOC_Active_Clients_including_Key_Contacts\";\nq = filter q by 'Asset.RecordType.DeveloperName' == \"WO\";\nq = filter q by 'Asset.Status' in [\"Active\", \"Onboarding\"];\nq = filter q by 'NSP_Service_Roles__c' == \"Key Decision Maker\";\nq = foreach q generate q.'Account.NSP_AIMS_Client__c' as 'Account.NSP_AIMS_Client__c', q.'Account.Name' as 'Account.Name', q.'Account.Phone' as 'Account.Phone', q.'Asset.NSP_Service_Region__c' as 'Asset.NSP_Service_Region__c', q.'Asset.NSP_Client_Segment_type__c' as 'Asset.NSP_Client_Segment_type__c', q.'Asset.NSP_Service_Package__c' as 'Asset.NSP_Service_Package__c', q.'Account_Gr.NSP_Accountgroup.NSP_Type__c' as 'Account_Gr.NSP_Accountgroup.NSP_Type__c', q.'Account.NSP_Account_Health__c' as 'Account.NSP_Account_Health__c', q.'Account.NSP_Renewal_Probability__c' as 'Account.NSP_Renewal_Probability__c', q.'Rating_Last_Updated' as 'Rating_Last_Updated', q.'Asset.NSP_Unique_Active_Employee__c' as 'Asset.NSP_Unique_Active_Employee__c', q.'AIMS_Renewal_Date' as 'AIMS_Renewal_Date', q.'AIMS_Original_first_pay_date' as 'AIMS_Original_first_pay_date', mv_to_string(q.'Join17.Transform0.MHRS') as 'Join17.Transform0.MHRS', mv_to_string(q.'Join17.Transform1.PayrollSupervisor') as 'Join17.Transform1.PayrollSupervisor', mv_to_string(q.'Join17.Transform2.BPA') as 'Join17.Transform2.BPA', q.'Contact.Name' as 'Contact.Name', q.'Contact.NSP_Work_Phone__c' as 'Contact.NSP_Work_Phone__c', q.'Contact.NSP_Work_email__c' as 'Contact.NSP_Work_email__c', q.'NSP_Service_Roles__c' as 'NSP_Service_Roles__c', q.'User.Name' as 'User.Name', q.'NSP_Sub_Cl.NSP_On_Site_Supervisor__c' as 'NSP_Sub_Cl.NSP_On_Site_Supervisor__c';\nq = limit q 25000;","receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"none","strings":[],"type":"saql","useGlobal":true}},"widgets":{"saql_table":{"parameters":{"borderColor":"#a8b7c7","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#16325c","fontColor":"#ffffff","fontSize":12,"textWrap":true},"innerMajorBorderColor":"#54698d","innerMinorBorderColor":"#a8b7c7","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"showRowIndexColumn":true,"step":"saql","totals":true,"verticalPadding":8},"type":"table"}}}