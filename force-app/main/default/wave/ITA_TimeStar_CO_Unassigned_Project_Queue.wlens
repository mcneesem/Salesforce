{"filters":[],"gridLayouts":[],"layouts":[],"steps":{"saql":{"broadcastFacet":false,"groups":[],"numbers":[],"query":"q = load \"ITA_TimeStar_Dataset\";\nq = filter q by 'pse__Project_Status__c' in [\"Active\", \"Quality Review\",\"Special Extension\"];\nq = filter q by 'pse__Proje.pse__Status__c' == \"In Progress\";\nq = filter q by 'NSP_Change_Order_Classification__c' is not null;\nq = filter q by 'RecordType.DeveloperName' == \"Time_Attendance\";\nq = foreach q generate q.'pse__Project_ID__c' as 'pse__Project_ID__c', q.'Name' as 'Name', q.'Asset.NSP_Product_Segment__c' as 'Asset.NSP_Product_Segment__c', q.'NSP_Change_Order_Classification__c' as 'NSP_Change_Order_Classification__c', q.'NSP_HRQST_Review_Status__c' as 'NSP_HRQST_Review_Status__c', q.'Start_Date' as 'Start Date',q.'pse__Start_Date__c_formula' as 'pse__Start_Date__c_formula', q.'Case.CaseNumber' as 'Case.CaseNumber', q.'pse__Project_Status__c' as 'pse__Project_Status__c', q.'First_Contact_Date' as 'First_Contact_Date', q.'Go_Live_Date' as 'Go Live Date', q.'Invoice_Ready__c' as 'Invoice_Ready__c', q.'UserCopy.Name' as 'Project Implementer', q.'Peer_Review__c' as 'Peer_Review__c', q.'pse__Proje.Name' as 'pse__Proje.Name';\nq = limit q 25000;","receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"none","strings":[],"type":"saql","useGlobal":true}},"widgets":{"saql_table":{"parameters":{"borderColor":"#a8b7c7","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{"pse__Project_ID__c":{"parameters":{"alignment":"left","styles":{"linkColor":"#006dcc"}},"type":"text"},"Case.CaseNumber":{"parameters":{"alignment":"left","styles":{"linkColor":"#006dcc"}},"type":"text"}},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#16325c","fontColor":"#ffffff","fontSize":12,"textWrap":true},"innerMajorBorderColor":"#54698d","innerMinorBorderColor":"#a8b7c7","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"showRowIndexColumn":true,"step":"saql","totals":true,"verticalPadding":8},"type":"table"}}}