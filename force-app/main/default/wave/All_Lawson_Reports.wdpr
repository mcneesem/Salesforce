    "FORMULA0" : {
      "action" : "formula",
      "sources" : [ "APPEND10" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Object_Name",
          "label" : "Object",
          "formulaExpression" : "case \r\n\twhen startsWith(\"blng__Cred.Name\", 'CN-')\r\n\tthen 'Credit Note'\r\n\twhen startsWith(\"blng__Cred.Name\", 'P-')\r\n\tthen 'Payment'\r\n\twhen startsWith(\"blng__Cred.Name\", 'RS-')\r\n\tthen 'Revenue Schedule'\r\n\twhen startsWith(\"blng__Cred.Name\", 'INV-')\r\n\tthen 'Invoice'\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
