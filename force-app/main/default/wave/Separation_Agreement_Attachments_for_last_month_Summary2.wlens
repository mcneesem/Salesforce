{"filters":[],"gridLayouts":[],"layouts":[],"steps":{"saql":{"broadcastFacet":false,"groups":[],"numbers":[],"query":"q = load \"Wiz_ContentVer\";\nq = group q by ('Account.Name', 'NSP_ReportRequest__c.Id');\nq = foreach q generate q.'Account.Name' as 'Account.Name', q.'NSP_ReportRequest__c.Id' as 'NSP_ReportRequest__c.Id', unique(q.'ContentDocumentId') as 'Number of Attachments';\nq = order q by ('Account.Name' asc, 'NSP_ReportRequest__c.Id' asc);\nq = limit q 2000;","receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"none","strings":[],"type":"saql","useGlobal":true}},"widgets":{"saql_table":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{"NSP_ReportRequest__c.Id":{"parameters":{"alignment":"left","styles":{"linkColor":"#006dcc"}},"type":"text"},"Account.Name":{"parameters":{"alignment":"left","styles":{"linkColor":"#006dcc"}},"type":"text"}},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"textWrap":true},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"showRowIndexColumn":true,"step":"saql","totals":true,"verticalPadding":8},"type":"table"}}}