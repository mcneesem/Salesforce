s":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"columnMap":{"trellis":[],"dimensionAxis":["Account.Name"],"plots":["A"]},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"lens_2":{"broadcastFacet":true,"groups":[],"label":"lens_2","numbers":[],"query":"q = load \"Laura_s_Combined_Queue_DataSet2\";\nq = filter q by 'Status' not in [\"Cancelled\", \"Closed\"];\nq = filter q by 'Account.Name' matches \"Congruex Group\" || 'Account.Name' matches \"C.C.L.D. Technologies\" || 'Account.Name' matches \"Terra Technologies\" || 'Account.Name' matches \"Whiteco\" || 'Account.Name' matches \"HHS Construction\" || 'Account.Name' matches \"CHC Consulting\" || 'Account.Name' matches \"A&M Communications Company\" || 'Account.Name' matches \"Congruex SpliceCo\" || 'Account.Name' matches \"Gudenkauf\" || 'Account.Name' matches \"Southeast Utilities of Georgia\" || 'Account.Name' matches \"True North Management Services\" || 'Account.Name' matches \"Trigild\" ;\nq = filter q by 'Subject' matches \"New Jurisdiction\" || 'Subject' matches \"PTO Smart Form\" || 'Subject' matches \"**\" || 'Subject' matches \"New Part Time Employee\";\nq = filter q by !('Subject' matches \"DST\") && !('Subject' matches \"Internal\") && !('Subject' matches \"Inquiry\") && !('Subject' matches \"Time & Attendance Version 7 Upgrade\") && !('Subject' matches \"**WO/WA Transition**\")  ;\n--q = filter q by !('Subject' matches \"Internal\");\nq = filter q by ('NSP_Case_Sub_Status__c' != \"Waiting on Client\" || 'NSP_Case_Sub_Status__c' is null);\nq = foreach q generate q.'CaseNumber' as 'CaseNumber', q.'Subject' as 'Subject', q.'Account.Name' as 'Account.Name', q.'NSP_Due_Date__c' as 'NSP_Due_Date__c', q.'NSP_Case_Sub_Status__c' as 'NSP_Case_Sub_Status__c', q.'Priority' as 'Priority', q.'NSP_Level_2__c' as 'NSP_Level_2__c', q.'User.Name' as 'Owner Name';\nq = order q by 'NSP_Due_Date__c' asc;\nq = limit q 25000","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#a8b7c7","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#16325c","fontColor":"#ffffff","fontSize":12,"textWrap":true},"innerMajorBorderColor":"#54698d","innerMinorBorderColor":"#a8b7c7","interactions":[],"mode":"fittocontainer","numberOfLines":1,"showActionMenu":true,"showRowIndexColumn":true,"totals":true,"verticalPadding":8},"type":"table"}}},"widgetStyle":{"backgroundColor":"#FFFFFF","borderColor":"#E6ECF2","borderEdges":[],"borderRadius":0,"borderWidth":1},"widgets":{"table_2":{"parameters":{"borderColor":"#a8b7c7","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{"CaseNumber":{"parameters":{"alignment":"left","styles":{"linkColor":"#006dcc"}},"type":"text"}},"columns":[],"customBulkActions":[],"exploreLink":true,"header":{"backgroundColor":"#16325c","fontColor":"#ffffff","fontSize":12,"textWrap":true},"innerMajorBorderColor":"#54698d","innerMinorBorderColor":"#a8b7c7","interactions":[],