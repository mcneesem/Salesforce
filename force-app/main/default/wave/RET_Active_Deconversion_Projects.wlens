{"filters":[],"gridLayouts":[],"layouts":[],"steps":{"saql":{"broadcastFacet":false,"groups":[],"numbers":[],"query":"q = load \"Project_with_Project_Task_and_Assignment\";\nq = filter q by 'pse__Proje.Name' in [\"401K Employee training\", \"401K Reports\", \"401K meeting with client\", \"<WSEE Name>: LOA Form needed\", \"Add to NOS Calendar\", \"Add to NPM Calendar\", \"CRMA Test1\", \"Change management: change management and communication strategy plan\", \"Client Packing slip setup\", \"Client Setup\", \"Conduct call with the client (collaborate with Payroll Specialist)\", \"Create Work Order field Sync 2/13 01 from Sa1\", \"DDI\", \"Duration Test\", \"EEO1 Number/Questionnaire\", \"Financial Service 1.1\", \"First Payroll\", \"First Payroll Approved\", \"IRR Report Access Requested and Added to Payroll Reports\", \"Letter Received (Termination Letter)\", \"Mani Project Task\", \"Mani RET\", \"Notify April Nikolaus of MM Client and benefit effective date\", \"Officer K Project Task\", \"PT 1\", \"PT1\", \"PT3\", \"Pay Code Assignment - Client level\", \"Project Task\", \"RET Test Project Task\", \"Review WO to WX Internal Call Guide\", \"Schedule deconversion date\", \"Stay Strong TP based on unfavorable rating\", \"Swarna 1\", \"Task 1\", \"Test\", \"Test Proj Task\", \"Test pT\", \"Test11\", \"TestBoardeligibletasks\", \"TestingCreateWorkOrderAddress2\", \"Time Card entry task\", \"Validation of PPTT feed to OMNI\", \"Wave10\", \"child\", \"task2\", \"test\", \"test project task\"];\nq = filter q by 'pse__Proje.pse__Status__c' in [\"Cancelled\", \"Complete\", \"In Progress\", \"None\", \"Not Started\", \"Scheduled\"];\nq = filter q by 'pse__Proje1.pse__Resource_Role__c' in [\"Client Liaison\", \"IPIC\", \"Insperity\", \"Performance Specialist\", \"Project Manager\", \"RET Plan Consulting\"];\nq = foreach q generate  q.'pse__Proj_.Name' as 'pse__Proj_.Name',q.AccountName, q.'pse__Proje.Name' as 'pse__Proje.Name', q.'pse__Proje.pse__Status__c' as 'pse__Proje.pse_