rue,"groups":[],"label":"ITA- CSA for Simultaneous Start Next Week","numbers":[],"query":"q = load \"ITA_CSA_for_Simultaneous_Start_Next_Week\";\nq = filter q by 'RecordType.DeveloperName' == \"Time_Attendance\";\nq = filter q by 'pse__Proj__c.NSP_BPS_Project_Template__c' in [\"ITA-Implementation\", \"ITA-Other\"];\nq = filter q by 'pse__Proje.pse__Status__c' == \"In Progress\";\nq = filter q by 'pse__Proj__c.Product_Line__c' == \"WO\";\nq = filter q by 'pse__Proj__c.pse__Project_Status__c' in [\"Active\", \"Quality Review\", \"Special Extension\"];\nq = filter q by 'pse__Proj__c.Invoice_Ready__c' == \"true\";\nq = filter q by date('pse__Proj__c.Go_Live_Date__c_Year', 'pse__Proj__c.Go_Live_Date__c_Month', 'pse__Proj__c.Go_Live_Date__c_Day') in [\"1 month ago\"..\"1 month ago\"];\nq = filter q by 'pse__Proj__c.Service_Level__c' == \"New PEO Client\";\nq = foreach q generate q.'pse__Proj__c.pse__Project_ID__c' as 'pse__Proj__c.pse__Project_ID__c', q.'pse__Proj__c.Name' as 'pse__Proj__c.Name', q.'pse__Proj__c.pse__Project_Status__c' as 'pse__Proj__c.pse__Project_Status__c', q.'Account.NSP_SKO__c' as 'Account.NSP_SKO__c', q.'pse__Proj__c.Go_Live_Date__c' as 'pse__Proj__c.Go_Live_Date__c', q.'pse__Proj__c.Invoice_Ready__c' as 'pse__Proj__c.Invoice_Ready__c', q.'UserCopy1.Name' as 'UserCopy1.Name', q.'User.Name' as 'User.Name', q.'Asset.NSP_SaaS_URL__c' as 'Asset.NSP_SaaS_URL__c', q.'pse__Proj__c.Hold_Start_Date__c' as 'pse__Proj__c.Hold_Start_Date__c', q.'pse__Proj__c.Hold_End_date__c' as 'pse__Proj__c.Hold_End_date__c';\nq = limit q 25000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#a8b7c7","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#16325c","fontColor":"#ffffff","fontSize":12,"textWrap":true},"inne