      "sources" : [ "JOIN0" ],
      "parameters" : {
        "fields" : [ {
          "name" : "Status_bucket",
          "label" : "Status Bucket",
          "type" : "TEXT",
          "bucketsSetup" : {
            "isPassthroughEnabled" : true,
            "sourceField" : {
              "name" : "Status",
              "type" : "TEXT"
            },
            "buckets" : [ {
              "value" : "Open",
              "sourceValues" : [ "Open", "ReOpened" ]
            }, {
              "value" : "Closed",
              "sourceValues" : [ "Cancelled", "Closed" ]
            } ]
          }
        } ]
      }
