    "TO_MEASURE0" : {
      "action" : "typeCast",
      "sources" : [ "BUCKET0" ],
      "parameters" : {
        "fields" : [ {
          "name" : "CaseNumber",
          "newProperties" : {
            "label" : "Case Number_N",
            "name" : "CaseNumber_to_measure",
            "typeProperties" : {
              "type" : "NUMBER",
              "scale" : 2,
              "precision" : 18
            }
          }
        } ]
      }
    },
    "FORMULA0" : {
      "action" : "formula",
      "sources" : [ "TO_MEASURE0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "CaseNumber_formula",
          "label" : "Open Cases",
          "formulaExpression" : "case when Status = 'Open' then  (1) else 0   end",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA1" : {
      "action" : "formula",
      "sources" : [ "FORMULA3" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "CaseNumber_formula1",
          "label" : "Closed Cases",
          "formulaExpression" : "case when Status = 'Closed' then 1 else 0 end",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA2" : {
      "action" : "formula",
      "sources" : [ "FORMULA0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "CaseNumber_formula_formula",
          "label" : "Total Cases",
          "formulaExpression" : "(case when Status = 'Open' then  (1) else 0   end)\r\n+\r\n(case when Status = 'Closed' then  (1) else 0   end)\r\n+\r\n(case when Status = 'Cancelled' then  (1) else 0   end)\r\n+\r\n(case when Status = 'ReOpened' then  (1) else 0   end)",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA3" : {
      "action" : "formula",
      "sources" : [ "FORMULA2" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "CaseNumber_formula_formula_formula",
          "label" : "Percent Complete",
          "formulaExpression" : "(case when Status = 'Closed' then  (1) else 0   end)\r\n/(\r\n(case when Status = 'Open' then  (1) else 0   end)\r\n+\r\n(case when Status = 'Closed' then  (1) else 0   end)\r\n+\r\n(case when Status = 'Cancelled' then  (1) else 0   end)\r\n+\r\n(case when Status = 'ReOpened' then  (1) else 0   end)) * 100",
          "precision" : 10,
          "scale" : 1,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA4" : {
      "action" : "formula",
      "sources" : [ "FORMULA1" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Asset.NSP_Service_Region__c_formula",
          "label" : "Service Region Formula",
          "formulaExpression" : "case when \"Asset.NSP_Service_Region__c\" is null then 'Not specified' else \"Asset.NSP_Service_Region__c\" end",
          "precision" : 255,
          "defaultValue" : "Service Region_Custom"
        } ]
      }
    }
