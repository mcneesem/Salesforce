    "FORMULA18_copy0" : {
      "action" : "formula",
      "sources" : [ "FORMULA1_copy0_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Opportunity_Overall_Status_formula",
          "label" : "Opportunity Overall Status",
          "formulaExpression" : "case \r\n\twhen NSP_Overall_Status__c = 1\r\n\tthen 'Data Collection'\r\n\twhen NSP_Overall_Status__c = 2\r\n\tthen 'P&R New Bid'\r\n\twhen NSP_Overall_Status__c = 3\r\n\tthen 'Sales'\r\n\twhen NSP_Overall_Status__c = 4\r\n\tthen 'P&R Re-Look'\r\n\twhen NSP_Overall_Status__c = 5\r\n\tthen 'Closed'\r\n\twhen NSP_Overall_Status__c = 6\r\n\tthen 'Contracting'\r\n\twhen NSP_Overall_Status__c = 7\r\n\tthen 'OnBoarding'\r\n\twhen NSP_Overall_Status__c = 8\r\n\tthen 'Waiting On Others'\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
