{"filters":[],"gridLayouts":[],"layouts":[],"steps":{"saql":{"broadcastFacet":false,"groups":[],"numbers":[],"query":"q = load \"ProjectTask_Asset_ImplementationProfile\";\nq = filter q by date('pse__End_Date_Time__c_Year', 'pse__End_Date_Time__c_Month', 'pse__End_Date_Time__c_Day') in [\"1 day ago\"..\"1 day ago\"];\nq = filter q by 'NSP_Category__c' == \"Client Implementation\";\nq = filter q by 'pse__Status__c' == \"Canceled\";\nq = foreach q generate q.'Asset.NSP_Client__c' as 'Asset.NSP_Client__c', q.'Asset.NSP_Company_Name__c' as 'Asset.NSP_Company_Name__c', q.'Asset.NSP_Service_Region__c' as 'Asset.NSP_Service_Region__c', q.'Asset.Status' as 'Asset.Status', q.'Name' as 'Name', q.'User.Name' as 'User.Name', q.'End_Date_Time' as 'End_Date_Time', mv_to_string(q.'Join13.Transform6.Onboarding_Specialist') as 'Join13.Transform6.Onboarding_Specialist';\nq = limit q 25000;","receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"none","strings":[],"type":"saql","useGlobal":true}},"widgets":{"saql_table":{"parameters":{"borderColor":"#a8b7c7","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{"Asset.NSP_Company_Name__c":{"parameters":{"alignment":"left","styles":{"linkColor":"#006dcc"}},"type":"text"}},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#16325c","fontColor":"#ffffff","fontSize":12,"textWrap":true},"innerMajorBorderColor":"#54698d","innerMinorBorderColor":"#a8b7c7","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"showRowIndexColumn":true,"step":"saql","verticalPadding":8},"type":"table"}}}