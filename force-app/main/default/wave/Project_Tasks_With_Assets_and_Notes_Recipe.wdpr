    "FORMULA17" : {
      "action" : "formula",
      "sources" : [ "LOAD_DATASET18_copy0_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Division_Region_formula",
          "label" : "Region",
          "formulaExpression" : "case \r\n\twhen Division='Client OT - Central Rgn'\r\n\tthen 'Central'\r\n    when Division='Client OT - Eastern Rgn'\r\n\tthen 'Eastern'\r\n    when Division='Client OT - Houston Rgn'\r\n\tthen 'Houston'\r\n    when Division='Client OT - Mid Atlantic Rgn'\r\n\tthen 'Mid Atlantic'\r\n    when Division='Client OT - NorthEastern Rgn'\r\n\tthen 'NorthEastern'\r\n    when Division='Client OT - SouthEastern Rgn'\r\n\tthen 'SouthEastern'\r\n    when Division='Client OT - Western Rgn'\r\n\tthen 'Western'\r\n    when Division='Client OT - Planners'\r\n\tthen 'Planners'\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
