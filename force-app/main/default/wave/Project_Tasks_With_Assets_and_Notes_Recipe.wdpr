          "label" : "PM Assignment to 1st Pay Date",
          "formulaExpression" : "case \r\n    when  NSP_AIMS_Original_First_Pay_Date__c is not null\r\n    then \r\n    datediff(NSP_AIMS_Original_First_Pay_Date__c,\"Asset_PT.pse__Actual_End_Date_Time__c\")\r\n    else\r\n    ' '\r\nend\r\n",
