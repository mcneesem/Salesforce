{"dataSourceLinksInfo":{"enableAutomaticLinking":false,"excludeRelationships":[],"links":[]},"filters":[],"gridLayouts":[],"layouts":[],"steps":{"saql":{"broadcastFacet":false,"groups":[],"numbers":[],"query":"q = load \"MODIFIED_RET_NSPk_SUBLISTING\";\nq = filter q by 'Account.NSP_Accoun.NSP_Role__c' == \"401k Plan Consultant\";\nq = filter q by 'NSP_Account_Status__c' == \"Active\";\nq = filter q by 'RecordType.Name' in [\"RET Choice\", \"RET WO\"];\nq = foreach q generate 'NSP_Plan_SubPlan__c.NSP_Subplan_ID__c' as 'NSP_Plan_SubPlan__c.NSP_Subplan_ID__c','NSP_Plan_SubPlan__c.NSP_Subplan_Name__c' as 'NSP_Plan_SubPlan__c.NSP_Subplan_Name__c','NSP_Plan_SubPlan__c.NSP_Original_PE_Date__c_formula' as 'Original PE Date','NSP_Plan_SubPlan__c.NSP_Plan_Effective_Date__c_formula' as ' Plan Effective Date ','NSP_Start_Date__c_formula' as 'NSP_Start_Date__c', 'NSP_Plan_SubPlan__c.NSP_Plan_Type__c' as 'NSP_Plan_SubPlan__c.NSP_Plan_Type__c','NSP_Plan_SubPlan__c.NSP_Test_Plan_Status__c' as 'NSP_Plan_SubPlan__c.NSP_Test_Plan_Status__c','NSP_Plan_SubPlan__c.NSP_Auto_Deferral__c' as 'NSP_Plan_SubPlan__c.NSP_Auto_Deferral__c', 'NSP_Price_Level__c' as 'NSP_Price_Level__c','NSP_Client_Segment_type__c' as 'NSP_Client_Segment_type__c','NSP_Status__c' as 'NSP_Status__c','Account.NSP_Accoun.User.Name' as 'Account.NSP_Accoun.User.Name',  'NSP_RET_Employee_Count__c' as 'NSP_RET_Employee_Count__c','NSP_Account_Status__c' as 'NSP_Account_Status__c',  'NSP_Client__c' as 'NSP_Client__c',    'NSP_Plan_SubPlan__c.NSP_Status__c' as 'NSP_Plan_SubPlan__c.NSP_Status__c',     'NSP_RET_NAICS_Description__c' as 'NSP_RET_NAICS_Description__c',   'UserWA_WX.Name' as 'UserWA_WX.Name' , 'Id' as 'Id';\nq = limit q 25000;","receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"none","strings":[],"type":"saql","useGlobal":true}},"widgets":{"saql_table":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnPr