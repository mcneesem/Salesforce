onParameters":{}},"employee_enrollment_1":{"broadcastFacet":true,"groups":[],"label":"employee enrollment","numbers":[],"query":"q = load \"Project_Worksite_Employee_Enrollment_Percentage\";\nq = filter q by 'pse__Project_Type__c' == \"Implementation\";\nq = filter q by 'TemplateName__c' == \"Middle Market - Implementation\";\nq = filter q by 'pse__Project_Status__c' in [\"Active\", \"Close/Lost\", \"Inactive\", \"Intake\", \"Not Yet Active\", \"On Hold\", \"Pending Approval\"];\nq = filter q by 'NSP_Visible_to_Client__c' == \"true\";\nq = group q by all;\nNotStarted = foreach q generate \"Not Started\" as 'Bucket', (sum(q.NSP_Employee_Enrollment_Not_Started__c)/sum(q.'NSP_Total_Projected_Employee_Enrollment__c')*100) as 'Employee Enrollment';\nInProgress = foreach q generate \"In Progress\" as 'Bucket', (sum(q.NSP_Employee_Enrollment_In_Progress__c)/sum(q.'NSP_Total_Projected_Employee_Enrollment__c')*100) as 'Employee Enrollment';\nSubmitted = foreach q generate \"Submitted\" as 'Bucket', (sum(q.NSP_Employee_Enrollment_Submitted__c)/sum(q.'NSP_Total_Projected_Employee_Enrollment__c')*100) as 'Employee Enrollment';\nTotal = union NotStarted, InProgress, Submitted;\nTotal = group Total by ('Bucket');\nTotal = foreach Total generate 'Bucket' as 'Employee_Enrollment', sum('Employee Enrollment') as 'Employee Enrollment Status';\nq = limit Total 2000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","centerText":"","legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"bottom-center","inside":false},"showMeasureTitle":true,"tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"pie","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"ce