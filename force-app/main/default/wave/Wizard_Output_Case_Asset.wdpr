        }
      },
      "parameters" : {
        "joinType" : "LEFT_OUTER",
        "leftKeys" : [ "Id" ],
        "rightQualifier" : "FilterSubs",
        "rightKeys" : [ "CaseId" ]
      }
    },
    "FORMULA7" : {
      "action" : "formula",
      "sources" : [ "JOIN21" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "NSP_Case_Current_Sub_Category__c",
          "label" : "NSP_Case_Current_Sub_Category__c",
          "formulaExpression" : "case \r\n\twhen \"FilterSubs.Field\" = 'NSP_Case_Sub_Status__c'\r\n\tthen \"FilterSubs.NewValue\"\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA8" : {
      "action" : "formula",
      "sources" : [ "FORMULA7" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Initial_Date",
          "label" : "Initial Date",
          "formulaExpression" : "case when \"FilterSubs.NewValue\" = 'Awaiting Verification' then\r\ndate_format(\"FilterSubs.CreatedDate\", 'MM/dd/yyyy')\r\nEND",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA9" : {
      "action" : "formula",
      "sources" : [ "FORMULA8" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Awaiting_Verification_Datetime",
          "label" : "Awaiting Verification Datetime",
          "formulaExpression" : "case when \"FilterSubs.NewValue\" = 'Awaiting Verification' then\r\ndate_format(\"FilterSubs.CreatedDate\", 'MM/dd/yyyy:hh:mm:ss')\r\nEND",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "EXTRACT0" : {
      "action" : "extractGrains",
      "sources" : [ "FORMULA9" ],
      "parameters" : {
        "grainExtractions" : [ {
          "source" : "NSP_Original_Assigned_Queue_Date__c",
          "targets" : [ {
            "name" : "NSP_Original_Assigned_Queue_Date__c_extract",
            "label" : "Original Assigned Queue Date Extract",
            "grainType" : "SEC_EPOCH"
          } ]
        } ]
      }
    },
    "EXTRACT1" : {
      "action" : "extractGrains",
      "sources" : [ "EXTRACT0" ],
      "parameters" : {
        "grainExtractions" : [ {
          "source" : "FilterSubs.CreatedDate",
          "targets" : [ {
            "name" : "FilterSubs.CreatedDate_extract",
            "label" : "FilterSubs.Created Date Extract",
            "grainType" : "SEC_EPOCH"
          } ]
        } ]
      }
    },
    "FORMULA11" : {
      "action" : "formula",
      "sources" : [ "EXTRACT1" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "Turn_Around_Time",
          "label" : "Turn Around Time",
          "formulaExpression" : "case when\r\n\"FilterSubs.NewValue\" = 'Awaiting Verification' then\r\nabs(NSP_Original_Assigned_Queue_Date__c_extract-\"FilterSubs.CreatedDate_extract\")/3600\r\nEnd",
          "precision" : 16,
          "scale" : 2,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA12" : {
      "action" : "formula",
      "sources" : [ "FORMULA11" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "DATETIME",
          "name" : "Case_Substatus_Date_formula",
          "label" : "Case Substatus Date",
          "formulaExpression" : "case \r\n\twhen \"FilterSubs.NewValue\" = 'WIRE - Migration Complete'\r\n\tthen \"FilterSubs.CreatedDate\"\r\n\twhen \"FilterSubs.NewValue\" = 'Awaiting Verification'\r\n\tthen \"FilterSubs.CreatedDate\"\r\n\twhen \"FilterSubs.NewValue\" = 'In Process'\r\n\tthen \"FilterSubs.CreatedDate\"\r\n\twhen \"FilterSubs.NewValue\" ='Waiting on Requester'\r\n\tthen \"FilterSubs.CreatedDate\"\r\nend",
          "format" : "MM/dd/yyyy",
          "defaultValue" : ""
        } ]
      }
    },
    "OUTPUT2" : {
      "action" : "save",
      "sources" : [ "FORMULA12" ],
      "parameters" : {
        "fields" : [ ],
        "dataset" : {
          "type" : "analyticsDataset",
          "label" : "RDT Reports Awaiting Verification",
          "name" : "RDT_Reports_Awaiting_Verification",
          "folderName" : "Report_Development_Team"
        },
        "measuresToCurrencies" : [ ]
      }
    }
