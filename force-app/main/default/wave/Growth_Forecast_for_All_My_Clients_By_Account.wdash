,\"groups\":[\"Join2.Account.Name\"]}","version":-1.0},"receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"multi","type":"aggregateflex","useGlobal":true,"visualizationParameters":{}},"lens_1":{"broadcastFacet":true,"groups":[],"label":"lens_1","numbers":[],"query":"q = load \"Growth_Forecast_for_All_Clients\";\nq = filter q by 'NSP_Type__c' == \"Growth Forecast\";\nq = filter q by 'NSP_Primary__c' == \"true\";\nq = filter q by 'Join2.NSP_Account_Status__c' == \"Active\";\nq = filter q by 'Join2.RecordType.DeveloperName' == \"WO\";\nq = group q by 'Join2.Account.Name';\nAcquisition = foreach q generate q.'Join2.Account.Name' as 'Join2.Account.Name',\"Acquisition\" as 'Bucket', sum(q.'NSP_Accoun.NSP_Acquisition_Current_Quarter__c') as 'Current QTR', sum(q.'NSP_Accoun.NSP_Acquisition_Current_Quarter_1__c') as 'QTR + 1',sum(q.'NSP_Accoun.NSP_Acquisition_Current_Quarter_2__c') as 'QTR + 2',sum(q.'NSP_Accoun.NSP_Acquisition_Current_Quarter_3__c') as 'QTR + 3';\nOrganic = foreach q generate q.'Join2.Account.Name' as 'Join2.Account.Name', \"Organic\" as 'Bucket', sum(q.'NSP_Accoun.NSP_Organic_Current_Quarter__c') as 'Current QTR', sum(q.'NSP_Accoun.NSP_Organic_Current_Quarter_1__c') as 'QTR + 1',sum(q.'NSP_Accoun.NSP_Organic_Current_Quarter_2__c') as 'QTR + 2',sum(q.'NSP_Accoun.NSP_Organic_Current_Quarter_3__c') as 'QTR + 3';\nReduction = foreach q generate q.'Join2.Account.Name' as 'Join2.Account.Name',\"Reduction\" as 'Bucket', sum(q.'NSP_Accoun.NSP_Reduction_Current_Quarter__c') as 'Current QTR', sum(q.'NSP_Accoun.NSP_Reduction_Current_Quarter_1__c') as 'QTR + 1',sum(q.'NSP_Accoun.NSP_Reduction_Current_Quarter_2__c') as 'QTR + 2',sum(q.'NSP_Accoun.NSP_Reduction_Current_Quarter_3__c') as 'QTR + 3';\nTotal = foreach q generate q.'Join2.Account.Name' as 'Join2.Account.Name',\"Total\" as 'Bucket', sum(q.'NSP_Accoun.NSP_Acquisition_Current_Quarter__c')+sum(q.'NSP_Accoun.NSP_Organic_Current_Quarter__c')+sum(q.'NSP_Accoun.NSP_Reduction_Current_Quarter__c') as 'Current QTR', sum(q.'NSP_Accoun.NSP_Acquisition_Current_Quarter_1__c')+sum(q.'NSP_Accoun.NSP_Organic_Current_Quarter_1__c')+sum(q.'NSP_Accoun.NSP_Reduction_Current_Quarter_1__c')  as 'QTR + 1',sum(q.'NSP_Accoun.NSP_Acquisition_Current_Quarter_2__c')+sum(q.'NSP_Accoun.NSP_Organic_Current_Quarter_2__c') +sum(q.'NSP_Accoun.NSP_Reduction_Current_Quarter_2__c') as 'QTR + 2',sum(q.'NSP_Accoun.NSP_Acquisition_Current_Quarter_3__c')+sum(q.'NSP_Accoun.NSP_Organic_Current_Quarter_3__c')+sum(q.'NSP_Accoun.NSP_Reduction_Current_Quarter_3__c') as 'QTR + 3';\nTotal1 = union Acquisition, Organic, Reduction,Total;\nTotal1 = foreach Total1 generate 'Join2.Account.Name' as 'Join2.Account.Name', 'Bucket' as 'Growth Forecast', sum('Current QTR') as 'Current QTR',sum('QTR + 1') as 'QTR + 1',sum('QTR + 2') as 'QTR + 2',sum('QTR + 3') as 'QTR + 3',('Current QTR'+'QTR + 1'+'QTR + 2'+'QTR + 3') as 'Total WSEE';\nq = limit Total1 25000;\n","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#a8b7c7","borderWidth":2,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#16325c","fontColor":"#ffffff","fontSize":12,"textWrap":true},"innerMajorBorderColor":"#54698d","innerMinorBorderColor":"#a8b7c7","interactions":[],"mode":"fittocontainer","numberOfLines":1,"pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"lens_2":{"broadcastFacet":true,"groups":[],"label":"lens_2","numbers":[],"query":"q = load \"Growth_Forecast_for_My_Clients\";\nq = filter q by 'NSP_Type__c' == \"Growth Forecast\";\nq = filter q by 'NSP_Primary__c' == \"true\";\nq = filter q by 'Join2.NSP_Account_Status__c' == \"Active\";\nq = filter q by 'Join2.RecordType.DeveloperName' == \"WO\";\nq = group q by 'Join2.Account.Name';\nAcquisitio