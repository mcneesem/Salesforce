rvice\";\nq = filter q by 'pse__Status__c' == \"Complete\";\nq = group q by rollup('NSP_Owner__c', 'Asset.NSP_Client_Segment_type__c', 'User_PTO.User_PTOM.Name', 'Account_name.Name', 'NSP_AIMS_Account__c', 'pse__Status__c', 'End_Date_and_Time_formula');\nq = foreach q generate q.'NSP_Owner__c' as 'NSP_Owner__c', q.'Asset.NSP_Client_Segment_type__c' as 'Asset.NSP_Client_Segment_type__c', q.'User_PTO.User_PTOM.Name' as 'User_PTO.User_PTOM.Name', q.'Account_name.Name' as 'Account_name.Name', q.'NSP_AIMS_Account__c' as 'NSP_AIMS_Account__c', q.'pse__Status__c' as 'pse__Status__c', q.'End_Date_and_Time_formula' as 'End_Date_and_Time_formula', grouping(q.'NSP_Owner__c') as 'grouping_NSP_Owner__c', grouping(q.'Asset.NSP_Client_Segment_type__c') as 'grouping_Asset.NSP_Client_Segment_type__c', grouping(q.'User_PTO.User_PTOM.Name') as 'grouping_User_PTO.User_PTOM.Name', grouping(q.'Account_name.Name') as 'grouping_Account_name.Name', grouping(q.'NSP_AIMS_Account__c') as 'grouping_NSP_AIMS_Account__c', grouping(q.'pse__Status__c') as 'grouping_pse__Status__c', grouping(q.'End_Date_and_Time_formula') as 'grouping_End_Date_and_Time_formula';\nq = filter q by 'grouping_NSP_Owner__c' == 0 and (('grouping_Asset.NSP_Client_Segment_type__c' == 0 and 'grouping_User_PTO.User_PTOM.Name' == 0 and 'grouping_Account_name.Name' == 0 and 'grouping_NSP_AIMS_Account__c' == 0 and 'grouping_pse__Status__c' == 0 and 'grouping_End_Date_and_Time_formula' == 0) or ('grouping_Asset.NSP_Client_Segment_type__c' == 1 and 'grouping_User_PTO.User_PTOM.Name' == 1 and 'grouping_Account_name.Name' == 1 and 'grouping_NSP_AIMS_Account__c' == 1 and 'grouping_pse__Status__c' == 1 and 'grouping_End_Date_and_Time_formula' == 1));\nq = order q by ('NSP_Owner__c' asc, 'Asset.NSP_Client_Segment_type__c' asc, 'User_PTO.User_PTOM.Name' asc, 'Account_name.Name' asc, 'NSP_AIMS_Account__c' asc, 'pse__Status__c' asc, 'End_Date_and_Time_formula' asc);\nq = limit q 25000;","receiveFacetSource":{"mode":"include","steps":["pse