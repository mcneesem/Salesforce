","type":"aggregateflex","useGlobal":true,"visualizationParameters":{"options":{},"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["NSP_Employee_Enrollment_In_Progress__c","NSP_Employee_Enrollment_Not_Started__c","NSP_Employee_Enrollment_Submitted__c","NSP_Total_Projected_Employee_Enrollment__c"],"customBulkActions":[],"header":{"backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"textWrap":true},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"showRowIndexColumn":true,"totals":true,"verticalPadding":8},"type":"table"}},"Worksite_Table_1":{"broadcastFacet":true,"groups":[],"label":"Worksite Chart","numbers":[],"query":"q = load \"Projects_with_accounts\";\nq = filter q by 'pse__Project_Type__c' == \"Implementation\";\nq = group q by all;\nNotStarted = foreach q generate \"Not Started\" as 'Bucket', (sum(q.'NSP_Employee_Enrollment_Not_Started__c')/sum(q.'NSP_Total_Projected_Employee_Enrollment__c')*100) as 'Employee Enrollment';\nInProgress = foreach q generate \"In Progress\" as 'Bucket', (sum(q.'NSP_Employee_Enrollment_In_Progress__c')/sum(q.'NSP_Total_Projected_Employee_Enrollment__c')*100) as 'Employee Enrollment';\nSubmitted = foreach q generate \"Submitted\" as 'Bucket', (sum(q.'NSP_Employee_Enrollment_Submitted__c')/sum(q.'NSP_Total_Projected_Employee_Enrollment__c')*100) as 'Employee Enrollment';\nTotal = union NotStarted, InProgress, Submitted;\nTotal = group Total by ('Bucket');\nTotal = foreach Total generate 'Bucket' as 'Employee Enrollment', sum('Employee Enrollment') as 'Employee Enrollment Status';\nq = limit Total 25000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"none","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"autoFitM