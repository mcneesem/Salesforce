    "FORMULA0" : {
      "action" : "formula",
      "sources" : [ "JOIN14" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "CLIENT_TENURE_DAYS",
          "label" : "Client Tenure (Days)",
          "formulaExpression" : "case \r\n\twhen Status = 'Terminated'\r\n\tthen datediff(NSP_Termination_Date__c, NSP_First_Pay_Date__c)\r\n\telse\r\n    datediff(current_date(), NSP_First_Pay_Date__c)\r\nend",
