{"filters":[],"gridLayouts":[],"layouts":[],"steps":{"saql":{"broadcastFacet":false,"groups":[],"numbers":[],"query":"q = load \"Asset_AccountTeam_ImplementationProfile\";\nq = filter q by 'RecordType.DeveloperName' == \"WO\";\nq = filter q by 'Status' == \"Active\";\nq = foreach q generate q.'NSP_Client__c' as 'NSP_Client__c', q.'NSP_Company_Name__c' as 'NSP_Company_Name__c', q.'NSP_Client_Segment_type__c' as 'NSP_Client_Segment_type__c', q.'AIMS_Original_First_Pay_Date' as 'AIMS_Original_First_Pay_Date', q.'WO_Sold_Date' as 'WO_Sold_Date',q.'CSA_Signed_Date' as 'CSA_Signed_Date',q.'Bid_Download_Date' as 'Bid_Download_Date',q.'Renewal_Date' as 'Renewal_Date', q.'Join10.BusTeamHRCL.Bus_Team_HRSp_CL_Final' as 'Join10.BusTeamHRCL.Bus_Team_HRSp_CL_Final', q.'Join10.CL.Client_Liaison_Final' as 'Join10.CL.Client_Liaison_Final', q.'Join10.MMAE.MidMarket_AE_Final' as 'Join10.MMAE.MidMarket_AE_Final',q.'Join10.MHRS.MHRS_Final' as 'Join10.MHRS.MHRS_Final',q.'Join10.RenewalCor.RenewalCoordinator_final' as 'Join10.RenewalCor.RenewalCoordinator_final',mv_to_string(q.'Join7.Transform6.Onboarding_Specialist') as 'Join7.Transform6.Onboarding_Specialist';\nq = limit q 25000;","receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"none","strings":[],"type":"saql","useGlobal":true}},"widgets":{"saql_table":{"parameters":{"borderColor":"#a8b7c7","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#16325c","fontColor":"#ffffff","fontSize":12,"textWrap":true},"innerMajorBorderColor":"#54698d","innerMinorBorderColor":"#a8b7c7","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"showRowIndexColumn":true,"step":"saql","verticalPadding":8},"type":"table"}}}