uery":"q = load \"Case_details_with_User_Queue\";\nq = filter q by ('Transform2.Queue_Member' in [\"Contact_Center_Member\", \"Escalations_Member\"] or 'Queue_begins_with' in [\"Contact Center\", \"Escalations\"]) and 'Status' in [\"Open\", \"ReOpened\"];\nq = group q by rollup('Join6.UserCopy.Name', 'Join6.Name', 'Date_Time_Opened', 'NSP_Category__c', 'NSP_SubCategory__c', 'Case_Owner', 'Status', 'CaseNumber', 'NSP_ClientNumber__c');\nq = foreach q generate q.'Join6.UserCopy.Name' as 'Join6.UserCopy.Name', q.'Join6.Name' as 'Join6.Name', q.'Date_Time_Opened' as 'Date_Time_Opened', q.'NSP_Category__c' as 'NSP_Category__c', q.'NSP_SubCategory__c' as 'NSP_SubCategory__c', q.'Case_Owner' as 'Case_Owner', q.'Status' as 'Status', q.'CaseNumber' as 'CaseNumber', q.'NSP_ClientNumber__c' as 'NSP_ClientNumber__c', grouping(q.'Join6.UserCopy.Name') as 'grouping_Join6.UserCopy.Name', grouping(q.'Join6.Name') as 'grouping_Join6.Name', grouping(q.'Date_Time_Opened') as 'grouping_Date_Time_Opened', grouping(q.'NSP_Category__c') as 'grouping_NSP_Category__c', grouping(q.'NSP_SubCategory__c') as 'grouping_NSP_SubCategory__c', grouping(q.'Case_Owner') as 'grouping_Case_Owner', grouping(q.'Status') as 'grouping_Status', grouping(q.'CaseNumber') as 'grouping_CaseNumber', grouping(q.'NSP_ClientNumber__c') as 'grouping_NSP_ClientNumber__c';\ns = filter q by 'grouping_Join6.UserCopy.Name' == 1;\nq = filter q by 'grouping_Join6.UserCopy.Name' == 0 and 'grouping_Join6.Name' == 0 and 'grouping_Date_Time_Opened' == 0 and 'grouping_NSP_Category__c' == 0 and 'grouping_NSP_SubCategory__c' == 0 and 'grouping_Case_Owner' == 0 and 'grouping_Status' == 0 and 'grouping_CaseNumber' == 0 and 'grouping_NSP_ClientNumber__c' == 0;\nq = order q by ('Join6.UserCopy.Name' asc, 'Join6.Name' asc, 'Date_Time_Opened' asc, 'NSP_Category__c' asc, 'NSP_SubCategory__c' asc, 'Case_Owner' asc, 'Status' asc, 'CaseNumber' asc, 'NSP_ClientNumber__c' asc);\nq = limit q 25000;\nq = union q, s;\nq = limit q 25000;","receiv