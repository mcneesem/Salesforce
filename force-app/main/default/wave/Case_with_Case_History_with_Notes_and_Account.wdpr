    "FORMULA29_copy0" : {
      "action" : "formula",
      "sources" : [ "JOIN2_copy1" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "Queue_Age",
          "label" : "Ageing",
          "formulaExpression" : "case \r\n    when Status = 'Closed'\r\n    then datediff(\"ClosedDate\", \"CaseHistory_Queue.Assigned_Queue_Oldest\")\r\n  else \r\n    datediff(now(), \"CaseHistory_Queue.Assigned_Queue_Oldest\")\r\n\r\nend",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA30_copy0" : {
      "action" : "formula",
      "sources" : [ "JOIN9_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "Notes_Age",
          "label" : "Notes Age",
          "formulaExpression" : " datediff(\"Notes.CreatedDate\", \"CaseHistory_Queue.Assigned_Queue_Oldest\")\r\n\r\n  ",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA33_copy0" : {
      "action" : "formula",
      "sources" : [ "FORMULA30_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Notes_Age_Gap",
          "label" : "Duplicate_Gap",
          "formulaExpression" : "case \r\n    when \"Notes_Age\" is not null\r\n    then \"Notes_Age\"\r\n    else\r\n    'null'\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
