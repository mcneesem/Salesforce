{"filters":[],"gridLayouts":[],"layouts":[],"steps":{"saql":{"broadcastFacet":false,"groups":[],"numbers":[],"query":"q = load \"NSPK_Client_Call_Data\";\nq = filter q by 'RecordType.Name' in [\"RET Choice\", \"RET WO\"];\nq = filter q by 'Asset.NSP_Account_Status__c' == \"Active\";\nq = filter q by date('NSP_Date_Received__c_Year', 'NSP_Date_Received__c_Month', 'NSP_Date_Received__c_Day') in [\"4 months ago\"..\"1 day ahead\"];\nq = filter q by date('NSP_DEFCON_Set_Up_Date__c_Year', 'NSP_DEFCON_Set_Up_Date__c_Month', 'NSP_DEFCON_Set_Up_Date__c_Day')  in [\"4 months ago\"..\"1 day ahead\"];\nq = filter q by 'NSP_Status__c' == \"Closed/Won\";\nq = filter q by date('NSP_Status_Date__c_Year', 'NSP_Status_Date__c_Month', 'NSP_Status_Date__c_Day') in [\"4 months ago\"..\"1 day ahead\"];;\nq = filter q by 'NSP_Product__c' == \"MEP\";\nq = foreach q generate q.'Asset.NSP_RET_Client_ID__c' as 'Asset.NSP_RET_Client_ID__c',  q.'Plan.NSP_Plan_Id__c' as 'Plan.NSP_Plan_Id__c', q.'PlanSubPlan.NSP_Subplan_ID__c' as 'PlanSubPlan.NSP_Subplan_ID__c', q.'Asset.NSP_Company_Name__c' as 'Asset.NSP_Company_Name__c', q.'NSP_Client_Plan_Type__c' as 'NSP_Client_Plan_Type__c', q.'Asset.NSP_RET_Employee_Count__c' as 'Asset.NSP_RET_Employee_Count__c',q.'Account_Group_Member.Name' as 'Account_Group_Member.Name', q.'Asset.NSP_Client_Segment_type__c' as 'Asset.NSP_Client_Segment_type__c', q.'NSP_Status_Date__c' as 'NSP_Status_Date__c', q.'NSP_DEFCON_Set_Up_Date__c' as 'NSP_DEFCON_Set_Up_Date__c', q.'SubPlanHistory.NSP_Start_Date__c' as 'Start Date', q.'Asset.NSP_AIMS_First_Pay_Date__c' as 'AIMS First Pay Date', q.'Asset.NSP_Next_Pay_Date__c' as 'Next Pay Dat', q.'Asset.NSP_Pay_Frequency__c' as 'Asset.NSP_Pay_Frequency__c', q.'NSP_Sales_Qualification__c' as 'NSP_Sales_Qualification__c', mv_to_string('Multivalue_AccountTeam.PlanConsult.PlanConsultant') as 'Multivalue_AccountTeam.PlanConsult.PlanConsultant', q.'IMPL_User.Name' as 'NBI IMPL Resource', q.'SalesConsultant.Name' as 'Sales Consultant', q.'Asset.NSP_RET_AIMS_Original_Empl_Date__c' as 'RET AIMS Original Empl Date', q.'NSP_Current_RecordKeeper__c' as 'NSP_Current_RecordKeeper__c', q.'NSP_Prior_Plan_Name__c' as 'NSP_Prior_Plan_Name__c', q.'NSP_Target_Transfer_Date__c' as 'NSP_Target_Transfer_Date__c', q.'Account.BillingState' as 'Account.BillingState', q.'Account.BillingCity' as 'Account.BillingCity', mv_to_string('Multivalue_AccountTeam.PayRoll.PayrollSpecialist') as 'Multivalue_AccountTeam.PayRoll.PayrollSpecialist', mv_to_string('Multivalue_AccountTeam.Busi_Perfor_Advi.BusinessPerformanceAdvisor') as 'Multivalue_AccountTeam.Busi_Perfor_Advi.BusinessPerformanceAdvisor', mv_to_string('Multivalue_AccountTeam.Client.ClientLiaison') as 'Multivalue_AccountTeam.Client.ClientLiaison', mv_to_string('Multivalue_AccountTeam.MidMarket.MidMarketAccountExec') as 'Multivalue_AccountTeam.MidMarket.MidMarketAccountExec', mv_to_string('Multivalue_AccountTeam.BusTeam.Business') as 'Multivalue_AccountTeam.BusTeam.Business', q.'NSP_Installation_Notes__c' as 'NSP_Installation_Notes__c', q.'NSP_Contact_Name__c' as 'NSP_Contact_Name__c', q.'Asset.NSP_Business_Type__c' as 'Asset.NSP_Business_Type__c', q.'NSP_Consolidated_Notes__c' as 'NSP_Consolidated_Notes__c';\nq = limit q 25000;\n","receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"none","strings":[],"type":"saql","useGlobal":true}},"widgets":{"saql_table":{"parameters":{"borderColor":"#a8b7c7","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#16325c","fontColor":"#ffffff","fontSize":12,"textWrap":true},"innerMajorBorderColor":"#54698d","innerMinorBorderColor":"#a8b7c7","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"step":"saql","totals":true,"verticalPadding":8},"type":"table"}}}