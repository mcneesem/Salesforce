    "FORMULA1" : {
      "action" : "formula",
      "sources" : [ "JOIN10" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "DATETIME",
          "name" : "Scheduled_Mail_Date",
          "label" : "Scheduled Mail Date",
          "formulaExpression" : "NSP_Blackout_Period_Begins__c - INTERVAL 35 DAY",
          "format" : "yyyy-MM-dd",
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA2" : {
      "action" : "formula",
      "sources" : [ "FORMULA1" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "NSP_Blackout_Period_Begins__c_formula",
          "label" : "Blackout Period Begins Formula",
          "formulaExpression" : "string(dayofweek(NSP_Blackout_Period_Begins__c))",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA3" : {
      "action" : "formula",
      "sources" : [ "FORMULA2" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Day_of_Week_BO_begins",
          "label" : "Day of Week BO begins",
          "formulaExpression" : "case NSP_Blackout_Period_Begins__c_formula\r\nwhen '1' then 'Sunday'\r\nwhen '2' then 'Monday'\r\nwhen '3' then 'Tuesday'\r\nwhen '4' then 'Wednesday'\r\nwhen '5' then 'Thursday'\r\nwhen '6' then 'Friday'\r\nwhen '7' then 'Saturday'\r\nelse\r\n'NA'\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA4" : {
      "action" : "formula",
      "sources" : [ "FORMULA3" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "NSP_Blackout_Period_Ends__c_formula",
          "label" : "Blackout Period Ends Formula",
          "formulaExpression" : "string(dayofweek(NSP_Blackout_Period_Ends__c))",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA5" : {
      "action" : "formula",
      "sources" : [ "FORMULA4" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Blackout_Period_Ends_Beginning_Week_Date",
          "label" : "Blackout Period Ends Beginning Week Date",
          "formulaExpression" : "case NSP_Blackout_Period_Ends__c_formula\r\nwhen '1' then 'Sunday'\r\nwhen '2' then 'Monday'\r\nwhen '3' then 'Tuesday'\r\nwhen '4' then 'Wednesday'\r\nwhen '5' then 'Thursday'\r\nwhen '6' then 'Friday'\r\nwhen '7' then 'Saturday'\r\nelse\r\n'NA'\r\nend\r\n",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
