          "name" : "Seven_Days_Old",
          "label" : "7+ Days Old",
          "formulaExpression" : "case \r\n    when (STY_03728_Scenario_2) > '6'\r\n    then 'Yes'\r\n    when (STY_03728_Scenario_1) > '6'\r\n    then 'Yes'\r\n    else\r\n    'No'\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
