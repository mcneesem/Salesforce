    "FORMULA14" : {
      "action" : "formula",
      "sources" : [ "EDIT_ATTRIBUTES7" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Queue_begins_with",
          "label" : "Queue begins with",
          "formulaExpression" : "case\r\n    when startsWith(Case_Owner, 'Contact Center')\r\n    then'Contact Center'\r\n     when startsWith(Case_Owner, 'Escalations')\r\n    then'Escalations'\r\n    else\r\n    ''\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
