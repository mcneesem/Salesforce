    "FORMULA0_copy0" : {
      "action" : "formula",
      "sources" : [ "JOIN1_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Case_Owner",
          "label" : "Case Owner",
          "formulaExpression" : "case\r\n    when startsWith(OwnerId, '00G')\r\n    then\"Group.Name\"\r\n    else\r\n    \"User.Name\"\r\nend",
