    },
    "FORMULA30" : {
      "action" : "formula",
      "sources" : [ "FORMULA29" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "STY_03728_Scenario_2",
          "label" : "STY-03728 Scenario 2",
          "formulaExpression" : "case\r\n    when \"Transformd.Status\" != 'Closed'\r\n    then datediff(now(),\"Transform1.Assigned_Queue_Newest\")\r\nend",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA31" : {
