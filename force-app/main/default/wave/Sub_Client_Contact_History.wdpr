    "FORMULA29" : {
      "action" : "formula",
      "sources" : [ "JOIN31" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "STY_03728_Scenario_1",
          "label" : "STY-03728 Scenario 1",
          "formulaExpression" : "case\r\n    when \"Transformd.Status\" = 'Closed'\r\n    then datediff(\"Transformd.ClosedDate\",\"Transform1.Assigned_Queue_Newest\")\r\nend",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : ""
        } ]
