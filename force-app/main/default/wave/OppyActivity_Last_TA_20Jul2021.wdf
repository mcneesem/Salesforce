["{\"nodes\":{\"sfdcRegister_LastActivity\":{\"action\":\"register\",\"parameters\":{\"label\":\"LastActivity\",\"name\":\"LastActivity\"},\"sources\":[\"filter_OppyActivity\"]},\"edgemart_OppyActivity\":{\"action\":\"dataset\",\"parameters\":{\"name\":\"Activity_w_OppyNSP\"}},\"computeRelative_findLast\":{\"action\":\"computeRelative\",\"parameters\":{\"computedFields\":[{\"description\":\"most recent Activity associated with an Account\",\"expression\":{\"saqlExpression\":\"case\\nwhen current(Id) == first(Id) then \\\"yes\\\"\\nelse \\\"no\\\"\\nend\",\"type\":\"Text\"},\"label\":\"lastAct\",\"name\":\"lastAct\"}],\"orderBy\":[{\"direction\":\"desc\",\"name\":\"ActivityDate\"}],\"partitionBy\":[\"Activity_w_Oppy.Id\"]},\"sources\":[\"edgemart_OppyActivity\"]},\"filter_OppyActivity\":{\"action\":\"filter\",\"parameters\":{\"saqlFilter\":\"'lastAct' == \\\"yes\\\" || 'lastAct' == \\\"no\\\"\"},\"sources\":[\"computeRelative_findLast\"]}}}",null]