{"dataSourceLinksInfo":{"enableAutomaticLinking":true,"excludeRelationships":[],"links":[]},"filters":[],"gridLayouts":[{"name":"Default","numColumns":12,"pages":[{"label":"Employee Enrollment Status","name":"d48e488d-a54d-4c2d-a358-f5c422c3de47","navigationHidden":false,"widgets":[{"colspan":12,"column":0,"name":"chart_1","row":1,"rowspan":8,"widgetStyle":{"borderEdges":[]}},{"colspan":12,"column":0,"name":"text_1","row":0,"rowspan":1,"widgetStyle":{"backgroundColor":"#7D98B3","borderColor":"#E6ECF2","borderEdges":[],"borderRadius":0,"borderWidth":1}}]}],"rowHeight":"normal","selectors":[],"style":{"alignmentX":"left","alignmentY":"top","backgroundColor":"#F2F6FA","cellSpacingX":8,"cellSpacingY":8,"fit":"original","gutterColor":"#C5D3E0"},"version":1.0}],"layouts":[],"steps":{"lens_1":{"broadcastFacet":true,"groups":[],"label":"Employee Enrollment Status","numbers":[],"query":"q = load \"Project_Worksite_Employee_Enrollment_Percentage\";\nq = filter q by 'pse__Project_Type__c' == \"Implementation\";\nq = filter q by 'TemplateName__c' == \"Middle Market - Implementation\";\nq = filter q by 'pse__Project_Status__c' in [\"Active\", \"Close/Lost\", \"Inactive\", \"Intake\", \"Not Yet Active\", \"On Hold\", \"Pending Approval\"];\nq = filter q by 'NSP_Visible_to_Client__c' == \"true\";\nq = group q by all;\nNotStarted = foreach q generate \"Not Started\" as 'Bucket', (sum(q.NSP_Employee_Enrollment_Not_Started__c)/sum(q.'NSP_Total_Projected_Employee_Enrollment__c')*100) as 'Employee Enrollment';\nInProgress = foreach q generate \"In Progress\" as 'Bucket', (sum(q.NSP_Employee_Enrollment_In_Progress__c)/sum(q.'NSP_Total_Projected_Employee_Enrollment__c')*100) as 'Employee Enrollment';\nSubmitted = foreach q generate \"Submitted\" as 'Bucket', (sum(q.NSP_Employee_Enrollment_Submitted__c)/sum(q.'NSP_Total_Projected_Employee_Enrollment__c')*100) as 'Employee Enrollment';\nTotal = union NotStarted, InProgress, Submitted;\nTotal = group Total by ('Bucket');\nTotal = foreach Total generate 'Bucket' as 'Employee_Enrollment', sum('Employee Enrollment') as 'Employee Enrollment Status';\nq = limit Total 25000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","centerText":"","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":false,"show":true,"customSize":"auto","position":"bottom-center","inside":false},"showMeasureTitle":true,"axisMode":"multi","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"pie","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"inner":60,"columnProperties":{},"columnMap":{"trellis":[],"dimension":["Employee_Enrollment"],"plots":["Employee Enrollment Status"]},"showActionMenu":true,"centerValueType":"none","measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"percent","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}}},"widgetStyle":{"backgroundColor":"#FFFFFF","borderColor":"#E6ECF2","borderEdges":[],"borderRadius":0,"borderWidth":1},"widgets":{"text_1":{"parameters":{"content":{"richTextContent":[{"attributes":{"