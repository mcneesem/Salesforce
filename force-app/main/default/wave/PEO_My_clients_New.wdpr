    "FORMULA5" : {
      "action" : "formula",
      "sources" : [ "JOIN7" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Overall_Status",
          "label" : "Overall Status.",
          "formulaExpression" : "case \r\n\twhen \"Augment_Ac.NSP_Overall_Status__c\" = '1'\r\n\tthen 'Data Collection'\r\n\twhen \"Augment_Ac.NSP_Overall_Status__c\" = '1'\r\n\tthen 'P&R New Bid'\r\n\twhen \"Augment_Ac.NSP_Overall_Status__c\" = '1'\r\n\tthen 'Sales'\r\n\twhen \"Augment_Ac.NSP_Overall_Status__c\" = '1'\r\n\tthen 'P&R Re-Look'\r\n\twhen \"Augment_Ac.NSP_Overall_Status__c\" = '1'\r\n\tthen 'Closed'\r\n\twhen \"Augment_Ac.NSP_Overall_Status__c\" = '1'\r\n\tthen 'Contracting'\r\n\twhen \"Augment_Ac.NSP_Overall_Status__c\" = '1'\r\n\tthen 'OnBoarding'\r\n\twhen \"Augment_Ac.NSP_Overall_Status__c\" = '1'\r\n\tthen 'OnBoarding'\r\n\telse\r\n\t''\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
