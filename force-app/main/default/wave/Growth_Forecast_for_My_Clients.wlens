{"dataSourceLinksInfo":{"enableAutomaticLinking":false,"excludeRelationships":[],"links":[]},"filters":[],"gridLayouts":[],"layouts":[],"steps":{"saql":{"broadcastFacet":false,"groups":[],"numbers":[],"query":"q = load \"Growth_Forecast_for_My_Clients\";\nq = filter q by 'NSP_Type__c' == \"Growth Forecast\";\nq = filter q by 'NSP_Primary__c' == \"true\";\nq = filter q by 'Join2.NSP_Account_Status__c' == \"Active\";\nq = filter q by 'Join2.RecordType.DeveloperName' == \"WO\";\nq = group q by all;\nAcquisition = foreach q generate \"Acquisition\" as 'Bucket', sum(q.'NSP_Accoun.NSP_Acquisition_Current_Quarter_1__c') as 'Q1',sum(q.'NSP_Accoun.NSP_Acquisition_Current_Quarter_2__c') as 'Q2',sum(q.'NSP_Accoun.NSP_Acquisition_Current_Quarter_3__c') as 'Q3';\nOrganic = foreach q generate \"Organic\" as 'Bucket', sum(q.'NSP_Accoun.NSP_Organic_Current_Quarter_1__c') as 'Q1',sum(q.'NSP_Accoun.NSP_Organic_Current_Quarter_2__c') as 'Q2',sum(q.'NSP_Accoun.NSP_Organic_Current_Quarter_3__c') as 'Q3';\nReduction = foreach q generate \"Reduction\" as 'Bucket', sum(q.'NSP_Accoun.NSP_Reduction_Current_Quarter_1__c') as 'Q1',sum(q.'NSP_Accoun.NSP_Reduction_Current_Quarter_2__c') as 'Q2',sum(q.'NSP_Accoun.NSP_Reduction_Current_Quarter_3__c') as 'Q3';\nTotal = foreach q generate \"Total\" as 'Bucket', sum(q.'NSP_Accoun.NSP_Acquisition_Current_Quarter_1__c')+sum(q.'NSP_Accoun.NSP_Organic_Current_Quarter_1__c')+sum(q.'NSP_Accoun.NSP_Reduction_Current_Quarter_1__c')  as 'Q1',sum(q.'NSP_Accoun.NSP_Acquisition_Current_Quarter_2__c')+sum(q.'NSP_Accoun.NSP_Organic_Current_Quarter_2__c') +sum(q.'NSP_Accoun.NSP_Reduction_Current_Quarter_2__c') as 'Q2',sum(q.'NSP_Accoun.NSP_Acquisition_Current_Quarter_3__c')+sum(q.'NSP_Accoun.NSP_Organic_Current_Quarter_3__c')+sum(q.'NSP_Accoun.NSP_Reduction_Current_Quarter_3__c') as 'Q3';\nTotal1 = union Acquisition, Organic, Reduction,Total;\nTotal1 = foreach Total1 generate 'Bucket' as 'Growth Forecast', sum('Q1') as 'Q1',sum('Q2') as 'Q2',sum('Q3') as 'Q3',('Q1'+'Q2'+'Q3') as 'Total';\nq = limit Total1 25000;","receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"none","strings":[],"type":"saql","useGlobal":true}},"widgets":{"saql_table":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"textWrap":true},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"showRowIndexColumn":false,"step":"saql","totals":true,"verticalPadding":8},"type":"table"}}}