{"filters":[],"gridLayouts":[],"layouts":[],"steps":{"saql":{"broadcastFacet":false,"groups":[],"numbers":[],"query":"q = load \"NSPK_Client_Call_Data\";\nq = filter q by 'Account_Group_Member.NSP_Type__c' == \"Controlled Group\";\nq = filter q by 'NSP_Signoff_filter' == \"True\";\nq = filter q by 'RecordType.Name' in [\"RET Choice\", \"RET WO\"];\nq = foreach q generate q.'NSP_Plan_ID_Reserved__c' as 'NSP_Plan_ID_Reserved__c', q.'NSP_IPT_Plan_Product__c' as 'NSP_IPT_Plan_Product__c', q.'NSP_Date_Assigned__c' as 'NSP_Date_Assigned__c', q.'NSP_Fund_Selection_Type__c' as 'NSP_Fund_Selection_Type__c', q.'NSP_Tentative_Start_Date__c' as 'NSP_Tentative_Start_Date__c', q.'NSP_Current_RecordKeeper__c' as 'NSP_Current_RecordKeeper__c', q.'NSP_Prior_Plan_Name__c' as 'NSP_Prior_Plan_Name__c', q.'NSP_Target_Transfer_Date__c' as 'NSP_Target_Transfer_Date__c', q.'SalesConsultant.Name' as 'SalesConsultant', q.'NSP_Installation_Notes__c' as 'NSP_Installation_Notes__c', q.'NSP_IPT_IMP_Effort_Type__c' as 'NSP_IPT_IMP_Effort_Type__c', q.'NSP_SDA_Accounts__c' as 'NSP_SDA_Accounts__c', q.'Asset.NSP_Company_Name__c' as 'Asset.NSP_Company_Name__c', q.'Asset.NSP_Business_Type__c' as 'Asset.NSP_Business_Type__c', q.'Asset.NSP_FEIN__c' as 'Asset.NSP_FEIN__c', q.'Asset.NSP_RET_Client_ID__c' as 'Asset.NSP_RET_Client_ID__c', q.'Asset.NSP_Renewal_Date__c' as 'Renewal Date', q.'Asset.NSP_RET_Employee_Count__c' as 'Asset.NSP_RET_Employee_Count__c', q.'Asset.NSP_Client_Segment_type__c' as 'Asset.NSP_Client_Segment_type__c', q.'Asset.NSP_AIMS_First_Pay_Date__c' as 'AIMS First Pay Date', q.'Asset.NSP_Next_Pay_Date__c' as 'Next Pay Date', q.'Asset.NSP_Pay_Frequency__c' as 'Asset.NSP_Pay_Frequency__c', q.'Asset.NSP_RET_AIMS_Original_Empl_Date__c' as 'RET AIMS Original Empl Date', q.'Plan.NSP_Plan_Id__c' as 'Plan.NSP_Plan_Id__c', q.'PlanSubPlan.NSP_Subplan_ID__c' as 'PlanSubPlan.NSP_Subplan_ID__c', q.'Account.BillingState' as 'Account.BillingState', q.'Account.BillingCity' as 'Account.BillingCity', q.'Account_Group_Member.Name' as 'Account_Group_Member.Name', q.'Account_Group_Member.Id' as 'Account Group Member Id', q.'Account_Group_Member.NSP_Type__c' as 'Account_Group_Member.NSP_Type__c', mv_to_string('Multivalue_AccountTeam.PlanConsult.PlanConsultant') as 'Multivalue_AccountTeam.PlanConsult.PlanConsultant', mv_to_string('Multivalue_AccountTeam.PayRoll.PayrollSpecialist') as 'Multivalue_AccountTeam.PayRoll.PayrollSpecialist', mv_to_string('Multivalue_AccountTeam.Client.ClientLiaison') as 'Multivalue_AccountTeam.Client.ClientLiaison', mv_to_string('Multivalue_AccountTeam.MidMarket.MidMarketAccountExec') as 'Multivalue_AccountTeam.MidMarket.MidMarketAccountExec', mv_to_string('Multivalue_AccountTeam.BusTeam.Business') as 'Multivalue_AccountTeam.BusTeam.Business';\nq = limit q 25000;","receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"none","strings":[],"type":"saql","useGlobal":true}},"widgets":{"saql_table":{"parameters":{"borderColor":"#a8b7c7","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#16325c","fontColor":"#ffffff","fontSize":12,"textWrap":true},"innerMajorBorderColor":"#54698d","innerMinorBorderColor":"#a8b7c7","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"showRowIndexColumn":true,"step":"saql","verticalPadding":8},"type":"table"}}}