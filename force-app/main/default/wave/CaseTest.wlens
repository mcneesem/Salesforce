{"filters":[],"gridLayouts":[],"layouts":[],"steps":{"saql":{"broadcastFacet":false,"groups":[],"numbers":[],"query":"q = load \"Open_Benefits_Cases_All_MM_Benefits_Divisions\";\nq = filter q by ('User.Division_formula' != \"false\" || 'User.Division_formula' is null);\nq = filter q by 'Case.Status' in [\"Open\", \"ReOpened\"];\nq = foreach q generate q.'User.Division' as 'User.Division', q.'User_Queue' as 'User_Queue', q.'Case.CaseNumber' as 'Case.CaseNumber', q.'Case.CreatedDate' as 'Date/Time Opened', q.'Recent_Assigned_Date' as 'Recent_Assigned_Date', q.'Account.Name' as 'Account.Name', q.'Case.NSP_ClientNumber__c' as 'Case.NSP_ClientNumber__c', q.'Case.Status' as 'Case.Status', q.'Case.NSP_Case_Sub_Status__c' as 'Case.NSP_Case_Sub_Status__c', q.'Case.NSP_Category__c' as 'Case.NSP_Category__c', q.'Case.NSP_SubCategory__c' as 'Case.NSP_SubCategory__c', q.'Case.NSP_Detail__c' as 'Case.NSP_Detail__c', q.'Notes.CreatedDate' as 'Most Recent Note Date', q.'Case.NSP_Case_Contact_Name__c' as 'Primary Contact Name', q.'Case.NSP_PerID__c' as 'Case.NSP_PerID__c', q.'Case.Age' as 'Case.Age', q.'Notes.Gap' as 'Notes.Gap';\nq = limit q 25000;","receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"none","strings":[],"type":"saql","useGlobal":true}},"widgets":{"saql_table":{"parameters":{"borderColor":"#a8b7c7","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{"Case.CaseNumber":{"parameters":{"alignment":"left","styles":{"linkColor":"#006dcc"}},"type":"text"}},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#16325c","fontColor":"#ffffff","fontSize":12,"textWrap":true},"innerMajorBorderColor":"#54698d","innerMinorBorderColor":"#a8b7c7","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"showRowIndexColumn":true,"step":"saql","totals":true,"verticalPadding":8},"type":"table"}}}