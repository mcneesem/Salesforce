{"filters":[],"gridLayouts":[],"layouts":[],"steps":{"saql":{"broadcastFacet":false,"groups":[],"numbers":[],"query":"q = load \"Clients_with_No_Key_Decision_Makers_DS\";\nq = filter q by 'Account.Account.NSP_Sales_Service_Account_Status__c' == \"Active\";\nq = filter q by 'Account.IsActive' == \"true\";\nq = filter q by ('Account.NSP_Service_Roles__c' != \"Key Decision Maker\" || 'Account.NSP_Service_Roles__c' is null);\nq = group q by ('Account.Account.Name', 'Account.Account.NSP_AIMS_Client__c', 'Account.NSP_AIMS_First_Pay_Date__c_formula');\nq = foreach q generate q.'Account.Account.Name' as 'Account.Account.Name', q.'Account.Account.NSP_AIMS_Client__c' as 'Account.Account.NSP_AIMS_Client__c', q.'Account.NSP_AIMS_First_Pay_Date__c_formula' as 'AIMS First Pay Date';\nq = order q by ('Account.Account.Name' asc, 'Account.Account.NSP_AIMS_Client__c' asc, 'AIMS First Pay Date' asc);\nq = limit q 25000;","receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"none","strings":[],"type":"saql","useGlobal":true}},"widgets":{"saql_table":{"parameters":{"borderColor":"#a8b7c7","borderWidth":2,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#16325c","fontColor":"#ffffff","fontSize":12,"textWrap":true},"innerMajorBorderColor":"#54698d","innerMinorBorderColor":"#a8b7c7","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"showRowIndexColumn":false,"step":"saql","totals":true,"verticalPadding":8},"type":"table"}}}