    "FORMULA4" : {
      "action" : "formula",
      "sources" : [ "EDIT_ATTRIBUTES4" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "OLD_VALUE_contain_Completed_formula",
          "label" : "OLD VALUE contain Completed",
          "formulaExpression" : "case \r\n\twhen \"pse__Proj_.Field\" =  'Peer_Review__c' AND contains(\"pse__Proj_.OldValue\", 'Completed')\r\n\r\n\tthen 'true'\r\n\telse 'false'\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA5" : {
      "action" : "formula",
      "sources" : [ "FORMULA4" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "DATETIME",
          "name" : "PeerReviewCompletedDate_formula",
          "label" : "Peer Review-Completed Date",
          "formulaExpression" : "case \r\n\twhen \"pse__Proj_.Field\" =  'Peer_Review__c' AND contains(\"pse__Proj_.NewValue\", 'Completed')\r\n\r\n\tthen \"pse__Proj_.CreatedDate\"\r\nend",
          "format" : "MM/dd/yyyy hh:mm:ss a",
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA6" : {
      "action" : "formula",
      "sources" : [ "FORMULA5" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "FormattedPeerReviewCompletedDate_formula",
          "label" : "Peer Review-Completed Date",
          "formulaExpression" : "date_format(PeerReviewCompletedDate_formula, 'MM/dd/yyyy HH:MM:SS')",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    }
