          "type" : "TEXT",
          "name" : "InvoiceLineORCreditNoteLine_Formula",
          "label" : "Invoice Line or Credit Note Line",
          "formulaExpression" : "case \r\n\twhen (NSP_NetSuite_Item_Name__c!= '')\r\n\tthen (NSP_NetSuite_Item_Name__c)\r\n\twhen (\"InvoiceLine.NSP_NetSuite_Item_Name__c\"!= '') then\r\n\t\"InvoiceLine.NSP_NetSuite_Item_Name__c\" \r\n\twhen \r\n\t(\"Product.Name\" != '' ) then \"Product.Name\"\r\nend",
