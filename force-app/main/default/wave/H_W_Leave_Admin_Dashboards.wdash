\" or 'GroupCopy.Name' == \"Health & Welfare Leave Admin\");\nq = group q by 'Join1.Case.Subject';\nq = foreach q generate q.'Join1.Case.Subject',case when (q.'Join1.Case.Subject' matches \"Add/Terms Report\") then \"Add/Terms Report\" when (q.'Join1.Case.Subject' matches \"Email\") then \"Email\" when (q.'Join1.Case.Subject' matches \"FSA\") then \"FSA\" when (q.'Join1.Case.Subject' matches \"Cert\") then \"Cert\" when (q.'Join1.Case.Subject' matches \"DB 120\") then \"DB 120\" when (q.'Join1.Case.Subject' matches \"Disability Escalation\") then \"Disability Escalation\" when (q.'Join1.Case.Subject' matches \"LOA Request Form\") then \"LOA Request Form\" when (q.'Join1.Case.Subject' matches \"Medical Release\") then \"Medical Release\" when (q.'Join1.Case.Subject' matches \"Future Dated\") then \"Future Dated\" when (q.'Join1.Case.Subject' matches \"Returned Mail\") then \"Returned Mail\" when (q.'Join1.Case.Subject' matches \"RTW\") then \"RTW\" when (q.'Join1.Case.Subject' matches \"State\") then \"State\" when (q.'Join1.Case.Subject' matches \"Subpoena\") then \"Subpoena\" when (q.'Join1.Case.Subject' matches \"Triage\") then \"Triage\" when (q.'Join1.Case.Subject' matches \"Voicemail\") then \"Voicemail\" else \"Others\" end as 'Subject keywords';\nq = group q by 'Subject keywords';\nq = foreach q generate q.'Subject keywords', count(q) as 'Total count';\nq = order q by 'Subject keywords' asc;\nq = limit q 25000;","receiveFacetSource":{"mode":"include","steps":["Join1_Case_CreatedDa_1"]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#a8b7c7","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#16325c","fontColor":"#ffffff","fontSize":12,"textWrap":true},"innerMajorBorderColor":"#54698d","innerMinorBorderColor":"#a8b7c7","interactions":[],"mode":"fit