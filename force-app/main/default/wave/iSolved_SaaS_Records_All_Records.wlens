{"filters":[],"gridLayouts":[],"layouts":[],"steps":{"saql":{"broadcastFacet":false,"groups":[],"numbers":[],"query":"q = load \"Asset_Account_Address_OrderItem_Product\";\nq = filter q by 'RecordType.Name' == \"WX_WA\";\nq = filter q by 'Product2.ProductNameStartswithWorkforceAcceleration' == \"True\";\nq = foreach q generate q.'NSP_iSolved_ID__c' as 'NSP_iSolved_ID__c', q.'NSP_WX_WA_Parent_ID__c' as 'NSP_WX_WA_Parent_ID__c', q.'Account.Name' as 'Account.Name', q.'Status' as 'Status', q.'NSP_ProductBundle__c' as 'NSP_ProductBundle__c', q.'NSP_Product_Segment__c' as 'NSP_Product_Segment__c', q.'SignatureDate' as 'SignatureDate', q.'TerminationDate' as 'TerminationDate', q.'NSP_Actual_of_Employee_at_Signature__c' as 'NSP_Actual_of_Employee_at_Signature__c', q.'NSP_Current_SaaS_Seats__c' as 'NSP_Current_SaaS_Seats__c', q.'NSP_Product_Risk_Level__c' as 'NSP_Product_Risk_Level__c', q.'NSP_Product_Term_Reason__c' as 'NSP_Product_Term_Reason__c', q.'NSP_WOSS_Type__c' as 'NSP_WOSS_Type__c',mv_to_string(q.'NSP_WX_WA_Modules_Implemented__c') as 'NSP_WX_WA_Modules_Implemented__c', q.'NSP_Benefits_Agency__c' as 'NSP_Benefits_Agency__c', q.'NSP_Reference_Able__c' as 'NSP_Reference_Able__c', q.'Account.NSP_FEIN__c' as 'Account.NSP_FEIN__c', q.'Account.Sic' as 'Account.Sic', q.'Account.SicDesc' as 'Account.SicDesc', q.'Account.DNBoptimizer__DNB_D_U_N_S_Number__c' as 'Account.DNBoptimizer__DNB_D_U_N_S_Number__c', q.'LookupJoin.LeftJoinAc.NSP_Addres.Billing_State_formula' as 'LookupJoin.LeftJoinAc.NSP_Addres.Billing_State_formula', q.'Account.NSP_Engagement_Level__c' as 'Account.NSP_Engagement_Level__c', q.'Account.NSP_Legacy_HCM_System__c' as 'Account.NSP_Legacy_HCM_System__c', mv_to_string(q.'Join24.Transform1.CustomerSuccessSpecialist') as 'Join24.Transform1.CustomerSuccessSpecialist', mv_to_string(q.'Join24.Transform3.WX_WABenefitsSpecialist') as 'Join24.Transform3.WX_WABenefitsSpecialist', mv_to_string(q.'Join24.Transform2.WA_WXPayrollSpecialist') as 'Join24.Transform2.WA_WXPayrollSpecialist', q.'OrderItem.StartDate' as 'OrderItem.StartDate', q.'OrderItem.UnitPrice' as 'OrderItem.UnitPrice', q.'OrderItem.Description' as 'OrderItem.Description', q.'OrderItem.LastChargeToDate' as 'OrderItem.LastChargeToDate', q.'Product21.Name' as 'Product21.Name', q.'OrderItem.SBQQ__Activated__c' as 'OrderItem.SBQQ__Activated__c', q.'OrderItem.SBQQ__Status__c' as 'OrderItem.SBQQ__Status__c';\nq = limit q 25000;","receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"none","strings":[],"type":"saql","useGlobal":true}},"widgets":{"saql_table":{"parameters":{"borderColor":"#a8b7c7","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#16325c","fontColor":"#ffffff","fontSize":12,"textWrap":true},"innerMajorBorderColor":"#54698d","innerMinorBorderColor":"#a8b7c7","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"showRowIndexColumn":true,"step":"saql","totals":true,"verticalPadding":8},"type":"table"}}}