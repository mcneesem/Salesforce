n":6,"column":27,"name":"text_10","row":13,"rowspan":3,"widgetStyle":{"borderEdges":[]}},{"colspan":9,"column":33,"name":"text_11","row":7,"rowspan":3,"widgetStyle":{"borderEdges":[]}},{"colspan":10,"column":33,"name":"text_12","row":10,"rowspan":3,"widgetStyle":{"borderEdges":[]}}]}],"rowHeight":"fine","selectors":[],"style":{"alignmentX":"left","alignmentY":"top","backgroundColor":"#FFFFFF","cellSpacingX":0,"cellSpacingY":0,"fit":"original","gutterColor":"#C5D3E0"},"version":1.0}],"layouts":[],"steps":{"AC2___Balance_Due_1":{"broadcastFacet":true,"groups":[],"label":"AC2 - Balance Due","numbers":[],"query":"q = load \"AR_Aging_Metrics_Dataset\";\nq = filter q by ('blng__Invo.blng__InvoiceStatus__c' != \"Draft\" || 'blng__Invo.blng__InvoiceStatus__c' is null);\nq = group q by rollup('Name', 'blng__Invo.blng__DaysOutstanding__c_bucket');\nq = foreach q generate 'Name' as 'Name', 'blng__Invo.blng__DaysOutstanding__c_bucket' as 'blng__Invo.blng__DaysOutstanding__c_bucket', sum('blng__Invo.blng__Balance__c') as 'sum_blng__Invo.blng__Balance__c', grouping('Name') as 'grouping_Name', grouping('blng__Invo.blng__DaysOutstanding__c_bucket') as 'grouping_blng__Invo.blng__DaysOutstanding__c_bucket';\nq = filter q by 'grouping_Name' == 0;\nq = order q by ('Name' asc nulls last, 'blng__Invo.blng__DaysOutstanding__c_bucket' asc nulls last);\nq = limit q 25000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#a8b7c7","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#16325c","fontColor":"#ffffff","fontSize":12,"textWrap":true},"innerMajorBorderColor":"#54698d","innerMinorBorderColor":"#a8b7c7","interactions":[],"mode":"fittocontainer","numberOfLines":1,"pivoted":true,"showActionMenu":true,"showRowIndexColumn":false,"verticalPadding":8},"type":"table"}},"AC1___A_R_Aging_1":{"broadcastFacet":true,"groups":[],"label":"AC1 - A/R Aging","numbers":[],"query":"q = load \"AR_Aging_Metrics_Dataset\";\nq = filter q by ('blng__Invo.blng__InvoiceStatus__c' in [\"Cancelled\", \"Error\", \"Post In progress\", \"Posted\", \"Rebilled\"]);\nq = filter q by 'blng__Invo.blng__PaymentStatus__c' in [\"Partially Paid\", \"Unpaid\"];\nq = filter q by 'blng__Invo.blng__DaysOutstanding__c_bucket' in [\"Tier 1 ( 0 - 30 Days Overdue )\", \"Tier 2 ( 31 - 60 Days Overdue)\"];\nq = group q by ('User.Name', 'blng__Invo.blng__DaysOutstanding__c_bucket','Name','blng__Invo.Name','blng__Invo.blng_DueDate__cFormula','NSP_Account_Status__c','blng__Invo.blng__InvoiceStatus__c','blng__Invo.blng__PaymentStatus__c');\nq = foreach q generate 'User.Name' as 'User.Name', 'blng__Invo.blng__DaysOutstanding__c_bucket' as 'blng__Invo.blng__DaysOutstanding__c_bucket','Name' as 'Account Name','blng__Invo.Name' as 'Invoice Number','NSP_Account_Status__c' as 'Account Status','blng__Invo.blng__InvoiceStatus__c' as 'Invoice Status','blng__Invo.blng__PaymentStatus__c' as 'Payment Status','blng__Invo.blng_DueDate__cFormula' as 'Date',sum('blng__Invo.blng__Balance__c') as 'Amount Due';\nq = order q by ('User.Name' asc, 'blng__Invo.blng__DaysOutstanding__c_bucket' asc);\nq = limit q 25000;","receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"single","strings":[],"type":"saql","useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#a8b7c7","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{},"columns":["Amount Due","Account Name","blng__Invo.blng__DaysOutstanding__c_bucket","Invoice Number","Date"],"customBulkActions":[],"header":{"backgroundColor":"#16325c","fontColor":"#ffffff","fontSize":10,"textWrap":true},"innerMajorBorderColor":"#54698d","innerMinorBorderColor":"#a8b7c7","interactions":[],"mode":"fittocontainer","numberOfLines":1,"piv