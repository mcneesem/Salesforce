      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "SalesOffice",
          "label" : "Sales Office",
          "formulaExpression" : "case \r\nwhen NSP_Sales_Office__c='301'                     \r\n              then '0301 Phoenix 1'\r\nwhen NSP_Sales_Office__c=302                     \r\n              then '0302 Phoenix 2'\r\nwhen NSP_Sales_Office__c=501                     \r\n              then '0501 Los Angeles 1'\r\nwhen NSP_Sales_Office__c=502                     \r\n              then '0502 Los Angeles 2'\r\nwhen NSP_Sales_Office__c='503'                     \r\n              then '0503 Los Angeles 3'\r\nwhen NSP_Sales_Office__c='504'                     \r\n              then '0504 Los Angeles 4'\r\nwhen NSP_Sales_Office__c='505'                     \r\n              then '0505 Los Angeles 5'\r\nwhen NSP_Sales_Office__c='506'                     \r\n              then '0506 Los Angeles 6'\r\nwhen NSP_Sales_Office__c='507'                     \r\n              then '0507 Los Angeles 7'\r\nwhen NSP_Sales_Office__c='508'                     \r\n              then '0508 Los Angeles 8'\r\nwhen NSP_Sales_Office__c='520'                     \r\n              then '0520 San Francisco 1'\r\nwhen NSP_Sales_Office__c='522'                     \r\n              then '0522 San Francisco 3'\r\nwhen NSP_Sales_Office__c='521'                    \r\n              then '0521 San Francisco 2'\r\nwhen NSP_Sales_Office__c='523'                    \r\n              then '0523 San Francisco 4'\r\nwhen NSP_Sales_Office__c='540'                    \r\n              then '0540 San Diego 1'\r\nwhen NSP_Sales_Office__c='541'                    \r\n              then '0541 San Diego 2'\r\nwhen NSP_Sales_Office__c='561'                     \r\n              then '0561 San Jose 1'\r\nwhen NSP_Sales_Office__c='581'                     \r\n              then '0581 Sacramento 1'\r\nwhen NSP_Sales_Office__c='601'                     \r\n              then '0601 Denver 1'\r\nwhen NSP_Sales_Office__c='602'                     \r\n              then '0602 Denver 2'\r\nwhen NSP_Sales_Office__c='701'                     \r\n              then '0701 Stamford 1'\r\nwhen NSP_Sales_Office__c='801'                     \r\n              then '801 Delaware 1'\r\nwhen NSP_Sales_Office__c='901'                     \r\n              then '901 Washington DC 1'\r\nwhen NSP_Sales_Office__c='902'                     \r\n              then '0902 Washington DC 2'\r\nwhen NSP_Sales_Office__c='903'                     \r\n              then '0903 Washington DC 3'\r\nwhen NSP_Sales_Office__c='1001'                     \r\n              then '1001 Orlando 1'\r\nwhen NSP_Sales_Office__c='1021'                     \r\n              then '1021 Jacksonville 1'\r\nwhen NSP_Sales_Office__c='1041'                    \r\n              then '1041 Ft Lauderdale 1'\r\nwhen NSP_Sales_Office__c='1061'                     \r\n              then '1061 Tampa 1'\r\nwhen NSP_Sales_Office__c='1081'                     \r\n              then '1081 Miami 1'\r\nwhen NSP_Sales_Office__c='1101'                     \r\n              then '1101 Atlanta 1'\r\nwhen NSP_Sales_Office__c='1102'                     \r\n              then '1102 Atlanta 2'\r\nwhen NSP_Sales_Office__c='1103'                     \r\n              then '1103 Atlanta 3'\r\nwhen NSP_Sales_Office__c='1104'                    \r\n              then '1104 Atlanta 4'\r\nwhen NSP_Sales_Office__c='1400'                     \r\n              then '1400 Chicago'\r\nwhen NSP_Sales_Office__c='1401'                     \r\n              then '1401 Chicago 1'\r\nwhen NSP_Sales_Office__c='1402'                     \r\n              then '1402 Chicago 2'\r\nwhen NSP_Sales_Office__c='1403'                     \r\n              then '1403 Chicago 3' \r\nwhen NSP_Sales_Office__c='1404'                     \r\n              then '1404 Chicago 4'\r\nwhen NSP_Sales_Office__c='1405'                     \r\n              then '1405 Chicago 5'\r\nwhen NSP_Sales_Office__c='1406'                     \r\n              then '1406 Chicago 6'\r\nwhen NSP_Sales