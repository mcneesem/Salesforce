    "FORMULA15" : {
      "action" : "formula",
      "sources" : [ "EDIT_ATTRIBUTES5" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Plan_Effective_Date",
          "label" : "Plan Effective Date",
          "formulaExpression" : "date_format(\"PlanSubPlan.NSP_Plan_Effective_Date__c\", 'MM/dd/yyyy')",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA16" : {
      "action" : "formula",
      "sources" : [ "FORMULA15" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "SubplanID_begins_with_1",
          "label" : "SubplanID begins with \"1\"",
          "formulaExpression" : "case \r\n\twhen startsWith(\"PlanSubPlan.NSP_Subplan_ID__c\", '1')\r\n\tthen 'Yes'\r\n\telse\r\n\t     'No'\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA17" : {
      "action" : "formula",
      "sources" : [ "FORMULA16" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Contribution_Type",
          "label" : "Contribution Rules Description",
          "formulaExpression" : "case \r\n    when \"NSP_Contri.NSP_Contribution_Type__c\" = '401'\r\n    then '401 Employee Pre-tax'\r\n    when \"NSP_Contri.NSP_Contribution_Type__c\" = '402'\r\n    then '402 Employer Match'\r\n    when \"NSP_Contri.NSP_Contribution_Type__c\" = '403'\r\n    then '403 Safe Harbor Match'\r\n    when \"NSP_Contri.NSP_Contribution_Type__c\" = '404'\r\n    then '404 Non-Elective Employer'\r\n    when \"NSP_Contri.NSP_Contribution_Type__c\" = '405'\r\n    then '405 Non-Elective Safe Harbor'\r\n    when \"NSP_Contri.NSP_Contribution_Type__c\" = '406'\r\n    then '406 Employee After Tax'\r\n    when \"NSP_Contri.NSP_Contribution_Type__c\" = '407'\r\n    then '407 Employee Catch Up'\r\n    when \"NSP_Contri.NSP_Contribution_Type__c\" = '408'\r\n    then '408 Employer Catch Up Match'\r\n    when \"NSP_Contri.NSP_Contribution_Type__c\" = '409'\r\n    then '409 Safe Harbor Catch Up Match'\r\n    when \"NSP_Contri.NSP_Contribution_Type__c\" = '410'\r\n    then '410 Roth After Tax'\r\n    when \"NSP_Contri.NSP_Contribution_Type__c\" = '411'\r\n    then '411 Roth Catch Up'\r\n    when \"NSP_Contri.NSP_Contribution_Type__c\" = '412'\r\n    then '412 Non-Qualified Pre-taxh'\r\n    when \"NSP_Contri.NSP_Contribution_Type__c\" = '413'\r\n    then '413 Non-Qualified Match'\r\n    when \"NSP_Contri.NSP_Contribution_Type__c\" = '414'\r\n    then '414 414h'\r\n    when \"NSP_Contri.NSP_Contribution_Type__c\" = '415'\r\n    then '415 NQDC Employer Contribution'\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA18" : {
      "action" : "formula",
      "sources" : [ "FORMULA17" ],
      "parameters" : {
        "expressionType" : "SQL",
