      "sources" : [ "FORMULA0_copy0" ],
      "parameters" : {
        "fields" : [ {
          "name" : "Case.Status_bucket",
          "label" : "Status Bucket",
          "type" : "TEXT",
          "bucketsSetup" : {
            "defaultBucketValue" : "Other",
            "isPassthroughEnabled" : false,
            "sourceField" : {
              "name" : "Case.Status",
              "type" : "TEXT"
            },
            "buckets" : [ {
              "value" : "Open",
              "sourceValues" : [ "Open", "ReOpened" ]
            }, {
              "value" : "Closed",
              "sourceValues" : [ "Closed" ]
            } ]
          }
        } ]
      }
    },
    "FORMULA3_copy0" : {
      "action" : "formula",
