    "FORMULA0_copy0" : {
      "action" : "formula",
      "sources" : [ "EDIT_ATTRIBUTES1_copy1" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "User_Division",
          "label" : "User: Division",
          "formulaExpression" : "case \r\n\twhen (\"User.Name\" = 'Christene Bishop')\r\n\tthen 'National - Quality'\r\n\twhen (\"UserRole.Name\" = 'Payroll Implementation') and (\"User.Division\" not in ('NDM Payroll Imp Coord Team'|| 'Field Payroll Operations'|| 'Operations'))\r\n\tthen 'National - Client Implementation Team'\r\n\telse\r\n\t\"User.Division\"\r\nend\r\n",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "BUCKET0_copy0" : {
