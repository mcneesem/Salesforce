          "type" : "TEXT",
          "name" : "Contact_Center_Group_Member_Formula",
          "label" : "Contact Center Group Member",
          "formulaExpression" : "case \r\n\twhen startsWith(\"Group.Name\", 'Contact Center') and \"JoinGroupw.Group.Name\" != 'Contact Center'\r\n\tthen 'true'\r\n\telse\r\n\t'false'\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
