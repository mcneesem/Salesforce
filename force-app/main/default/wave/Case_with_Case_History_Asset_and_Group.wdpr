    "FORMULA16" : {
      "action" : "formula",
      "sources" : [ "EDIT_ATTRIBUTES10" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Queue_Members",
          "label" : "Queue Members",
          "formulaExpression" : "case \r\n    when \"Group.Name\" = 'Health & Welfare Products'\r\n    then 'Health & Welfare Products member'\r\n    when \"Group.Name\" = 'Health & Welfare Bus. Process Control'\r\n    then 'Health & Welfare Bus. Process Control member'\r\n     when \"Group.Name\" = 'Health & Welfare Communications'\r\n    then 'Health & Welfare Communications  member'\r\n    else 'others'\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA34" : {
      "action" : "formula",
      "sources" : [ "FORMULA16" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "ContactCenterMembers_formula",
          "label" : "Contact Center Members",
          "formulaExpression" : "case \r\n\twhen startsWith(\"Group.Name\", 'Contact Center') \r\n\tthen \"User.Name\"\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
