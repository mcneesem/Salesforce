          "type" : "TEXT",
          "name" : "Case_Current_Owner",
          "label" : "Case Current Owner.",
          "formulaExpression" : "case \r\n\twhen startsWith(\"QueueSobje.Id\", '00G')\r\n\tthen \"QueueSobje.Name\"\r\n\telse\r\n\t\"User1.Name\"\r\nend",
