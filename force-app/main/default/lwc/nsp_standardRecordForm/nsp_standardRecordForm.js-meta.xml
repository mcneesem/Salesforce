<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>55.0</apiVersion>
    <isExposed>true</isExposed>
    <targets>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <propertyType name="T" extends="SObject" label="Input Type" description="Generic sObject data type used for input sObject properties" />
            <property label="Object API Name" name="objectName" type="String"  />
            <property label="Field Set Name" name="fieldSetName" type="String"  />
            <property label="Form Values" role="outputOnly" name="formValues" type="{T}" />
            <property name="heading" type="String" label="Enter the Heading" />
            <property name="_columns" type="Integer" label="Enter the no. of Columns" description="The number of columns you wish for the fields to be displayed"/>
        </targetConfig>    
    </targetConfigs>

</LightningComponentBundle>