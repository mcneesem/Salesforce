<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Schedule Seller</masterLabel>
    <targets>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <!-- INPUTS -->
            <property
                name="skill"
                type="String"
                label="Skill"
                description="Selected skill for availability check"
                />
            <property
                name="timeZone"
                type="String"
                label="Time Zone"
                description="Selected time zone"
                />
            <!-- OUTPUTS -->
            <property
                name="startDateTime"
                type="DateTime"
                label="Selected Start DateTime"
                role="outputOnly"
                />
            <property
                name="endDateTime"
                type="DateTime"
                label="Selected End DateTime"
                role="outputOnly"
                />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>