<apex:component controller="NSP_DisplayQliController" access="global" id="qliCmp">
 <apex:attribute name="quoteId" description="This is the quote Id for the component."
        type="String" required="true" assignTo="{!quoteIdstr}" access="global"/>
       <style>
      table, th, td {
  border: 1px solid black;
  border-collapse: collapse;
}
#test tr:last-child { font-weight: bold; }
       </style> 
  
   <p>
<apex:outputPanel rendered="{!approverCommentsList}"> 
    <b><apex:outputText value="Approver's Comment :"/></b>   <br> 
  <apex:repeat var="qli" value="{!ApproversComment}">
    <div> <apex:outputText value="{!qli.approverComment}"/> </div>
   </apex:repeat>   
   </br>
</apex:outputPanel>
   </p>
</apex:component>