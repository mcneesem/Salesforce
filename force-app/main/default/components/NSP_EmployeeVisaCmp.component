<apex:component access="global" controller="NSP_RelatedAssetsController" >
    <apex:attribute name="currentRecordId" description="recordId" type="String" assignTo="{!recId}" />    
    <apex:outputPanel rendered="{!empWrapperList.size > 0}">    
        <p>List of Employees:</p>
        <ul>
            <apex:repeat value="{!empWrapperList}" var="emp" id="empWrapperList">
                <li><apex:outputText value="{!emp}" id="empData" /></li> 
            </apex:repeat>
        </ul>
    </apex:outputPanel>
</apex:component>