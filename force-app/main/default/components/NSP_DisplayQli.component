    <apex:component controller="NSP_DisplayQliController" access="global" id="qliCmp">
    <apex:attribute name="quoteId" description="This is the quote Id for the component." type="String" required="true" assignTo="{!quoteIdstr}" access="global" />
    <style>
        table,
        th,
        td {
            border-collapse: collapse;
        }
       hr {
            height: 1px;
            border-width: 0;
            color: rgb(0, 0, 0);
            background-color: black;
        }
    </style>
    <apex:variable value="{!1}" var="count" />
    <apex:variable value="{!1}" var="countpepm" />
    <apex:variable value="{!1}" var="countrecruting" />
    <apex:variable value="{!1}" var="countComments" />
    <p>
        <apex:outputPanel rendered="{!approverCommentsList}">
            <b>
                <apex:outputText value="Approver's Comment :" />
            </b>
            <br />
            <apex:repeat var="qli" value="{!ApproversComment}">
                <apex:outputText value="{!qli.approverComment}" />
                <br />
            </apex:repeat>
        </apex:outputPanel>
    </p>
    <p>
        <apex:outputPanel rendered="{!quoteList}">
            <table style="width: 100%; table-layout: auto;">
                <tr style="text-align: center;">
                    <th style="height: 30px; padding: 1%;text-decoration: underline;font-size: 12px;word-wrap: normal;white-space: normal;">Unit Price</th>
                    <th style="height: 30px; padding: 1%;text-decoration: underline;font-size: 12px;word-wrap: normal;white-space: normal;">Discount Amt</th>
                    <th style="height: 30px; padding: 1%;text-decoration: underline;font-size: 12px;word-wrap: normal;white-space: normal;">Final Price</th>
                    <th style="height: 30px; padding: 1%;text-decoration: underline;font-size: 12px;word-wrap: normal;white-space: normal;">Discount %</th>
                    <apex:outputPanel layout="none" rendered="{!recruitingQuote}">
                        <th style="height: 30px; padding: 1%;text-decoration: underline;font-size: 12px;word-wrap: normal;white-space: normal;">Annual Base Salary</th>
                    </apex:outputPanel>
                    <apex:outputPanel layout="none" rendered="{!recruitingQuote}">
                        <th style="height: 30px; padding: 1%;text-decoration: underline;font-size: 12px;word-wrap: normal;white-space: normal;">Salary Bracket %</th>
                    </apex:outputPanel>
                    <apex:outputPanel layout="none" rendered="{!recruitingQuote}">
                        <th style="height: 30px; padding: 1%;text-decoration: underline;font-size: 12px;word-wrap: normal;white-space: normal;">Upfront Payment %</th>
                    </apex:outputPanel>
                    <th style="height: 30px; text-align: left;padding: 1%;font-size: 12px; text-decoration: underline; word-wrap: normal;white-space: normal; min-width: 30%; max-width: 60%;">Description</th>
                </tr>
                <apex:repeat var="qli" value="{!QliList}">
                    <tr style="height: 30px;text-align: center;">
                        <td style="height: 30px; padding: 1%;font-size: 11px;white-space: nowrap;">${!qli.formattedUnitPrice}</td>
                        <td style="height: 30px; padding: 1%;font-size: 11px;white-space: nowrap;">${!qli.formattedDiscPrice}</td>
                        <td style="height: 30px; padding: 1%;font-size: 11px;white-space: nowrap;">${!qli.formattedFinalPrice}</td>
                        <td style="height: 30px; padding: 1%;font-size: 11px;white-space: nowrap;">
                            <apex:outputText rendered="{!qli.discount != null}"> {!qli.discount} %</apex:outputText>
                            <apex:outputText rendered="{!qli.discount = null}"></apex:outputText>
                        </td>
                        <apex:outputPanel layout="none" rendered="{!recruitingQuote}">
                            <td style="height: 30px; padding: 1%;font-size: 11px;white-space: nowrap;">${!qli.formattedABS}</td>
                        </apex:outputPanel>
                        <apex:outputPanel layout="none" rendered="{!recruitingQuote}">
                            <td style="height: 30px; padding: 1%;font-size: 11px;white-space: nowrap;">{!qli.formattedSBP}%</td>
                        </apex:outputPanel>
                        <apex:outputPanel layout="none" rendered="{!recruitingQuote}">
                            <td style="height: 30px; padding: 1%;font-size: 11px;white-space: nowrap;">{!qli.formattedUFP}%</td>
                        </apex:outputPanel>
                        <td style="height: 30px;padding: 1%;font-size: 11px;text-align: left; word-wrap: normal;white-space: normal;">
                            <apex:outputText value="{!IF(contains(qli.description,'Minimum Fee'),LEFT(qli.description, LEN(qli.description)-14),qli.description)}"> </apex:outputText>
                            <apex:outputText value="{!IF(contains(qli.description,'Minimum Fee'),' '+$Label.MinimumFeeItalic,'')}" escape="false" />
                        </td>
                    </tr>
                </apex:repeat>
                <apex:repeat var="qli" value="{!LastLine}">
                    <tr style="height: 30px;text-align: center;font-weight: bold; border-top: 1px solid black;border-bottom: 1px solid black;">
                        <td style="height: 30px; padding: 2px;font-size: 11px;white-space: nowrap;"><span style="white-space: nowrap;">${!qli.formattedUnitPrice}</span></td>
                        <td style="height: 30px; padding: 2px;font-size: 11px;white-space: nowrap;"><span style="white-space: nowrap;">${!qli.formattedDiscPrice}</span></td>
                        <td style="height: 30px; padding: 2px;font-size: 11px;white-space: nowrap;"><span style="white-space: nowrap;">${!qli.formattedFinalPrice}</span></td>
                        <td style="height: 30px; padding: 1%;font-size: 11px;white-space: nowrap;">
                            <apex:outputText rendered="{!qli.discount != null}"> {!qli.discount} %</apex:outputText>
                            <apex:outputText rendered="{!qli.discount = null}"></apex:outputText>
                        </td>
                        <apex:outputPanel layout="none" rendered="{!recruitingQuote}">
                            <td style="height: 30px; padding: 1%;font-size: 11px;white-space: nowrap;"></td>
                        </apex:outputPanel>
                        <apex:outputPanel layout="none" rendered="{!recruitingQuote}">
                            <td style="height: 30px; padding: 1%;font-size: 11px;white-space: nowrap;"></td>
                        </apex:outputPanel>
                        <apex:outputPanel layout="none" rendered="{!recruitingQuote}">
                            <td style="height: 30px; padding: 1%;font-size: 11px;white-space: nowrap;"></td>
                        </apex:outputPanel>
                        <td style="height: 30px;padding: 1%;font-size: 11px;text-align: left; word-wrap: normal;white-space: normal;">
                            <apex:outputText value="{!IF(contains(qli.description,'Minimum Fee'),LEFT(qli.description, LEN(qli.description)-14),qli.description)}"> </apex:outputText>
                            <apex:outputText value="{!IF(contains(qli.description,'Minimum Fee'),' '+$Label.MinimumFeeItalic,'')}" escape="false" />
                        </td>
                    </tr>
                </apex:repeat>
            </table>
        </apex:outputPanel>
    </p>
    <br />
    <p>
        <apex:outputPanel rendered="{!pepmList}">
            <table style="width: 100%;table-layout: auto; border-bottom: 2px double black">
                <tr style="text-align: center;">
                    <th style="height: 30px; padding: 1%;text-decoration: underline;font-size: 12px;word-wrap: normal;white-space: normal;">Employees</th>
                    <th style="height: 30px; padding: 1%;text-decoration: underline;font-size: 12px;word-wrap: normal;white-space: normal;">Base PEPM</th>
                    <th style="height: 30px; padding: 1%;text-decoration: underline;font-size: 12px;word-wrap: normal;white-space: normal;">Final PEPM</th>
                    <th style="height: 30px; padding: 1%;text-decoration: underline;font-size: 12px;word-wrap: normal;white-space: normal;">Discount %</th>
                    <th style="height: 30px; text-align: left;padding: 1%;font-size: 12px; text-decoration: underline; word-wrap: normal;white-space: normal; min-width: 30%; max-width: 60%;">Description</th>
                </tr>
                <apex:repeat var="qli" value="{!QliPEPMList}">
                    <tr style="height: 30px; text-align: center">
                        <td style="height: 30px; padding: 1%;font-size: 11px;white-space: nowrap;"><span style="white-space: nowrap;">{!qli.numberOfEmployees}</span></td>
                        <td style="height: 30px; padding: 1%;font-size: 11px;white-space: nowrap;"><span style="white-space: nowrap;">${!qli.formattedUnitPrice}</span></td>
                        <td style="height: 30px; padding: 1%;font-size: 11px;white-space: nowrap;"><span style="white-space: nowrap;">${!qli.formattedFinalPrice}</span></td>
                        <td style="height: 30px; padding: 1%;font-size: 11px;white-space: nowrap;">
                            <apex:outputText rendered="{!qli.discount != null}"> {!qli.discount} %</apex:outputText>
                            <apex:outputText rendered="{!qli.discount = null}"></apex:outputText>
                        </td>
                        <td style="height: 30px;padding: 1%;font-size: 11px;text-align: left; word-wrap: normal;white-space: normal;">{!qli.description}</td>
                    </tr>
                </apex:repeat>
            </table>
        </apex:outputPanel>
    </p>
</apex:component>