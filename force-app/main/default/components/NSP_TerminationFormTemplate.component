<apex:component controller="NSP_TerminationFormTemplateController" access="global">
    <apex:image id="Logo" url="{!TopLogoUrl}"  width="700" height="100"/><br/>
    <apex:outputText value="TERMINATIONS / REINSTATEMENTS" style="padding-left: 230px; font-weight:bold;"/><br/>
    <apex:outputText value="PLEASE PROCESS TERMS AS STATED" style="padding-left: 230px; font-weight:bold;"/><br/>
    <div style="padding-left:2%;">
        <b>TERMINATIONS</b>
    </div>
    <apex:dataTable value="{!wrapTerminationList}" var="termination" width="100%">
        <apex:column style="padding:2%;">
            Client:  &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;{!termination.clinetName}<br/>
            Client#: &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;{!termination.clinetNumber}<br/>
            <div>
                CSA Term:&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                <apex:outputText value="{0,date,MM dd yyyy}">
                    <apex:param value="{!termination.csaTerm}" />
                </apex:outputText>
            </div>
            <div>
                Bene Term:&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                <apex:outputText value="{0,date,MM dd yyyy}">
                    <apex:param value="{!termination.beneterm}" />
                </apex:outputText>
            </div>
            Reason: &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;{!termination.reason}
        </apex:column>
    </apex:dataTable>
    <div style="padding-left:2%;">
        <b>REINSTATEMENTS</b>
    </div>
    <apex:dataTable value="{!reinstatementList}" var="reinstatement" width="100%">
        <apex:column style="padding:2%;">
            Client:  &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;{!reinstatement.NSP_Project_Task__r.pse__Project__r.pse__Account__r.Name}<br/>
            Client#: &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;{!reinstatement.NSP_Project_Task__r.pse__Project__r.pse__Account__r.NSP_AIMS_Client__c}<br/>
            <div>
                CSA Term: &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                <apex:outputText value="{0,date,MM dd yyyy}">
                    <apex:param value="{!reinstatement.NSP_Client_Term_Date__c}" />
                </apex:outputText>
            </div>
            Reason:&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;{!reinstatement.NSP_Term_Reason__c}
        </apex:column>
    </apex:datatable>
    <apex:image id="Logo1" url="{!BottomLogoUrl}"  width="700" height="30"/>
    <p><b><big>Terminations Team </big></b><br/></p>
    <apex:image id="Logo2" url="{!AddressLogoUrl}"  width="500" height="100"/>
</apex:component>