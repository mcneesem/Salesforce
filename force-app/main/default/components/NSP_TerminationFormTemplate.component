<apex:component controller="NSP_TerminationFormTemplateController" access="global">
    <apex:image id="Logo" url="{!TopLogoUrl}" style="width:600px; height:auto;"/><br/><br/>
    <apex:outputText value="TERMINATIONS / REINSTATEMENTS" style=" font-weight:bold;"/><br/>
    <apex:outputText value="PLEASE PROCESS TERMS AS STATED" style=" font-weight:bold;"/><br/><br/>

    <!-- Termination Section -->
    <apex:outputPanel rendered="{!NOT(ISBLANK(wrapTerminationList))}">
        <div style="padding-left:2%; text-align:left;">
            <b>TERMINATIONS</b>
        </div>
    </apex:outputPanel>
    <apex:dataTable value="{!wrapTerminationList}" var="termination" width="100%">
        <apex:column style="padding-left:2%; padding-bottom:1%;">
            <table style="width: 100%; table-layout: fixed; text-align:left;">
                <tr>
                    <td style="width: 10%; margin: 0; padding: 0; vertical-align: top; white-space: nowrap;">
                        <div style="width: 100%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                            <b>Client:</b>
                        </div>
                    </td>
                    <td style="margin: 0; padding: 0 0 0 12.5px;vertical-align: top;"><b>{!termination.clinetName}</b></td>
                </tr>
                <tr>
                    <td style="width: 10%; margin: 0; padding: 0; vertical-align: top; white-space: nowrap;">
                        <div style="width: 100%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                            Client #:
                        </div>
                    </td>
                    <td style="margin: 0; padding: 0 0 0 12.5px;vertical-align: top;">{!termination.clinetNumber}</td>
                </tr>
                <tr>
                    <td style="width: 10%; margin: 0; padding: 0; vertical-align: top; white-space: nowrap;">
                        <div style="width: 100%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                            # EE's:
                        </div>
                    </td>
                    <td style="margin: 0; padding: 0 0 0 12.5px;vertical-align: top;">
                        {!termination.eeNumber}
                        <apex:outputText value=" (MOVED)" rendered="{!OR(termination.reason == '1900 Merger with Insperity Client', termination.reason == '2700 Change in FEIN')}"/>
                    </td>
                </tr>
                <tr>
                    <td style="width: 10%; margin: 0; padding: 0; vertical-align: top; white-space: nowrap;">
                        <div style="width: 100%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                            PS:
                        </div>
                    </td>
                    <td style="margin: 0; padding: 0 0 0 12.5px;vertical-align: top;">{!termination.psName}</td>
                </tr>
                <tr>
                    <td style="width: 10%; margin: 0; padding: 0; vertical-align: top; white-space: nowrap;">
                        <div style="width: 100%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                            SA:
                        </div>
                    </td>
                    <td style="margin: 0; padding: 0 0 0 12.5px;vertical-align: top;">{!termination.saName}</td>
                </tr>
                <tr>
                    <td style="width: 10%; margin: 0; padding: 0; vertical-align: top; white-space: nowrap;">
                        <div style="width: 100%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                            CL:
                        </div>
                    </td>
                    <td style="margin: 0; padding: 0 0 0 12.5px;vertical-align: top;">{!termination.clName}</td>
                </tr>
                <tr>
                    <td style="width: 10%; margin: 0; padding: 0; vertical-align: top; white-space: nowrap;">
                        <div style="width: 100%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                            CSA Term:
                        </div>
                    </td>
                    <td style="margin: 0; padding: 0 0 0 12.5px;vertical-align: top;">
                        <apex:outputText value="{!IF (AND(termination.revision == 'Yes',termination.csaterm != termination.previousTermDate,NOT(ISNULL(termination.previousTermDate))), 
                                                'REVISED ' & TEXT(MONTH(termination.csaterm)) & '/' & TEXT(DAY(termination.csaterm)) & '/' &
                                                TEXT(YEAR(termination.csaterm)) &
                                                ' (Previous Term Date: ' &
                                                TEXT(MONTH(termination.previousTermDate)) & '/' &
                                                TEXT(DAY(termination.previousTermDate)) & '/' &
                                                TEXT(YEAR(termination.previousTermDate)) & ')',
                                                TEXT(MONTH(termination.csaterm)) & '/' &
                                                TEXT(DAY(termination.csaterm)) & '/' &
                                                TEXT(YEAR(termination.csaterm))
                                                )}">
                        </apex:outputText>
                    </td>
                </tr>
                <tr>
                    <td style="width: 10%; margin: 0; padding: 0; vertical-align: top; white-space: nowrap; overflow: hidden;">
                        <div style="width: 100%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                            Bene Term:
                        </div>
                    </td>
                    <td style="margin: 0; padding: 0 0 0 12.5px;vertical-align: top;">
                        <apex:outputText value="{!IF(
                            termination.beneterm == Null,
                            'NA',
                            IF(
                            AND(
                            termination.revision == 'Yes', termination.beneterm != termination.previousBeneTerm, NOT(ISNULL(termination.previousBeneTerm))),
                            'REVISED ' &
                            TEXT(MONTH(termination.beneterm)) & '/' &
                            TEXT(DAY(termination.beneterm)) & '/' &
                            TEXT(YEAR(termination.beneterm)) & ' ' &
                            IF(
                            termination.previousBeneTerm == Null,
                            '(Previous Bene Date: NA)',
                            '(Previous Bene Date: ' &
                            TEXT(MONTH(termination.previousBeneTerm)) & '/' &
                            TEXT(DAY(termination.previousBeneTerm)) & '/' &
                            TEXT(YEAR(termination.previousBeneTerm)) & ')'
                            ),
                            TEXT(MONTH(termination.beneterm)) & '/' &
                            TEXT(DAY(termination.beneterm)) & '/' &
                            TEXT(YEAR(termination.beneterm))
                            )
                            )}"/>
                        
                    </td>
                </tr>
                <tr>
                    <td style="width: 10%; margin: 0; padding: 0; vertical-align: top; white-space: nowrap;">
                        <div style="width: 100%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                            Reason:
                        </div>
                    </td>
                    <td style="margin: 0; padding: 0 0 0 12.5px;vertical-align: top;">
                        <apex:outputText value="{!IF(
                            ISBLANK(termination.reason),
                            'NA',
                            IF(AND(termination.revision == 'Yes', termination.reason != termination.previousReason), 'REVISED ', '') &
                            IF(
                            OR(
                            termination.reason == '1900 Merger with Insperity Client',
                            termination.reason == '2700 Change in FEIN'
                            ),
                            termination.reason,
                            IF(
                            NOT(ISBLANK(termination.subTermReason)),
                            termination.reason & ' / ' & termination.subTermReason,
                            termination.reason
                            )
                            ))}" />
                        <apex:outputText value="{!IF(
                            termination.reason == Null,
                            'NA',
                            IF(
                            OR(
                            termination.reason == '1900 Merger with Insperity Client',
                            termination.reason == '2700 Change in FEIN'
                            ),
                            '&nbsp;',
                            ''
                            ))}" escape="false" />
                        <apex:outputText value="{!IF(
                                termination.reason == Null,
                                'NA',
                                '(' & termination.clientname & ' - ' & termination.clientnumber & ')'
                                )}" escape="false"
                                rendered="{!OR(termination.reason == '1900 Merger with Insperity Client', termination.reason == '2700 Change in FEIN')}" />
                        <apex:outputPanel rendered="{!AND(termination.revision == 'Yes', termination.reason != termination.previousReason)}">
                            &nbsp;<apex:outputText value="{!'(Previous Reason: ' & termination.previousReason & 
                                IF(NOT(ISBLANK(termination.previousSubtermReason)),
                                '/' & termination.previousSubtermReason,
                                ''
                                ) &
                                ')'}" escape="false" />
                        </apex:outputPanel>
                    </td>
                </tr>
            </table>
        </apex:column>
    </apex:dataTable>
    <!-- Reinstatement Section -->
    <apex:outputPanel rendered="{!NOT(ISBLANK(wrapReinstatementList))}">
        <div style="padding-left:2%; text-align:left;">
            <b>REINSTATEMENTS</b> 
        </div>
    </apex:outputPanel>
    <apex:dataTable value="{!wrapReinstatementList}" var="reinstatement" width="100%">
        <apex:column style="padding-left:2%; padding-bottom:1%;">
            <table style="width: 100%; table-layout: fixed; text-align:left;">
                <tr>
                    <td style="width: 10%; margin: 0; padding: 0;"><b>Client:</b></td>
                    <td style="margin: 0; padding: 0 0 0 12.5px;vertical-align: top;"><b>{!reinstatement.clinetName}</b></td>
                </tr>
                <tr>
                    <td style="width: 10%; margin: 0; padding: 0;">Client #:</td>
                    <td style="margin: 0; padding: 0 0 0 12.5px;vertical-align: top;">{!reinstatement.clinetNumber}</td>
                </tr>
                <tr>
                    <td style="width: 10%; margin: 0; padding: 0;">PS:</td>
                    <td style="margin: 0; padding: 0 0 0 12.5px;vertical-align: top;">{!reinstatement.psName}</td>
                </tr>
                <tr>
                    <td style="width: 10%; margin: 0; padding: 0;">SA:</td>
                    <td style="margin: 0; padding: 0 0 0 12.5px;vertical-align: top;">{!reinstatement.saName}</td>
                </tr>
                <tr>
                    <td style="width: 10%; margin: 0; padding: 0;">CL:</td>
                    <td style="margin: 0; padding: 0 0 0 12.5px;vertical-align: top;">{!reinstatement.clName}</td>
                </tr>
               <tr>
                    <td style="width: 10%; margin: 0; padding: 0;">CSA Term:</td>
                    <td style="margin: 0; padding: 0 0 0 12.5px;vertical-align: top;">
                        <apex:outputText value="{!reinstatement.clientTermDate}"/>
                    </td>
                </tr>
                <tr>
                    <td style="width: 10%; margin: 0; padding: 0;">Reason:</td>
                    <td style="margin: 0; padding: 0 0 0 12.5px;vertical-align: top;">
                        <apex:outputText value="{!reinstatement.reinstatementReason}"/>
                    </td>
                </tr>
            </table>
        </apex:column>
    </apex:dataTable>
    <br/><br/>
    <b><big>Terminations Team </big></b><br/><br/>
    <apex:image id="Logo2" url="{!AddressLogoUrl}" width="200" height="56"/><br/><br/>
    <apex:image id="Logo1" url="{!BottomLogoUrl}" style="width:600px; height:auto;" />
</apex:component>