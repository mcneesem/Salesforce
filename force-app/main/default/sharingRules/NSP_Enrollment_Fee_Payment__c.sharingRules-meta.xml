<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>Read_Access_on_MidMarket_Enrollment_Fee_payment</fullName>
        <accessLevel>Read</accessLevel>
        <label>Read Access on MidMarket Enrollment Fee payment</label>
        <sharedTo>
            <role>MidMarket_Administrator</role>
        </sharedTo>
        <criteriaItems>
            <field>NSP_Is_MidMarket__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Share_Enrollment_Fee_When_Doucpay_is_greater_than_0</fullName>
        <accessLevel>Edit</accessLevel>
        <description>This rule will share the Enrollment Fee records with all the internal users when Docu Pay Up Front Fee is greater than 0</description>
        <label>Share Enrollment Fee When Doucpay is greater than 0</label>
        <sharedTo>
            <allInternalUsers></allInternalUsers>
        </sharedTo>
        <criteriaItems>
            <field>NSP_Docupay_Upfront_fee__c</field>
            <operation>greaterThan</operation>
            <value>0</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingOwnerRules>
        <fullName>Enrollment_Fee_NCS_Access</fullName>
        <accessLevel>Edit</accessLevel>
        <label>Enrollment Fee NCS Access</label>
        <sharedTo>
            <group>NSP_New_Client_Sales</group>
        </sharedTo>
        <sharedFrom>
            <allInternalUsers></allInternalUsers>
        </sharedFrom>
    </sharingOwnerRules>
    <sharingOwnerRules>
        <fullName>Sales_Compensation_EFP_Read_Edit</fullName>
        <accessLevel>Edit</accessLevel>
        <description>Read access to Sales Compensation on Enrollment Fee Payment records</description>
        <label>Sales Compensation- EFP Read_Edit</label>
        <sharedTo>
            <group>NSP_Sales_Compensation</group>
        </sharedTo>
        <sharedFrom>
            <allInternalUsers></allInternalUsers>
        </sharedFrom>
    </sharingOwnerRules>
    <sharingOwnerRules>
        <fullName>NSP_Enrollment_Fee_Finance_Lead_Node_All_Access</fullName>
        <accessLevel>Edit</accessLevel>
        <description>Sharing enrollment fee with Finance leader, Finance Manager, Finance supervisor, Finance user</description>
        <label>Enrollment Fee Finance Lead Node All Access</label>
        <sharedTo>
            <group>Finance_leader_For_Enrollment_Fee_Group</group>
        </sharedTo>
        <sharedFrom>
            <allInternalUsers></allInternalUsers>
        </sharedFrom>
    </sharingOwnerRules>
</SharingRules>
