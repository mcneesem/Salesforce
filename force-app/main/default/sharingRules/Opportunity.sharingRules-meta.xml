<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>Deals_Oppty_Edit</fullName>
        <accessLevel>Edit</accessLevel>
        <label>Deals - Oppty Edit</label>
        <sharedTo>
            <group>NSP_Deal_Team</group>
        </sharedTo>
        <booleanFilter>1 AND 2</booleanFilter>
        <criteriaItems>
            <field>StageName</field>
            <operation>equals</operation>
            <value>Proposal,Closed Lost,Analysis,Closing,Closed Won</value>
        </criteriaItems>
        <criteriaItems>
            <field>NSP_PrimaryProduct__c</field>
            <operation>equals</operation>
            <value>HRCore Solution,HRCore - Select Edition,HR360 Solution,HR360 - Select Edition</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>NCS_Sales_Compensation_Opportunity_Access</fullName>
        <accessLevel>Edit</accessLevel>
        <label>NCS Sales Compensation Opportunity Access</label>
        <sharedTo>
            <group>NSP_Sales_Compensation</group>
        </sharedTo>
        <criteriaItems>
            <field>StageName</field>
            <operation>equals</operation>
            <value>Closing,Closed Lost,Closed Won</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Primary_Product_is_WS_or_WA</fullName>
        <accessLevel>Edit</accessLevel>
        <description>If Primary Product is WS, HRScale or WA, share with MidMarket Admins</description>
        <label>Primary Product is WS or WA</label>
        <sharedTo>
            <role>MidMarket_Administrator</role>
        </sharedTo>
        <criteriaItems>
            <field>NSP_PrimaryProduct__c</field>
            <operation>equals</operation>
            <value>HR360 - Select Edition,HRCore - Select Edition,HRScale</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Sales_Enablement_Analyst</fullName>
        <accessLevel>Edit</accessLevel>
        <label>Sales Enablement Analyst</label>
        <sharedTo>
            <group>Sales_Enablement_Analyst</group>
        </sharedTo>
        <criteriaItems>
            <field>StageName</field>
            <operation>notEqual</operation>
            <value></value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Sales_Operation_Manager_Opportunity_Share_Access</fullName>
        <accessLevel>Edit</accessLevel>
        <description>This is required for SEM to assign SE (Sales Engineer) as part of Opportunity team.</description>
        <label>Sales Operation Manager Opportunity Share Access</label>
        <sharedTo>
            <role>Sales_Engineer_Manager</role>
        </sharedTo>
        <criteriaItems>
            <field>StageName</field>
            <operation>equals</operation>
            <value>Analysis,Proposal</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Share_MidMarket_Opportunities_to_MM_Admin</fullName>
        <accessLevel>Edit</accessLevel>
        <label>Share MidMarket Opportunities to MM Admin</label>
        <sharedTo>
            <group>MidMarket_Administrator</group>
        </sharedTo>
        <booleanFilter>1 AND  NOT (2 OR 3)</booleanFilter>
        <criteriaItems>
            <field>NSP_Number_of_Employees__c</field>
            <operation>greaterOrEqual</operation>
            <value>150</value>
        </criteriaItems>
        <criteriaItems>
            <field>Is_Services_Opportunity__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <criteriaItems>
            <field>Type</field>
            <operation>equals</operation>
            <value>Client Growth Credit</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Share_WS_or_WA_to_MM_Admins</fullName>
        <accessLevel>Edit</accessLevel>
        <label>Share WS, HRScale or WA to MM Admins</label>
        <sharedTo>
            <group>MidMarket_Administrator</group>
        </sharedTo>
        <booleanFilter>1 AND  NOT (2 OR 3)</booleanFilter>
        <criteriaItems>
            <field>NSP_PrimaryProduct__c</field>
            <operation>equals</operation>
            <value>HR360 - Select Edition,HRCore - Select Edition,HRScale</value>
        </criteriaItems>
        <criteriaItems>
            <field>Is_Services_Opportunity__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <criteriaItems>
            <field>Type</field>
            <operation>equals</operation>
            <value>Client Growth Credit</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Strategic_Sales_Leaders</fullName>
        <accessLevel>Edit</accessLevel>
        <label>Strategic_Sales_Leaders</label>
        <sharedTo>
            <group>Strategic_Sales_Leaders</group>
        </sharedTo>
        <booleanFilter>(1 OR 4) AND NOT (2 OR 3)</booleanFilter>
        <criteriaItems>
            <field>NSP_PrimaryProduct__c</field>
            <operation>equals</operation>
            <value>Workday,HRCore Solution,HRCore - Select Edition,HR360 Solution,HR360 - Select Edition,HRScale</value>
        </criteriaItems>
        <criteriaItems>
            <field>Is_Services_Opportunity__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <criteriaItems>
            <field>Type</field>
            <operation>equals</operation>
            <value>Client Growth Credit</value>
        </criteriaItems>
        <criteriaItems>
            <field>NSP_PrimaryProduct__c</field>
            <operation>equals</operation>
            <value></value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
