<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>Channel_Operations_Opportunity_Access</fullName>
        <accessLevel>Edit</accessLevel>
        <label>Channel Operations Opportunity Access</label>
        <sharedTo>
            <role>Channel_Operations</role>
        </sharedTo>
        <criteriaItems>
            <field>StageName</field>
            <operation>equals</operation>
            <value>Closed Lost,Closed Won</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Deals_Oppty_Edit</fullName>
        <accessLevel>Edit</accessLevel>
        <label>Deals - Oppty Edit</label>
        <sharedTo>
            <group>NSP_Deal_Team</group>
        </sharedTo>
        <booleanFilter>1 AND 2</booleanFilter>
        <criteriaItems>
            <field>StageName</field>
            <operation>equals</operation>
            <value>Proposal,Closed Lost,Analysis,Closing,Closed Won</value>
        </criteriaItems>
        <criteriaItems>
            <field>NSP_PrimaryProduct__c</field>
            <operation>equals</operation>
            <value>Workforce Acceleration,Workforce Administration,Workforce Optimization,Workforce Synchronization</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>NCS_Manager_Opportunity_Access</fullName>
        <accessLevel>Edit</accessLevel>
        <label>NCS Manager Opportunity Access</label>
        <sharedTo>
            <group>NSP_New_Client_Sales</group>
        </sharedTo>
        <criteriaItems>
            <field>StageName</field>
            <operation>equals</operation>
            <value>Closing,Closed Lost,Closed Won</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>NCS_Sales_Compensation_Opportunity_Access</fullName>
        <accessLevel>Edit</accessLevel>
        <label>NCS Sales Compensation Opportunity Access</label>
        <sharedTo>
            <group>NSP_Sales_Compensation</group>
        </sharedTo>
        <criteriaItems>
            <field>StageName</field>
            <operation>equals</operation>
            <value>Closing,Closed Lost,Closed Won</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Read_Edit_Access_on_MidMarket_Opportunities_to_MM_Admin</fullName>
        <accessLevel>Edit</accessLevel>
        <label>Read Edit Access on MidMarket Opportunities to MM Admin</label>
        <sharedTo>
            <role>MidMarket_Administrator</role>
        </sharedTo>
        <criteriaItems>
            <field>NSP_Number_of_Employees__c</field>
            <operation>greaterOrEqual</operation>
            <value>150</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Read_Edit_Access_on_MidMarket_Opportunities_to_MM_Sales_Leader</fullName>
        <accessLevel>Edit</accessLevel>
        <label>Read Edit Access on MidMarket Opportunities to MM Sales Leader</label>
        <sharedTo>
            <role>MidMarket_Sales_Leader</role>
        </sharedTo>
        <criteriaItems>
            <field>NSP_Number_of_Employees__c</field>
            <operation>greaterOrEqual</operation>
            <value>150</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Sales_Operation_Manager_Opportunity_Share_Access</fullName>
        <accessLevel>Edit</accessLevel>
        <description>This is required for SEM to assign SE (Sales Engineer) as part of Opportunity team.</description>
        <label>Sales Operation Manager Opportunity Share Access</label>
        <sharedTo>
            <role>Sales_Engineer_Manager</role>
        </sharedTo>
        <criteriaItems>
            <field>StageName</field>
            <operation>equals</operation>
            <value>Analysis,Proposal</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingOwnerRules>
        <fullName>All_Opportunities_Edit_access_to_Finance_Users</fullName>
        <accessLevel>Read</accessLevel>
        <description>Sharing rule to give edit access of opportunities to Finance Users</description>
        <label>All Opportunities Edit access to Finance Users</label>
        <sharedTo>
            <group>NSP_Finance_Users_Edit_Access_Group</group>
        </sharedTo>
        <sharedFrom>
            <allInternalUsers></allInternalUsers>
        </sharedFrom>
    </sharingOwnerRules>
    <sharingOwnerRules>
        <fullName>All_Opportunities_view_access_to_Finance</fullName>
        <accessLevel>Read</accessLevel>
        <description>Sharing Rule to give View access of opportunities to Finance users</description>
        <label>All Opportunities view access to Finance</label>
        <sharedTo>
            <group>NSP_Finance_Users_Read_Access_Group</group>
        </sharedTo>
        <sharedFrom>
            <allInternalUsers></allInternalUsers>
        </sharedFrom>
    </sharingOwnerRules>
</SharingRules>
