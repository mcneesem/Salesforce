    <sharingCriteriaRules>
        <fullName>NSP_Share_Segment_Accounts_to_BPC_Support_Group</fullName>
        <accessLevel>Edit</accessLevel>
        <accountSettings>
            <caseAccessLevel>None</caseAccessLevel>
            <contactAccessLevel>Edit</contactAccessLevel>
            <opportunityAccessLevel>None</opportunityAccessLevel>
        </accountSettings>
        <description>This rule will Share Segment Accounts to BPC Support Group</description>
        <label>Share Segment Accounts to BPC Support Group</label>
        <sharedTo>
            <group>NSP_BPC_Support</group>
        </sharedTo>
        <criteriaItems>
            <field>NSP_Account_Segment__c</field>
            <operation>equals</operation>
            <value>MidMarket</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>NSP_Share_Segment_Accounts_to_MM_Role_Users</fullName>
        <accessLevel>Edit</accessLevel>
        <accountSettings>
            <caseAccessLevel>None</caseAccessLevel>
            <contactAccessLevel>Edit</contactAccessLevel>
            <opportunityAccessLevel>Edit</opportunityAccessLevel>
        </accountSettings>
        <description>This Rule will Share Segment Accounts to MM Admin Role Users and subordinates</description>
        <label>Share Segment Accounts to MM Role Users</label>
        <sharedTo>
            <roleAndSubordinates>MidMarket_Administrator</roleAndSubordinates>
        </sharedTo>
        <booleanFilter>1 OR 2</booleanFilter>
        <criteriaItems>
            <field>NSP_Account_Segment__c</field>
            <operation>equals</operation>
            <value>MidMarket</value>
        </criteriaItems>
        <criteriaItems>
            <field>MidMarket_National_Account__c</field>
            <operation>notEqual</operation>
            <value></value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
