<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>Account_Segment_MidMarket_or_MMNA_populated</fullName>
        <accessLevel>Edit</accessLevel>
        <accountSettings>
            <caseAccessLevel>None</caseAccessLevel>
            <contactAccessLevel>Edit</contactAccessLevel>
            <opportunityAccessLevel>Edit</opportunityAccessLevel>
        </accountSettings>
        <description>If Account Segment = MidMarket or MidMarket National Account field is populated, share with MidMarket Admins</description>
        <label>Account Segment MidMarket or MMNA populated</label>
        <sharedTo>
            <role>MidMarket_Administrator</role>
        </sharedTo>
        <booleanFilter>1 OR 2</booleanFilter>
        <criteriaItems>
            <field>NSP_Account_Segment__c</field>
            <operation>equals</operation>
            <value>MidMarket</value>
        </criteriaItems>
        <criteriaItems>
            <field>MidMarket_National_Account__c</field>
            <operation>notEqual</operation>
            <value></value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Data_Gov_Account_Edit</fullName>
        <accessLevel>Edit</accessLevel>
        <accountSettings>
            <caseAccessLevel>None</caseAccessLevel>
            <contactAccessLevel>Edit</contactAccessLevel>
            <opportunityAccessLevel>Edit</opportunityAccessLevel>
        </accountSettings>
        <label>Data Gov - Account &amp; Edit</label>
        <sharedTo>
            <group>NSP_Data_Governance_Group</group>
        </sharedTo>
