<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>NSP_FLSA_Note_Sharing_Rules</fullName>
        <accessLevel>Read</accessLevel>
        <label>FLSA Note Sharing Rules</label>
        <sharedTo>
            <group>NSP_FLSA_Users</group>
        </sharedTo>
        <criteriaItems>
            <field>Note_Type__c</field>
            <operation>equals</operation>
            <value>FLSA</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>NSP_UX_Team_Note_Sharing_Rules</fullName>
        <accessLevel>Read</accessLevel>
        <label>UX Team Note Sharing Rules</label>
        <sharedTo>
            <group>NSP_UX_Users</group>
        </sharedTo>
        <criteriaItems>
            <field>Note_Type__c</field>
            <operation>equals</operation>
            <value>UX Team Only</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Non_FLSA_Note_Sharing_Rules</fullName>
        <accessLevel>Read</accessLevel>
        <label>Non FLSA Note Sharing Rules</label>
        <sharedTo>
            <allInternalUsers></allInternalUsers>
        </sharedTo>
        <booleanFilter>1 AND 2</booleanFilter>
        <criteriaItems>
            <field>Note_Type__c</field>
            <operation>notEqual</operation>
            <value>FLSA</value>
        </criteriaItems>
        <criteriaItems>
            <field>Note_Type__c</field>
            <operation>notEqual</operation>
            <value>UX Team Only</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
</SharingRules>
