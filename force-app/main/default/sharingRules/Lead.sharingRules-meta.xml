<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>Google_Ads_Integration</fullName>
        <accessLevel>Read</accessLevel>
        <description>Lead Sharing Rule required by Google Ads Integration.</description>
        <label>Google Ads Integration</label>
        <sharedTo>
            <group>Google_Ads_Integration</group>
        </sharedTo>
        <criteriaItems>
            <field>ConvertedDate</field>
            <operation>notEqual</operation>
            <value></value>
        </criteriaItems>
        <criteriaItems>
            <field>GCLID__c</field>
            <operation>notEqual</operation>
            <value></value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>NSP_Referral_Lead_Sharing</fullName>
        <accessLevel>Read</accessLevel>
        <description>This sharing rule is created as part of DF-01721. 
When the referral lead is assigned to Inbound solutions queue, granting access to all salesforce users.</description>
        <label>Referral Lead Sharing</label>
        <sharedTo>
            <allInternalUsers></allInternalUsers>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>Referral</value>
        </criteriaItems>
        <criteriaItems>
            <field>OwnerId</field>
            <operation>startsWith</operation>
            <value>00G</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingOwnerRules>
        <fullName>Lead_BPA_group_Owner_to_Data_Science_group</fullName>
        <accessLevel>Edit</accessLevel>
        <label>Lead - BPA group Owner to Data Science group</label>
        <sharedTo>
            <group>NSP_Data_Science</group>
        </sharedTo>
        <sharedFrom>
            <group>Business_Performance_Advisor</group>
        </sharedFrom>
    </sharingOwnerRules>
    <sharingOwnerRules>
        <fullName>Lead_BPA_group_Owner_to_NCS_group</fullName>
        <accessLevel>Edit</accessLevel>
        <label>Lead - BPA group Owner to NCS group</label>
        <sharedTo>
            <group>NSP_New_Client_Sales</group>
        </sharedTo>
        <sharedFrom>
            <group>Business_Performance_Advisor</group>
        </sharedFrom>
    </sharingOwnerRules>
    <sharingOwnerRules>
        <fullName>NSP_BPA_owner_Lead_to_Data_Science_Group</fullName>
        <accessLevel>Edit</accessLevel>
        <description>Share BPA owner Lead to Data Science Group</description>
        <label>BPA owner Lead to Data Science Group</label>
        <sharedTo>
            <group>NSP_Data_Science</group>
        </sharedTo>
        <sharedFrom>
            <role>Business_Performance_Advisor</role>
        </sharedFrom>
    </sharingOwnerRules>
    <sharingOwnerRules>
        <fullName>NSP_BPA_owner_Lead_to_NCS_group</fullName>
        <accessLevel>Edit</accessLevel>
        <description>Share Lead BPA owner Leads with NCS Public Group</description>
        <label>BPA owner Lead to NCS group</label>
        <sharedTo>
            <group>NSP_New_Client_Sales</group>
        </sharedTo>
        <sharedFrom>
            <role>Business_Performance_Advisor</role>
        </sharedFrom>
    </sharingOwnerRules>
</SharingRules>
