        <label>RET-Compliance Sharing Rule</label>
        <sharedTo>
            <group>NSP_Ret_Services_Objects_Read_Edit</group>
        </sharedTo>
        <criteriaItems>
            <field>Name</field>
            <operation>notEqual</operation>
            <value></value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>NSP_RET_Compliance_For_RET_Sales</fullName>
