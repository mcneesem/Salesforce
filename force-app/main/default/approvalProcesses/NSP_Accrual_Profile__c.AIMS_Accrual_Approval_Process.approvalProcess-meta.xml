<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <submitter>NSP_Service_Profile_Group_Members</submitter>
        <type>group</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>NSP_Status__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>NSP_Middle_Market_PTO_Specialists</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <criteriaItems>
                <field>NSP_Accrual_Profile__c.NSP_Is_this_a_Middle_Market_client__c</field>
                <operation>equals</operation>
                <value>Yes</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>MM PTO Received</label>
        <name>MM_PTO_Received</name>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>NSP_National_PTO</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <criteriaItems>
                <field>NSP_Accrual_Profile__c.NSP_Is_this_a_Middle_Market_client__c</field>
                <operation>equals</operation>
                <value>No</value>
            </criteriaItems>
        </entryCriteria>
        <label>National PTO Received</label>
        <name>National_PTO_Received</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <booleanFilter>1 AND 2</booleanFilter>
        <criteriaItems>
            <field>NSP_Accrual_Profile__c.RecordType</field>
            <operation>equals</operation>
            <value>AIMS</value>
        </criteriaItems>
        <criteriaItems>
            <field>NSP_Accrual_Profile__c.NSP_Status__c</field>
            <operation>notEqual</operation>
            <value>Recalled</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Change_Status_to_Approved_AIMS</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>NSP_Accrual_Profile_Approval_AIMS</name>
            <type>Alert</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Change_Status_to_Rejected_AIMS</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>NSP_Approval_Process_Rejection_1</name>
            <type>Alert</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Change_Status_to_Submitted_AIMS</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>NSP_Updating_Submitter_Field2</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>AIMS Accrual Approval Process</label>
    <processOrder>1</processOrder>
    <recallActions>
        <action>
            <name>Change_Status_to_Recalled</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>