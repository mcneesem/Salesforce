<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>NSP_Approver__c</field>
        <field>Owner</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Mark_Form_Status_PR_Supervisor_Approved</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>NSP_Approver__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>Unanimous</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <booleanFilter>1 AND (2 OR 4) AND 3</booleanFilter>
            <criteriaItems>
                <field>NSP_Termination_Form__c.NSP_Approver__c</field>
                <operation>notEqual</operation>
            </criteriaItems>
            <criteriaItems>
                <field>NSP_Termination_Form__c.RecordType</field>
                <operation>equals</operation>
                <value>Payroll Specialist Form</value>
            </criteriaItems>
            <criteriaItems>
                <field>NSP_Termination_Form__c.NSP_Status__c</field>
                <operation>equals</operation>
                <value>Resubmitted by PS</value>
            </criteriaItems>
            <criteriaItems>
                <field>NSP_Termination_Form__c.RecordType</field>
                <operation>equals</operation>
                <value>Client Reinstatement</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>Assign to Payroll Supervisor</label>
        <name>Assign_to_Payroll_Supervisor</name>
        <rejectionActions>
            <action>
                <name>Mark_Form_Status_PR_Supervisor_Denied</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Set_Status_to_Resubmitted_by_PR_Super</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>NSP_Approver__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>Unanimous</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <booleanFilter>1 AND (2 OR 4) AND 3</booleanFilter>
            <criteriaItems>
                <field>NSP_Termination_Form__c.NSP_Approver__c</field>
                <operation>notEqual</operation>
            </criteriaItems>
            <criteriaItems>
                <field>NSP_Termination_Form__c.RecordType</field>
                <operation>equals</operation>
                <value>Payroll Specialist Form</value>
            </criteriaItems>
            <criteriaItems>
                <field>NSP_Termination_Form__c.NSP_Status__c</field>
                <operation>equals</operation>
                <value>Term Team Denied</value>
            </criteriaItems>
            <criteriaItems>
                <field>NSP_Termination_Form__c.RecordType</field>
                <operation>equals</operation>
                <value>Client Reinstatement</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>Reassign to Payroll Supervisor</label>
        <name>Reassign_to_Payroll_Supervisor</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
        <rejectionActions>
            <action>
                <name>Mark_Form_Status_PR_Supervisor_Denied</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Mark_Form_Status_Term_Team_Approved</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>Termination_Team</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Assign to Termination team</label>
        <name>Assign_to_Termination_team</name>
        <rejectBehavior>
            <type>BackToPrevious</type>
        </rejectBehavior>
        <rejectionActions>
            <action>
                <name>Mark_Form_Status_Term_Team_Denied</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <description>As part of STY-01956. Need to Hide the Submit for Approval Button. If Entry Criteria is satisfied Button is available for Apporval. If Any changes are made to the Entry Criteria Formula field i.e, NSP_Hide_Submit_For_Approval__c needs to be Updated.</description>
    <emailTemplate>Services_Emails/Termination_Form_Assigned</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <formula>AND(
    OR(
        ISPICKVAL(NSP_Status__c, &quot;Term Team Denied&quot;),
        ISPICKVAL(NSP_Status__c, &quot;PR Supervisor Denied&quot;)
    ),
    IF(
    RecordType.Name = &apos;Payroll Specialist Form&apos;,
    AND( 
        NOT(ISBLANK(NSP_Approver__c)),
        NOT(ISBLANK(NSP_CSA_Effective_Date__c)),
        NOT(ISBLANK(NSP_Payroll_Specialist__c)),
        NOT(ISBLANK(NSP_Supervisor__c)),
        NOT(ISBLANK(NSP_Manager_HR_Services__c)),
        NOT(ISBLANK(NSP_Client_Name__c)),
        NOT(ISBLANK(NSP_Client_Owner__c)),
        NOT(ISBLANK(Client_Owner_Email__c)),
        NOT(ISBLANK(Client_Owner_Phone__c)),
        NOT(ISBLANK(NSP_Client_Sub_Account_Numbers__c)),
        NOT(ISBLANK(NSP_Client__c)),
        NOT(ISBLANK(TEXT(NSP_EmployeesEverWorkedInStateNewYork__c))),
        NOT(ISBLANK(NSP_Last_Date_Wages_Paid_Through__c)),
        NOT(ISBLANK(NSP_Number_of_Active_Employees__c)),
        NOT(ISBLANK(NSP_Project_Task__c)),
        NOT(ISBLANK(NSP_Renewal_Date__c)),
        NOT(ISBLANK(NSP_Segment_Type__c)),
        NOT(ISBLANK(TEXT(NSP_Status__c))),
        NOT(ISBLANK(TEXT(NSP_Term_Code__c))),
        NOT(ISBLANK(Name))
        ), 
    IF(
        RecordType.Name = &apos;Client Reinstatement&apos;,
        AND( 
            NOT(ISBLANK(NSP_Approver__c)),
            NSPClientDocumentRequestingReinstatement__c,
            NOT(ISBLANK(NSP_Client_Name__c)),
            NOT(ISBLANK(NSP_Client_Sub_Account_Numbers__c)),
            NOT(ISBLANK(NSP_Client_Term_Date__c)),
            NOT(ISBLANK(NSP_Client__c)),
            NOT(ISBLANK(NSP_Project_Task__c)),
            NOT(ISBLANK(TEXT(NSP_Status__c))),
            NOT(ISBLANK(TEXT(NSP_Term_Code__c))),
            NOT(ISBLANK(TEXT(NSP_Term_Reason__c)))
            ),
        AND( 
NOT(ISBLANK(NSP_CSA_Effective_Date__c)),
NOT(ISBLANK(NSP_Payroll_Specialist__c)),
NOT(ISBLANK(NSP_Supervisor__c)),
NOT(ISBLANK(NSP_Manager_HR_Services__c)),
NOT(ISBLANK(NSP_Client_Name__c)),
NOT(ISBLANK(NSP_Client_Owner__c)),
NOT(ISBLANK(Client_Owner_Email__c)),
NOT(ISBLANK(Client_Owner_Phone__c)),
NOT(ISBLANK(NSP_Client_Sub_Account_Numbers__c)),
NOT(ISBLANK(NSP_Client__c)),
NOT(ISBLANK(Credit_Specialist__c)),
NOT(ISBLANK(NSP_Credit_Specialist_Phone__c)),
NOT(ISBLANK(TEXT(NSP_EmployeesEverWorkedInStateNewYork__c))),
NOT(ISBLANK(NSP_Last_Date_Wages_Paid_Through__c)),
NOT(ISBLANK(NSP_Number_of_Active_Employees__c)),
NOT(ISBLANK(NSP_Project_Task__c)),
NOT(ISBLANK(NSP_Renewal_Date__c)),
NOT(ISBLANK(NSP_Segment_Type__c)),
NOT(ISBLANK(TEXT(NSP_Status__c))),
NOT(ISBLANK(TEXT(NSP_Term_Code__c))),
NOT(ISBLANK(TEXT(NSP_TWC_Bad_faith_credit_letter__c))),
NOT(ISBLANK(Name))
            )
        )
    )
)</formula>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Send_Email_to_Owner_and_Created_By</name>
            <type>Alert</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>true</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Send_Email_to_Owner_and_Created_By_if_rejected</name>
            <type>Alert</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Set_Status_to_Resubmitted_by_PS</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Resubmit Approval for Termination Form</label>
    <processOrder>3</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>false</showApprovalHistory>
</ApprovalProcess>
