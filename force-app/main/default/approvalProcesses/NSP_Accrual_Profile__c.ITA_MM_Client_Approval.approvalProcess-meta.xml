<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <submitter>NSP_Service_Profile_Group_Members</submitter>
        <type>group</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>NSP_Status__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>NSP_MM_Accrual_Profile_Team</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <criteriaItems>
                <field>NSP_Accrual_Profile__c.Is_Client_MM_or_MM_Enterprise__c</field>
                <operation>equals</operation>
                <value>Middle Market</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>Step 1 MM</label>
        <name>Step_1_MM</name>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>MM_Enterprise_Accrual_Profile_Team</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <criteriaItems>
                <field>NSP_Accrual_Profile__c.Is_Client_MM_or_MM_Enterprise__c</field>
                <operation>equals</operation>
                <value>Middle Market Enterprise</value>
            </criteriaItems>
        </entryCriteria>
        <label>Step 1 MME</label>
        <name>Step_1_MME</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <booleanFilter>(1 OR 2) AND 3</booleanFilter>
        <criteriaItems>
            <field>NSP_Accrual_Profile__c.Is_Client_MM_or_MM_Enterprise__c</field>
            <operation>equals</operation>
            <value>Middle Market</value>
        </criteriaItems>
        <criteriaItems>
            <field>NSP_Accrual_Profile__c.Is_Client_MM_or_MM_Enterprise__c</field>
            <operation>equals</operation>
            <value>Middle Market Enterprise</value>
        </criteriaItems>
        <criteriaItems>
            <field>NSP_Accrual_Profile__c.RecordType</field>
            <operation>equals</operation>
            <value>ITA</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Change_the_Status_to_AP_Approved</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Update_Status_to_rejected</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Change_the_status_to_submit_for_Approval</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_email_submitter_field</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>ITA MM Client  Approval</label>
    <processOrder>3</processOrder>
    <recallActions>
        <action>
            <name>Update_status_to_Draft</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>