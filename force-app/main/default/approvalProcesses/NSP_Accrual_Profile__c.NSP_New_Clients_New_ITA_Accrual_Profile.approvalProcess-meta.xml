<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <submitter>NSP_Service_Profile_Group_Members</submitter>
        <type>group</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>NSP_Account_HRS__c</field>
        <field>NSP_Accrual_Levels__c</field>
        <field>NSP_Accrual_Period_Limit__c</field>
        <field>NSP_Accrual_Profile_Plan_Name__c</field>
        <field>NSP_Compliance_Locations__c</field>
        <field>NSP_Contact__c</field>
        <field>NSP_Contact_email__c</field>
        <field>CreatedBy</field>
        <field>CurrencyIsoCode</field>
        <field>NSP_Does_this_plan_replace_other_plans__c</field>
        <field>NSP_Effective_date__c</field>
        <field>NSP_Employee_Status_check_all_that_apply__c</field>
        <field>NSP_Hours_paid_for_earning_accruals__c</field>
        <field>NSP_Is_a_prorated_accrual_earned__c</field>
        <field>NSP_Is_there_a_frontloaded_proration__c</field>
        <field>LastModifiedBy</field>
        <field>NSP_List_pay_codes__c</field>
        <field>NSP_NewExisting_Client_or_Change_order__c</field>
        <field>NSP_New_Implementation_or_Change_Order__c</field>
        <field>NSP_Policy_Type_Provide_Details__c</field>
        <field>RecordType</field>
        <field>NSP_Select_Pay_Frequency__c</field>
        <field>NSP_Status__c</field>
        <field>NSP_Submitted_by__c</field>
        <field>NSP_Submitted_to_satisfy_compliance_need__c</field>
        <field>NSP_Type_of_Policy__c</field>
        <field>NSP_What_is_the_plan_year__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>NSP_HR_Client_Implementation</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Step 1</label>
        <name>Step_1</name>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>NSP_ITA_Accrual_Profile_Team</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Step 2</label>
        <name>Step_2</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>NSP_Accrual_Profile__c.NSP_NewExisting_Client_or_Change_order__c</field>
            <operation>equals</operation>
            <value>New Client/New ITA Implementation</value>
        </criteriaItems>
        <criteriaItems>
            <field>NSP_Accrual_Profile__c.RecordType</field>
            <operation>equals</operation>
            <value>ITA</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Change_Status_to_Active</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>NSP_Accrual_Profile_Approval_Alert</name>
            <type>Alert</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Change_Status_to_Rejected</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>NSP_New_ITA_Approval_Process_Rejection</name>
            <type>Alert</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Change_Status_to_Submitted</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>NSP_Updating_Submitter_Email_Field</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>New Clients/New ITA Accrual Profile</label>
    <processOrder>1</processOrder>
    <recallActions>
        <action>
            <name>Change_Status_to_ReSubmitted</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
