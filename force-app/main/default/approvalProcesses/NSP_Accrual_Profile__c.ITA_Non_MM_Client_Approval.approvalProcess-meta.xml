<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <submitter>NSP_Service_Profile_Group_Members</submitter>
        <type>group</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>NSP_Status__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>NSP_HR_Client_Implementation</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <criteriaItems>
                <field>NSP_Accrual_Profile__c.NSP_NewExisting_Client_or_Change_order__c</field>
                <operation>equals</operation>
                <value>New Client/New ITA Implementation</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>Step 1 New Client New ITA</label>
        <name>Step_1_New_Client_New_ITA</name>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>NSP_HR_Quality_Assurance_Team</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <criteriaItems>
                <field>NSP_Accrual_Profile__c.NSP_NewExisting_Client_or_Change_order__c</field>
                <operation>equals</operation>
                <value>Existing Client/New ITA Implementation</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>Step 2 Existing Client New ITA</label>
        <name>Step_2_Existing_Client_New_ITA</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Change_Status_to_HR_Approved</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>NSP_HR_Quality_Assurance_Team</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <criteriaItems>
                <field>NSP_Accrual_Profile__c.NSP_NewExisting_Client_or_Change_order__c</field>
                <operation>equals</operation>
                <value>Existing Client/Change Orders (changes to current ITA plan)</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>ApproveRecord</ifCriteriaNotMet>
        <label>Step 3 Existing Client Change Order</label>
        <name>Step_3_Existing_Client_Change_Order</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>NSP_ITA_Accrual_Profile_Team</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <criteriaItems>
                <field>NSP_Accrual_Profile__c.NSP_NewExisting_Client_or_Change_order__c</field>
                <operation>equals</operation>
                <value>Existing Client/Change Orders (changes to current ITA plan)</value>
            </criteriaItems>
        </entryCriteria>
        <label>Step 4 Existing Client Change Order</label>
        <name>Step_4_Existing_Client_Change_Order</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>NSP_Accrual_Profile__c.Is_Client_MM_or_MM_Enterprise__c</field>
            <operation>equals</operation>
            <value>N/A</value>
        </criteriaItems>
        <criteriaItems>
            <field>NSP_Accrual_Profile__c.RecordType</field>
            <operation>equals</operation>
            <value>ITA</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Change_Status_to_AP_Approved</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>NSP_Approval_Process_Approval</name>
            <type>Alert</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>true</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Change_Status_to_Rejected</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>NSP_ITA_Accrual_Profile_Final_Rejection_Alert</name>
            <type>Alert</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Change_Status_to_Submitted</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>NSP_Updating_Submitter_Field</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>ITA Non MM Client Approval</label>
    <processOrder>1</processOrder>
    <recallActions>
        <action>
            <name>Change_Status_to_Draft</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
