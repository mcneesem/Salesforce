<aura:component implements="lightning:recordHomeTemplate" description="Weighted Three Column Page Template">
    <aura:attribute name="left" type="Aura.Component[]" />
    <aura:attribute name="center" type="Aura.Component[]" />
    <aura:attribute name="right" type="Aura.Component[]" />
    <aura:attribute name="recordId" type="String" />
    
    <html>
        <head>
            <meta charset="utf-8" />
            <meta http-equiv="x-ua-compatible" content="ie=edge" />
            <title>Service Transformation</title>
            <meta name="description" content="" />
            <meta name="viewport" content="width=device-width, initial-scale=1.0" />
            
            <ltng:require styles="{!join(',',  
                                  $Resource.NSP_Cust360 + '/Resources/custom/css/left.css', 
                                  $Resource.NSP_Cust360 + '/Resources/custom/css/case360.css', 
                                  $Resource.NSP_Cust360 + '/Resources/custom/css/right.css')
                                  }" />
        </head>
        <body>
            <div class="slds">
		        <div class="slds-grid st-case__container">
		            <div class="slds-col st-left-case">
		            	<div class="st-left_container slds-p-around_medium">
		              		{!v.left}
		               </div>
		            </div>
		            <div class="slds-col st-middle-case">
		               {!v.center}
		            </div>
		            <div class="slds-col st-right-case">
		                <div class="st-left_container slds-p-around_medium">
		            		{!v.right}
		                </div>
		            </div>
		         </div>
		      </div>
        </body>
    </html>
</aura:component>