<design:component label="Weighted Three Column Page Template">
    <flexipage:template >
            <flexipage:region name="left" defaultWidth="MEDIUM" >
                <flexipage:formfactor type="MEDIUM" width="SMALL" />
            </flexipage:region>
            <flexipage:region name="center" defaultWidth="SMALL" />
            <flexipage:region name="right" defaultWidth="SMALL" />
       </flexipage:template>
</design:component>