<!--
****************************************************************************************************
Component Name     :  NSP_OrderManagement
Related Component    :  NSP_ContractDataTable
Version              :  1.0
Created Date         :  July 30,2021
Function             :  This component is called from the 'Manage Order' button
****************************************************************************************************
* Developer                   Date                   Description
****************************************************************************************************
* Utpal Utkalit             July 30,2021
****************************************************************************************************
 -->
 <aura:component controller="NSP_OrderManagement" implements="lightning:isUrlAddressable,force:lightningQuickActionWithoutHeader,flexipage:availableForRecordHome,force:hasRecordId,force:appHostable">
    <!--Attrinutes used in the Component -->
    <lightning:notificationsLibrary aura:id="notifLib"/>
    <aura:attribute name="selectedContractId" type="Id" />
    <aura:attribute name="recordId" type="Id" />
    <aura:attribute name="optionSelected" type="string" />
    <aura:attribute name="accName" type="string"/>
    <aura:attribute name="section" type="string" default="MSAContract"/>
    <aura:attribute name="value" type="String"/>
    <aura:attribute name="isDisable" type="Boolean" default="true"/>
    <aura:attribute name="selectedRow" type="Object"/>
    <aura:attribute name="contRec" Type="sObject"  default="{ 'sobjectType': 'Contract',
                     'SBQQ__RenewalOpportunity__c': ' ',
                      'SBQQ__RenewalOpportunity__r.Name': ' ',
                   }"/>
    <aura:attribute name="options" type="List" default="[]"/>

    <aura:attribute name="spinner" type="Boolean" default="false" />
    <aura:attribute name ="displaystring" type='string' default="" />
    <aura:attribute name ="displayhelp" type='boolean' default="false" />
    <aura:attribute name="terminationDate" type="Date" default="false" />
    <aura:attribute name="hasTerminationPermission" type="Boolean" default="false"/>
    <aura:attribute name="bypassTerminationDateValidation" type="Boolean" default="false"/>
    <aura:attribute name="showMessageModal" type="Boolean" default="false"/>
    <aura:if isTrue="{!v.spinner }">
            <lightning:spinner alternativeText="Loading" />
    </aura:if>

    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>

    <!--Custom Styles for Modal Header and Footer-->
    <aura:html tag="style">
        .cuf-content {
        padding: 0 0rem !important;
        }
        .slds-p-around--medium {
        padding: 0rem !important;
        }
        .slds-modal__content{
        overflow-y:hidden !important;
        height:unset !important;
        max-height:unset !important;
        }
    </aura:html>
    <ltng:require styles="{!$Resource.BillingCustomStyles}" />
    <!--Condition to show the section when section is set to option(default)-->
    <aura:if isTrue="{!(v.section=='Option')}">
        <!--Modal Header-->
        <div class="modal-header slds-modal__header slds-size_1-of-1">
            <h4 class="title slds-text-heading_medium">Manage Order</h4>
        </div>
        <!--End Modal Header-->

        <!--Modal Body-->

        <div class="slds-modal__content slds-p-around_x-small slds-size_1-of-1 slds-is-relative slds-p-bottom_xx-large">
            <aura:if isTrue="{!v.displayhelp}">
                <div class="slds-form-element__icon">
                    <div class="slds-popover slds-popover_tooltip slds-nubbin_bottom-left" role="tooltip" id="help" >
                        <div class="slds-popover__body">{!v.displaystring}</div>
                    </div>
                </div>
            </aura:if>
        </div>
        <div class="slds-modal__content slds-p-around_x-small slds-size_1-of-1 slds-is-relative slds-p-bottom_xx-large">
            <form class="slds-form_stacked slds-p-left_small">
                <lightning:radioGroup
                                      aura:id="mygroup"
                                      label="Please select an option"
                                      options="{! v.options }"
                                      value="{! v.value }"
                                      onchange="{! c.handleSelection}" />
            </form>
            <!-- Add a new input field for termination date -->
            <aura:if isTrue="{!(v.optionSelected == 'Termination' &amp;&amp; v.hasTerminationPermission)}">
                <lightning:input type="date" label="Termination Date" value="{!v.terminationDate}" maxlength="10" aura:id="terminationDate" class="slds-m-top_medium slds-size_1-of-2" required="{!v.optionSelected == 'Termination'}"/>
            </aura:if>
            <div class="slds-p-bottom_xx-large"/>
            <div class="slds-p-bottom_xx-large"/>
            <div class="slds-p-bottom_xx-large"/>
        </div>
        <!--End of Modal Body-->
    </aura:if>

    <!--Condition to show the section when section is set to MSA Contract-->
    <aura:if isTrue="{!(v.section=='MSAContract')}">
         <!--Modal Header-->
        <div class="modal-header slds-modal__header slds-size_1-of-1">
            <lightning:card variant="Narrow" title="{!v.accName}" iconName="standard:account"/>
        </div>
        <!--End Modal Header-->
        <div class="slds-p-left_medium slds-p-right_medium">
           <c:NSP_ContractDataTable accID="{!v.recordId}" selectedRow="{!v.selectedRow}"/>
        </div>
        <div class="slds-p-bottom_xx-large"/>
        <div class="slds-p-bottom_xx-large"/>
        <div class="slds-p-bottom_xx-large"/>
    </aura:if>

    <aura:if isTrue="{!(v.showMessageModal &amp;&amp; v.hasTerminationPermission)}">
        <div class="modal-header slds-modal__header slds-size_1-of-1">
            <h4 class="title slds-text-heading_medium">Message</h4>
        </div>
        <div class="slds-modal__content slds-p-around_x-small slds-size_1-of-1 slds-is-relative slds-p-bottom_xx-large">
                <div class="slds-modal__content slds-p-around_medium">
                    <p>Your termination request for {!v.terminationDate} has been submitted successfully. The process may take a couple of minutes to complete.</p>
                </div>
        </div>
    </aura:if>


    <!--Modal Footer-->
    <div class="modal-footer slds-modal__footer slds-size_1-of-1">
        <aura:if isTrue="{!!(v.showMessageModal &amp;&amp; v.hasTerminationPermission)}">
        <lightning:button variant="Neutral" class="slds-button" label="Cancel" onclick="{!c.handleCancel}"/>
        </aura:if>
        <aura:if isTrue="{!(v.section=='MSAContract')}">
            <lightning:button variant="Brand" class="slds-button" label="Next" onclick="{!c.handleContractSelect}" />
        </aura:if>
        <aura:if isTrue="{!(v.section=='Option')}">
            <lightning:button variant="Brand" class="slds-button" label="Select" onclick="{!c.handleTransactionTypeSelection}"/>
        </aura:if>
        <aura:if isTrue="{!(v.showMessageModal &amp;&amp; v.hasTerminationPermission)}">
            <lightning:button variant="Brand" class="slds-button" label="Close" onclick="{!c.closeMessageModal}"/>
        </aura:if>
    </div>
    <!--End of Modal Footer-->


</aura:component>