<!-- 
 * Name: NSP_DependentPicklistCmp.cmp
 * Purpose: Redirect to the record (open record in new tab)
-->
<aura:component implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickAction"
                access="global" controller="NSP_AddressUtility">
	<aura:method name="fetchDependentValues" action="{!c.fetchdependentValues}">
    	<aura:attribute name="callback" type="function"/>
    </aura:method>
    <aura:attribute name="sObject" type="String" default="Contact"/>
    <aura:attribute name="controllingFieldName" type="String" default="MailingCountryCode"/>
    <aura:attribute name="dependentFieldName" type="String" default="MailingStateCode"/>
     <!-- Below three lines shows error message on Component if expection occurs -->
    <aura:attribute name="toogleErrorMessage" type="Boolean" default="False"/>
    
    <aura:if isTrue="{!v.toogleErrorMessage}">
       <!-- <c:SME_LightningErrorCmp/> -->
    </aura:if>
    
</aura:component>