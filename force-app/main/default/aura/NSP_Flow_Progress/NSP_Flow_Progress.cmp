<!--
 * Name: NSP_Flow_Progress
 * Purpose: This component will be used to display the status on all flows, due to Spring'18 enabled capablity
 * Author: Ryan Del Mauro
 * Create Date: 2018-01-08
 * Modify History:
 * 2018-01-08    Ryan Del Mauro
-->

<aura:component implements="lightning:availableForFlowScreens">
   <aura:attribute name="stages" type="String[]"/>
   <aura:attribute name="currentStage" type="String"/>
   <aura:handler name="init" value="{!this}" action="{!c.init}"/>
   <lightning:progressIndicator aura:id="progressIndicator" currentStep="{!v.currentStage}" type="path"/>
</aura:component>