<aura:component extends="forceCommunity:navigationMenuBase">
    <nav class="slds-grid slds-grid_vertical slds-navigation-list_vertical">
    <div class="nsp-nav-container">
        <ul onclick="{!c.onClick}" class="nsp-standard-list toggle-nav-list">
           <li class="active">
               <a class="tier-one" href="https://portal.insperity.com/cs/nsp/index" style="cursor: pointer;">
               <lightning:icon iconName="utility:open_folder" size="x-small" alternativeText="open_folder" title="open_folder" /> My Account</a>
            <ul class="nsp-standard-list sub-navfix">
                <aura:iteration items="{!v.menuItems}" var="item">
               <li class="{!item.active ? 'active' : ''}">
                   <a href="javascript:void(0);" data-menu-item-id="{!item.id}" class="tier-one-item">
                       {!item.label}
                   </a>
               </li>
           </aura:iteration>
            </ul>
        </li>
       </ul>
        </div>
    </nav>
   
</aura:component>