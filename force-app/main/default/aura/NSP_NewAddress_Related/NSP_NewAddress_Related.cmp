<!-- **************************************************************************************************   
Component Name :  NSP_NewAddress_Related.Cmp
Version              :  1.0                                                                          
Created Date         :  March 20, 2022                                                            
Function             :  This component is cloned from NSP_NewAddress.cmp and used used to create New address
           : 	when the user clicks on New Button in Account, Contact, Asset relatedlist page.
Story                :  DF-01393                                                                           
Modification Log     :                                                                               
***************************************************************************************************
-->
<aura:component implements="lightning:actionOverride,force:lightningQuickActionWithoutHeader,flexipage:availableForRecordHome,force:hasRecordId,lightning:isUrlAddressable,lightning:hasPageReference" controller="NSP_AddressCtrl" access="global">
    <aura:attribute name="addressRecord" type="NSP_Address__c" default="{sobjectType: 'NSP_Address__c'}" 
                    description = "This attribute will hold new address record.  "/>
    <aura:attribute name="recordId" type="String" />
    <aura:attribute name="recordTypeId" type="String" />
    <aura:attribute name="toggleModal" type="boolean" default="true"/>
    <aura:attribute name="stateOptions" type="List" access="private"/>
    <aura:handler name="init" value="this" action ="{!c.doInit}"/>
    
    <c:NSP_DependentPicklistCmp aura:id="dependentPicklist" />
    <aura:attribute type="map" name="countryStateMap" description ="Map for holding State and country picklist."/>
    <aura:attribute name="toogleErrorMessage" type="Boolean" default="False"/>
    <!-- DF-01313 Showing error message when Non Integration users creates a Addrress record from "New Addrress" Button-->
    <aura:attribute name = "responseObject" type = "Object" />
    <!-- DF-01313 -->
    
    <!-- As part of DF-01393, added the below attributes -->
    <aura:attribute name="isAccountObject" type="boolean" default="false"/>
    <aura:attribute name="isAssetObject" type="boolean" default="false"/>
    <aura:attribute name="isContactObject" type="boolean" default="false"/>
    <aura:attribute name="relatedListLabel" type="String" default="Address__r"/>
    <aura:attribute name="isModalOpen" type="boolean" default="false"/>
    <!-- DF-01393 -->
    
    <!-- Added Modal box so that the user will not be allowed to click on any other tab when he is on Address page -->
    <aura:if isTrue="{!v.isModalOpen}">
        <section role="dialog" tabindex="-1" aria-labelledby="modal-heading-01" aria-modal="true" aria-describedby="modal-content-id-1" class="slds-modal slds-fade-in-open">
            <div class="slds-modal__container">
                <div class="slds-modal__content slds-p-around_medium" id="modal-content-id-1">
                    <aura:if isTrue="{!v.toogleErrorMessage}">
                    </aura:if>
                    <aura:if isTrue="{!v.toggleModal}">
                        <div class="slds-modal__header">               
                            <h2 class="slds-text-heading_medium">New Address</h2>
                        </div>
                        <lightning:card title = "">
                            <div class="slds-m-around_medium">
                                <lightning:recordEditForm  objectApiName="NSP_Address__c">
                                    <div class="slds-modal__content slds-p-around_medium slds-grid slds-wrap ">
                                        <div class="demo-only" >
                                            <div class="slds-form slds-form_compound">
                                                <fieldset class="slds-form-element">
                                                    <h3 class="slds-form-element__label slds-text-title_caps slds-section__title slds-theme_shade primaryPaletteBorder test-id__section-header-container ">Information</h3>
                                                    <div class="slds-form-element__group">
                                                        <lightning:messages aura:id="errorMessage" />
                                                        <div class="slds-form-element__row">
                                                            <div class="slds-form-element slds-size_1-of-2">
                                                                <lightning:input label="Address Name" type="text" aura:id="addressName" fieldName="Name" value="{!v.addressRecord.Name}" required="true" messageWhenValueMissing="Please add address Name"/>
                                                            </div>
                                                            <div class="slds-form-element slds-size_1-of-2">
                                                                <lightning:inputfield label="Address Type" aura:id="addressType" fieldName="NSP_Address_Type__c"  value="{!v.addressRecord.NSP_Address_Type__c}" required="true" messageWhenValueMissing="Please select address Type"/>
                                                            </div>
                                                            <div class="slds-form-element slds-size_1-of-2">
                                                                <div class="slds-hidden"><lightning:inputField aura:id="relatedAccount" fieldName="NSP_Related_Site__c"  value="{!v.addressRecord.NSP_Related_Site__c}" required="true" /></div>
                                                            </div>
                                                        </div>
                                                        <div class="slds-form-element__row">
                                                            <div class="slds-form-element slds-size_1-of-2">
                                                                <lightning:inputField aura:id="legalNumber" fieldName="NSP_Legal_Name__c"  value="{!v.addressRecord.NSP_Legal_Name__c}" />
                                                            </div>
                                                            <div class="slds-form-element slds-size_1-of-2">
                                                                <lightning:inputField aura:id="paymentTerms" fieldName="NSP_Payment_Terms__c"  value="{!v.addressRecord.NSP_Payment_Terms__c}" />
                                                            </div>
                                                        </div> 
                                                        <div class="slds-form-element__row">
                                                            <div class="slds-form-element slds-size_1-of-2">
                                                                <lightning:inputField aura:id="coName" fieldName="NSP_C_O_Name__c"  value="{!v.addressRecord.NSP_C_O_Name__c}"  />
                                                            </div>
                                                            <div class="slds-form-element slds-size_1-of-2">
                                                                <lightning:inputField aura:id="vatRegNum" fieldName="NSP_VAT_Registration_No__c"  value="{!v.addressRecord.NSP_VAT_Registration_No__c}" />
                                                            </div>
                                                        </div>
                                                    </div>
                                                </fieldset>
                                                <fieldset class="slds-form-element">
                                                    <h3 class="slds-form-element__label slds-text-title_caps slds-section__title slds-theme_shade primaryPaletteBorder test-id__section-header-container ">Address</h3>
                                                    <div class="slds-form-element__group">
                                                        <div class="slds-form-element__row">
                                                            <div class="slds-form-element slds-size_1-of-2">
                                                                <lightning:inputField aura:id="street" fieldName="NSP_Street__c"  value="{!v.addressRecord.NSP_Street__c}" />
                                                            </div>
                                                            <div class="slds-form-element slds-size_1-of-2">
                                                                <lightning:inputField aura:id="city" fieldName="NSP_City__c" value="{!v.addressRecord.NSP_City__c}" /> 
                                                            </div>
                                                        </div>
                                                        <div class="slds-form-element__row">
                                                            <div class="slds-form-element slds-size_1-of-2">
                                                                <lightning:inputfield aura:id="country" label ="Country" fieldName="NSP_Country__c" onchange="{!c.getStateValues}" value="{!v.addressRecord.NSP_Country__c}" required="true"  messageWhenValueMissing="Please select a country"/>
                                                            </div>
                                                            <div class="slds-form-element slds-size_1-of-2">
                                                                <lightning:select aura:id="states" name="state"  label="State" value="{!v.addressRecord.NSP_State__c}" required="true" messageWhenValueMissing="Please select a state">
                                                                    <aura:iteration items="{!v.stateOptions}" var="option">
                                                                        <option text="{!option.label}" value="{!option.id}" selected="{!option.selected}"/>
                                                                    </aura:iteration>
                                                                </lightning:select>
                                                            </div>
                                                        </div>
                                                        <div class="slds-form-element__row">
                                                            <div class="slds-form-element slds-size_1-of-2">
                                                                <lightning:inputfield  label="Postal Code" aura:id="postalCode" fieldName="NSP_Postal_Code__c" value="{!v.addressRecord.NSP_Postal_Code__c}" required="true"  messageWhenValueMissing="Please add postal code"/>
                                                            </div>
                                                        </div>
                                                        
                                                    </div>
                                                </fieldset>
                                            </div>
                                        </div>   
                                    </div>
                                </lightning:recordEditForm>
                            </div>
                            <div class="slds-align_absolute-center">                
                                <lightning:button variant="neutral" label="Cancel" onclick="{!c.gotoURL}"/>
                                <lightning:button variant="brand" label="Submit" onclick="{!c.saveRecord}" />
                            </div>
                        </lightning:card>
                    </aura:if>
                </div>
            </div>
        </section>
        <div class="slds-backdrop slds-backdrop_open"></div>
    </aura:if>
</aura:component>