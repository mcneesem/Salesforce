<aura:component implements="forceCommunity:themeLayout" access="global">
    <aura:attribute name="search" type="Aura.Component[]" required="false"/>
    <aura:attribute name="profileMenu" type="Aura.Component[]" required="false"/>
    <div class="slds-grid slds-wrap">
         <div class="slds-size_12-of-12">
                 <div class="nsp-main-header">
                      <div class="logoContainer"></div>
                 
                     <c:searchInterface></c:searchInterface>
                     
                      <div class="profileMenuRegion">
                        <!-- User Profile Menu component -->
                        {!v.profileMenu}
                    </div>
             </div>
        </div>
    </div>
    <div class="slds-grid slds-wrap">
        <div class="slds-col nsp-main-side-nav ">
            <div class="slds-grid slds-grid--vertical">
               
                <div class="slds-col mt-75">
                 <c:verticalNav></c:verticalNav>
                </div>
                
            </div>
        </div>
        <div class="slds-col main content">
            {!v.body}
        </div>
    </div>
</aura:component>