<!-- **************************************************************************************************   
Component Name :  NSP_EditAddressCmp
Version              :  1.0                                                                          
Created Date         :  October 10, 2021                                                             
Function             :  This component is used as for Edit address
Story                :                                                                             
Modification Log     :                                                                               
*	Tejas           October 10, 2021          First Iteration
*
*
*
*
*
***************************************************************************************************
-->
<aura:component implements="lightning:actionOverride,force:lightningQuickActionWithoutHeader,flexipage:availableForRecordHome,force:hasRecordId" controller="NSP_AddressCtrl" access="global" >
    <aura:attribute name="addressRecord" type="NSP_Address__c" default="{sobjectType: 'NSP_Address__c'}" description="
                                                                                                                      This attribute will contain the current address."/>
    <aura:attribute name="recordId" type="String"/>
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    
    <!-- Below three lines shows error message on Component if expection occurs -->
    <aura:attribute name="toogleErrorMessage" type="Boolean" default="False"/>
    <aura:if isTrue="{!v.toogleErrorMessage}">
        <!--<c:SME_LightningErrorCmp/> -->
    </aura:if>
    
    <c:NSP_DependentPicklistCmp aura:id="dependentPicklist" />
    
    <aura:attribute type="map" name="countryStateMap" />
    <aura:attribute type="Boolean" name="showAccountLookUp" default="true" />
    <div aura:id="editDialog" role="dialog" tabindex="-1" aria-labelledby="header43" class="slds-modal slds-fade-in-open slds-p-top_large">
        <div class="slds-modal__header">
            <h2 class="slds-text-heading_medium"> Edit Address </h2>
        </div>
        <div class="slds-modal__content slds-p-around_medium slds-grid slds-wrap ">
            <div class="demo-only" >
                <div class="slds-form slds-form_compound">
                    <!--<lightning:spinner alternativeText="Loading" size="medium" aura:id="mySpinner" class="slds-hide"/>-->
                    
                    <lightning:recordEditForm aura:id="recordEditForm" objectApiName="NSP_Address__c" recordTypeId="{!v.recordTypeId}"  recordId="{!v.recordId}" onload="{!c.setStateValue}">
                        <fieldset class="slds-form-element">
                            <h3 class="slds-form-element__label slds-text-title_caps slds-section__title slds-theme_shade primaryPaletteBorder test-id__section-header-container ">Information</h3>
                            <div class="slds-form-element__group">
                                <div class="slds-form-element__row">
                                    <div class="slds-form-element slds-size_1-of-2">
                                        <!--lightning:inputField fieldName="SME_Address_Type__c" aura:id="addressType" /-->
                                        <!--<lightning:select name="addressType" aura:id="addressType" label="Address Type">
                                            <option value="">None</option>
                                            <option value="Bill To">Bill To</option>
                                            <option value="Ship To">Ship To</option>
                                        </lightning:select>-->
                                        <div class="slds-form-element slds-size_1-of-2">
                                            <lightning:inputField aura:id="addressType" fieldName="NSP_Address_Type__c"  value="{!v.addressRecord.NSP_Address_Type__c}" required="true" />
                                        </div>
                                    </div>
                                    <div class="slds-form-element slds-size_1-of-2">
                                        <div class="slds-hidden"><lightning:inputField aura:id="relatedSite" fieldName="NSP_Related_Site__c"  value="{!v.addressRecord.NSP_Related_Site__c}" required="true" /></div>
                                    </div>
                                    
                                </div>
                                <div class="slds-form-element__row">
                                    <div class="slds-form-element slds-size_1-of-2">
                                        <lightning:inputField aura:id="legalNumber" fieldName="NSP_Legal_Name__c"  value="{!v.addressRecord.NSP_Legal_Name__c}" />
                                    </div>
                                    
                                    <div class="slds-form-element slds-size_1-of-2">
                                        <lightning:inputField aura:id="paymentTerms" fieldName="NSP_Payment_Terms__c"  value="{!v.addressRecord.NSP_Payment_Terms__c}" />
                                    </div>
                                </div>
                                <div class="slds-form-element__row">
                                    <div class="slds-form-element slds-size_1-of-2">
                                        <lightning:inputField aura:id="coName" fieldName="NSP_C_O_Name__c"  value="{!v.addressRecord.NSP_C_O_Name__c}"  />
                                    </div>
                                    
                                    <div class="slds-form-element slds-size_1-of-2">
                                        <lightning:inputField aura:id="vatRegNum" fieldName="NSP_VAT_Registration_No__c"  value="{!v.addressRecord.NSP_VAT_Registration_No__c}" />
                                    </div>
                                </div>
                            </div>
                        </fieldset>
                        <fieldset class="slds-form-element demo-only">
                            <h3 class="slds-form-element__label slds-text-title_caps slds-section__title slds-theme_shade primaryPaletteBorder test-id__section-header-container ">Address</h3>
                            
                            <div class="slds-form-element__group">
                                <div class="slds-form-element__row">
                                    <div class="slds-form-element slds-size_1-of-2">
                                        <lightning:inputField aura:id="street" fieldName="NSP_Street__c"  value="{!v.addressRecord.NSP_Street__c}" />
                                    </div>
                                    <div class="slds-form-element slds-size_1-of-2">
                                        <lightning:inputField aura:id="city" fieldName="NSP_City__c" value="{!v.addressRecord.NSP_City__c}" /> 
                                    </div>
                                </div>
                                
                                <div class="slds-form-element__row">
                                    <div class="slds-form-element slds-size_1-of-2">
                                        <!--<lightning:inputField fieldName="SME_Country__c" onchange="{!c.getStateValues}"  aura:id="country"/>-->
                                        
                                        <lightning:inputField aura:id="country" fieldName="NSP_Country__c" onchange="{!c.getStateValues}" value="{!v.addressRecord.NSP_Country__c}" />
                                        
                                        <lightning:inputField fieldName="NSP_State__c" class="slds-hide" aura:id="stateHidden"/>
                                    </div>
                                    <div class="slds-form-element slds-size_1-of-2">                                                        
                                        <label class="slds-form-element__label" for="state">State</label>
                                        <ui:inputSelect  class="slds-input" aura:id="state" disabled="{!if(v.addressRecord.NSP_Country__c == '',true,false)}" value="{!v.addressRecord.NSP_State__c}" />
                                    </div>
                                </div>
                                <div class="slds-form-element__row">
                                    <div class="slds-form-element slds-size_1-of-2">
                                        <lightning:inputField aura:id="postalCode" fieldName="NSP_Postal_Code__c" value="{!v.addressRecord.NSP_Postal_Code__c}"  />
                                    </div>
                                </div>
                            </div>
                        </fieldset>                        
                    </lightning:recordEditForm>                     
                </div>
            </div>
        </div>
        <div class="slds-modal__footer">                
            <lightning:button variant="neutral" label="Cancel" onclick="{!c.navigateToDetail}" />
            <lightning:button variant="brand" label="Save" onclick="{!c.saveRecord}" />
        </div>
    </div>
</aura:component>