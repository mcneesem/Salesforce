<apex:page controller="NSP_PrepSandbox">
 <apex:form >
    <apex:commandButton style="font-size:12px" value="Post-Refresh Steps" action="{!runManualStepsButton}" rerender="result" status="Status1" oncomplete="callMethod2();"/>
    <apex:actionFunction name="callMethod2" action="{!doUserImportPage}" rerender="result" status="Status2"/>
    <apex:outputPanel id="postRefreshAlreadyRun" style="font-size:14px;color:black" rendered="{!$Setup.OrgSettings__c.PostRefreshRun__c}"><i>&nbsp;&nbsp;Post-refresh steps have been run.</i></apex:outputPanel>
    <br/>
    <apex:commandButton style="font-size:12px" value="Post-Import Steps" action="{!runManualStepsButton2}" rerender="result" status="Status1"/>
    <apex:outputPanel id="postRefreshAlreadyRun2" style="font-size:14px;color:black" rendered="{!$Setup.OrgSettings__c.PostRefreshRun2__c}"><i>&nbsp;&nbsp;Post-import steps have been run.</i></apex:outputPanel>
    <br/><br/>
    <apex:outputPanel id="result" style="font-size:14px">&nbsp;&nbsp;
        <apex:actionStatus id="Status1" startText="...updating Metadata..." />
        <apex:actionStatus id="Status2" startText="...importing Users..." />
        {!runManualResult}
    </apex:outputPanel>
 </apex:form>
</apex:page>