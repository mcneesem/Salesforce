<apex:page controller="NSP_PrepSandbox">
 <apex:form >
    <apex:outputPanel id="verifyUsersMsg" style="font-size:14px;color:red">&nbsp;Please verify PreProd_Users static resource before running!</apex:outputPanel>
    <br/><br/>
    <apex:commandButton style="font-size:16px" value="Run Post-Refresh Steps" action="{!runManualStepsButton}" rerender="result" status="Status1" oncomplete="callMethod2();"/>
    <apex:actionFunction name="callMethod2" action="{!doUserImportPage}" rerender="result" status="Status2"/>
    <apex:outputPanel id="postRefreshAlreadyRun" style="font-size:14px;color:black" rendered="{!$Setup.OrgSettings__c.PostRefreshRun__c}"><i>&nbsp;&nbsp;Steps have been run since last org refresh.</i></apex:outputPanel>
    <br/><br/>
    <apex:outputPanel id="result" style="font-size:14px">&nbsp;&nbsp;
        <apex:actionStatus id="Status1" startText="...updating Metadata..." />
        <apex:actionStatus id="Status2" startText="...importing Users..." />
        {!runManualResult}
    </apex:outputPanel>
 </apex:form>
</apex:page>