<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <alerts>
        <fullName>NSP_Notify_When_Demo_Event_Assignment_Exceeds_SLA</fullName>
        <description>Notify When Demo Event Assignment Exceeds SLA</description>
        <protected>false</protected>
        <recipients>
            <field>NSP_WO_WX_Email__c</field>
            <type>email</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>NSP_Sales/NSP_Demo_assignment_has_exceeded_SLA</template>
    </alerts>
    <alerts>
        <fullName>NSP_Send_email_when_Demo_Event_is_created_for_WO_WX_opportunities</fullName>
        <description>Send email when Demo Event is created for WO/WX opportunities</description>
        <protected>false</protected>
        <recipients>
            <field>NSP_WO_WX_Email__c</field>
            <type>email</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>NSP_Sales/NSP_Demo_Request_Submitted</template>
    </alerts>
    <rules>
        <fullName>NSP Demo Event Activity assignment has exceeded SLA</fullName>
        <active>true</active>
        <description>When Activity(Event) of Type demo is been created for an Opportunity and Assigned Sales Engineer field is blank even after 24hrs of creating the Activity then send email</description>
        <formula>AND( NSP_Opportunity__c   &lt;&gt; &apos;&apos;,  ISPICKVAL( NSP_Activity_type__c , &apos;Demo&apos;),  NSP_Assigned_Sales_Engineer__c = &apos;&apos;, OR( NSP_Opportunity_Product_Type__c =&apos;WO&apos;, NSP_Opportunity_Product_Type__c =&apos;WX&apos;) )</formula>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
        <workflowTimeTriggers>
            <actions>
                <name>NSP_Notify_When_Demo_Event_Assignment_Exceeds_SLA</name>
                <type>Alert</type>
            </actions>
            <offsetFromField>Event.CreatedDate</offsetFromField>
            <timeLength>24</timeLength>
            <workflowTimeTriggerUnit>Hours</workflowTimeTriggerUnit>
        </workflowTimeTriggers>
    </rules>
</Workflow>
