    <rules>
        <fullName>Demo Activity on Opportunity at Analysis stage</fullName>
        <active>false</active>
        <description>.....</description>
        <formula>ISPICKVAL(StageName  , &apos;Analysis&apos;) &amp;&amp;  NOT(NSP_Has_Demo_Activity__c )</formula>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
        <workflowTimeTriggers>
            <actions>
                <name>NSP_Schedule_Demo_For_Opportunity_At_Analysis_Stage</name>
                <type>Alert</type>
            </actions>
            <timeLength>7</timeLength>
            <workflowTimeTriggerUnit>Days</workflowTimeTriggerUnit>
        </workflowTimeTriggers>
        <workflowTimeTriggers>
            <timeLength>1</timeLength>
            <workflowTimeTriggerUnit>Hours</workflowTimeTriggerUnit>
        </workflowTimeTriggers>
    </rules>
    <rules>
        <fullName>NSP Lock Opportunity for Edits</fullName>
        <actions>
            <name>Check_Lock_Opportunity_Checkbox</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <description>Opportunity record is locked once the status is changed to Closed Won</description>
        <formula>OR(AND(ISNEW(),ISPICKVAL(StageName , &quot;Closed Won&quot;)), AND( ISPICKVAL(StageName , &quot;Closed Won&quot;), ISCHANGED(StageName)) )</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>NSP Unlock Opportunity For Edit</fullName>
        <actions>
            <name>NSP_Uncheck_Lock_Opportunity_Checkbox</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Opportunity.StageName</field>
            <operation>notEqual</operation>
            <value>Closed Won</value>
        </criteriaItems>
        <description>Unlock the Opportunity when the Stage is NOT EQUAL to Closed Won</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
</Workflow>
