    <decisions>
        <name>Check_Autolaunched_Flow_Bypass</name>
        <label>Check Autolaunched Flow Bypass</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Is_the_Discovery_Call_related_to_a_Lead</targetReference>
