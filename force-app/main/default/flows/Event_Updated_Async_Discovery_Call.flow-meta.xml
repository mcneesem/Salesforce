    <decisions>
        <name>Is_Discovery_Call_Completed</name>
        <label>Is Discovery Call Completed?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Opportunity_Info_for_non_completed_Discovery_Call</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Event Status is not &apos;Completed&apos;</defaultConnectorLabel>
        <rules>
            <name>Is_Event_Screen_Discovery_Call_Completed_ON</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.NSP_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Completed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Setup.OpportunityStageSettings__c.Is_Enabled_DiscoveryCallCompletedScreen__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Is Event - Screen - Discovery Call Completed ON?</label>
        </rules>
        <rules>
            <name>Yes_Discovery_Call_Completed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.NSP_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Completed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Setup.OpportunityStageSettings__c.Is_Enabled_DiscoveryCallCompletedScreen__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Opportunity_Info_for_Discovery_Call_Completed</targetReference>
            </connector>
            <label>Yes - Discovery Call Completed</label>
        </rules>
    </decisions>
