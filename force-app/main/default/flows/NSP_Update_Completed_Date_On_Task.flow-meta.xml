<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>54.0</apiVersion>
    <decisions>
        <description>Checks whether status is completed or not.</description>
        <name>Is_Completed</name>
        <label>Is Completed?</label>
        <locationX>522</locationX>
        <locationY>594</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>isStatusCompleted</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Completed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Eloqua_Task_RT</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Complete_Date</targetReference>
            </connector>
            <label>isStatusCompleted</label>
        </rules>
        <rules>
            <name>isStatusOpen</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Open</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Eloqua_Task_RT</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Completed_Date_to_Null</targetReference>
            </connector>
            <label>isStatusOpen</label>
        </rules>
        <rules>
            <name>ifEloquaRecord</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CreatedBy.FirstName</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Eloqua</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CreatedBy.Profile.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Integration User</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Eloqua_Record_Type</targetReference>
            </connector>
            <label>ifEloquaRecord</label>
        </rules>
    </decisions>
    <description>This flow describes about the updation of Completed Date on Task based on Status.</description>
    <formulas>
        <description>This Formula is used to store today&apos;s date.</description>
        <name>TodayDate</name>
        <dataType>Date</dataType>
        <expression>Today()</expression>
    </formulas>
    <interviewLabel>Update Completed Date On Task {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Update Completed Date On Task</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Get the record type id for the task Eloqua Recordtype</description>
        <name>Get_Eloqua_Task_Id</name>
        <label>Get Eloqua Task RecordId</label>
        <locationX>518</locationX>
        <locationY>347</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_Completed</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SobjectType</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Task</stringValue>
            </value>
        </filters>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Eloqua_Task_RT</stringValue>
            </value>
        </filters>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>RecordType</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Completed Date is updated to Today based on Status.</description>
        <name>Update_Complete_Date</name>
        <label>Update Complete Date</label>
        <locationX>217</locationX>
        <locationY>662</locationY>
        <inputAssignments>
            <field>NSP_Completed_Date__c</field>
            <value>
                <elementReference>TodayDate</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <description>Completed Date is updated to Null If Status is Open.</description>
        <name>Update_Completed_Date_to_Null</name>
        <label>Update Completed Date to Null</label>
        <locationX>409</locationX>
        <locationY>675</locationY>
        <inputAssignments>
            <field>NSP_Completed_Date__c</field>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <description>This node is created to update the record type id for the Eloqua Tasks which are created by integration user for Eloqua</description>
        <name>Update_Eloqua_Record_Type</name>
        <label>Update Eloqua Record Type</label>
        <locationX>732</locationX>
        <locationY>675</locationY>
        <inputAssignments>
            <field>RecordTypeId</field>
            <value>
                <elementReference>Get_Eloqua_Task_Id.Id</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>458</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>Get_Eloqua_Task_Id</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </filters>
        <object>Task</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>idTaskEloquaRT</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
