<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>54.0</apiVersion>
    <assignments>
        <description>map the existing Account Status from Account to the variable so it doesn&apos;t get changed</description>
        <name>Set_varAccountStatus_to_current_Account_Status</name>
        <label>Set varAccountStatus to current Account Status</label>
        <locationX>66</locationX>
        <locationY>492</locationY>
        <assignmentItems>
            <assignToReference>varAccountStatus</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Account_Record.NSP_Sales_Service_Account_Status__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_related_account_record</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_varAccountStatus_to_Networking</name>
        <label>Set varAccountStatus to Networking</label>
        <locationX>594</locationX>
        <locationY>600</locationY>
        <assignmentItems>
            <assignToReference>varAccountStatus</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Networking</stringValue>
            </value>
        </assignmentItems>
        <connector>
