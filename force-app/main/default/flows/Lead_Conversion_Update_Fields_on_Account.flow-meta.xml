        </rules>
    </decisions>
    <description>Updated to include Account Status considerations. Use for mapping of custom field of lead to standard fields of account when Lead is converted. Updated to run asynchronously</description>
    <environments>Default</environments>
    <formulas>
        <description>80-character maximum SicDesc to prevent DmlExceptions.</description>
        <name>safeSicDesc</name>
        <dataType>String</dataType>
        <expression>IF(
  AND(
    NOT( ISBLANK( {!$Record.NSP_SicDesc__c} ) ) ,
    ( LEN( {!$Record.NSP_SicDesc__c} ) &gt; 80 )
  ) ,
  LEFT( {!$Record.NSP_SicDesc__c} , 80 ) ,
  {!$Record.NSP_SicDesc__c}
)</expression>
    </formulas>
