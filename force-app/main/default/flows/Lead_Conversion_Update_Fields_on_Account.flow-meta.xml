        </connector>
    </assignments>
    <assignments>
        <name>Set_varAccountStatus_to_Prospecting</name>
        <label>Set varAccountStatus to Prospecting</label>
        <locationX>330</locationX>
        <locationY>600</locationY>
        <assignmentItems>
            <assignToReference>varAccountStatus</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Prospecting</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_related_account_record</targetReference>
        </connector>
    </assignments>
    <constants>
        <name>flowName</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Lead Conversion - Update Fields on Account</stringValue>
        </value>
    </constants>
    <decisions>
        <description>If current Account Status (NSP_Sales_Service_Account_Status__c) is: Active, Onboarding, On Demand, Prospecting then don&apos;t update Account Status,

If current Account Status is: Blank, Terminated, or Lost, then update Account Status.

Further consideration in another node: if current Account Status is Networking, and Opportunity DOES exist on Lead Conversion then update to Prospecting</description>
        <name>Does_Account_have_an_Account_Status_that_should_be_updated</name>
        <label>Does Account have an Account Status that should be updated?</label>
        <locationX>550</locationX>
        <locationY>384</locationY>
        <defaultConnector>
            <targetReference>Update_related_account_record</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Applicable</defaultConnectorLabel>
        <rules>
            <name>No_Account_Status_should_NOT_be_updated</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account_Record.NSP_Sales_Service_Account_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Active</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Account_Record.NSP_Sales_Service_Account_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Onboarding</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Account_Record.NSP_Sales_Service_Account_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>On Demand</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Account_Record.NSP_Sales_Service_Account_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Prospecting</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_varAccountStatus_to_current_Account_Status</targetReference>
            </connector>
            <label>No - Account Status should NOT be updated</label>
        </rules>
        <rules>
            <name>Yes_Account_Status_SHOULD_be_updated</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account_Record.NSP_Sales_Service_Account_Status__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Account_Record.NSP_Sales_Service_Account_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Terminated</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Account_Record.NSP_Sales_Service_Account_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Lost</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Account_Record.NSP_Sales_Service_Account_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Networking</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Is_there_an_Opportunity_attached_to_this_Lead</targetReference>
            </connector>
            <label>Yes - Account Status SHOULD be updated</label>
        </rules>
    </decisions>
    <decisions>
        <description>If current Account Status is Networking, and Opportunity DOES exist on Lead Conversion then update to Prospecting</description>
        <name>Is_there_an_Opportunity_attached_to_this_Lead</name>
        <label>Is there an Opportunity attached to this Lead?</label>
        <locationX>594</locationX>
        <locationY>492</locationY>
        <defaultConnector>
            <targetReference>Update_related_account_record</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Applicable</defaultConnectorLabel>
        <rules>
            <name>Opportunity_DOES_exist</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ConvertedOpportunityId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_varAccountStatus_to_Prospecting</targetReference>
            </connector>
            <label>Opportunity DOES exist</label>
        </rules>
        <rules>
            <name>Opportunity_DOES_NOT_exist</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ConvertedOpportunityId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_varAccountStatus_to_Networking</targetReference>
            </connector>
            <label>Opportunity DOES NOT exist</label>
        </rules>
    </decisions>
