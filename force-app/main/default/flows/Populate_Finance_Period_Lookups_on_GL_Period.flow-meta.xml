    <recordLookups>
        <description>Get all the Finance Period Records where the Period End Date matches with Period End Date of GL Period</description>
        <name>Get_All_Finance_Period</name>
        <label>Get All Finance Period</label>
        <locationX>182</locationX>
        <locationY>395</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_If_Finance_Period_Records_Are_Returned</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>blng__PeriodEndDate__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Period_End_Date__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>blng__PeriodEndDate__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>blng__FinancePeriod__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>blng__PeriodType__c</queriedFields>
        <queriedFields>blng__LegalEntity__c</queriedFields>
        <queriedFields>blng__PeriodEndDate__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Reset_Financial_Periods</targetReference>
        </connector>
        <filterFormula>AND(
  NOT( ISBLANK( {!$Record.Period_End_Date__c} ) ) ,
  OR(
    ISNEW() ,
    ISCHANGED( {!$Record.Period_End_Date__c} )
  )
)</filterFormula>
        <object>GL_Period__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
