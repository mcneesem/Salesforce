    <description>This flow auto populates the finance periods on the GL period record upon termination date change</description>
    <environments>Default</environments>
    <interviewLabel>Populate Finance Period Lookups on GL Period {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Populate Finance Period Lookups on GL Period</label>
    <loops>
        <description>Iterate through all the Finance Period records returned on Get Finance Period</description>
        <name>Loop_Through_Each_Finance_Period</name>
        <label>Loop Through Each Finance Period</label>
        <locationX>50</locationX>
        <locationY>611</locationY>
        <collectionReference>Get_All_Finance_Period</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Check_Period_Type_And_Legal_Entity</targetReference>
        </nextValueConnector>
    </loops>
