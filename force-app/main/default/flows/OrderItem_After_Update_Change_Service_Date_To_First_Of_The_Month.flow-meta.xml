<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <description>This flow updates the Service date on Order Product to the first of the month for evergreen subscriptions</description>
    <environments>Default</environments>
    <formulas>
        <description>Gives 1st day of the month</description>
        <name>FirstDateOfTheMonth</name>
        <dataType>Date</dataType>
        <expression>DATE(YEAR(TODAY()),MONTH(TODAY()),1)</expression>
    </formulas>
    <interviewLabel>OrderItem After {!$Flow.CurrentDateTime}</interviewLabel>
    <label>OrderItem-After Update-Change Service Date To First Of The Month</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>Updates the dates on the Order Products</description>
        <name>Update_Order_Products</name>
        <label>Update Order Products</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <targetReference>FaultHanlder</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SBQQ__SubscriptionType__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Evergreen</stringValue>
            </value>
        </filters>
        <filters>
            <field>NSP_OrderProductStartDate__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>1st of the month</stringValue>
            </value>
        </filters>
        <filters>
            <field>ServiceDate</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>FirstDateOfTheMonth</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>ServiceDate</field>
            <value>
                <elementReference>FirstDateOfTheMonth</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record.OrderItems</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Order_Products</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Amendment</stringValue>
            </value>
        </filters>
        <filters>
            <field>NSP_Transaction_Type__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Termination</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Draft</stringValue>
            </value>
        </filters>
        <object>Order</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
    <subflows>
        <description>This element handles the exceptions during DML.</description>
        <name>FaultHanlder</name>
        <label>FaultHanlder</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>Insperity_Fault_Handler_Subflow</flowName>
        <inputAssignments>
            <name>faultElement</name>
            <value>
                <stringValue>Update_Order_Products</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>faultMessage</name>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>triggeringFlow</name>
            <value>
                <stringValue>OrderItem_After_Update_Change_Service_Date_To_First_Of_The_Month</stringValue>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
