    <recordLookups>
        <description>get all the invoices that are posted  but the invoice lines are still not posted using the list created earlier and the current invoice run</description>
        <name>get_invoices</name>
        <label>get invoices</label>
        <locationX>50</locationX>
        <locationY>650</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Count_Of_Faulty_Invoices</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Get_Invoices_Fault_element</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>blng__InvoiceRunCreatedBy__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>In</operator>
            <value>
                <elementReference>InvoiceIdList</elementReference>
            </value>
        </filters>
        <filters>
            <field>blng__InvoiceStatus__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Posted</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>blng__Invoice__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Get all invoice lines from the invoice run, that are not posted.</description>
        <name>get_unposted_Invoice_Lines</name>
        <label>get unposted Invoice Lines</label>
        <locationX>50</locationX>
        <locationY>242</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Add_Invoice_Ids</targetReference>
        </connector>
        <faultConnector>
            <targetReference>get_unposted_invoice_lines_fault_element</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>blng__InvoiceLineStatus__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Posted</stringValue>
            </value>
        </filters>
        <filters>
            <field>blng__InvoiceRun__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>blng__InvoiceLine__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>blng__Invoice__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
