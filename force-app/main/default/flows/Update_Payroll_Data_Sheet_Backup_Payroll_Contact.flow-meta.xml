    <decisions>
        <description>Verify Payroll Data Sheet Custom Settings enable for Workday</description>
        <name>Kill_Switch_Enable_For_Workday</name>
        <label>Kill Switch : Enable For Workday?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Enable_For_Workday</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Setup.Payroll_Data_Sheet_Settings__c.IsEnabledPrimaryPayrollContact__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Setup.Payroll_Data_Sheet_Settings__c.IsEnabledOnsiteSupervisor__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Setup.Payroll_Data_Sheet_Settings__c.IsEnabledHRContact__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Remove_Back_up_PC_Other_Fields</targetReference>
            </connector>
            <label>Yes : Enable For Workday</label>
        </rules>
    </decisions>
