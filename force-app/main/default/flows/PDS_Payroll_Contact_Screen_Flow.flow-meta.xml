    <decisions>
        <description>Verify Payroll Data Sheet Custom Settings enable for Workday - Multiple Contact Flag PC/HR</description>
        <name>Kill_Switch_Enable_For_Workday</name>
        <label>Kill Switch : Enable For Workday?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Enable_For_Workday</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Setup.Payroll_Data_Sheet_Settings__c.IsEnabledHRContact__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Setup.Payroll_Data_Sheet_Settings__c.IsEnabledOnsiteSupervisor__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Setup.Payroll_Data_Sheet_Settings__c.IsEnabledPrimaryPayrollContact__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>recordId_Is_Empty</targetReference>
            </connector>
            <label>Yes : Enable For Workday</label>
        </rules>
    </decisions>
    <decisions>
        <name>PDS_Record_Exist</name>
        <label>PDS Record Exist?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Valid_PDS_Record</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>record_PDS</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Primary_Payroll</targetReference>
            </connector>
            <label>Yes : Valid PDS Record</label>
        </rules>
    </decisions>
    <decisions>
        <description>When PC is same as PDS PC then execute else skip update</description>
        <name>Primary_PC_Selected</name>
        <label>Primary PC Selected?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Valid_PC</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>scc_Record_Id</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>scc_Contact_Id</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>record_PDS.NSP_Primary_Payroll_Contact__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>scc_Contact_Id</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_PC_on_PDS</targetReference>
            </connector>
            <label>Yes : Valid PC</label>
        </rules>
    </decisions>
    <decisions>
        <description>recordId is pass from LWC Wrapper component:</description>
        <name>recordId_Is_Empty</name>
        <label>recordId Is Empty?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Valid_RecordId</name>
