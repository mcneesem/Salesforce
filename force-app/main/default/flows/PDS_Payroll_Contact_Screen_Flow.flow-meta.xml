                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_PDS_Record</targetReference>
            </connector>
            <label>Yes : Valid RecordId</label>
        </rules>
    </decisions>
    <description>AZD-502310 , Used LWC Wrapper to show/hide the flow . refer- pdsPayrollContact</description>
    <dynamicChoiceSets>
        <name>scc_Payroll_Contact</name>
        <dataType>String</dataType>
        <displayField>Contact_full_name__c</displayField>
        <filterLogic>and</filterLogic>
        <filters>
            <field>NSP_Sub_Client__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>record_PDS.NSP_Sub_Client_Name__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>NSP_Payroll_Contact__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <limit>10</limit>
        <object>NSP_Sub_Client_Contact__c</object>
        <outputAssignments>
            <assignToReference>scc_Record_Id</assignToReference>
            <field>Id</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>scc_Contact_Id</assignToReference>
            <field>NSP_Contact__c</field>
        </outputAssignments>
        <valueField>Contact_full_name__c</valueField>
    </dynamicChoiceSets>
