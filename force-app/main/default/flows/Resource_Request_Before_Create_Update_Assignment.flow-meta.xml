    <recordLookups>
        <name>Get_Assignment_Record</name>
        <label>Get Assignment Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assignment_Record_Exist</targetReference>
