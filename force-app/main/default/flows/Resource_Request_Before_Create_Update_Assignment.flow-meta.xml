        </rules>
    </decisions>
    <description>AZD-459027 : Update Assignments When &quot;WX Benefits Renewal Project&quot; Project Resource is Created by batch.
Refer batch - NSP_WXBenefitsRenewalProjectCreation
AZD-520750 - HRCore Client Engagement Project Automation</description>
    <environments>Default</environments>
    <interviewLabel>Resource Request - Before Create - Update Assignment {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Resource Request - Before Create - Update Assignment</label>
