    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Is_Project_Linked</targetReference>
        </connector>
        <filterFormula>AND(
  NOT( ISBLANK( {!$Record.pse__Project__c} ) ) ,
  OR(
    ( {!$Record.pse__Project__r.TemplateName__c} = &apos;WX Benefits Renewal Project&apos; ) ,
    ( {!$Record.pse__Project__r.TemplateName__c} = &apos;HRCore Client Engagement Y1&apos; ) ,
    ( {!$Record.pse__Project__r.TemplateName__c} = &apos;HRCore Client Engagement Y2+&apos; )
  ),
  ISBLANK( {!$Record.pse__Staffer_Resource__c} )
)</filterFormula>
        <object>pse__Resource_Request__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
