    <decisions>
        <name>Check_Record_Before_Update</name>
        <label>Check Record Before Update</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Valid_Record</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>r_PDS_to_update</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_PDS_Record</targetReference>
            </connector>
            <label>Yes : Valid Record</label>
        </rules>
    </decisions>
    <decisions>
        <description>Kill Switch for Workday - Verify Payroll Data Sheet Custom Settings enable for Workday - Multiple Contact Flag PC/HR</description>
        <name>Kill_Switch_Enable_For_Workday</name>
        <label>Kill Switch : Enable For Workday?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Enable_For_Workday</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Setup.Payroll_Data_Sheet_Settings__c.IsEnabledHRContact__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Setup.Payroll_Data_Sheet_Settings__c.IsEnabledOnsiteSupervisor__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Setup.Payroll_Data_Sheet_Settings__c.IsEnabledPrimaryPayrollContact__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_PDS_Record</targetReference>
            </connector>
            <label>Yes : Enable For Workday</label>
        </rules>
    </decisions>
    <decisions>
        <name>Valid_PDS_Record</name>
        <label>Valid PDS Record?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Valid_PDS</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>r_PDS</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_PDS_HR_PC_OSS_Contacts</targetReference>
            </connector>
            <label>Yes : Valid PDS</label>
        </rules>
    </decisions>
    <description>AZD-502310 , When PC/HR/OSS Flags updated on SCC Update the PC/HR/OSS on PDS Record
11/11 - Get PDS record to Update</description>
