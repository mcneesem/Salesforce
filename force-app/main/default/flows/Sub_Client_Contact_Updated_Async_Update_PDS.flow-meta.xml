<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Kill Switch for Workday - Verify Payroll Data Sheet Custom Settings enable for Workday - Multiple Contact Flag PC/HR</description>
        <name>Kill_Switch_Enable_For_Workday</name>
        <label>Kill Switch : Enable For Workday?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Enable_For_Workday</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Setup.Payroll_Data_Sheet_Settings__c.IsEnabledHRContact__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Setup.Payroll_Data_Sheet_Settings__c.IsEnabledOnsiteSupervisor__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Setup.Payroll_Data_Sheet_Settings__c.IsEnabledPrimaryPayrollContact__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_PDS_HR_PC_OSS_Contacts</targetReference>
            </connector>
            <label>Yes : Enable For Workday</label>
        </rules>
    </decisions>
    <description>AZD-502310 , When PC/HR/OSS Flags updated on SCC Update the PC/HR/OSS on PDS Record</description>
    <environments>Default</environments>
    <interviewLabel>Sub Client Contact Updated Async Update PDS {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Sub Client Contact Updated Async Update PDS</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>or</filterLogic>
        <filters>
            <field>NSP_Payroll_Contact__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>NSP_HR_Contact__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>NSP_On_Site_Supervisor__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>NSP_Sub_Client_Contact__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>Kill_Switch_Enable_For_Workday</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <description>Invoke the Sub flow to compute the logic for PC/HR/OSS contacts on PDS</description>
        <name>Update_PDS_HR_PC_OSS_Contacts</name>
        <label>Update PDS HR/PC/OSS Contacts</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>Sub_Client_Contact_Updated_Async_Update_PDS_Subflow</flowName>
        <inputAssignments>
            <name>r_triggering_scc_record</name>
            <value>
                <elementReference>$Record</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <variables>
        <name>RecordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>Records_Collection</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
