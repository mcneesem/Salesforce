        <rules>
            <name>Account_Group_is_Valid</name>
            <conditionLogic>(1 OR 2) AND (3 OR 4 OR 5 OR 6)</conditionLogic>
            <conditions>
                <leftValueReference>Iterate_Account_Group_Members.NSP_Group__r.NSP_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Account Health</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Iterate_Account_Group_Members.NSP_Group__r.NSP_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Renewal Probability</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Iterate_Account_Group_Members.NSP_Group__r.NSP_Account_Health__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Unfavorable</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Iterate_Account_Group_Members.NSP_Group__r.NSP_Account_Health__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Somewhat unfavorable</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Iterate_Account_Group_Members.NSP_Group__r.NSP_Renewal_Probability__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Unfavorable</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Iterate_Account_Group_Members.NSP_Group__r.NSP_Renewal_Probability__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Somewhat unfavorable</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Has_Valid_Account_Groups</targetReference>
            </connector>
            <label>Account Group is Valid</label>
        </rules>
    </decisions>
