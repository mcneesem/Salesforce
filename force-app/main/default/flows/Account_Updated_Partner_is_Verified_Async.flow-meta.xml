<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>58.0</apiVersion>
    <decisions>
        <name>Bypass_Trigger</name>
        <label>Bypass Trigger?</label>
        <locationX>374</locationX>
        <locationY>276</locationY>
        <defaultConnector>
            <targetReference>Account_Email_Alert_Subflow</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Bypass Trigger</defaultConnectorLabel>
        <rules>
            <name>Yes_Bypass_Trigger</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Setup.NSP_Trigger_Switch__c.AutoLaunchedFlows__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Yes - Bypass Trigger</label>
        </rules>
    </decisions>
    <description>Triggers Account - Email Alert subflow to notify Channel Partner Manager flipped entry criteria to remove the &quot;isChanged&quot; on Account Status, updated with Bypass Trigger</description>
    <environments>Default</environments>
    <interviewLabel>Account - Updated Partner is Verified Async {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account - Updated Partner is Verified Async</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>(1 OR 2) AND 3 AND 4 AND 5</filterLogic>
        <filters>
            <field>CreatedByUserRole__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Business_Performance_Consultant</stringValue>
            </value>
        </filters>
        <filters>
            <field>CreatedByUserRole__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Business_Performance_Advisor</stringValue>
            </value>
        </filters>
        <filters>
            <field>NSP_Account_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Active</stringValue>
            </value>
        </filters>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Partner</stringValue>
            </value>
        </filters>
        <filters>
            <field>NSP_Channel_Partner_Manager__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Account</object>
        <recordTriggerType>Update</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>Bypass_Trigger</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>Account_Email_Alert_Subflow</name>
        <label>Account - Email Alert Subflow</label>
        <locationX>506</locationX>
        <locationY>384</locationY>
        <flowName>Account_Email_Alert_Subflow</flowName>
        <inputAssignments>
            <name>accountRecordId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>emailAlertAPIName</name>
            <value>
                <stringValue>NSP_Email_Alert_for_Verified_Partner</stringValue>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
