    <description>To populate Finance Period lookup field on Refund Object</description>
    <environments>Default</environments>
    <formulas>
        <description>Formula to get the String value of Refund date and legal entity</description>
        <name>RefundIdentifier</name>
        <dataType>String</dataType>
        <expression>IF(
  AND(
    NOT( ISNULL( {!$Record.blng__RefundDate__c} ) ) ,
    NOT( ISNULL( {!$Record.blng__LegalEntity__c} ) )
  ) ,
  TEXT( MONTH( {!$Record.blng__RefundDate__c} ) )
  + TEXT( YEAR( {!$Record.blng__RefundDate__c} ) )
  + LEFT( {!$Record.blng__LegalEntity__c} , 15 )
  + &apos;Accounting&apos; ,
  &apos;&apos;
)</expression>
    </formulas>
