    <recordLookups>
        <name>Get_Final_Meeting_Date_Time_OMR_Record</name>
        <label>Get Final Meeting Date/Time OMR Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Record_Found</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Set_Fault_Element_Get_Final_Meeting_Date_Time_OMR_Record</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Parent__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Date_Valid__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>finalmeetingDate</elementReference>
            </value>
        </filters>
        <filters>
            <field>Meeting_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_OMD_Record.Onboarding_Meeting_Request__r.Meeting_Type__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Start_Time_Number__c</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <elementReference>finalstarttimenumber</elementReference>
            </value>
        </filters>
        <filters>
            <field>End_Time_Number__c</field>
            <operator>GreaterThan</operator>
            <value>
                <elementReference>finalstarttimenumber</elementReference>
            </value>
        </filters>
        <filters>
            <field>Slots_Remaining__c</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </filters>
        <filters>
            <field>Time_Zone__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>final_time_zone</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Onboarding_Meeting_Request__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
