<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <apiVersion>56.0</apiVersion>
    <decisions>
        <description>User role needs to be: L1, L2 or New Client Sales in order to continue</description>
        <name>Does_the_user_have_permission_to_run_this_flow</name>
        <label>Does the user have permission to run this flow?</label>
        <locationX>182</locationX>
        <locationY>158</locationY>
        <defaultConnector>
            <targetReference>No_Permission_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>User Doesn&apos;t have permission</defaultConnectorLabel>
        <rules>
            <name>Yes_User_has_permission_to_enter_NonProfit_Rewards_Info</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$UserRole.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>NSP_L1_Support</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$UserRole.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>NSP_L2_Support_Admin</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$UserRole.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>New_Client_Sales</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Opportunity_Info</targetReference>
            </connector>
            <label>Yes - User has permission to enter NonProfit Rewards Info</label>
        </rules>
    </decisions>
    <description>User Story 195066 - Allows the following roles permission to update NonProfit Rewards information: L1, L2 and New Client Sales</description>
    <dynamicChoiceSets>
        <description>picklist values 	NSP_Nonprofit__c</description>
        <name>referralBenefitsChoices</name>
        <dataType>Picklist</dataType>
        <displayField xsi:nil="true"/>
        <object xsi:nil="true"/>
        <picklistField>NSP_Nonprofit__c</picklistField>
        <picklistObject>Opportunity</picklistObject>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <interviewLabel>Opportunity - Rewards Info Screen Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity - Rewards Info Screen Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <description>Get the originating opportunity information</description>
        <name>Get_Opportunity_Info</name>
        <label>Get Opportunity Info</label>
        <locationX>50</locationX>
        <locationY>278</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Rewards_Information</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Opportunity</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Enter rewards information on the opportunity record</description>
        <name>Update_opportunity_record</name>
        <label>Update opportunity record</label>
        <locationX>50</locationX>
        <locationY>518</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Opportunity_Info.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>NSP_NonprofitNameAddress__c</field>
            <value>
                <elementReference>Nonprofit_Name_Address</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>NSP_Nonprofit_Organization_Name__c</field>
            <value>
                <elementReference>Nonprofit_Organization_Name</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>NSP_Nonprofit__c</field>
            <value>
                <elementReference>Referral_benefits_a_nonprofit_org</elementReference>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <screens>
        <name>No_Permission_Screen</name>
        <label>No Permission Screen</label>
        <locationX>314</locationX>
        <locationY>278</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>NoPermissionToEnterRewards</name>
            <fieldText>&lt;p&gt;You do not have permission to enter NonProfit Rewards information on this record. Please reach out to your System Administrator for help.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <description>User enter non-profit information</description>
        <name>Rewards_Information</name>
        <label>Rewards Information</label>
        <locationX>50</locationX>
        <locationY>398</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <connector>
            <targetReference>Update_opportunity_record</targetReference>
        </connector>
