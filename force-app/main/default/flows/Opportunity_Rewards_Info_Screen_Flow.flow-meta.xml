    <decisions>
        <description>User role needs to be: L1, L2 or New Client Sales in order to continue</description>
        <name>Does_the_user_have_permission_to_run_this_flow</name>
        <label>Does the user have permission to run this flow?</label>
        <locationX>314</locationX>
        <locationY>134</locationY>
        <defaultConnector>
            <targetReference>No_Permission_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>User Doesn&apos;t have permission</defaultConnectorLabel>
        <rules>
            <name>Yes_User_has_permission_to_enter_NonProfit_Rewards_Info</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Permission.Opportunity_Create_Rewards</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Rewards_Information</targetReference>
            </connector>
            <label>Yes - User has permission to enter NonProfit Rewards Info</label>
        </rules>
    </decisions>
