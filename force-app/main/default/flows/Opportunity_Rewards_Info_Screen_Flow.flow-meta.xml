        <fields>
            <name>Nonprofit_Organization_Name</name>
            <dataType>String</dataType>
            <fieldText>Nonprofit Organization Name</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Does_the_user_have_permission_to_run_this_flow</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
