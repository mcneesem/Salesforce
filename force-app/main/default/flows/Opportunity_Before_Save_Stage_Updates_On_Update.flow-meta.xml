    <description>Updated to include &quot;Number of Days in Booking&quot;. Common &quot;current stage start date&quot;</description>
    <environments>Default</environments>
    <formulas>
        <description>Calculate the new total Days in Analysis</description>
        <name>totalDaysInAnalysisFormula</name>
        <dataType>Number</dataType>
        <expression>IF( {!priorDaysInAnalysis} &gt; 0, {!priorDaysInAnalysis} + {!priorDaysInCurrentStage}, {!priorDaysInCurrentStage})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
