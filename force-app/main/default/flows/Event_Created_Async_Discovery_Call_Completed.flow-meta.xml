    <decisions>
        <description>Prevent DmlExceptions: HCM Sales Consultants can modify only WX Opportunities. Check HR360 Primary Product</description>
        <name>Check_HCM_Rules_and_HR360_Primary_Product</name>
        <label>Check HCM Rules and HR360 Primary Product</label>
        <locationX>666</locationX>
