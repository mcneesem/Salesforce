    <decisions>
        <name>Check_Case_Status</name>
        <label>Check Case Status</label>
        <locationX>550</locationX>
        <locationY>866</locationY>
        <defaultConnector>
            <targetReference>Loop_Evaluate_Each_Case</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Eligible_Status</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Select_Case_Status</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
