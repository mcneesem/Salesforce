        </rules>
    </decisions>
    <decisions>
        <name>Verify_Case_Owner</name>
        <label>Verify Case Owner</label>
        <locationX>396</locationX>
        <locationY>974</locationY>
        <defaultConnector>
            <targetReference>Loop_Evaluate_Each_Case</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Owner_Check_Passed</name>
            <conditionLogic>(1 AND 2) OR (3 AND 4) OR 5</conditionLogic>
            <conditions>
                <leftValueReference>Owner</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>UserAsOwner</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Evaluate_Each_Case.OwnerId</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>005</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Owner</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>queueAsOwner</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Evaluate_Each_Case.OwnerId</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>00G</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Owner</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Any</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Case_for_Display</targetReference>
            </connector>
            <label>Owner Check Passed</label>
        </rules>
    </decisions>
