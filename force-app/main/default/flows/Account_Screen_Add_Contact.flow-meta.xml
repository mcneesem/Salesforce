<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <customProperties>
        <name>ScreenProgressIndicator</name>
        <value>
            <stringValue>{&quot;location&quot;:&quot;top&quot;,&quot;type&quot;:&quot;simple&quot;}</stringValue>
        </value>
    </customProperties>
    <description>Screen flow triggered from custom &quot;Add Contact&quot; button on Account record in Seller Experience app to create a new Contact and update the auto-created AccountContactRelationship record.</description>
    <environments>Default</environments>
    <interviewLabel>Account - Screen - Add Contact {!$Flow.CurrentDateTime}</interviewLabel>
    <isAdditionalPermissionRequiredToRun>true</isAdditionalPermissionRequiredToRun>
    <label>Account - Screen - Add Contact</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Account_Screen_Add_Contact_and_Add_Relationship_Subflow</targetReference>
        </connector>
    </start>
    <status>Draft</status>
    <subflows>
        <name>Account_Screen_Add_Contact_and_Add_Relationship_Subflow</name>
        <label>Account - Screen - Add Contact and Add Relationship Subflow</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>Account_Screen_Add_Contact_and_Add_Relationship_Subflow</flowName>
        <inputAssignments>
            <name>varAccountId</name>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varAction</name>
            <value>
                <stringValue>Add Contact</stringValue>
            </value>
        </inputAssignments>
    </subflows>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
