<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <decisions>
        <name>Bypass_Opportunity_Email_Alerts_Custom_Permission_check</name>
        <label>Bypass Opportunity Email Alerts Custom Permission check</label>
        <locationX>407</locationX>
        <locationY>276</locationY>
        <defaultConnector>
            <targetReference>Is_Account_Owner_different_from_Opty_Owner</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Bypass</defaultConnectorLabel>
        <rules>
            <name>User_has_bypass_permission</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Permission.Bypass_Opportunity_Email_Alerts</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>User has bypass permission</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Account_Owner_different_from_Opty_Owner</name>
        <label>Is Account Owner different from Opty Owner?</label>
        <locationX>605</locationX>
        <locationY>384</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Account_Owner_is_different</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account.OwnerId</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.OwnerId</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordTypeId</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Setup.Renewal_Opportunity_Settings__c.RenewalRecordTypeId__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Opportunity_Subflow_Email_Alerts</targetReference>
            </connector>
            <label>Yes - Account Owner is different</label>
        </rules>
    </decisions>
    <description>Removed redundancies. Updated Entry Criteria. If Opty Owner is not Account Owner, send notifications to Account Owner</description>
    <environments>Default</environments>
    <interviewLabel>Opportunity - Created - Async - Notifications to Account Owner {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity - Created - Async - Trigger Notifications to Account Owner</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>AccountId</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </filters>
        <filters>
            <field>Account_Owner_isActive__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Account_Owner_Email_Populated__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>Create</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>Bypass_Opportunity_Email_Alerts_Custom_Permission_check</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
    <subflows>
        <name>Opportunity_Subflow_Email_Alerts</name>
        <label>Opportunity - Subflow - Email Alerts</label>
        <locationX>473</locationX>
        <locationY>492</locationY>
        <flowName>Opportunity_Subflow_Email_Alerts</flowName>
        <inputAssignments>
            <name>opportunityId</name>
            <value>
                <elementReference>$Record.NSP_Opportunity_ID_18__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varEmailAlert</name>
            <value>
                <stringValue>NSP_Notify_Account_Owner_on_Creation_of_New_Opportunity</stringValue>
            </value>
        </inputAssignments>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </subflows>
</Flow>
