    <decisions>
        <name>Closed_Won_and_Owner_Active</name>
        <label>Closed Won and Owner Active?</label>
        <locationX>489</locationX>
        <locationY>492</locationY>
        <defaultConnector>
            <targetReference>Does_Opty_Type_Termination_And_Acct_Owner_Active</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>N/A</defaultConnectorLabel>
        <rules>
            <name>Yes_Closed_Won_and_Owner_Active</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Owner_isActive__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Owner_Email_Populated__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Opportunity_Subflow_Email_Alerts_NotifyOwnerClosedWon</targetReference>
            </connector>
            <label>Yes - Closed Won and Owner Active</label>
        </rules>
    </decisions>
    <decisions>
        <name>Does_Opty_Type_Termination_And_Acct_Owner_Active</name>
        <label>Does Opty Type = Termination And Acct Owner Active?</label>
        <locationX>489</locationX>
        <locationY>792</locationY>
        <defaultConnectorLabel>N/A</defaultConnectorLabel>
        <rules>
            <name>Yes_Opty_Type_Termination_and_Acct_Owner_Active</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Termination</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account_Owner_isActive__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account_Owner_Email_Populated__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Opportunity_Subflow_Email_Alerts_NoticeOfTermination</targetReference>
            </connector>
            <label>Yes - Opty Type = Termination and Acct Owner Active</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Parent_Closed_Lost_and_Product_IS_Retirement_Services</name>
        <label>Is Parent Closed Lost and Product IS Retirement Services?</label>
        <locationX>1017</locationX>
        <locationY>492</locationY>
        <defaultConnectorLabel>N/A</defaultConnectorLabel>
        <rules>
            <name>Yes_Parent_is_Closed_Lost_and_Product_IS_Retirement_Services</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.pse__Parent_Opportunity__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Parent_Opportunity_Stage__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Closed Lost</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.NSP_PrimaryProduct__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Retirement Services</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Owner_isActive__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Owner_Email_Populated__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Opportunity_Subflow_Email_Alerts_ChildOptyClosedLost</targetReference>
            </connector>
            <label>Yes - Parent is Closed Lost and Product IS Retirement Services</label>
        </rules>
    </decisions>
    <decisions>
        <name>What_is_Opty_Stage</name>
        <label>What is Opty Stage?</label>
        <locationX>951</locationX>
        <locationY>384</locationY>
        <defaultConnectorLabel>Not Termination</defaultConnectorLabel>
        <rules>
            <name>Stage_Closed_Won</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Closed Won</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Closed_Won_and_Owner_Active</targetReference>
            </connector>
            <label>Stage = Closed Won</label>
        </rules>
        <rules>
            <name>Stage_Closed_Lost</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Closed Lost</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Is_Parent_Closed_Lost_and_Product_IS_Retirement_Services</targetReference>
            </connector>
            <label>Stage = Closed Lost</label>
        </rules>
    </decisions>
