  {!priorDaysInCurrentStatus}
)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <description>Calculate the new total Days in Unqualified</description>
        <name>totalDaysInUnqualified</name>
        <dataType>Number</dataType>
        <expression>IF(
  AND(
    NOT( ISNULL( {!priorDaysInUnqualified} ) ) ,
    ( {!priorDaysInUnqualified} &gt; 0 )
  ) ,
  ( {!priorDaysInUnqualified} + {!priorDaysInCurrentStatus} ) ,
  {!priorDaysInCurrentStatus}
