    <description>This flow calculates the total days a lead spends in each stage</description>
    <environments>Default</environments>
    <formulas>
        <description>Calculate the new total Days in New</description>
        <name>totalDaysInNew</name>
        <dataType>Number</dataType>
        <expression>IF(
  AND(
    NOT( ISNULL( {!priorDaysInNew} ) ) ,
    ( {!priorDaysInNew} &gt; 0 )
  ) ,
  ( {!priorDaysInNew} + {!priorDaysInCurrentStatus} ) ,
  {!priorDaysInCurrentStatus}
)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <description>Calculate the new total Days in Nurturing</description>
        <name>totalDaysInNurturing</name>
        <dataType>Number</dataType>
        <expression>IF(
  AND(
