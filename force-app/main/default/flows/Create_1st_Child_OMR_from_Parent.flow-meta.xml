    <formulas>
        <name>Friday_NextDateThatMatches</name>
        <dataType>Date</dataType>
        <expression>IF((
{!$Record.Start__c} + (5 - MOD({!$Record.Start__c} - DATE( 1900, 1, 7 ), 7 ) ) + IF( MOD({!$Record.Start__c} - DATE( 1900, 1, 7 ), 7 ) &gt;= 5, 7, 0)) &lt;= {!$Record.End__c}, {!$Record.Start__c} + (5 - MOD({!$Record.Start__c} - DATE( 1900, 1, 7 ), 7 ) ) + IF( MOD({!$Record.Start__c} - DATE( 1900, 1, 7 ), 7 ) &gt;= 5, 7, 0), null)</expression>
    </formulas>
