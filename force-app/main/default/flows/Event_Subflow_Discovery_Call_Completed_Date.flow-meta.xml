        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_updateOpportunity_equals_True</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>updateOpportunity</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Opportunity_Record</targetReference>
            </connector>
            <label>Yes - updateOpportunity equals True</label>
        </rules>
    </decisions>
    <decisions>
        <name>Was_the_District_Manager_found</name>
        <label>Was the District Manager found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Should_Opportunity_Discovery_Call_Completed_Date_be_updated</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>DM not found</defaultConnectorLabel>
        <rules>
            <name>Yes_DM_was_found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varDistrictManager</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Discovery_Call_Custom_Notification</targetReference>
            </connector>
            <label>Yes - DM was found</label>
        </rules>
    </decisions>
    <description>Handles close-lost info from &quot;Event Screen Discovery Call Completed&quot; flow. Removed HCM decision node at the bottom, should update opty regardless of user and product. Sends notifications to the Opty Owner&apos;s DM (if applicable) and updates the related Opportunity if needed.</description>
    <environments>Default</environments>
    <formulas>
        <name>eventCompletedDatePlus60Formula</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} + 60</expression>
    </formulas>
    <formulas>
        <name>opportunityRecordURLFormula</name>
        <dataType>String</dataType>
        <expression>&quot;&lt;a href=&apos;&quot; &amp; LEFT({!$Api.Partner_Server_URL_260}, FIND(&quot;/services&quot;, {!$Api.Partner_Server_URL_260}) - 1) &amp; &quot;/lightning/r/Opportunity/&quot; &amp; {!varOpportunity.Id} &amp; &quot;/view&apos;&gt;&quot; &amp; {!varOpportunity.Name} &amp; &quot;&lt;/a&gt;&quot;</expression>
    </formulas>
    <interviewLabel>Event - Subflow - Discovery Call Completed Date {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Event - Subflow - Discovery Call Completed Date</label>
    <loops>
        <name>Loop_Over_Public_Groups</name>
        <label>Loop Over Public Groups</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Public_Group_Id</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Check_for_Group_Type</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Get_Opty_Owner_in_BPA_Public_Group</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Discovery_Call_Custom_Notification</name>
        <label>Get Discovery Call Custom Notification</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assign_DM_Id_to_collectionRecipientsIds</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Assign_varFaultElement_Get_Discovery_Call_Custom_Notification</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Event_Create_Update_Discovery_Call_Notification</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>CustomNotificationType</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Opty_Owner_in_BPA_Public_Group</name>
        <label>Get Opty Owner in BPA Public Group</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_the_Opty_Owner_in_the_BPA_Public_Group</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Assign_varFaultElement_Get_Opty_Owner_in_BPA_Public_Group</targetReference>
        </faultConnector>
        <filterLogic>1 AND (2 OR 3)</filterLogic>
        <filters>
            <field>GroupId</field>
            <operator>In</operator>
            <value>
                <elementReference>publicGroupIds</elementReference>
            </value>
        </filters>
        <filters>
            <field>UserOrGroupId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varOpportunity.OwnerId</elementReference>
            </value>
        </filters>
        <filters>
            <field>UserOrGroupId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>roleRelatedId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>GroupMember</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Public_Group_Id</name>
        <label>Get Public Group Id</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_if_Public_Group_Records_Exist</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Assign_varFaultElement_Get_Public_Group_Id</targetReference>
        </faultConnector>
        <filterLogic>1 OR (2 AND 3)</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Business Performance Advisor</stringValue>
            </value>
        </filters>
        <filters>
            <field>RelatedId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varOpportunity.Owner.UserRoleId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Role</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Group</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>RelatedId</queriedFields>
        <queriedFields>Type</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_the_Owners_District_Manager</name>
        <label>Get the Owner&apos;s District Manager</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Was_the_District_Manager_found</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Assign_varFaultElement_Get_the_Owners_District_Manager</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varOpportunity.District_Manager_Id__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Email</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Email</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </filters>
        <object>User</object>
        <outputReference>varDistrictManager</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Email</queriedFields>
    </recordLookups>
    <recordUpdates>
        <name>Update_Opportunity_Record</name>
        <label>Update Opportunity Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <targetReference>Assign_varFaultElement_Update_Opportunity_Record</targetReference>
        </faultConnector>
        <inputReference>varOpportunityToUpdate</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Does_varOpportunity_have_all_the_info_needed</targetReference>
        </connector>
