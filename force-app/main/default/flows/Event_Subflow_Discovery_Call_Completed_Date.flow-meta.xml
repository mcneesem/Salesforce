    </textTemplates>
    <textTemplates>
        <name>emailSubjectTemplate</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;Action Required: Discovery Call Follow-up -&amp;nbsp;{!varOpportunity.Name}&lt;/p&gt;</text>
