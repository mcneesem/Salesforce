        <expression>CASE(
  {!Loop_Each_Positions} ,
  &quot;Project Manager (Main Point of Contact)&quot; , {!recordImplProfile.NSP_Project_Manager__c} ,
  &quot;Orientation Representative&quot; , {!recordImplProfile.NSP_Orientation_Rep__c} ,
  &quot;Payroll Implementation&quot; , {!recordImplProfile.NSP_Payroll_Specialist__c} ,
  &quot;HR Implementation&quot; , {!recordImplProfile.NSP_HR_Quality_Support_Team_Member__c} ,
  &quot;Time and Attendance&quot; , {!recordImplProfile.NSP_ITA_Analyst__c} ,
  null
)</expression>
