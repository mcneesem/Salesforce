    <description>The PB notifies the lead record owner whenever a record is assigned to them. Default the Lead Stage field to &apos;Suspect&apos; if its blank</description>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>$Setup.NSP_Trigger_Switch__c.AutoLaunchedFlows__c</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>{!$Setup.NSP_Trigger_Switch__c.AutoLaunchedFlows__c}</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND (OR(ISCHANGED([Lead].OwnerId),ISNEW()),LEFT($User.Id,15) &lt;&gt; LEFT([Lead].OwnerId,15))</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_3</name>
        <dataType>Boolean</dataType>
        <expression>AND (OR(ISCHANGED({!myVariable_current.OwnerId}),ISNEW()),LEFT({!$User.Id},15) &lt;&gt; LEFT({!myVariable_current.OwnerId},15))</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND([Lead].RecordType.Name =&quot;Referral&quot;,[Lead].IsConverted, [Lead].CreatedById &lt;&gt; [Lead].OwnerId ,[Lead].CreatedBy.IsActive )</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_5</name>
        <dataType>Boolean</dataType>
        <expression>AND({!myVariable_current.RecordType.Name} =&quot;Referral&quot;,{!myVariable_current.IsConverted}, {!myVariable_current.CreatedById} &lt;&gt; {!myVariable_current.OwnerId} ,{!myVariable_current.CreatedBy.IsActive} )</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND (ISNEW(),ISPICKVAL([Lead].LeadSource, &quot;Partner&quot;),NOT(ISBLANK([Lead].NSP_Partner_Email__c ) ))</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_7</name>
        <dataType>Boolean</dataType>
        <expression>AND (ISNEW(),ISPICKVAL({!myVariable_current.LeadSource}, &quot;Partner&quot;),NOT(ISBLANK({!myVariable_current.NSP_Partner_Email__c} ) ))</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND (ISNEW(),ISPICKVAL([Lead].LeadSource, &quot;Loyalty&quot;),NOT(ISBLANK([Lead].NSP_Partner_Email__c ) ))</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_9</name>
        <dataType>Boolean</dataType>
        <expression>AND (ISNEW(),ISPICKVAL({!myVariable_current.LeadSource}, &quot;Loyalty&quot;),NOT(ISBLANK({!myVariable_current.NSP_Partner_Email__c} ) ))</expression>
    </formulas>
