<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <decisions>
        <description>Is AIMS Sub Client # = AIMS Client #?</description>
        <name>Check_AIMS_number</name>
        <label>Check AIMS number</label>
        <locationX>314</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>AIMS_are_equal</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.NSP_Client__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.NSP_Sub_Client__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Fields</targetReference>
            </connector>
            <label>AIMS are equal</label>
        </rules>
    </decisions>
    <description>This flow is used for updating values in Account when a field is changed in Sub Client.</description>
    <environments>Default</environments>
    <interviewLabel>Sub Client Update Account fields {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Sub Client Update Account fields</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Fields</name>
        <label>Update Fields</label>
        <locationX>50</locationX>
        <locationY>431</locationY>
        <faultConnector>
            <targetReference>Insperity_Fault_Handler_Subflow_Flow</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.NSP_Account__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>NSP_Margin__c</field>
            <value>
                <elementReference>$Record.NSP_Margin__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>NSP_Reserve__c</field>
            <value>
                <elementReference>$Record.NSP_Reserve__c</elementReference>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>
    <start>
        <locationX>188</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_AIMS_number</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>NSP_Margin__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>NSP_Reserve__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>NSP_Margin__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>NSP_Reserve__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>NSP_Sub_Client__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
    <subflows>
        <name>Insperity_Fault_Handler_Subflow_Flow</name>
        <label>Insperity Fault Handler Subflow Flow</label>
        <locationX>314</locationX>
        <locationY>539</locationY>
        <flowName>Insperity_Fault_Handler_Subflow</flowName>
        <inputAssignments>
            <name>faultElement</name>
            <value>
                <stringValue>Update_Fields</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>faultFlow</name>
            <value>
                <stringValue>Sub_Client_Update_Account_fields</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>faultMessage</name>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
