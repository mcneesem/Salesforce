    <description>This flow asynchronously updates the Order products with the latest Invoice Group Id whenever the Shipping Postal Code is changed on the Order.</description>
    <environments>Default</environments>
    <formulas>
        <description>This formula is used to create desired Invoice Group Id. Any blanks or missing fields are replaced by a string &quot;null&quot;</description>
        <name>InvoiceGroupIdFormula</name>
        <dataType>String</dataType>
        <expression>IF(OR(ISBLANK({!AccountIdVariable}),ISNULL({!AccountIdVariable})), &apos;null&apos;, {!AccountIdVariable}) + 
IF(OR(ISBLANK({!BillingAccountVariable}),ISNULL({!BillingAccountVariable})), &apos;null&apos;, {!BillingAccountVariable}) + 
IF(OR(ISBLANK({!ShippingPostalCodeVariable}),ISNULL({!ShippingPostalCodeVariable})), &apos;null&apos;, {!ShippingPostalCodeVariable}) + 
IF(OR(ISBLANK({!PaymentMethodVariable}),ISNULL({!PaymentMethodVariable})), &apos;null&apos;, {!PaymentMethodVariable})</expression>
    </formulas>
    <interviewLabel>Order - Updated Async - Update Invoice Grouping Id on Order Product {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Order - Updated - Async - Update Invoice Grouping Id On Order Product</label>
    <loops>
        <description>This loop element goes through all order products to update the Invoice Group Id field</description>
        <name>Iterate_Through_Order_Products</name>
        <label>Iterate Through Order Products</label>
        <locationX>220</locationX>
