    <decisions>
        <name>Account_Segment_MidMarket_or_Enterprise_or_Employees_more_than_MM_threshold</name>
        <label>Account Segment MidMarket or Enterprise or Employees more than MM threshold</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Account_Segment_is_Midmarket_or_Enterprise_or_Employees_more_than_MM_threshold</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.NumberOfEmployees</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>midMarketThresholdFormula</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.NSP_Account_Segment__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>MidMarket</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.NSP_Account_Segment__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Enterprise</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Related_Open_Optys</targetReference>
            </connector>
            <label>Account Segment is Midmarket or Enterprise or Employees more than MM threshold</label>
        </rules>
    </decisions>
