<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Flow that refreshes the price fields on Price Increase Records that are active. Intentionally made synchronous-after-save ( not asynchronous-after-save), since there is a batch class that updates the price fields on Purchased Product records. This prevents row lock issues and the flow uses governer limits of each batch chunk.</description>
    <environments>Default</environments>
    <interviewLabel>Purchased Product - Updated - Handle Price Increases {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Purchased Product - Updated - Handle Price Increases</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>Update fields on Price Increase Records</description>
        <name>Update_Price_Increase_Records</name>
        <label>Update Price Increase Records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <targetReference>Handle_Faults</targetReference>
        </faultConnector>
        <filterLogic>1 AND ( 2 OR 3 )</filterLogic>
        <filters>
            <field>Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </filters>
        <filters>
            <field>Current_PEPM__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Total_Price__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Current_Retail_Price__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Total_Price__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Current_PEPM__c</field>
            <value>
                <elementReference>$Record.Total_Price__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Current_Retail_Price__c</field>
            <value>
                <elementReference>$Record.Retail_Price__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record.Price_Increases__r</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Price_Increase_Records</targetReference>
        </connector>
        <filterLogic>( 1 OR 3 ) AND 2 AND 4</filterLogic>
        <filters>
            <field>Retail_Price__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Retail_Price__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Total_Price__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Total_Price__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Purchased_Product__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
    <subflows>
        <name>Handle_Faults</name>
        <label>Handle Faults</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>Insperity_Fault_Handler_Subflow</flowName>
        <inputAssignments>
            <name>faultElement</name>
            <value>
                <stringValue>Update_Price_Increase_Records</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>faultFlow</name>
            <value>
                <stringValue>Purchased_Product_Updated_Handle_Price_Increases</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>faultMessage</name>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
