        </rules>
    </decisions>
    <decisions>
        <name>Is_Event_Status_Completed_and_should_Lead_Status_be_changed_to_Working</name>
        <label>Is Event Status &quot;Completed&quot; and should Lead Status be changed to &quot;Working&quot;?</label>
        <locationX>2250</locationX>
        <locationY>647</locationY>
        <defaultConnectorLabel>Lead status does not need to be updated</defaultConnectorLabel>
        <rules>
            <name>Yes_Event_is_Completed_and_Lead_should_move_to_Working</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.NSP_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Completed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Lead_Info.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>New</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Lead_Record</targetReference>
            </connector>
            <label>Yes - Event is Completed and Lead should move to Working</label>
        </rules>
    </decisions>
    <decisions>
        <name>What_type_of_record_is_in_WhatId</name>
        <label>What type of record is in WhatId?</label>
        <locationX>1678</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Not related to a relevant record</defaultConnectorLabel>
        <rules>
            <name>Related_to_Opportunity</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.WhatId</leftValueReference>
                <operator>StartsWith</operator>
