                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Lead_Info</targetReference>
            </connector>
            <label>Related to Lead</label>
        </rules>
    </decisions>
    <description>Upon Event update with a non-Cancelled status, flow updates Last Updated on related Account or Opportunity, if needed; flow updates related Lead status if Event is Completed.</description>
