    <decisions>
        <name>Check_Account_Last_Updated</name>
        <label>Check Account Last Updated</label>
        <locationX>1282</locationX>
        <locationY>647</locationY>
        <defaultConnector>
            <targetReference>Update_Event_Record_if_Status_not_Cancelled</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Account_Update_Needed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account_Info.NSP_Last_Updated__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Account_Record</targetReference>
            </connector>
            <label>Account Update Needed</label>
        </rules>
    </decisions>
