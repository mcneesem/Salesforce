    <start>
        <locationX>1552</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>What_type_of_record_is_in_WhatId</targetReference>
        </connector>
        <filterFormula>NOT(ISPICKVAL({!$Record.NSP_Status__c}, &quot;Cancelled&quot;))
&amp;&amp;
( NOT(ISBLANK( {!$Record.WhatId} )) || NOT(ISBLANK( {!$Record.WhoId} )) )
&amp;&amp;
NOT( {!$Setup.NSP_Trigger_Switch__c.AutoLaunchedFlows__c} )</filterFormula>
        <object>Event</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
