<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <decisions>
        <description>Tasks should be cancelled when Status is Open, or Status is blank, and is 45 day stale</description>
        <name>Should_Task_be_cancelled</name>
        <label>Should Task be cancelled?</label>
        <locationX>314</locationX>
        <locationY>252</locationY>
        <defaultConnectorLabel>Do Not Cancel Task</defaultConnectorLabel>
        <rules>
            <name>Yes_Cancel_Task</name>
            <conditionLogic>((1 AND 2) OR 3) AND (4 OR 5)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ActivityDate</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>createdAtLeast45DaysAgo</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>activityDateAtLeast45DaysAgo</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Open</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Task_statuses_to_Cancelled</targetReference>
            </connector>
            <label>Yes - Cancel Task</label>
        </rules>
    </decisions>
    <description>Scheduled to run at 3am to cancel Sales Tasks that are stale (45 days old and still open or no status)</description>
    <environments>Default</environments>
    <formulas>
        <name>activityDateAtLeast45DaysAgo</name>
        <dataType>Boolean</dataType>
        <expression>IF( ( TODAY() - {!$Record.ActivityDate} ) &gt;= 45, true, false )</expression>
    </formulas>
    <formulas>
        <name>createdAtLeast45DaysAgo</name>
        <dataType>Boolean</dataType>
        <expression>IF( ( TODAY() - DATEVALUE( {!$Record.CreatedDate} ) ) &gt;= 45, true, false )</expression>
    </formulas>
    <interviewLabel>Task - Scheduled Cancellation of Sales Tasks {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Task - Scheduled Cancellation of Sales Tasks</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Set_Task_statuses_to_Cancelled</name>
        <label>Set Task statuses to &quot;Cancelled&quot;</label>
        <locationX>50</locationX>
        <locationY>360</locationY>
        <faultConnector>
            <targetReference>Fault_Handler_Subflow</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>NSP_Status__c</field>
            <value>
                <stringValue>Cancelled</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Cancelled</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>188</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Should_Task_be_cancelled</targetReference>
        </connector>
        <filterLogic>1 AND (2 OR 3)</filterLogic>
        <filters>
            <field>RecordTypeId</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>0124x000000yRvRAAU</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Open</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Task</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2024-03-14</startDate>
            <startTime>04:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Draft</status>
    <subflows>
        <name>Fault_Handler_Subflow</name>
        <label>Fault Handler Subflow</label>
        <locationX>314</locationX>
        <locationY>468</locationY>
        <flowName>Insperity_Fault_Handler_Subflow</flowName>
        <inputAssignments>
            <name>faultMessage</name>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>triggeringFlow</name>
            <value>
                <stringValue>Task - Scheduled Cancellation of Sales Tasks</stringValue>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
