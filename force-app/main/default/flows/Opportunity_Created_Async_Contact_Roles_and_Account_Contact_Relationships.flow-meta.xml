    <decisions>
        <description>Prevent Flow Error: Number of iterations exceeded
~ Salesforce has a limit of 2000 executed elements at run time.
~ The following loop has a potential to execute 2 element per ACR selected in the previous query</description>
        <name>Check_Count_ACRs</name>
        <label>Check Count ACRs</label>
        <locationX>3229</locationX>
        <locationY>2862</locationY>
        <defaultConnector>
            <targetReference>LoopEachACRtoCreateOCR</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Too_Many_ACRs</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>countACRs</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>900.0</numberValue>
                </rightValue>
            </conditions>
            <label>Too Many ACRs</label>
        </rules>
    </decisions>
    <decisions>
        <description>Prevent DmlExceptions: This error occurred when the flow tried to create records: ENTITY_IS_DELETED: entity is deleted.</description>
