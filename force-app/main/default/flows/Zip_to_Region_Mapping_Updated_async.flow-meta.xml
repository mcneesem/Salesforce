    <recordLookups>
        <description>Get all Account records with Billing Zip that matches Zip to Region Mapping record&apos;s zip code</description>
        <name>Get_Available_Owned_Acct_with_Matching_Zip</name>
        <label>Get Available Owned Acct with Matching Zip</label>
        <locationX>352</locationX>
        <locationY>276</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_over_all_Accounts_to_get_IDs</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Assign_varFaultElement_Get_Available_Owned_Acct_with_Matching_Zip</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OwnerId</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>0054x000008PgqNAAS</stringValue>
            </value>
        </filters>
        <filters>
            <field>BillingPostalCode</field>
            <operator>StartsWith</operator>
            <value>
                <elementReference>$Record.NSP_Zip__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
