<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Update Order product consumption rate Upper Bound When Subscription Consumption Rate Pricing Method=&apos;Flat Fee&apos; and Lower Bound = 0 and Upper Bound = 1</description>
    <environments>Default</environments>
    <interviewLabel>Subscription Consumption Rate {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Subscription Consumption Rate  - Created - Async - Update Upper Bound</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_OrderItem_Consumption_Rate</name>
        <label>Update OrderItem Consumption Rate</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <targetReference>Fault_Flow</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OrderItemId__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.OrderItemId__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>SBQQ__LowerBound__c</field>
            <operator>EqualTo</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </filters>
        <filters>
            <field>SBQQ__UpperBound__c</field>
            <operator>EqualTo</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </filters>
        <inputAssignments>
            <field>SBQQ__UpperBound__c</field>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </inputAssignments>
        <object>SBQQ__OrderItemConsumptionRate__c</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SBQQ__PricingMethod__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>FlatFee</stringValue>
            </value>
        </filters>
        <filters>
            <field>SBQQ__LowerBound__c</field>
            <operator>EqualTo</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </filters>
        <filters>
            <field>SBQQ__UpperBound__c</field>
            <operator>EqualTo</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </filters>
        <filters>
            <field>OrderItemId__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>SBQQ__SubscriptionConsumptionRate__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>Update_OrderItem_Consumption_Rate</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
    <subflows>
        <name>Fault_Flow</name>
        <label>Fault Flow</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>Insperity_Fault_Handler_Subflow</flowName>
        <inputAssignments>
            <name>faultElement</name>
            <value>
                <stringValue>Update_OrderItem_Consumption_Rate</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>faultFlow</name>
            <value>
                <stringValue>Subscription_Consumption_Rate_Created_Async_Update_Upper_Bound</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>faultMessage</name>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
