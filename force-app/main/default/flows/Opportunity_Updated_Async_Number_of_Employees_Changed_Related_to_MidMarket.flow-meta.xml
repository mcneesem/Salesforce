    <decisions>
        <description>Only proceed to Email Alerts if Opty has an Open or Completed Discovery Call. In future, flow will only apply to Opty&apos;s in Stages after Prospecting.</description>
        <name>Discovery_Call_Found</name>
        <label>Discovery Call Found?</label>
        <locationX>209</locationX>
        <locationY>990</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varDiscoveryCallEvent</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Opportunity_Subflow_Email_Alerts</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Send_Opportunity_Email_Alert</name>
        <label>Send Opportunity Email Alert?</label>
        <locationX>539</locationX>
        <locationY>774</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Email_Alert</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Permission.Bypass_Opportunity_Email_Alerts</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Owner_isActive__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Owner_Email_Populated__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.NSP_Mid_Market_Sales_Email__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_DC_Event</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Update_Related_Account</name>
        <label>Update Related Account?</label>
        <locationX>539</locationX>
        <locationY>276</locationY>
        <defaultConnector>
            <targetReference>Send_Opportunity_Email_Alert</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Update_Acct</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>New Product</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.AccountId</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Number_of_Employees_on_Account</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>If Product is WX, WO, WA or WS and Opty is MidMarket (by segment or number of employees) and Num of Employees gets changed, then update related Account and send email alert if applicable.</description>
    <environments>Default</environments>
    <interviewLabel>Opportunity - Updated - Async - Number of Employees Changed Related To MidMarket {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity - Updated - Async - Number of Employees Changed Related to MidMarket</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>See if Opty has any non-Cancelled Discovery Call Events</description>
        <name>Get_DC_Event</name>
        <label>Get DC Event</label>
        <locationX>209</locationX>
        <locationY>882</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Discovery_Call_Found</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Assign_varFaultElement_Get_DC_Event</targetReference>
        </faultConnector>
        <filterLogic>(1 OR 2) AND 3 AND 4</filterLogic>
        <filters>
            <field>NSP_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Open</stringValue>
            </value>
        </filters>
        <filters>
            <field>NSP_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </filters>
        <filters>
            <field>NSP_Event_Subtype__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Discovery Call</stringValue>
            </value>
        </filters>
        <filters>
            <field>WhatId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <object>Event</object>
        <outputReference>varDiscoveryCallEvent</outputReference>
        <queriedFields>Id</queriedFields>
    </recordLookups>
    <recordUpdates>
        <name>Update_Number_of_Employees_on_Account</name>
        <label>Update Number of Employees on Account</label>
        <locationX>275</locationX>
        <locationY>384</locationY>
        <connector>
            <targetReference>Send_Opportunity_Email_Alert</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Assign_varFaultElement_Update_Num_EEs_on_Acct</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>NumberOfEmployees</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.NSP_Number_of_Employees__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>NumberOfEmployees</field>
            <value>
                <elementReference>$Record.NSP_Number_of_Employees__c</elementReference>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <filterLogic>(1 AND 2 AND 3 AND (4 OR 5) AND (6 OR 7 OR 8 OR 9) )</filterLogic>
        <filters>
            <field>NSP_Number_of_Employees__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Type</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Type</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Client Growth Credit</stringValue>
            </value>
        </filters>
        <filters>
            <field>NSP_Account_Segment__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>MidMarket</stringValue>
            </value>
        </filters>
        <filters>
            <field>Opty_NumOfEmp_more_than_MM_Threshold__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>NSP_PrimaryProduct__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>WX</stringValue>
            </value>
        </filters>
        <filters>
            <field>NSP_PrimaryProduct__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>WO</stringValue>
            </value>
        </filters>
        <filters>
            <field>NSP_PrimaryProduct__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>WS</stringValue>
            </value>
        </filters>
        <filters>
            <field>NSP_PrimaryProduct__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>WA</stringValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>Update</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>Update_Related_Account</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
