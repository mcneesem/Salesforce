<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_Fault_Element_Update_Opp_To_Closed_Won</name>
        <label>Set Fault Element : Update_Opp_To_Closed_Won</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varFaultElement</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Update_Opp_To_Closed_Won</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Fault_Flow</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_Opportunity_Primary_Quote</name>
        <label>Check Opportunity Primary Quote</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_Opp_To_Closed_Won</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Opportunity_Has_Primary_Quote</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SBQQ__Opportunity2__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SBQQ__Opportunity2__r.SBQQ__PrimaryQuote__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Opportunity_Primary_Quote_Status</targetReference>
            </connector>
            <label>Opportunity Has Primary Quote</label>
        </rules>
    </decisions>
    <decisions>
        <description>Prevent DmlExceptions: FIELD_CUSTOM_VALIDATION_EXCEPTION: Primary Quote status must be Approved or Submitted To Order to move opportunity to Proposal (Label.NSP_Approve_Primary_Quote)</description>
        <name>Check_Opportunity_Primary_Quote_Status</name>
        <label>Check Opportunity Primary Quote Status</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_Opp_To_Closed_Won</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Not_Approved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SBQQ__Opportunity2__r.SBQQ__PrimaryQuote__r.SBQQ__Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <label>Is Not Approved</label>
        </rules>
    </decisions>
    <decisions>
        <name>Extra_Condition_Check</name>
        <label>Extra Condition Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Eligible</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SBQQ__LastCalculatedOn__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>$Record.CreatedDate</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SBQQ__Opportunity2__r.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Termination</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SBQQ__Opportunity2__r.StageName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Closed Won</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Validate_Primary_Product_and_Primary_Bundle</targetReference>
            </connector>
            <label>Is Eligible</label>
        </rules>
    </decisions>
    <decisions>
        <description>Prevent DmlExceptions: FIELD_CUSTOM_VALIDATION_EXCEPTION: Please update the Primary Product and Primary Bundle on the opportunity that matches the quote.</description>
        <name>Validate_Primary_Product_and_Primary_Bundle</name>
        <label>Validate Primary Product and Primary Bundle</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Validated</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.NSP_Opportunity_Primary_Product__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.SBQQ__Opportunity2__r.NSP_PrimaryProduct__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.NSP_Client_For_Life__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.SBQQ__Opportunity2__r.NSP_Client_For_Life__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Opportunity_Primary_Quote</targetReference>
            </connector>
            <label>Is Validated</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Quote - Updated - Async - Related Termination Opportunities {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Quote - Updated - Async - Related Termination Opportunities</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>Prevent DmlExceptions: FIELD_CUSTOM_VALIDATION_EXCEPTION: Once an Opportunity is Closed Won it cannot be modified. Please contact Sales Operations team.  ( (StageName Does Not Equal Closed Won) AND (NSP_Lock_Opportunity__c Equals False) )</description>
        <name>Update_Opp_To_Closed_Won</name>
        <label>Update Opp To Closed Won</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <targetReference>Set_Fault_Element_Update_Opp_To_Closed_Won</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>StageName</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Closed Won</stringValue>
            </value>
        </filters>
        <filters>
            <field>NSP_Lock_Opportunity__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <inputAssignments>
            <field>StageName</field>
            <value>
                <stringValue>Closed Won</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record.SBQQ__Opportunity2__r</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SBQQ__LastCalculatedOn__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Auto_Termination__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>SBQQ__Opportunity2__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>SBQQ__Quote__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>Extra_Condition_Check</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
    <subflows>
        <name>Fault_Flow</name>
        <label>Fault Flow</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Send_Failure_Email</targetReference>
        </connector>
        <flowName>Insperity_Fault_Handler_Subflow</flowName>
        <inputAssignments>
