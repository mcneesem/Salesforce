            <value>
                <elementReference>varFaultElement</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>faultFlow</name>
            <value>
                <stringValue>Quote_Updated_Async_Related_Termination_Opportunities</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>faultMessage</name>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <subflows>
        <name>Send_Failure_Email</name>
        <label>Send Failure Email</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>Contract_Termination_Failure_Email_Notification</flowName>
        <inputAssignments>
            <name>failureReason</name>
            <value>
                <elementReference>varFailureReason</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varQuoteRec</name>
            <value>
                <elementReference>$Record</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <textTemplates>
        <name>varFailureReason</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Opportunity Update for Contract (Id={!$Record.SBQQ__Opportunity2__r.SBQQ__AmendedContract__c})</text>
    </textTemplates>
    <variables>
        <name>RecipientAddress</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varFaultElement</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
