{!$Record.Date_Valid__c} + ({!$Record.Selected_Day_of_Week_Number__c} - MOD({!$Record.Date_Valid__c} - DATE( 1900, 1, 7 ), 7 ) ) + IF( MOD({!$Record.Date_Valid__c} - DATE( 1900, 1, 7 ), 7 ) &gt;= {!$Record.Selected_Day_of_Week_Number__c}, 7, 0)) &lt;= {!$Record.Parent_OMR__r.End__c}, {!$Record.Date_Valid__c} + ({!$Record.Selected_Day_of_Week_Number__c} - MOD({!$Record.Date_Valid__c} - DATE( 1900, 1, 7 ), 7 ) ) + IF( MOD({!$Record.Date_Valid__c} - DATE( 1900, 1, 7 ), 7 ) &gt;= {!$Record.Selected_Day_of_Week_Number__c}, 7, 0), null)</expression>
