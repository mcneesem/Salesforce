    <formulas>
        <description>Task Description for - Plan Review Error Found</description>
        <name>f_PlanReviewErrorFoundDesc</name>
        <dataType>String</dataType>
        <expression>if({!record.NSP_OMNI1__c}, &apos;OMNI, &apos;, &apos;&apos;) +
if({!record.NSP_SmartPlan__c}, &apos;SmartPlan, &apos;, &apos;&apos;) +
if({!record.RET_System__c}, &apos;RET System, &apos;, &apos;&apos;) +
if({!record.Salesforce__c}, &apos;Salesforce, &apos;, &apos;&apos;) +
if({!record.Payroll_System__c}, &apos;Payroll System, &apos;, &apos;&apos;) +
if({!record.Custodian__c}, &apos;Custodian, &apos;, &apos;&apos;) +
if(NOT(ISBLANK({!record.ORK_Subplan__c})), &apos;ORK Subplan: &apos; + {!record.ORK_Subplan__c}, &apos;&apos;)</expression>
    </formulas>
    <formulas>
        <description>Task Description for - QC Error Found</description>
        <name>f_QCErrorFoundDesc</name>
        <dataType>String</dataType>
        <expression>IF(
    AND(
        NOT(ISBLANK({!record.Money_File_Error__c})),
        NOT(ISBLANK({!record.Loan_File_Error__c}))
    ),
    &quot;Money File Error : &quot; &amp; {!record.Money_File_Error__c} &amp; &quot; , Loan File Error : &quot; &amp; {!record.Loan_File_Error__c},
    IF(
        NOT(ISBLANK({!record.Money_File_Error__c})),
        &quot;Money File Error : &quot; &amp; {!record.Money_File_Error__c},
        IF(
            NOT(ISBLANK({!record.Loan_File_Error__c})),
            &quot;Loan File Error : &quot; &amp; {!record.Loan_File_Error__c},
            &quot;&quot;
        )
    )
)</expression>
    </formulas>
