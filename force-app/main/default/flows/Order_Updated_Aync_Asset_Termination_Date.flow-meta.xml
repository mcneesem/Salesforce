    <description>Updates Termination Date on Asset when order is updated with backout date</description>
    <environments>Default</environments>
    <formulas>
        <name>AssetTerminationDate</name>
        <dataType>Date</dataType>
        <expression>IF(
ISPICKVAL({!$Record.NSP_Project__r.pse__Project_Status__c},&apos;Close/Lost&apos; ) ,
        IF(
            NOT(ISBLANK({!$Record.NSP_Project__r.Go_Live_Date__c})),
            {!$Record.NSP_Project__r.Go_Live_Date__c},
            TODAY()
        ),
        TODAY()
    )</expression>
    </formulas>
