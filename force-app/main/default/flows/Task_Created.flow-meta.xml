    <decisions>
        <name>Is_Task_Status_Completed_and_should_Lead_Status_be_changed_to_Working</name>
        <label>Is Task Status &quot;Completed&quot; and should Lead Status be changed to &quot;Working&quot;?</label>
        <locationX>2294</locationX>
        <locationY>755</locationY>
        <defaultConnectorLabel>Lead status does not need to be updated</defaultConnectorLabel>
        <rules>
            <name>Yes_Task_is_Completed_and_Lead_should_move_to_Working</name>
            <conditionLogic>(1 OR 2) AND 3</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Completed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.NSP_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Completed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Lead_Info.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>New</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Lead_Record</targetReference>
            </connector>
            <label>Yes - Task is Completed and Lead should move to Working</label>
        </rules>
    </decisions>
