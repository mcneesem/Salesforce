    </formulas>
    <formulas>
        <name>myDomain</name>
        <dataType>String</dataType>
        <expression>IF(
  AND(
    {!$Setup.OrgSettings__c.IsSandbox__c} ,
    NOT( ISBLANK( {!$Setup.OrgSettings__c.SandboxApiName__c} ) )
  ) ,
  &quot;insperity--&quot; &amp; {!$Setup.OrgSettings__c.SandboxApiName__c} &amp; &quot;.sandbox&quot; ,
  &quot;insperity&quot;
)</expression>
    </formulas>
