<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_Stage_and_Reason_Lost_to_varUpdateOpportunity</name>
        <label>Assign Stage and Reason Lost to varUpdateOpportunity</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varUpdateOpportunity.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varOpportunityRecord.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varUpdateOpportunity.StageName</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Closed Lost</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varUpdateOpportunity.NSP_Lost_Reason__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>What_is_the_reason_for_moving_this_opportunity_to_Close_Lost</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varUpdateOpportunity.NSP_ReasonLostNotes__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Reason_Lost_Notes</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varUpdateOpportunity.Product_Recommendation_Outcome__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Product_Recommendation_Outcome</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Opportunity_to_Close_Lost</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_varFaultElement_Get_Opportunity_Info</name>
        <label>Assign varFaultElement - Get Opportunity Info</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varFaultElement</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Get_Opportunity_Info</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Fault_Handler_Subflow</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_varFaultElement_Update_Opportunity_to_Close_Lost</name>
        <label>Assign varFaultElement - Update Opportunity to Close Lost</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varFaultElement</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Update_Opportunity_to_Close_Lost</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <isGoTo>true</isGoTo>
            <targetReference>Fault_Handler_Subflow</targetReference>
        </connector>
    </assignments>
    <choices>
        <name>Continue_working_the_opportunity</name>
        <choiceText>Continue working the opportunity</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Continue working the opportunity</stringValue>
        </value>
    </choices>
    <choices>
        <name>Move_the_opportunity_to_Close_Lost</name>
        <choiceText>Move the opportunity to Close Lost</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Move the opportunity to Close Lost</stringValue>
        </value>
    </choices>
    <customProperties>
        <name>ScreenProgressIndicator</name>
        <value>
            <stringValue>{&quot;location&quot;:&quot;top&quot;,&quot;type&quot;:&quot;simple&quot;}</stringValue>
        </value>
    </customProperties>
    <decisions>
        <name>Check_that_Opportunity_Id_was_passed_in</name>
        <label>Check that Opportunity Id was passed in</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Missing Opty Id</defaultConnectorLabel>
        <rules>
            <name>Yes_Opty_Id_is_populated</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordId</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>recordId</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>006</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Opportunity_Info</targetReference>
            </connector>
            <label>Yes - Opty Id is populated</label>
        </rules>
    </decisions>
    <decisions>
        <name>Continue_working_or_Close_Opty</name>
        <label>Continue working or Close Opty?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>N/A</defaultConnectorLabel>
        <rules>
            <name>Continue_chosen</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>What_is_your_next_step</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Continue_working_the_opportunity</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Reminder_about_Opty_Credits_Screen</targetReference>
            </connector>
            <label>Continue chosen</label>
        </rules>
        <rules>
            <name>Move_Opty_to_Close_Lost</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>What_is_your_next_step</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Move_the_opportunity_to_Close_Lost</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Move_Opty_to_Close_Lost_Screen</targetReference>
            </connector>
            <label>Move Opty to Close Lost</label>
        </rules>
    </decisions>
    <decisions>
        <name>Was_the_Opportunity_found</name>
        <label>Was the Opportunity found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Opty not found or already closed</defaultConnectorLabel>
        <rules>
            <name>Yes_Opty_found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varOpportunityRecord</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>What_is_the_next_step</targetReference>
            </connector>
            <label>Yes - Opty found</label>
        </rules>
    </decisions>
    <description>Added Product Recommendation on Close Lost</description>
