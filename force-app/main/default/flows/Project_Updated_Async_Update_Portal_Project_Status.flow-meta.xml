<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_Fault_Element_Get_Portal_Project</name>
        <label>Set Fault Element : Get_Portal_Project</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>FaultElement</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Get_Portal_Project</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <isGoTo>true</isGoTo>
            <targetReference>Insperity_Fault_Handler_Subflow</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Fault_Element_Update_Portal_Project_Status</name>
        <label>Set Fault Element : Update_Portal_Project_Status</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>FaultElement</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Update_Portal_Project_Status</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Insperity_Fault_Handler_Subflow</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>Validate if Portal Project is exists</description>
        <name>Portal_Project_Exists</name>
        <label>Portal Project Exists?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Update_Portal_Project_Status</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Portal_Project</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Portal_Project_Status</targetReference>
            </connector>
            <label>Yes : Update Portal Project Status</label>
        </rules>
        <rules>
            <name>No_Sync_Portal_Project</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Portal_Project</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.NSP_Visible_to_Client__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Portal_Project_Full_Sync</targetReference>
            </connector>
            <label>No : Sync Portal Project</label>
        </rules>
    </decisions>
    <description>New Client Portal: Show/Hide Portal Project and Full Sync Project &amp; IP details to Portal</description>
    <environments>Default</environments>
    <formulas>
        <description>Hide or Show Portal Project</description>
        <name>f_showhidePortalProject</name>
        <dataType>String</dataType>
        <expression>IF(
  {!$Record.NSP_Visible_to_Client__c} ,
  &quot;Active&quot; ,
  &quot;Hidden&quot;
)</expression>
    </formulas>
    <interviewLabel>Project - Updated - Async - Update Portal Project - Status {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Project - Updated - Async - Update Portal Project - Status</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Retrieve the associated Portal Project</description>
        <name>Get_Portal_Project</name>
        <label>Get Portal Project</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Portal_Project_Exists</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Set_Fault_Element_Get_Portal_Project</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Project__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Portal_Project__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Portal_Project_Status</name>
        <label>Update Portal Project Status</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <targetReference>Set_Fault_Element_Update_Portal_Project_Status</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Portal_Project.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <elementReference>f_showhidePortalProject</elementReference>
            </value>
        </inputAssignments>
        <object>Portal_Project__c</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>pse__Account__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>TemplateName__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>FSO - Implementation</stringValue>
            </value>
        </filters>
        <filters>
            <field>pse__Is_Template__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>NSP_Visible_to_Client__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>pse__Proj__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>Get_Portal_Project</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
    <subflows>
        <name>Insperity_Fault_Handler_Subflow</name>
        <label>Insperity Fault Handler Subflow</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>Insperity_Fault_Handler_Subflow</flowName>
        <inputAssignments>
            <name>faultElement</name>
            <value>
                <elementReference>FaultElement</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>faultFlow</name>
            <value>
                <stringValue>Project_Updated_Async_Update_Portal_Project_Status</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>faultMessage</name>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <subflows>
        <description>Sync Project details, tasks and IP details to Portal</description>
        <name>Portal_Project_Full_Sync</name>
        <label>Portal Project Full Sync</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>Project_Updated_Subflow_Sync_Portal_Project</flowName>
        <inputAssignments>
            <name>projectId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <variables>
        <name>FaultElement</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
