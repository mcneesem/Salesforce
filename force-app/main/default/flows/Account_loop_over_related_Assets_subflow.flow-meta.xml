        <locationX>182</locationX>
        <locationY>650</locationY>
        <defaultConnector>
            <targetReference>Update_Account_Record</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Related Asset was NOT deleted</defaultConnectorLabel>
        <rules>
