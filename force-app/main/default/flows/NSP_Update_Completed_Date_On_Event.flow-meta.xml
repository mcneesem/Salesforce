<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>54.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Checks whether status is completed or not</description>
        <name>Is_Completed</name>
        <label>Is Completed?</label>
        <locationX>314</locationX>
        <locationY>287</locationY>
        <defaultConnector>
            <targetReference>Update_Completed_Date_to_Null_if_Status_is_Empty</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>isCompleted</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.NSP_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Completed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Complete_Date</targetReference>
            </connector>
            <label>isCompleted</label>
        </rules>
        <rules>
            <name>Not_Is_Completed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.NSP_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Open</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Completed_Date_to_Null</targetReference>
            </connector>
            <label>Not Is Completed</label>
        </rules>
    </decisions>
    <description>DEPRECATED - This flow updates the custom &quot;Completed Date&quot; on Event based on NSP_Status__c</description>
    <environments>Default</environments>
    <formulas>
        <description>This Formula is used to store today&apos;s date</description>
        <name>TodayDate</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate}</expression>
    </formulas>
    <interviewLabel>Update Completed Date On Event {!$Flow.CurrentDateTime}</interviewLabel>
    <label>DEPRECATED - Update Completed Date On Event</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>Completed Date is updated to Today based on Status.</description>
        <name>Update_Complete_Date</name>
        <label>Update Complete Date</label>
        <locationX>50</locationX>
        <locationY>395</locationY>
        <inputAssignments>
            <field>NSP_Completed_Date__c</field>
            <value>
                <elementReference>TodayDate</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <description>Completed Date is updated to Null If Status is Open.</description>
        <name>Update_Completed_Date_to_Null</name>
        <label>Update Completed Date to Null</label>
        <locationX>314</locationX>
        <locationY>395</locationY>
        <inputAssignments>
            <field>NSP_Completed_Date__c</field>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Completed_Date_to_Null_if_Status_is_Empty</name>
        <label>Update Completed Date to Null if Status is Empty</label>
        <locationX>578</locationX>
        <locationY>395</locationY>
        <inputAssignments>
            <field>NSP_Completed_Date__c</field>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>188</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Is_Completed</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>NSP_Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </filters>
        <filters>
            <field>NSP_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </filters>
        <object>Event</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Draft</status>
</Flow>
