    <decisions>
        <name>Check_which_Email_should_receive_Notification</name>
        <label>Check which Email should receive Notification</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>National_Account_is_populated_and_not_PCM_or_MidMarket</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetOpportunity.MidMarket_National_Account__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Private Capital Markets (PCM) – MM</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GetOpportunity.MidMarket_National_Account__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Private Capital Markets (PCM)</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GetOpportunity.MidMarket_National_Account__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>MidMarket</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GetOpportunity.MidMarket_National_Account__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GetOpportunity.NSP_Account_Segment__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>MidMarket</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_National_Account</targetReference>
            </connector>
            <label>National Account is populated and not PCM or MidMarket</label>
        </rules>
        <rules>
            <name>National_Account_is_populated_and_is_PCM</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>GetOpportunity.MidMarket_National_Account__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Private Capital Markets (PCM) – MM</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GetOpportunity.MidMarket_National_Account__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Private Capital Markets (PCM)</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Private_Capital_Market</targetReference>
            </connector>
            <label>National Account is populated and is PCM</label>
        </rules>
        <rules>
            <name>Account_Segment_is_MidMarket</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetOpportunity.NSP_Account_Segment__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>MidMarket</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GetOpportunity.MidMarket_National_Account__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Strategic_Sales</targetReference>
            </connector>
            <label>Account Segment is MidMarket</label>
        </rules>
