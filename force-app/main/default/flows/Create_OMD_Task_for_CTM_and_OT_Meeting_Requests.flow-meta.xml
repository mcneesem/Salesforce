    <description>Create/Update Task Record for CTM and Employee/Additional OT Meeting Requests</description>
    <environments>Default</environments>
    <formulas>
        <name>f_AccountName</name>
        <dataType>String</dataType>
        <expression>{!$Record.Account__r.Name}</expression>
    </formulas>
    <formulas>
        <name>f_AIMSClientNum</name>
        <dataType>String</dataType>
        <expression>{!$Record.Account__r.NSP_AIMS_Client__c}</expression>
    </formulas>
    <formulas>
        <name>f_meeting_request_type</name>
        <dataType>String</dataType>
        <expression>IF(TEXT({!$Record.Meeting_Request_Type__c}) = &quot;New Client Orientation Request&quot;, &quot;CTM and Employee Orientation Meeting&quot;,TEXT({!$Record.Meeting_Request_Type__c}))</expression>
    </formulas>
    <formulas>
        <name>f_task_type</name>
        <dataType>String</dataType>
        <expression>IF(TEXT({!$Record.Onboarding_Meeting_Request__r.Meeting_Type__c}) = &apos;Discovery/SKO&apos;,&apos;Client Transition Meeting Request&apos;, TEXT({!$Record.Onboarding_Meeting_Request__r.Meeting_Type__c})+&apos; Request&apos;)</expression>
    </formulas>
    <formulas>
        <name>f_taskdescriptiontemplate</name>
        <dataType>String</dataType>
        <expression>CASE(TEXT({!$Record.Onboarding_Meeting_Request__r.Meeting_Type__c}), &apos;Discovery/SKO&apos;, {!CTM_taskdescriptiontemplate}, &apos;Employee Orientation Meeting&apos;, {!OT_taskdescriptiontemplate} ,&quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>omr_task_subject</name>
        <dataType>String</dataType>
        <expression>TEXT({!$Record.Meeting_Request_Type__c})+&quot; | &quot; + {!Get_picklistvalueinfo_of_sales_office_on_account.Label}</expression>
    </formulas>
