    <description>AZD-516115 , 01/13/2025 - Portal Task Create and Update , upsert operation</description>
    <environments>Default</environments>
    <formulas>
        <name>f_PortalTaskName</name>
        <dataType>String</dataType>
        <expression>CASE(
  {!recordProjectTask.Name} ,  &quot;Employee Priming Data Provided&quot; , &quot;Employee Data Collection&quot; ,
  &quot;FEIN documentation&quot; , &quot;Federal Employer Identification Number (FEIN)&quot; ,
  &quot;Current Payroll Register&quot; , &quot;Current / Prior Payroll Report Samples&quot; ,
  &quot;Job Costing Setup&quot; , &quot;Job Costing / Labor Allocation Setup Information&quot; ,
  &quot;YTD Gross Wage Report Provided&quot; , &quot;YTD Gross Wages Report&quot; ,
  &quot;PTO, paid sick leave, or other accrual policy received&quot; , &quot;Time Off Policies / Handbook&quot; ,
&quot;Generate Form 8973&quot; , &quot;Form 8973&quot; ,
&quot;General/Auto Liability Certificate of Coverage&quot; , &quot;General Auto Liability Certificate of Coverage&quot; ,
&quot;Company Logo Collected&quot; , &quot;Company Logo&quot; ,
&quot;Direct Debit Agreement&quot; , &quot;Direct Debit Agreement&quot; , 
&quot;Client User Access&quot; , &quot;User Access Roles Request Form&quot; , 
  {!recordProjectTask.Name}
)</expression>
    </formulas>
    <formulas>
        <name>f_PortalTaskStatus</name>
        <dataType>String</dataType>
        <expression>IF({!recordProjectTask.Is_Completed__c},  &apos;Completed&apos;, &apos;Pending&apos;)</expression>
    </formulas>
    <formulas>
        <name>PortalTaskTypeValue</name>
        <dataType>String</dataType>
        <expression>CASE(
{!f_PortalTaskName} ,
&quot;Employee Data Collection&quot; , &quot;Pre-Transition Setup&quot; , 
&quot;Federal Employer Identification Number (FEIN)&quot; , &quot;Pre-Transition Setup&quot; , 
&quot;Current / Prior Payroll Report Samples&quot; , &quot;Pre-Transition Setup&quot; , 
&quot;Job Costing / Labor Allocation Setup Information&quot; , &quot;Pre-Transition Setup&quot; , 
&quot;YTD Gross Wages Report&quot; , &quot;Pre-Transition Setup&quot; , 
&quot;Time Off Policies / Handbook&quot; , &quot;Pre-Transition Setup&quot; , 
&quot;Form 8973&quot; , &quot;Company Setup&quot; , 
&quot;General Auto Liability Certificate of Coverage&quot; , &quot;Company Setup&quot; , 
&quot;Company Logo&quot; , &quot;Company Setup&quot; , 
&quot;Direct Debit Agreement&quot; , &quot;Company Setup&quot; , 
&quot;User Access Roles Request Form&quot; , &quot;Company Setup&quot; , 
&quot;&quot; 
)</expression>
    </formulas>
