    <description>12/11/2025 - AZD-500803</description>
    <environments>Default</environments>
    <interviewLabel>Implementation Pay Period - Populate Portal Pay Period - Subflow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Implementation Pay Period - Populate Portal Pay Period - Subflow</label>
    <loops>
        <description>Loop runs only once as there will be only one record should exists for each PC</description>
        <name>Loop_Extract_Pay_Period_Record</name>
        <label>Loop : Extract Pay Period Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Filter_Pay_Periods_for_Each_PC</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_Pay_Period_Record_to_Update</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Valid_Pay_Period_Record</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <description>Loop for each Pay roll contact and process the pay periods for each payroll contact record</description>
        <name>Loop_For_Each_Portal_Client_Record</name>
        <label>Loop : For Each Portal Client Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>rc_portal_clients</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Pay_Period_Exists</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Validate_Update</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <description>Assuming we have multiple PCs for given Account</description>
        <name>Loop_Multiple_Portal_Clients</name>
        <label>Loop : Multiple Portal Clients</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>rc_portal_clients</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_Portal_Client_Id_s</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Get_All_Portal_Pay_Periods</targetReference>
        </noMoreValuesConnector>
    </loops>
