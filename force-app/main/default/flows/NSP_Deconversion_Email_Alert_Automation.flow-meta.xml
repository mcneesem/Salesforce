<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>56.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Fault paths added. Outbound Email bypass added. Deconversion Email Alert Automation for Resource assignment</description>
    <environments>Default</environments>
    <formulas>
        <name>isChangedQCRep</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISNULL({!$Record.NSP_QC_Rep__c})) &amp;&amp; {!$Record.NSP_QC_Rep__c} != {!$Record__Prior.NSP_QC_Rep__c}</expression>
    </formulas>
    <formulas>
        <name>isChangedQCRepTrailing</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISNULL({!$Record.NSP_QC_Rep_Trailing__c})) &amp;&amp; {!$Record.NSP_QC_Rep_Trailing__c} != {!$Record__Prior.NSP_QC_Rep_Trailing__c}</expression>
    </formulas>
    <interviewLabel>Deconversion Email Alert Automation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Deconversion Email Alert Automation</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <filterLogic>(1 AND 3 ) OR (2 AND 4)</filterLogic>
        <filters>
            <field>NSP_QC_Rep__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>NSP_QC_Rep_Trailing__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>NSP_QC_Rep__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>NSP_QC_Rep_Trailing__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>NSP_Deconversion__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>RET_Deconversion_Subflow_Email_Notifications</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
    <subflows>
        <name>RET_Deconversion_Subflow_Email_Notifications</name>
        <label>RET-Deconversion- Subflow - Email Notifications</label>
        <locationX>308</locationX>
        <locationY>276</locationY>
        <flowName>RET_Deconversion_Subflow_Email_Notifications</flowName>
        <inputAssignments>
            <name>isChangedQCRep</name>
            <value>
                <elementReference>isChangedQCRep</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>isChangedQCRepTrailing</name>
            <value>
                <elementReference>isChangedQCRepTrailing</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>record</name>
            <value>
                <elementReference>$Record</elementReference>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
