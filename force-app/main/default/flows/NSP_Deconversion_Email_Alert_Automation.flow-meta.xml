    <decisions>
        <description>Check if QC Rep is updated or populated</description>
        <name>Check_if_QC_Rep_is_updated</name>
        <label>Check if QC Rep is updated</label>
        <locationX>374</locationX>
        <locationY>431</locationY>
        <defaultConnector>
            <targetReference>QcRepTrailingUpdated</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>isQcRepUpdatated</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.NSP_QC_Rep__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.NSP_QC_Rep__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.NSP_QC_Rep__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Qc_Rep_Assignment_Email_Alert</targetReference>
            </connector>
            <label>isQcRepUpdatated?</label>
        </rules>
    </decisions>
