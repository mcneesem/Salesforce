        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterFormula>AND({!$Record.IsActive}, NOT(ISBLANK({!$Record.UserRoleId})), CONTAINS(UPPER({!$Record.UserRole.Name}), &quot;SELLER&quot;))</filterFormula>
        <object>User</object>
