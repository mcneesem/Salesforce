<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <assignments>
        <description>Set Number of EE on Account to Number of Employees field value since another flow will be updating the Employees field on the Account record anyway</description>
        <name>Update_Num_EEs_on_Acct_field</name>
        <label>Update Num EEs on Acct field</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <assignmentItems>
            <assignToReference>$Record.Number_Of_EE_On_Acc__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.NSP_Number_of_Employees__c</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <description>Number of Employees changed on a MM Opty for New Product with WA, WO, WS, or WX primary product</description>
    <environments>Default</environments>
    <interviewLabel>Opportunity - Before Save {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity - Before Save - Number of Employees Changed - MM</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Num_EEs_on_Acct_field</targetReference>
        </connector>
        <filterLogic>1 AND (2 OR 3 OR 4 OR 5) AND 6 AND (7 OR 8)</filterLogic>
        <filters>
            <field>NSP_Number_of_Employees__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>NSP_PrimaryProduct__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>WX</stringValue>
            </value>
        </filters>
        <filters>
            <field>NSP_PrimaryProduct__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>WA</stringValue>
            </value>
        </filters>
        <filters>
            <field>NSP_PrimaryProduct__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>WO</stringValue>
            </value>
        </filters>
        <filters>
            <field>NSP_PrimaryProduct__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>WS</stringValue>
            </value>
        </filters>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>New Product</stringValue>
            </value>
        </filters>
        <filters>
            <field>NSP_Account_Segment__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>MidMarket</stringValue>
            </value>
        </filters>
        <filters>
            <field>Opty_NumOfEmp_more_than_MM_Threshold__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Draft</status>
</Flow>
