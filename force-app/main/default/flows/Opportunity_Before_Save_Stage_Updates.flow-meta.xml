    <decisions>
        <description>What was the stage that the opportunity is moving on from?</description>
        <name>What_was_the_prior_stage</name>
        <label>What was the prior stage?</label>
        <locationX>578</locationX>
        <locationY>431</locationY>
        <defaultConnector>
            <targetReference>Update_Current_Stage_Start_Date</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Prior stage not applicable</defaultConnectorLabel>
        <rules>
            <name>Discovery</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Discovery</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_total_Days_in_Discovery</targetReference>
            </connector>
            <label>Discovery</label>
        </rules>
        <rules>
            <name>Analysis</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Analysis</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_total_Days_in_Analysis</targetReference>
            </connector>
            <label>Analysis</label>
        </rules>
        <rules>
            <name>Proposal</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Proposal</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_total_Days_in_Proposal</targetReference>
            </connector>
            <label>Proposal</label>
        </rules>
        <rules>
            <name>Closing</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Closing</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_total_Days_in_Closing</targetReference>
            </connector>
            <label>Closing</label>
        </rules>
    </decisions>
    <description>A flow to run before save to make Stage related updates/changes</description>
    <environments>Default</environments>
    <formulas>
        <description>Calculate the new total Days in Analysis</description>
        <name>totalDaysInAnalysisFormula</name>
        <dataType>Number</dataType>
        <expression>IF( {!priorDaysInAnalysis} &gt; 0, {!priorDaysInAnalysis} + {!priorDaysInCurrentStage}, {!priorDaysInCurrentStage})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <description>Calculate the new total Days in Closing</description>
        <name>totalDaysInClosingFormula</name>
        <dataType>Number</dataType>
        <expression>IF( {!priorDaysInClosing} &gt; 0, {!priorDaysInClosing} + {!priorDaysInCurrentStage}, {!priorDaysInCurrentStage})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <description>Calculate the new total Days in Discovery</description>
        <name>totalDaysInDiscoveryFormula</name>
        <dataType>Number</dataType>
        <expression>IF( {!priorDaysInDiscovery} &gt; 0, {!priorDaysInDiscovery} + {!priorDaysInCurrentStage}, {!priorDaysInCurrentStage} )</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <description>Calculate the new total Days in Proposal</description>
        <name>totalDaysInProposalFormula</name>
        <dataType>Number</dataType>
        <expression>IF( {!priorDaysInProposal} &gt; 0, {!priorDaysInProposal} + {!priorDaysInCurrentStage}, {!priorDaysInCurrentStage})</expression>
        <scale>0</scale>
    </formulas>
