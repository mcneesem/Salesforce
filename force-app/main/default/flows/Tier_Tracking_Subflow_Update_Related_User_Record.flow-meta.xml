    <decisions>
        <name>Is_Tier_Tracking_Record_Active</name>
        <label>Is Tier Tracking Record Active?</label>
        <locationX>710</locationX>
        <locationY>134</locationY>
        <defaultConnectorLabel>Tier Tracking Inactive</defaultConnectorLabel>
        <rules>
            <name>Yes_Tier_Tracking_is_Active</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>tierTrackingRecord</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Flow.CurrentDate</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>tierTrackingRecord.NSP_Tier_Start_Date__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Flow.CurrentDate</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>tierTrackingRecord.NSP_Tier_End_Date__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_User_Record</targetReference>
            </connector>
            <label>Yes - Tier Tracking is Active</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_User_Active</name>
        <label>Is User Active?</label>
        <locationX>314</locationX>
        <locationY>350</locationY>
        <defaultConnectorLabel>User is Inactive</defaultConnectorLabel>
        <rules>
            <name>Yes_User_is_Active</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varUser</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varUser.IsActive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Current_Tier_Level_Number</targetReference>
            </connector>
            <label>Yes - User is Active</label>
        </rules>
    </decisions>
    <description>Added varFaultElement and removed triggeringFlow. If Tier Tracking record is active, and user record is active, update &quot;Current Tier Level&quot; on user record</description>
    <environments>Default</environments>
    <formulas>
