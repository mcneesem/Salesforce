            </connector>
            <label>Has Recipients</label>
        </rules>
    </decisions>
    <description>A Flow to handle Fault Paths from other Flows.
Save a Flow Fault Log record containing fault information.
Sends an email containing fault information.</description>
    <environments>Default</environments>
    <formulas>
        <name>orgApiName</name>
        <dataType>String</dataType>
        <expression>IF(
  {!$Setup.OrgSettings__c.IsSandbox__c} ,
  UPPER( {!$Setup.OrgSettings__c.SandboxApiName__c} ) ,
  &apos;PROD&apos;
)</expression>
    </formulas>
    <formulas>
        <name>recipients</name>
        <dataType>String</dataType>
        <expression>{!$Setup.InboundEmailLogSettings__c.NotificationRecipients__c}</expression>
    </formulas>
    <formulas>
        <name>safeFaultElement</name>
        <dataType>String</dataType>
        <expression>IF(
  NOT( ISBLANK( {!faultElement} ) ) ,
  IF(
    ( LEN( {!faultElement} ) &gt; 255 ) ,
    LEFT( {!faultElement} , 255 ) ,
    {!faultElement}
  ) ,
  &apos;&apos;
)</expression>
    </formulas>
    <formulas>
        <name>safeFaultFlow</name>
        <dataType>String</dataType>
        <expression>IF(
  NOT( ISBLANK( {!faultFlow} ) ) ,
  IF(
    ( LEN( {!faultFlow} ) &gt; 255 ) ,
    LEFT( {!faultFlow} , 255 ) ,
    {!faultFlow}
  ) ,
  &apos;&apos;
)</expression>
    </formulas>
    <formulas>
        <name>safeFaultMessage</name>
        <dataType>String</dataType>
        <expression>IF(
  NOT( ISBLANK( {!faultMessage} ) ) ,
  IF(
    ( LEN( {!faultMessage} ) &gt; 255 ) ,
    LEFT( {!faultMessage} , 255 ) ,
    {!faultMessage}
  ) ,
  &apos;&apos;
)</expression>
    </formulas>
    <formulas>
        <name>safeFaultMessageLong</name>
        <dataType>String</dataType>
        <expression>IF(
  NOT( ISBLANK( {!faultMessage} ) ) ,
  IF(
    ( LEN( {!faultMessage} ) &gt; 32768 ) ,
    LEFT( {!faultMessage} , 32768 ) ,
    {!faultMessage}
  ) ,
  &apos;&apos;
)</expression>
    </formulas>
