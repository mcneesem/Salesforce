    <decisions>
        <description>Prevent Flow Errors: We can&apos;t send your email because your email address domain isn&apos;t verified.</description>
        <name>Check_Recipients</name>
        <label>Check Recipients</label>
        <locationX>314</locationX>
        <locationY>350</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Has_Recipients</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recipients</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
