    <formulas>
        <name>f_LastModifiedDateTime</name>
        <dataType>DateTime</dataType>
        <expression>{!$Record.LastModifiedDate} - (30 / 86400)</expression>
    </formulas>
    <formulas>
        <name>f_MeetingRescheduled</name>
        <dataType>String</dataType>
        <expression>IF({!OnboardingMeetingDetailHistory.meetingRescheduled}, &apos;Meeting has been Rescheduled To &apos; + {!f_OMRDate}, &apos;&apos;)</expression>
    </formulas>
    <formulas>
        <name>f_OMRDate</name>
        <dataType>String</dataType>
        <expression>TEXT(MONTH({!$Record.Onboarding_Meeting_Request_Date__c})) &amp; &quot;-&quot; &amp;
TEXT(DAY({!$Record.Onboarding_Meeting_Request_Date__c})) &amp; &quot;-&quot; &amp;
TEXT(YEAR({!$Record.Onboarding_Meeting_Request_Date__c}))</expression>
    </formulas>
    <formulas>
        <name>f_TaskURL</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Api.partner_server_url_260},find(&apos;/services&apos;,{!$Api.Partner_Server_URL_260}))+{!$Record.TaskId__c}</expression>
    </formulas>
