<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Removed triggeringFlow. Updates the Start date on Order Products to first date of the month.</description>
    <environments>Default</environments>
    <formulas>
        <description>Gives 1st day of the month</description>
        <name>FirstDateOfTheMonth</name>
        <dataType>Date</dataType>
        <expression>DATE(YEAR(TODAY()),MONTH(TODAY()),1)</expression>
    </formulas>
    <interviewLabel>DEPRECATED - Order - Update - Async - First Of The Month Service Dates {!$Flow.CurrentDateTime}</interviewLabel>
    <label>DEPRECATED - Order - Update - Async - First Of The Month Service Dates</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>Updates the dates on the Order Products</description>
        <name>Update_Order_Products</name>
        <label>Update Order Products</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <targetReference>FaultHanlder</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SBQQ__SubscriptionType__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Evergreen</stringValue>
            </value>
        </filters>
        <filters>
            <field>NSP_OrderProductStartDate__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>1st of the month</stringValue>
            </value>
        </filters>
        <filters>
            <field>ServiceDate</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>FirstDateOfTheMonth</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>ServiceDate</field>
            <value>
                <elementReference>FirstDateOfTheMonth</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record.OrderItems</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Amendment</stringValue>
            </value>
        </filters>
        <filters>
            <field>NSP_Transaction_Type__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Termination</stringValue>
            </value>
        </filters>
        <filters>
            <field>NSP_Rev_Rec_Rules_Reviewed__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>NSP_Rev_Rec_Rules_Reviewed__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Order</object>
        <recordTriggerType>Update</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>Update_Order_Products</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
    <subflows>
        <description>This element handles the exceptions during DML.</description>
        <name>FaultHanlder</name>
        <label>FaultHanlder</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>Insperity_Fault_Handler_Subflow</flowName>
        <inputAssignments>
            <name>faultElement</name>
            <value>
                <stringValue>Update_Order_Products</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>faultFlow</name>
            <value>
                <stringValue>Order_Update_Async_First_Of_The_Month_Service_Dates</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>faultMessage</name>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
