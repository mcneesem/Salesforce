<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>57.0</apiVersion>
    <decisions>
        <name>Check_Asset_Recordtype</name>
        <label>Check Asset Recordtype</label>
        <locationX>314</locationX>
        <locationY>287</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_asset_is_T_A</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.AssetId</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue></stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>RecordtypeName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Time_Attendance</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Updating_Company_SaaS_URL_and_Internal_Comments</targetReference>
            </connector>
            <label>If asset is T&amp;A</label>
        </rules>
        <rules>
            <name>If_asset_is_changed_to_non_T_A</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>RecordtypeName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>TA_Recordtype</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.AssetId</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>BlankOut_Company_SaaS_URL_and_Internal_Comments</targetReference>
            </connector>
            <label>If asset is changed to non T&amp;A</label>
        </rules>
    </decisions>
    <description>Updating &quot;Company SaaS URL&quot; and &quot;Internal Comments fields&quot; on Time &amp; Attendance Case with Time &amp; Attendance asset added on case</description>
    <environments>Default</environments>
    <formulas>
        <name>RecordtypeName</name>
        <dataType>String</dataType>
        <expression>{!$Record.Asset.RecordType.DeveloperName}</expression>
    </formulas>
    <formulas>
        <name>TA_Recordtype</name>
        <dataType>Boolean</dataType>
        <expression>{!$Record.Asset.RecordType.DeveloperName}=&apos;Time_Attendance&apos;</expression>
    </formulas>
    <interviewLabel>Time &amp; Attendance Case update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Time &amp; Attendance Case update 10v3</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>BlankOut_Company_SaaS_URL_and_Internal_Comments</name>
        <label>BlankOut Company SaaS URL and Internal Comments</label>
        <locationX>314</locationX>
        <locationY>395</locationY>
        <inputAssignments>
            <field>NSP_Company_SaaS_URL__c</field>
            <value>
                <stringValue></stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>NSP_Internal_Comments__c</field>
            <value>
                <stringValue></stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Updating_Company_SaaS_URL_and_Internal_Comments</name>
        <label>Updating  Company SaaS URL and Internal Comments</label>
        <locationX>50</locationX>
        <locationY>395</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AssetId</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>NSP_Company_SaaS_URL__c</field>
            <value>
                <elementReference>$Record.Asset.NSP_SaaS_URL__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>NSP_Internal_Comments__c</field>
            <value>
                <elementReference>$Record.Asset.NSP_Comments__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>188</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Asset_Recordtype</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>NSP_Category__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Time &amp; Attendance</stringValue>
            </value>
        </filters>
        <object>Case</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
