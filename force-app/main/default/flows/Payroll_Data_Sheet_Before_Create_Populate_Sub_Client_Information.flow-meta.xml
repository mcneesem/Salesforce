<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_PDS_Other_Fields</name>
        <label>Assign PDS Other Fields</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.NSP_States_of_Operation__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.NSP_Sub_Client_Name__r.NSP_States_of_Operations__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Is_Valid_Asset</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Asset_on_PDS</name>
        <label>Set Asset on PDS</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Account__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.NSP_Sub_Client_Name__r.NSP_Account__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.NSP_Government_Contractor__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.NSP_Sub_Client_Name__r.NSP_Asset__r.NSP_Government_Contractor__c</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <description>Check if Sub Client associated to an Asset Record.</description>
        <name>Is_Valid_Asset</name>
        <label>Is Valid Asset?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Valid_Asset</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>r_PDS.NSP_Sub_Client_Name__r.NSP_Asset__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>r_PDS.NSP_Sub_Client_Name__r.NSP_Account__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Asset_on_PDS</targetReference>
            </connector>
            <label>Yes : Valid Asset</label>
        </rules>
    </decisions>
    <decisions>
        <description>Kill Switch for Workday - Verify Payroll Data Sheet Custom Settings enable for Workday - Create PDS</description>
        <name>Kill_Switch_Enable_For_Workday</name>
        <label>Kill Switch : Enable For Workday?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Enable_For_Workday</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Setup.Payroll_Data_Sheet_Settings__c.IsEnabledCreateUpdatePDS__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_PDS_Other_Fields</targetReference>
            </connector>
            <label>Yes : Enable For Workday</label>
        </rules>
    </decisions>
    <description>AZD-509194 : Flow will populate the basics fields , Invoked either by Manual / Integration Process- Workday Implementation</description>
    <environments>Default</environments>
    <interviewLabel>Payroll Data Sheet - Before Create - Populate Sub Client Information {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Payroll Data Sheet - Before Create - Populate Sub Client Information</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Kill_Switch_Enable_For_Workday</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>NSP_Sub_Client_Name__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>NSP_Payroll__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Draft</status>
    <variables>
        <name>r_PDS</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>NSP_Payroll__c</objectType>
    </variables>
</Flow>
