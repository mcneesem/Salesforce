                <elementReference>varFaultElement</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>faultFlow</name>
            <value>
                <stringValue>Event_Created_Async_Discovery_Call_Created_Date_on_Opportunity</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
