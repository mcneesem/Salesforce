        <filterLogic>(1 OR 2) AND 3 AND 4 AND 5 AND 6</filterLogic>
        <filters>
            <field>NSP_Event_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Core Sales</stringValue>
            </value>
        </filters>
        <filters>
            <field>NSP_Event_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Mid Market</stringValue>
            </value>
        </filters>
        <filters>
            <field>NSP_Event_Subtype__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Discovery Call</stringValue>
            </value>
        </filters>
        <filters>
            <field>WhatId</field>
            <operator>StartsWith</operator>
            <value>
                <stringValue>006</stringValue>
            </value>
        </filters>
        <filters>
            <field>CreatedDate</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>CreatedDate</field>
            <operator>NotEqualTo</operator>
        </filters>
        <object>Event</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <scheduledPaths>
