<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_DC_Created_Date</name>
        <label>Assign DC Created Date</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varOpportunity.Discovery_Call_Created_Date__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.CreatedDate</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Opportunity_DC_Created_Date</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_varFaultElement_Get_Opty_Info</name>
        <label>Assign varFaultElement - Get Opty Info</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varFaultElement</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Get_Opportunity_Info</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Fault_Handler_Subflow</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_varFaultElement_Update_Opty_DC_Created_Date</name>
        <label>Assign varFaultElement - Update Opty - DC Created Date</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varFaultElement</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Update_Opportunity_DC_Created_Date</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <isGoTo>true</isGoTo>
            <targetReference>Fault_Handler_Subflow</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_If_Discovery_Call_Created_Date_is_Blank</name>
        <label>Check If Discovery Call Created Date is Blank</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>DC Created Date Not Blank</defaultConnectorLabel>
        <rules>
            <name>DC_Created_Date_Blank</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>varOpportunity.Discovery_Call_Created_Date__c</leftValueReference>
                <operator>EqualTo</operator>
            </conditions>
            <conditions>
                <leftValueReference>varOpportunity.Discovery_Call_Created_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_DC_Created_Date</targetReference>
            </connector>
            <label>DC Created Date Blank</label>
        </rules>
    </decisions>
    <decisions>
        <name>Related_Opportunity_Found</name>
        <label>Related Opportunity Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Opty Not Found</defaultConnectorLabel>
        <rules>
            <name>Related_Opty_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varOpportunity</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_If_Discovery_Call_Created_Date_is_Blank</targetReference>
            </connector>
            <label>Related Opty Found</label>
        </rules>
    </decisions>
    <description>When a Discovery Call Event is created, if the RelatedTo = Opty and that Opty has a blank &quot;Discovery Call Created Date&quot; then it gets populated with the event&apos;s created date.</description>
    <environments>Default</environments>
    <interviewLabel>Event - Created - Async - Discovery Call Created Date on Opportunity {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Event - Created - Async - Discovery Call Created Date on Opportunity</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
