    <decisions>
        <description>Check if Aftd EEs field value is greater than two</description>
        <name>Check_if_Aftd_EEs_field_value_is_greater_than_two</name>
        <label>Check if Aftd EEs field value is greater than two</label>
        <locationX>446</locationX>
        <locationY>2087</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>isAftdEEsGreaterThan2</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.NSP_Aftd_EEs__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>2.0</numberValue>
                </rightValue>
            </conditions>
