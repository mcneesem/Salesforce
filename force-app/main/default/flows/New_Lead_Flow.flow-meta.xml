    <constants>
        <description>This contant is used to store the Error message in string format. And will be displayed when the flow fails due to Duplicate records</description>
        <name>Duplicate_Lead_Error_Message</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Duplicate lead Record exists in the system, Please check the Name, Phone, email and company name and provide the appropriate information.</stringValue>
        </value>
    </constants>
    <constants>
        <description>this variable/constant is used to store &apos;DUPLICATES_DETECTED&apos; string that will be used to identify if the fault is due to duplicate records</description>
        <name>LEAD_DUPLICATES_DETECTED</name>
        <dataType>String</dataType>
        <value>
            <stringValue>DUPLICATES_DETECTED</stringValue>
        </value>
    </constants>
    <constants>
        <description>This constant/variable has the error message that has to be displayed when the flow fails due to required fields not populated</description>
        <name>RequiredFieldsMissingErrorMsgString</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Please enter values in these fields: FirstName, LastName, Company, Phone or Email.</stringValue>
        </value>
    </constants>
    <decisions>
        <description>This decision element checks if variable &quot;leadRecordTypeId&quot; is populated with recordtype id, if not, then assigns default record type Id</description>
        <name>Check_if_RecordTypeId_is_available</name>
        <label>Check if RecordTypeId is available</label>
        <locationX>314</locationX>
        <locationY>278</locationY>
        <defaultConnector>
            <targetReference>crCreate_Lead_Record</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>RecordTypeId_Available</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>leadRecordTypeId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>crCreate_Lead_Record_0</targetReference>
            </connector>
            <label>RecordTypeId Available</label>
        </rules>
    </decisions>
    <decisions>
        <description>This element checks if the fault is due to the duplicate lead records being detected. If yes, then User friendly error message is displayed.</description>
        <name>dmDuplicate_Leads_Detected</name>
        <label>Duplicate Leads Detected</label>
        <locationX>1106</locationX>
        <locationY>518</locationY>
        <defaultConnector>
            <targetReference>Lead_Error_Message</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Duplicate_Lead_Records_Detected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Flow.FaultMessage</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>LEAD_DUPLICATES_DETECTED</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Duplicate_Lead_Error_Message_Screen</targetReference>
            </connector>
            <label>Duplicate Lead Records Detected</label>
        </rules>
        <rules>
            <name>Required_Fields_Missing</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Flow.FaultMessage</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>REQUIRED_FIELD_MISSING</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Flow.FaultMessage</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>FIELD_CUSTOM_VALIDATION_EXCEPTION</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Required_Fields_Missing_Error_Screen</targetReference>
            </connector>
            <label>Required Fields Missing</label>
        </rules>
    </decisions>
