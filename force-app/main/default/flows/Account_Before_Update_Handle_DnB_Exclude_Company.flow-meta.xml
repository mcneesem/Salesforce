    <assignments>
        <name>Assign_DnB_Exclude_FALSE</name>
        <label>Assign DnB Exclude - FALSE</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.dnb_exclude_company__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Assign_DnB_Exclude_TRUE</name>
        <label>Assign DnB Exclude - TRUE</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.dnb_exclude_company__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <description>When the NSP_Sales_Service_Account_Status__c field has a value of Active, Onboarding or On Demand, D&amp;B Exclude Company = TRUE, otherwise D&amp;B Exclude Company = FALSE.</description>
        <name>Is_this_an_Active_Account_that_should_be_DnB_Excluded</name>
        <label>Is this an Active Account that should be DnB Excluded?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_DnB_Exclude_FALSE</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not an Active Account</defaultConnectorLabel>
        <rules>
            <name>Active_Client</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.NSP_Sales_Service_Account_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Active</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.NSP_Sales_Service_Account_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Onboarding</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.NSP_Sales_Service_Account_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>On Demand</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_DnB_Exclude_TRUE</targetReference>
            </connector>
            <label>Active Client</label>
        </rules>
    </decisions>
    <description>When the NSP_Sales_Service_Account_Status__c field has a value of Active, Onboarding or On Demand, D&amp;B Exclude Company = TRUE, otherwise D&amp;B Exclude Company = FALSE.</description>
    <environments>Default</environments>
    <interviewLabel>Account - Before Update - DnB Exclude Company {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account - Before Update - Handle DnB Exclude Company</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
