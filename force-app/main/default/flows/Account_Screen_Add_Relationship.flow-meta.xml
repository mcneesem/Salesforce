<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_recordId_to_varAccountId</name>
        <label>Assign recordId to varAccountId</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varAccountId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Is_varAccountId_populated</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_varAccountId_and_varAction</name>
        <label>Assign varAccountId and varAction</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varAction</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Add Relationship</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Account_Screen_Add_Contact_and_Add_Relationship_Subflow</targetReference>
        </connector>
    </assignments>
    <customProperties>
        <name>ScreenProgressIndicator</name>
        <value>
            <stringValue>{&quot;location&quot;:&quot;top&quot;,&quot;type&quot;:&quot;simple&quot;}</stringValue>
        </value>
    </customProperties>
    <decisions>
        <name>Is_varAccountId_populated</name>
        <label>Is varAccountId populated?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>No_recordId_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>varAccountId is missing</defaultConnectorLabel>
        <rules>
            <name>Yes_recordId_has_varAccountId</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varAccountId</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varAccountId</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>001</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_varAccountId_and_varAction</targetReference>
            </connector>
            <label>Yes - varAccountId is populated</label>
        </rules>
    </decisions>
    <description>Screen flow triggered from custom &quot;Add Relationship&quot; button on Account record in Seller Experience app to relate an existing Contact to the current Account or to create a new AccountContactRelationship record between a related Contact and a different Account.</description>
    <environments>Default</environments>
    <interviewLabel>Account - Screen - Add Relationship {!$Flow.CurrentDateTime}</interviewLabel>
    <isAdditionalPermissionRequiredToRun>true</isAdditionalPermissionRequiredToRun>
    <label>Account - Screen - Add Relationship</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <screens>
