    <decisions>
        <description>if &quot;WX Account Group&quot; is not exists then create project for such self engaged account.
If &quot;WX Account Group&quot; is exists and triggering account is Primary Member then Create Project else don&apos;t create Project</description>
        <name>WX_Account_Group_Exists</name>
        <label>WX Account Group Exists?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
