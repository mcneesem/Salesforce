    <description>Create HR Core Project</description>
    <environments>Default</environments>
    <formulas>
        <name>f_ProjectTemplate</name>
        <dataType>String</dataType>
        <expression>IF(
  AND(
    {!$Record.Name} = {!ptTransitiontoSupport},
    {!$Record.Template_Name_Formula__c} = {!templateiSolvedHCM}
  ),
  {!templateHRCoreY1},
  IF(
    AND(
      {!$Record.Name} = {!ptQuarterlyClientMeeting4},
      {!$Record.Template_Name_Formula__c} = {!templateHRCoreY1}
    ),
   {!templateHRCoreY2},
    &quot;&quot;
  )
)</expression>
    </formulas>
    <interviewLabel>Project Task - Update - Async - Create HRCore Project From Template And Account {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Project Task - Update - Async - Create HRCore Project From Template and Account</label>
