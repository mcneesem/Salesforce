    <description>Create HR Core Project</description>
    <environments>Default</environments>
    <formulas>
        <name>f_ProjectTemplate</name>
        <dataType>String</dataType>
        <expression>IF(
  AND(
    {!$Record.Name} = &quot;Transition to Support&quot;,
    {!$Record.Template_Name_Formula__c} = &quot;iSolved HCM Implementation&quot;
  ),
  &quot;HRCore Client Engagement Y1&quot;,
  IF(
    AND(
      {!$Record.Name} = &quot;Quarterly Client Meeting 4&quot;,
      OR ({!$Record.Template_Name_Formula__c} = &quot;HRCore Client Engagement Y1&quot; , {!$Record.Template_Name_Formula__c} = &quot;HRCore Client Engagement Y2+&quot; )
    ),
   &quot;HRCore Client Engagement Y2+&quot;,
    &quot;&quot;
  )
)</expression>
    </formulas>
    <interviewLabel>Project Task - Update - Async - Create HRCore Project From Template And Account {!$Flow.CurrentDateTime}</interviewLabel>
