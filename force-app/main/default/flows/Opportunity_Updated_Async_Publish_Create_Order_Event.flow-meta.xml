        <locationX>842</locationX>
        <locationY>276</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Ordered</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SBQQ__PrimaryQuote__r.SBQQ__Ordered__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Product_Type</targetReference>
            </connector>
            <label>Is Ordered</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Product_Type</name>
        <label>Check Product Type</label>
        <locationX>578</locationX>
        <locationY>384</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Valid</name>
            <conditionLogic>( 1 AND 2 ) OR ( 3 AND 4 )</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SBQQ__PrimaryQuote__r.NSP_Product_Type__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Recruiting Services</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SBQQ__PrimaryQuote__r.NSP_Product_Type__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>I-9 Assist &amp; E-Verify</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.NSP_PrimaryProduct__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>I-9 Assist &amp; E-Verify</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.NSP_Client_For_Life__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>WO/WS</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Publish_Create_Order_Event</targetReference>
            </connector>
            <label>Is Valid ?</label>
        </rules>
    </decisions>
