            </connector>
            <label>Notify MidMarket Team of WX/WA Opty</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_this_possibly_an_HCM_Lead_Specialist_Opty</name>
        <label>Is this possibly an HCM Lead Specialist Opty?</label>
        <locationX>1075</locationX>
        <locationY>684</locationY>
        <defaultConnectorLabel>N/A</defaultConnectorLabel>
        <rules>
            <name>Need_to_Check_Owner_Perms</name>
            <conditionLogic>(1 OR 2) AND 3 AND 4</conditionLogic>
            <conditions>
                <leftValueReference>$Record.NSP_PrimaryProduct__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>WX</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.NSP_PrimaryProduct__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>WA</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.NSP_Client_For_Life__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>WO/WS</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>New Product</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Apex_CheckUserPermissionController</targetReference>
            </connector>
            <label>Need to Check Owner Perms</label>
        </rules>
    </decisions>
    <decisions>
        <name>MidMarket_Email_Alert_Check</name>
        <label>MidMarket Email Alert Check</label>
        <locationX>1075</locationX>
        <locationY>384</locationY>
        <defaultConnector>
            <targetReference>Is_this_possibly_an_HCM_Lead_Specialist_Opty</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>N/A</defaultConnectorLabel>
        <rules>
            <name>Send_MidMarket_Email</name>
            <conditionLogic>1 AND 2 AND 3 AND 4 AND 5 AND 6</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Opty_NumOfEmp_more_than_MM_Threshold__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Owner_isActive__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Owner_Email_Populated__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Type</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Type</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Client Growth Credit</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.NSP_Mid_Market_Sales_Email__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Opportunity_Subflow_Email_Alerts</targetReference>
            </connector>
            <label>Send MidMarket Email</label>
        </rules>
    </decisions>
