    <decisions>
        <name>Does_varEvent_have_all_the_info_needed</name>
        <label>Does varEvent have all the info needed?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>varEvent is missing info</defaultConnectorLabel>
        <rules>
            <name>Yes_varEvent_has_relevant_info</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>varEvent</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varEvent.WhoId</leftValueReference>
                <operator>WasSet</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varEvent.WhatId</leftValueReference>
                <operator>WasSet</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Is_the_WhoId_a_Lead</targetReference>
            </connector>
            <label>Yes - varEvent has relevant info</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_the_WhoId_a_Lead</name>
        <label>Is the WhoId a Lead?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Is_WhatId_an_Opportunity_or_Account_record</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>WhoId is not equal to Lead</defaultConnectorLabel>
        <rules>
            <name>Yes_WhoId_is_a_Lead</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varEvent.WhoId</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>00Q</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Lead_Info_if_Lead_Status_is_New</targetReference>
            </connector>
            <label>Yes - WhoId is a Lead</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_WhatId_an_Opportunity_or_Account_record</name>
        <label>Is WhatId an Opportunity or Account record?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Not related to a relevant record</defaultConnectorLabel>
        <rules>
            <name>Related_to_Opportunity</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varEvent.WhatId</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>006</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Opportunity_Info</targetReference>
            </connector>
            <label>Related to Opportunity</label>
        </rules>
        <rules>
            <name>Related_to_Account</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varEvent.WhatId</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>001</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Account_Info</targetReference>
            </connector>
            <label>Related to Account</label>
        </rules>
    </decisions>
    <decisions>
        <name>Was_an_Account_found_that_needs_to_be_updated</name>
        <label>Was an Account found that needs to be updated?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Account not found or does not need updating</defaultConnectorLabel>
        <rules>
            <name>Yes_Account_found_and_needs_updating</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
