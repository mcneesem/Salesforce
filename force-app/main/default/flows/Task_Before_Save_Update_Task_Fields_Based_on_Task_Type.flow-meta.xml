        <defaultConnectorLabel>Not WO or WX or missing email</defaultConnectorLabel>
        <rules>
            <name>Opty_found_and_is_WO_or_WX</name>
            <conditionLogic>(1 OR 2) AND 3</conditionLogic>
            <conditions>
                <leftValueReference>Get_Opty_Info.NSP_PrimaryProduct__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>WX</stringValue>
