            </conditions>
            <conditions>
                <leftValueReference>Get_Opty_Info.NSP_PrimaryProduct__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>WO</stringValue>
                </rightValue>
