            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>blng__FinanceBook__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Finance_Period</name>
        <label>Get Finance Period</label>
        <locationX>176</locationX>
        <locationY>455</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Update_fin_book_and_period_on_Credit_Note</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>blng__FinanceBook__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Accounting_Finance_Book.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>blng__LegalEntity__c</field>
            <operator>EqualTo</operator>
