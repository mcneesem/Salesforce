            <value>
                <elementReference>Get_Accounting_Finance_Book.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>blng__BillingFinancePeriod__c</field>
            <value>
                <elementReference>Get_Finance_Period.Id</elementReference>
