    <formulas>
        <name>CalculateContractLength</name>
        <dataType>Number</dataType>
        <expression>ROUND(( {!$Record.NSP_CSA_Multiyear_End_Date__c} - {!$Record.NSP_CSA_Multiyear_Effective_Date__c} ) / 365 , 0)</expression>
