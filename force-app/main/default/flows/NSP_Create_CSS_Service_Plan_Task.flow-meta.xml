    </formulas>
    <formulas>
        <name>CSSStartDatePlus35</name>
        <dataType>Date</dataType>
        <expression>{!$Record.NSP_CSS_Start_Date__c} + IF(WEEKDAY({!$Record.NSP_CSS_Start_Date__c}) = 1, 5, IF(WEEKDAY({!$Record.NSP_CSS_Start_Date__c}) = 7, 6, 7)) + 30</expression>
    </formulas>
