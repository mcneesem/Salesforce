    <constants>
        <name>flowName</name>
        <dataType>String</dataType>
            <value>
            <stringValue>Account_Updated_to_MidMarket_Async</stringValue>
            </value>
    </constants>
    <decisions>
        <name>Bypass_Trigger</name>
        <label>Bypass Trigger?</label>
        <locationX>506</locationX>
        <locationY>276</locationY>
        <defaultConnectorLabel>No Bypass Trigger or MidMarket Threshold not met</defaultConnectorLabel>
        <rules>
            <name>Yes_Bypass_Trigger</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Setup.NSP_Trigger_Switch__c.AutoLaunchedFlows__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Yes - Bypass Trigger</label>
        </rules>
        <rules>
            <name>NumberOfEmployees_greater_than_MidMarket_Threshold</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.NumberOfEmployees</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>midMarketThresholdFormula</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Account_Email_Alert_Subflow</targetReference>
            </connector>
            <label>NumberOfEmployees greater than MidMarket Threshold?</label>
        </rules>
    </decisions>
    <description>Triggers when NumberOfEmployees is changed and evaluates if it exceeds MidMarket Threshold</description>
    <environments>Default</environments>
    <formulas>
        <name>midMarketThresholdFormula</name>
        <dataType>Number</dataType>
        <expression>VALUE({!$Label.NSP_MidMarket_Threshold})</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Account - Updated to MidMarket Async {!$Flow.CurrentDateTime}</interviewLabel>
    <label>DEPRECATED - Account - Updated to MidMarket Async</label>
    <processMetadataValues>
