<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <decisions>
        <description>Event should be cancelled when Status is Open, or Status is blank, and is 30 day stale</description>
        <name>Should_Event_be_cancelled</name>
        <label>Should Event be cancelled?</label>
        <locationX>314</locationX>
        <locationY>252</locationY>
        <defaultConnectorLabel>Do Not Cancel Event</defaultConnectorLabel>
        <rules>
            <name>Yes_Cancel_Event</name>
            <conditionLogic>((1 AND 2) OR 3) AND (4 OR 5)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ActivityDate</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>createdAtLeast30DaysAgo</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>activityDateAtLeast30DaysAgo</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.NSP_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Open</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.NSP_Status__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Event_status_to_Cancelled</targetReference>
            </connector>
            <label>Yes - Cancel Event</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>activityDateAtLeast30DaysAgo</name>
        <dataType>Boolean</dataType>
        <expression>IF( ( TODAY() - {!$Record.ActivityDate} ) &gt;= 30, true, false )</expression>
    </formulas>
    <formulas>
        <name>createdAtLeast30DaysAgo</name>
        <dataType>Boolean</dataType>
        <expression>IF( ( TODAY() - DATEVALUE( {!$Record.CreatedDate} ) ) &gt;= 30, true, false )</expression>
    </formulas>
    <interviewLabel>Event - Scheduled Cancellation of Sales Events {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Event - Scheduled Cancellation of Sales Events</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Set_Event_status_to_Cancelled</name>
        <label>Set Event status to &quot;Cancelled&quot;</label>
        <locationX>50</locationX>
        <locationY>360</locationY>
        <faultConnector>
            <targetReference>Fault_Handler_Subflow</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>NSP_Status__c</field>
            <value>
                <stringValue>Cancelled</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>188</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Should_Event_be_cancelled</targetReference>
        </connector>
        <filterLogic>1 AND (2 OR 3) AND 4 AND 5</filterLogic>
        <filters>
            <field>RecordTypeId</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>0124x000000yRv2AAE</stringValue>
            </value>
        </filters>
        <filters>
            <field>NSP_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Open</stringValue>
            </value>
        </filters>
        <filters>
            <field>NSP_Status__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>IsRecurrence2</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>FSL__Event_Type__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Event</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2024-03-14</startDate>
            <startTime>03:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Draft</status>
    <subflows>
        <name>Fault_Handler_Subflow</name>
        <label>Fault Handler Subflow</label>
        <locationX>314</locationX>
        <locationY>468</locationY>
        <flowName>Insperity_Fault_Handler_Subflow</flowName>
        <inputAssignments>
            <name>faultMessage</name>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>triggeringFlow</name>
            <value>
                <stringValue>Event - Scheduled Cancellation of Sales Events</stringValue>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
