    <formulas>
        <name>safeStreetAddress</name>
        <dataType>String</dataType>
        <expression>IF(
  NOT( ISBLANK( {!streetAddressesJoined} ) ) ,
  IF(
    ( LEN( {!streetAddressesJoined} ) &gt; 255 ) ,
    LEFT( {!streetAddressesJoined} , 255 ) ,
    {!streetAddressesJoined}
