    <decisions>
        <description>Check if the Account group type is account health or Renewal Probability</description>
        <name>Check_Account_Group_Type</name>
        <label>Check Account Group Type</label>
        <locationX>358</locationX>
        <locationY>335</locationY>
        <defaultConnectorLabel>Default outcome</defaultConnectorLabel>
        <rules>
            <name>Account_Health_Group_Type</name>
            <conditionLogic>1 AND (  2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.NSP_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Account Health</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.NSP_Account_Health__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.NSP_Account_Health__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Associcate_Account_members_Account_Ids</targetReference>
            </connector>
            <label>Account Health Group Type</label>
        </rules>
        <rules>
            <name>Renewal_Probability_Group_Types</name>
            <conditionLogic>1 AND  (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.NSP_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Renewal Probability</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.NSP_Renewal_Probability__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.NSP_Renewal_Probability__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Renewal_Probability_Account_members_Account_Ids</targetReference>
            </connector>
            <label>Renewal Probability Group Types</label>
        </rules>
    </decisions>
