<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>57.0</apiVersion>
    <constants>
        <name>flowName</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Opportunity - Created with MidMarket National Account</stringValue>
        </value>
    </constants>
    <decisions>
        <name>Is_Account_MMNA</name>
        <label>Is Account MMNA</label>
        <locationX>314</locationX>
        <locationY>455</locationY>
        <defaultConnectorLabel>No - Account is not MMNA</defaultConnectorLabel>
        <rules>
            <name>Yes_Account_is_MMNA</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>AccountMMNA</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_New_Oppo</targetReference>
            </connector>
            <label>Yes - Account is MMNA</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>AccountMMNA</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISPICKVAL({!Get_Parent_Account.MidMarket_National_Account__c},&quot;&quot;))</expression>
    </formulas>
    <interviewLabel>Opportunity - Created with MidMarket National Account {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity - Created with MidMarket National Account</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Parent_Account</name>
        <label>Get Parent Account</label>
        <locationX>314</locationX>
        <locationY>335</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_Account_MMNA</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Fault_Handler_Subflow</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Account.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_New_Oppo</name>
        <label>Update New Oppo</label>
        <locationX>50</locationX>
        <locationY>575</locationY>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Fault_Handler_Subflow</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>NSP_MidMarketNationalAccount__c</field>
            <value>
                <elementReference>Get_Parent_Account.MidMarket_National_Account__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>188</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Parent_Account</targetReference>
        </connector>
        <object>Opportunity</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>Fault_Handler_Subflow</name>
        <label>Fault Handler Subflow</label>
        <locationX>842</locationX>
        <locationY>455</locationY>
        <flowName>Insperity_Fault_Handler_Subflow</flowName>
        <inputAssignments>
            <name>faultMessage</name>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>triggeringFlow</name>
            <value>
                <elementReference>flowName</elementReference>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
