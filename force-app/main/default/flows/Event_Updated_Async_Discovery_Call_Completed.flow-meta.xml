    <decisions>
        <description>Prevent DmlExceptions: HCM Sales Consultants can modify only WX Opportunities.</description>
        <name>Check_HCM_Rules</name>
        <label>Check HCM Rules</label>
        <locationX>209</locationX>
        <locationY>492</locationY>
        <defaultConnector>
            <targetReference>Assign_Discovery_Call_Completed_Date</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>HCM_Not_Allowed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Permission.Opportunity_WX_Product_Only</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varOpportunity.NSP_PrimaryProduct__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>WX</stringValue>
                </rightValue>
            </conditions>
            <label>HCM Not Allowed</label>
        </rules>
    </decisions>
    <decisions>
        <name>Related_Opportunity_Found</name>
        <label>Related Opportunity Found?</label>
        <locationX>539</locationX>
        <locationY>384</locationY>
        <defaultConnectorLabel>Opty NOT found</defaultConnectorLabel>
        <rules>
            <name>Related_Opty_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varOpportunity</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_HCM_Rules</targetReference>
            </connector>
            <label>Related Opty Found</label>
        </rules>
    </decisions>
    <environments>Default</environments>
