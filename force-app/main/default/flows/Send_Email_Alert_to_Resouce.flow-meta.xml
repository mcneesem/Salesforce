<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>55.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <constants>
        <name>emailContatant</name>
        <dataType>String</dataType>
        <value>
            <stringValue>abhishek.1rn17ec003@gmail.com</stringValue>
        </value>
    </constants>
    <description>Fault paths added. Outbound Email bypass added. Send an Email Alert to assigned NBI IMPL Resource  or QC Rep on S2I for assignment or completion</description>
    <environments>Default</environments>
    <formulas>
        <description>Url of S2I rec, triggering the flow</description>
        <name>salesToImplementationRecUrl</name>
        <dataType>String</dataType>
        <expression>LEFT($Api.Partner_Server_URL_260, FIND( &apos;/services&apos;, $Api.Partner_Server_URL_260)) + &quot;/lightning/r/NSP_Sales_to_Implementation__c/&quot; + {!$Record.Id} + &quot;/view&quot;</expression>
    </formulas>
    <interviewLabel>Send Email Alert to Resouce {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Send Email Alert to Resource on S2I Records</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>RET_Sales_to_Implementation_Subflow_Email_Alerts</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>NSP_Implementation_NBI_Resource__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>NSP_QC_Rep__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>NSP_Sales_to_Implementation__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
    <subflows>
        <name>RET_Sales_to_Implementation_Subflow_Email_Alerts</name>
        <label>RET-Sales-to-Implementation -Subflow - Email Alerts</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <flowName>RET_Sales_to_Implementation_Subflow_Email_Alerts</flowName>
        <inputAssignments>
            <name>PriorRETRecord</name>
            <value>
                <elementReference>$Record__Prior</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>RETRecord</name>
            <value>
                <elementReference>$Record</elementReference>
            </value>
        </inputAssignments>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </subflows>
    <textTemplates>
        <description>Body of the email template of NBI IMPL Res Assignment</description>
        <name>EmailbodyforNBIIMPLAssignment</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;You have been assigned S2I record.&amp;nbsp;Please review the Installation tab of the following record &lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;You may find the record via the following link&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;{!salesToImplementationRecUrl}&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; style=&quot;background-color: rgb(255, 255, 255); font-size: 14px;&quot;&gt;&lt;u&gt;View Record&lt;/u&gt;&lt;/a&gt;&lt;/p&gt;</text>
    </textTemplates>
    <textTemplates>
        <description>Email Body for QC Completion Mail</description>
        <name>EmailBodyforQCCompletionMail</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;&lt;span style=&quot;font-size: 12px; background-color: rgb(255, 255, 255);&quot;&gt;A S2I installation quality control has been completed.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;You may find the record via the following link&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;{!salesToImplementationRecUrl}&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;&lt;u&gt;View Record&lt;/u&gt;&lt;/a&gt;&amp;nbsp;&lt;/p&gt;</text>
    </textTemplates>
    <textTemplates>
        <description>Body of Email for QC Rep Assignment</description>
        <name>EmailbodyforQCRepAssignment</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); font-size: 12px;&quot;&gt;A S2I Installation has been assigned for quality review&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;You may find the record via the following link&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;{!salesToImplementationRecUrl}&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; style=&quot;font-size: 12px;&quot;&gt;&lt;u&gt;View Record&lt;/u&gt;&lt;/a&gt;&lt;/p&gt;</text>
    </textTemplates>
    <textTemplates>
        <description>Email Body for S2I completion</description>
        <name>EmailBodyForS2ICompletion</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;&lt;span style=&quot;font-size: 12px; background-color: rgb(255, 255, 255);&quot;&gt;A S2I Installation has been completed by the NBI Team.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;You may find the record via the following link&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;{!salesToImplementationRecUrl}&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;&lt;u&gt;View Record&lt;/u&gt;&lt;/a&gt;&lt;/p&gt;</text>
    </textTemplates>
    <variables>
        <description>Stores Email address of NBI Resource and Sales Consultant</description>
        <name>EmailAddressCollectionOfNBIResAndSalesConsultanat</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>varFaultElement</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
