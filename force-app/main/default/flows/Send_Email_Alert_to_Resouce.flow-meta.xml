<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Fault paths added. Outbound Email bypass added. Send an Email Alert to assigned NBI IMPL Resource  or QC Rep on S2I for assignment or completion</description>
    <environments>Default</environments>
    <formulas>
        <name>IsChangedNBIResourceFormula</name>
        <dataType>Boolean</dataType>
        <expression>{!$Record.NSP_Implementation_NBI_Resource__c}!= {!$Record__Prior.NSP_Implementation_NBI_Resource__c}</expression>
    </formulas>
    <formulas>
        <name>IsChangedQCRepFormula</name>
        <dataType>Boolean</dataType>
        <expression>{!$Record.NSP_QC_Rep__c} != {!$Record__Prior.NSP_QC_Rep__c}</expression>
    </formulas>
    <interviewLabel>Send Email Alert to Resouce {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Send Email Alert to Resource on S2I Records</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>( ( 1 AND 2 ) OR ( 3 AND 4 ) )</filterLogic>
        <filters>
            <field>NSP_Implementation_NBI_Resource__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>NSP_Implementation_NBI_Resource__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>NSP_QC_Rep__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>NSP_QC_Rep__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>NSP_Sales_to_Implementation__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>RET_Sales_to_Implementation_Subflow_Email_Notifications</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
    <subflows>
        <name>RET_Sales_to_Implementation_Subflow_Email_Notifications</name>
        <label>RET_Sales_to_Implementation_Subflow_Email_Notifications</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>RET_Sales_to_Implementation_Subflow_Email_Notifications</flowName>
        <inputAssignments>
            <name>isChangedNBIResource</name>
            <value>
                <elementReference>IsChangedNBIResourceFormula</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>isChangedQCRep</name>
            <value>
                <elementReference>IsChangedQCRepFormula</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>record</name>
            <value>
                <elementReference>$Record</elementReference>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
