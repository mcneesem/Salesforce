    <formulas>
        <description>Adding up 3 business days with the parent case closed date.</description>
        <name>VarDueDate_Add_3</name>
        <dataType>Date</dataType>
        <expression>CASE(
    WEEKDAY(DATEVALUE({!$Record.ClosedDate})),
    1, DATEVALUE({!$Record.ClosedDate}) + 3,
    2, DATEVALUE({!$Record.ClosedDate}) + 3,
    3, DATEVALUE({!$Record.ClosedDate}) + 3,
