    <decisions>
        <description>Checks whether status is completed or not</description>
        <name>What_is_the_new_status</name>
        <label>What is the new status?</label>
        <locationX>182</locationX>
        <locationY>287</locationY>
        <defaultConnector>
            <targetReference>Clear_Completed_Date</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Completed</defaultConnectorLabel>
        <rules>
            <name>Completed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.NSP_Status__c</leftValueReference>
