                <rightValue>
                    <stringValue>Completed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Completed_Date</targetReference>
            </connector>
            <label>Completed</label>
        </rules>
    </decisions>
    <description>If the Event is created with a NSP_Status = &quot;Completed&quot; then set the &quot;Completed Date&quot; to TODAY</description>
