    <decisions>
        <description>varOpportunity must have: Id, StageName, AccountId populated</description>
        <name>Does_varOpportunity_have_all_info_needed</name>
        <label>Does varOpportunity have all info needed?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>varOpportunity is missing info</defaultConnectorLabel>
        <rules>
            <name>Yes_varOpportunity_is_populated</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varOpportunity</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varOpportunity.Id</leftValueReference>
                <operator>WasSet</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varOpportunity.StageName</leftValueReference>
                <operator>WasSet</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varOpportunity.AccountId</leftValueReference>
                <operator>WasSet</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varOpportunity.Id</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varOpportunity.StageName</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varOpportunity.AccountId</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Account_Info</targetReference>
            </connector>
            <label>Yes - varOpportunity is populated</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Opportunity_in_Data_Collection_or_later</name>
        <label>Is Opportunity in Data Collection or later?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Stage is not applicable</defaultConnectorLabel>
        <rules>
            <name>Yes_Moved_to_Data_Collection_or_later</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>varOpportunity.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Data Collection</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varOpportunity.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Analysis</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varOpportunity.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Proposal</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varOpportunity.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Closing</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varOpportunity.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Booking</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varOpportunity.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Closed Won</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Account_DnB_Exclude_TRUE</targetReference>
            </connector>
            <label>Yes - Moved to Data Collection or later</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_the_Opportunity_Closed_Lost</name>
        <label>Is the Opportunity Closed Lost?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Not moved to Closed Lost</defaultConnectorLabel>
        <rules>
            <name>Opportunity_is_Closed_Lost</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varOpportunity.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Closed Lost</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Opportunity_History</targetReference>
            </connector>
            <label>Opportunity is Closed Lost</label>
        </rules>
    </decisions>
    <decisions>
        <name>Null_check_for_varOpportunityHistory</name>
        <label>Null check for varOpportunityHistory</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>varOpportunityHistory is null or missing</defaultConnectorLabel>
        <rules>
            <name>varOpportunityHistory_isNull_FALSE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varOpportunityHistory</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Was_previous_Stage_Data_Collection_or_later</targetReference>
            </connector>
            <label>varOpportunityHistory isNull = FALSE</label>
        </rules>
    </decisions>
    <decisions>
        <name>Was_Account_found</name>
        <label>Was Account found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Account not found</defaultConnectorLabel>
        <rules>
            <name>Yes_Account_was_found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varAccount</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>What_is_the_Account_s_Current_DnB_Exclude_Value</targetReference>
            </connector>
            <label>Yes - Account was found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Was_previous_Stage_Data_Collection_or_later</name>
        <label>Was previous Stage &quot;Data Collection&quot; or later?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Previous Stage is not applicable</defaultConnectorLabel>
        <rules>
            <name>Yes_Previously_Data_Collection_or_later</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>varOpportunityHistory.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Data Collection</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varOpportunityHistory.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Analysis</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varOpportunityHistory.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Proposal</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varOpportunityHistory.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Closing</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varOpportunityHistory.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Booking</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varOpportunityHistory.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Closed Won</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Account_DnB_Exclude_FALSE</targetReference>
            </connector>
            <label>Yes - Previously Data Collection or later</label>
        </rules>
    </decisions>
    <decisions>
        <name>What_is_the_Account_s_Current_DnB_Exclude_Value</name>
        <label>What is the Account&apos;s Current DnB Exclude Value?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Is_Opportunity_in_Data_Collection_or_later</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Exclude = FALSE</defaultConnectorLabel>
        <rules>
            <name>Exclude_TRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varAccount.DNB_Exclude_Company__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Is_the_Opportunity_Closed_Lost</targetReference>
            </connector>
            <label>Exclude = TRUE</label>
        </rules>
    </decisions>
    <description>Based on related Account&apos;s D&amp;B Exclude Company value, update to True or False based on Stage changes.</description>
