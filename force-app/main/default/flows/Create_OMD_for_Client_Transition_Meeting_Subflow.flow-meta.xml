    <formulas>
        <name>first_available_block</name>
        <dataType>Date</dataType>
        <expression>CASE(WEEKDAY(TODAY()), 1, TODAY()+4, 2, TODAY()+4, 3, TODAY()+6, 4, TODAY()+6, 5, TODAY()+6, 6, TODAY()+6, 7, TODAY()+5, TODAY()+4)</expression>
    </formulas>
    <formulas>
        <name>formuladecrementOMRrecord</name>
        <dataType>Number</dataType>
        <expression>{!OMRdatatable.firstSelectedRow.Available_Reps__c}-1</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>last_available_block</name>
        <dataType>Date</dataType>
        <expression>TODAY()+183</expression>
    </formulas>
    <formulas>
        <name>safeClientContactPhone</name>
        <dataType>String</dataType>
        <expression>IF(
  NOT( ISBLANK( {!ossphone.value} ) ) ,
  IF(
    ( LEN( {!ossphone.value} ) &gt; 40 ) ,
    LEFT( {!ossphone.value} , 40 ) ,
    {!ossphone.value}
  ) ,
  &apos;&apos;
)</expression>
    </formulas>
