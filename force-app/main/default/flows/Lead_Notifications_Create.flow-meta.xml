    <description>Migrated from the Notify Lead Owner of Assignment process using multiple criteria.
The PB notifies the lead record owner whenever a record is assigned to them. Default the Lead Stage field to &apos;Suspect&apos; if its blank</description>
    <environments>Default</environments>
    <formulas>
        <name>formulaNotifyLoyaltyLeadandLeadOwner</name>
        <dataType>Boolean</dataType>
        <expression>AND (ISNEW(),ISPICKVAL({!$Record.LeadSource}, &quot;Loyalty&quot;),NOT(ISBLANK({!$Record.NSP_Partner_Email__c})))</expression>
    </formulas>
    <formulas>
        <name>formulaNotifyPartnerandLeadOwner</name>
        <dataType>Boolean</dataType>
        <expression>AND (ISNEW(),ISPICKVAL({!$Record.LeadSource}, &quot;Partner&quot;),NOT(ISBLANK({!$Record.NSP_Partner_Email__c})))</expression>
    </formulas>
