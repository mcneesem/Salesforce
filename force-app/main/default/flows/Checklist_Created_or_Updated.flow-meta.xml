<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>56.0</apiVersion>
    <decisions>
        <description>Has the &quot;Requested First Pay Date&quot; field been entered/changed on the Checklist that needs to then be mapped to/updated on the related Opportunity?</description>
        <name>Has_the_Requested_First_Pay_Date_been_changed</name>
        <label>Has the Requested First Pay Date been changed?</label>
        <locationX>182</locationX>
        <locationY>455</locationY>
        <defaultConnectorLabel>Date not changed</defaultConnectorLabel>
        <rules>
            <name>Yes_Requested_First_Pay_Date_changed</name>
            <conditionLogic>(1 OR (2 AND 3)) AND 4</conditionLogic>
            <conditions>
                <leftValueReference>$Record.NSP_Requested_First_Pay_Date__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>IsNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.NSP_Requested_First_Pay_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.NSP_Opportunity__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Related_Opty</targetReference>
            </connector>
            <label>Yes - Requested First Pay Date changed</label>
        </rules>
    </decisions>
    <decisions>
        <description>Checks to see if the Checklist is the &quot;Sold To Paid&quot; type before moving on.</description>
        <name>Is_this_an_STP_Checklist</name>
        <label>Is this an STP Checklist?</label>
        <locationX>380</locationX>
        <locationY>335</locationY>
        <defaultConnectorLabel>Not STP Checklist</defaultConnectorLabel>
        <rules>
            <name>Yes_STP_Checklist</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>NSP_Sold_to_Paid_Checklist</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Has_the_Requested_First_Pay_Date_been_changed</targetReference>
            </connector>
            <label>Yes - STP Checklist</label>
        </rules>
    </decisions>
    <description>When an STP Checklist is created with a Requested First Pay Date, or if the Requested First Pay Date is changed, then update the related field on the Opportunity</description>
    <environments>Default</environments>
    <formulas>
        <description>A formula to see if the record is new</description>
        <name>IsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <interviewLabel>Checklist - Created or Updated {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Checklist - Created or Updated</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>Update the &quot;Requested First Pay Date&quot; field on the related Opty record</description>
        <name>Update_Related_Opty</name>
        <label>Update Related Opty</label>
        <locationX>50</locationX>
        <locationY>575</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.NSP_Opportunity__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>STP_Requested_First_Pay_Date__c</field>
            <value>
                <elementReference>$Record.NSP_Requested_First_Pay_Date__c</elementReference>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
    <start>
        <locationX>254</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Is_this_an_STP_Checklist</targetReference>
        </connector>
        <object>NSP_Checklist__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
