    <decisions>
        <description>Decision block for checking termination transaction. (Use Skip path for any future development other than termination)</description>
        <name>Check_Termination_Validity</name>
        <label>Check Termination Validity</label>
        <locationX>314</locationX>
        <locationY>384</locationY>
        <defaultConnectorLabel>Skip</defaultConnectorLabel>
        <rules>
