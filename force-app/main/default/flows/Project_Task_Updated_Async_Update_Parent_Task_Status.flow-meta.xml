            <connector>
                <targetReference>Get_Parent_Task_Record</targetReference>
            </connector>
            <label>Yes : Parent Task</label>
        </rules>
    </decisions>
    <decisions>
        <description>1) When one of child task status = Complete  then Set Parent = In Progress
2) When Mix of of child task status = Complete and Canceled then Set Parent = Complete
3) When all child task status = Complete  then Set Parent = Complete
4) When all child task status = Canceled  then Set Parent = Canceled</description>
        <name>Status_Completed_or_Canceled</name>
        <label>Status = Completed or Canceled</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Status_Complete_has_open_tasks</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>count_CompletedTasks</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>count_OpenTasks</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Parent_Task_Status_In_Progress</targetReference>
            </connector>
            <label>Status = Complete and/or has open tasks</label>
        </rules>
        <rules>
            <name>StatusCanceled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>count_CanceledTasks</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>count_AllChildTasks</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Parent_Task_Status_Canceled</targetReference>
            </connector>
            <label>Status = Canceled &amp; has no open tasks</label>
        </rules>
        <rules>
            <name>Status_Complete_has_no_open_tasks</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>count_CompletedTasks</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>count_OpenTasks</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Parent_Task_Status_Complete</targetReference>
            </connector>
            <label>Status = Complete &amp; has no open tasks</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check valid parent record exists</description>
        <name>Valid_Parent_Record</name>
        <label>Valid Parent Record?</label>
        <locationX>0</locationX>
