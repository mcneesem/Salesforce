    <formulas>
        <name>f_CTM_Date</name>
        <dataType>Date</dataType>
        <expression>CASE({!v_Meeting_Request_Type}, &apos;New Hire Orientation (current client)&apos;, TODAY(), &apos;Mid-Year Election (Revolution to Insperity Plan)&apos;,TODAY(),{!r_OMD_CTM_Meeting.Onboarding_Meeting_Request__r.Date_Valid__c})</expression>
    </formulas>
    <formulas>
        <name>f_disable_edit</name>
        <dataType>Boolean</dataType>
        <expression>IF({!OMRdatatable.firstSelectedRow.Id} = null , True, False)</expression>
    </formulas>
    <formulas>
        <name>first_available_block</name>
        <dataType>Date</dataType>
        <expression>CASE(WEEKDAY({!f_CTM_Date}), 1, {!f_CTM_Date} + 2, 2, {!f_CTM_Date} + 2, 3, {!f_CTM_Date} + 2, 4, {!f_CTM_Date} + 2, 5, {!f_CTM_Date} + 4, 6, {!f_CTM_Date} + 4, 7, {!f_CTM_Date} + 3, {!f_CTM_Date} + 2)</expression>
    </formulas>
    <formulas>
        <name>last_available_block</name>
        <dataType>Date</dataType>
        <expression>{!f_CTM_Date} + 183</expression>
    </formulas>
