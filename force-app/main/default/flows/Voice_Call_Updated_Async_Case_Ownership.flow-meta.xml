            <conditions>
                <leftValueReference>newCaseOwnerId</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CaseId__r.OwnerId</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
