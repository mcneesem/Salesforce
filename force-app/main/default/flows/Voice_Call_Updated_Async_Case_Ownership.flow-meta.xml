            </connector>
            <label>Found Case</label>
        </rules>
    </decisions>
    <decisions>
        <description>Prevent DmlExceptions.  Closed Cases can not be modified due to Case Validation Rules.</description>
        <name>Check_Case_Status</name>
        <label>Check Case Status</label>
        <locationX>578</locationX>
        <locationY>384</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Not_Closed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CaseId__r.Status</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Closed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Initialize_New_Case_Owner_Id</targetReference>
            </connector>
            <label>Not Closed</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_New_Case_Owner_Id</name>
