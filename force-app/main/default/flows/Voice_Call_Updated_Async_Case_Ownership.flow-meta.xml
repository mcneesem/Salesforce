                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Case_Owner</targetReference>
            </connector>
            <label>Has New Case Owner Id</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Voice_Call_User</name>
        <label>Check Voice Call User</label>
        <locationX>314</locationX>
        <locationY>600</locationY>
        <defaultConnector>
            <targetReference>Check_New_Case_Owner_Id</targetReference>
