            </conditions>
            <connector>
                <targetReference>Portal_Access_Provision</targetReference>
            </connector>
            <label>Is Prepare Success</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Provision_Success</name>
        <label>Check Provision Success</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
