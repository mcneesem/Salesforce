        <locationX>578</locationX>
        <locationY>492</locationY>
        <defaultConnectorLabel>n/a</defaultConnectorLabel>
        <rules>
            <name>Lead_was_Disqualified</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Unqualified</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.OneTrust_Opt_Out__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Setup.Lead_Trigger_Settings__c.IsEnabledRemoveUnqualifiedFromCadence__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>RemoveUnqualifiedLead</targetReference>
            </connector>
            <label>Lead was Disqualified</label>
        </rules>
        <rules>
