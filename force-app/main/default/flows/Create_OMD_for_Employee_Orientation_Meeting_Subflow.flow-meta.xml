    <formulas>
        <name>first_available_block</name>
        <dataType>Date</dataType>
        <expression>CASE(WEEKDAY({!f_CTM_Date}), 1, {!f_CTM_Date} + 2, 2, {!f_CTM_Date} + 2, 3, {!f_CTM_Date} + 2, 4, {!f_CTM_Date} + 2, 5, {!f_CTM_Date} + 4, 6, {!f_CTM_Date} + 4, 7, {!f_CTM_Date} + 3, {!f_CTM_Date} + 2)</expression>
