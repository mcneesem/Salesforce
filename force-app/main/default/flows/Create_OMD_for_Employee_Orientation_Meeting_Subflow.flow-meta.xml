        <dataType>Number</dataType>
        <expression>CASE({!Number_of_Employee_Orientation_Meetings_Required}, &quot;1&quot;, 1, &quot;2&quot;, 2, &quot;3&quot;, 3, &quot;4&quot;, 4, 0)</expression>
