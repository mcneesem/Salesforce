<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>AZD-502310 , Create SCC Records with PC/HR/OSS Flag = True Update PDS PC/HR/OSS
Bug Fix - ADO-531437 . 03/16/2026</description>
    <environments>Default</environments>
    <interviewLabel>Sub Client Contact Created Async Update PDS {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Sub Client Contact Created Async Update PDS</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>( 1 OR 2 OR 3 ) AND ( 4 AND 5 )</filterLogic>
        <filters>
            <field>NSP_Payroll_Contact__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>NSP_HR_Contact__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>NSP_On_Site_Supervisor__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>NSP_Sub_Client__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>NSP_Contact__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>NSP_Sub_Client_Contact__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>Update_PDS_HR_PC_OSS_Contacts</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
    <subflows>
        <description>Invoke the Sub flow to compute the logic for PC/HR/OSS contacts on PDS</description>
        <name>Update_PDS_HR_PC_OSS_Contacts</name>
        <label>Update PDS HR/PC/OSS Contacts</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>Sub_Client_Contact_Updated_Async_Update_PDS_Subflow</flowName>
        <inputAssignments>
            <name>r_SCC_Record</name>
            <value>
                <elementReference>$Record</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>v_SubClient_Id</name>
            <value>
                <elementReference>$Record.NSP_Sub_Client__c</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <variables>
        <name>FaultElement</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>r_PDS</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>NSP_Payroll__c</objectType>
    </variables>
    <variables>
        <name>r_PDS_to_Update</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>NSP_Payroll__c</objectType>
    </variables>
    <variables>
        <description>Holds default collection - PC , HR ,OSS</description>
        <name>v_SCC_Flags</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
