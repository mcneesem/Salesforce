<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Verify Payroll Data Sheet Custom Settings enable for Workday</description>
        <name>Kill_Switch_Enable_For_Workday</name>
        <label>Kill Switch : Enable For Workday?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Enable_For_Workday</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Setup.Payroll_Data_Sheet_Settings__c.IsEnabledHRContact__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Setup.Payroll_Data_Sheet_Settings__c.IsEnabledOnsiteSupervisor__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Setup.Payroll_Data_Sheet_Settings__c.IsEnabledPrimaryPayrollContact__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_PDS_HR_PC_OSS_Contacts</targetReference>
            </connector>
            <label>Yes : Enable For Workday</label>
        </rules>
    </decisions>
    <description>AZD-502310 , Create SCC Records with PC/HR/OSS Flag = True Update PDS PC/HR/OSS</description>
    <environments>Default</environments>
    <interviewLabel>Sub Client Contact Created Async Update PDS {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Sub Client Contact Created Async Update PDS</label>
