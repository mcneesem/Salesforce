                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>NSP_Sub_Client_Contact__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>Kill_Switch_Enable_For_Workday</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
