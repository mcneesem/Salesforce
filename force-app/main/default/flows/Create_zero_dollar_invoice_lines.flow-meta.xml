    <decisions>
        <name>check_if_order_item_has_free_periods</name>
        <label>check if order item has free periods</label>
        <locationX>380</locationX>
        <locationY>551</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>free_periods_available</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>get_linked_order_item.SBQQ__Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Activated</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>get_linked_order_item.NSP_Free_Periods_Available__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>update_invoice_line_to_zero</targetReference>
            </connector>
            <label>free periods available</label>
        </rules>
    </decisions>
    <decisions>
        <name>Identify_Free_Vs_Partial_Month</name>
        <label>Identify Free Vs Partial Month</label>
        <locationX>182</locationX>
        <locationY>791</locationY>
        <defaultConnector>
            <targetReference>Set_as_Free_month</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Zeroing Inv Line for Free Month</defaultConnectorLabel>
        <rules>
            <name>Zeroing_Inv_Line_for_Partial_Period</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>get_linked_order_item.NSP_Total_Free_Periods__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>get_linked_order_item.NSP_Free_Periods_Available__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>get_linked_order_item.NSP_Partial_Period_Applicable__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Reason_for_Zeroing_out_Inv_Line</targetReference>
            </connector>
            <label>Zeroing Inv Line for Partial Period</label>
        </rules>
    </decisions>
