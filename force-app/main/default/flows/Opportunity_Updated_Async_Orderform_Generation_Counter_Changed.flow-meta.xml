    <decisions>
        <name>Bypass_Opportunity_Email_Alerts_Custom_Permission_check</name>
        <label>Bypass Opportunity Email Alerts Custom Permission check</label>
        <locationX>407</locationX>
        <locationY>276</locationY>
        <defaultConnector>
            <targetReference>Is_Opty_Owner_the_Quote_Owner</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Bypass</defaultConnectorLabel>
        <rules>
            <name>User_has_bypass_permission</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Permission.Bypass_Opportunity_Email_Alerts</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>User has bypass permission</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Opty_Owner_the_Quote_Owner</name>
        <label>Is Opty Owner the Quote Owner?</label>
        <locationX>605</locationX>
        <locationY>384</locationY>
        <defaultConnectorLabel>N/A</defaultConnectorLabel>
        <rules>
            <name>No_Opty_Owner_is_NOT_the_Quote_Owner</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Owner.User_ID_18__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.NSP_Quote_Owner__r.User_ID_18__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Owner_isActive__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Owner_Email_Populated__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Opportunity_Subflow_Email_Alerts</targetReference>
            </connector>
            <label>No - Opty Owner is NOT the Quote Owner</label>
        </rules>
    </decisions>
    <description>Removed redundancies</description>
    <environments>Default</environments>
