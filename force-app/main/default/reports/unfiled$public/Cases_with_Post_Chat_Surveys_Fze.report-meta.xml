<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <columns>
        <field>Case.SurveySubjectEntities.SurveyResponses.SurveyQuestionResponses$Question</field>
    </columns>
    <columns>
        <field>Case.SurveySubjectEntities.SurveyResponses.SurveyQuestionResponses$QuestionChoice</field>
    </columns>
    <columns>
        <aggregateTypes>Sum</aggregateTypes>
        <field>CDF1</field>
    </columns>
    <currency>USD</currency>
    <customDetailFormulas>
        <calculatedFormula>CASE(SurveyQuestionResponse.Question.Name,
     &quot;How easy was it to resolve your request?&quot;, 
        CASE(SurveyQuestionResponse.QuestionChoice.Name,
        &quot;Very Easy&quot;, 5,
        &quot;Easy&quot;, 4,
        &quot;Somewhat Easy&quot;, 3,
        &quot;Diffucylt&quot;, 2,
        1),

    &quot;Was you inquiry resolved during today&apos;s chat session with the Contact Center?&quot;,
        IF(SurveyQuestionResponse.QuestionChoice.Name = &quot;Yes&quot;,
        1,
        0),

     CASE(SurveyQuestionResponse.QuestionChoice.Name,
        &quot;Completely Satisfied&quot;, 5,
        &quot;Satisfied&quot;, 4,
        &quot;Somewhat Satisfied&quot;, 3,
        &quot;Dissatisfied&quot;, 2,
        &quot;Completely Dissatisfied&quot;, 1,
        0)
)</calculatedFormula>
        <dataType>Double</dataType>
        <developerName>CDF1</developerName>
        <label>Score</label>
        <scale>0</scale>
    </customDetailFormulas>
    <format>Summary</format>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>Case$CaseNumber</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>Case.SurveySubjectEntities$Name</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>Case.SurveySubjectEntities.SurveyResponses$Name</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <name>Cases with Post Chat Surveys</name>
    <params>
        <name>co</name>
        <value>0</value>
    </params>
    <reportType>Cases_with_Survey_Responses__c</reportType>
    <scope>organization</scope>
    <showDetails>false</showDetails>
    <showGrandTotal>false</showGrandTotal>
    <showSubTotals>true</showSubTotals>
    <timeFrameFilter>
        <dateColumn>Case.SurveySubjectEntities$CreatedDate</dateColumn>
        <interval>INTERVAL_CUSTOM</interval>
    </timeFrameFilter>
</Report>
