<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NSP_DownPayment_Required__c</fullName>
    <description>Field indicate that down payment is required</description>
    <externalId>false</externalId>
    <formula>AND(
    NOT(ISNULL(blng__InvoicePlanLine__c)),
    ISPICKVAL(blng__InvoicePlanLine__r.NSP_Billing_Commencement_Trigger__c,&apos;Order Activation&apos;),
    blng__InvoicePlanLine__r.blng__ProcessingOrder__c == 1
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Down Payment Required</label>
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>
