<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Server_URL__c</fullName>
    <description>Active Account link for WO Asset Notification Emails</description>
    <externalId>false</externalId>
    <formula>LEFT(
    $Api.Enterprise_Server_URL_650 ,
    ( FIND( '/services' , $Api.Enterprise_Server_URL_650 ) - 1 )
    )
    & '/lightning/r/Account/' & AccountId & '/view'</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Server URL</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
