<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NSP_Renewal_within_next_30__c</fullName>
    <description>Asset Renewal Date not blank and one year head - Today &lt;= 90</description>
    <externalId>false</externalId>
    <formula>if(not(isblank(NSP_Renewal_Date__c)) &amp;&amp; ((NSP_Renewal_Date__c +365) - today())&lt;= 90, true,false)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Renewal within next 90 ?</label>
    <trackHistory>false</trackHistory>
    <type>Checkbox</type>
</CustomField>
