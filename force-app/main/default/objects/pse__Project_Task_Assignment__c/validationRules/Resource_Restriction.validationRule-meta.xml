<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Resource_Restriction</fullName>
    <active>true</active>
    <errorConditionFormula>AND($Setup.NSP_Trigger_Switch__c.ProjectTaskAssignmentValidations__c != true,
NOT(CONTAINS(CreatedBy.Profile.Name , &apos;Service&apos;)),
ISCHANGED(pse__Resource__c),
CONTAINS($Profile.Name,&apos;Service&apos;),
$Profile.Name &lt;&gt; CreatedBy.Profile.Name
)</errorConditionFormula>
    <errorDisplayField>pse__Resource__c</errorDisplayField>
    <errorMessage>Service Profile update resource only for their Records</errorMessage>
</ValidationRule>
