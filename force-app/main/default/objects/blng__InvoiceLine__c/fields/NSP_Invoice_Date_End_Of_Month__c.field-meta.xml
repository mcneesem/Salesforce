<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NSP_Invoice_Date_End_Of_Month__c</fullName>
    <description>Captures Invoice Date month end date</description>
    <externalId>false</externalId>
    <formula>IF( MONTH(blng__Invoice__r.blng__InvoiceDate__c) = 12, 
DATE( YEAR(blng__Invoice__r.blng__InvoiceDate__c), 12, 31 ), 
DATE( YEAR(blng__Invoice__r.blng__InvoiceDate__c), MONTH( blng__Invoice__r.blng__InvoiceDate__c ) + 1, 1) - 1)</formula>
    <label>Invoice Date End Of Month</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Date</type>
</CustomField>
