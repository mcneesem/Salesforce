<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_Field_When_ACH_Active</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
  NSP_Active_Custom__c ,
  ISPICKVAL( Payment_Method_Type__c , &quot;&quot; )
)</errorConditionFormula>
    <errorDisplayField>Payment_Method_Type__c</errorDisplayField>
    <errorMessage>Please enter value for Payment Method Type when ACH Active is True</errorMessage>
</ValidationRule>
