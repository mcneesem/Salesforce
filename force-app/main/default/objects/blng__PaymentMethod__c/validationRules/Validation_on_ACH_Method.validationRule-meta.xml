<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Validation_on_ACH_Method</fullName>
    <active>true</active>
    <description>Checks ACH method is selected if Payment Type is ACH.</description>
    <errorConditionFormula>AND(   ISPICKVAL(blng__PaymentType__c, &apos;ACH&apos;)  , ISBLANK(TEXT( NSP_ACH_method__c )),
NOT( $Setup.NSP_Trigger_Switch__c.PaymentMethodValidations__c) )</errorConditionFormula>
    <errorMessage>Please select a ACH Method from the list.</errorMessage>
</ValidationRule>
