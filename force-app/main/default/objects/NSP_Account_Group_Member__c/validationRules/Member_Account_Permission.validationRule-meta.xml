<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Member_Account_Permission</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  $Permission.Enforce_Rule_Member_Account ,
  ISCHANGED( NSP_Member_Account__c )
)</errorConditionFormula>
    <errorDisplayField>NSP_Member_Account__c</errorDisplayField>
    <errorMessage>You are not allowed to edit the Member Account field</errorMessage>
</ValidationRule>
