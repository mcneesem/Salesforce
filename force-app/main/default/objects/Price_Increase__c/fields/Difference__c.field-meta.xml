<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Difference__c</fullName>
    <description>Calculated Difference %</description>
    <formula>( Current_Retail_Price__c -  Current_PEPM__c ) /  Current_PEPM__c</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Percentage difference of Current PEPM and Retail Price.</inlineHelpText>
    <label>% Difference</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Percent</type>
</CustomField>
