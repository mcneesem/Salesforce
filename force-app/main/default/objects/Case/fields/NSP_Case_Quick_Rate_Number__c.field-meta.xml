<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NSP_Case_Quick_Rate_Number__c</fullName>
    <description>This is the numeric rating value that corresponds to the users selection in the Case Quick Rate picklist field</description>
    <externalId>false</externalId>
    <formula>CASE(NSP_Rating__c,
&quot;Unfavorable&quot;, -2 ,
&quot;Somewhat Unfavorable&quot;, -1 ,
&quot;Neutral&quot;,0 ,
&quot;Somewhat Favorable&quot;, 1,
&quot;Favorable&quot;, 2 , null)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Case Quick Rate Number</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
