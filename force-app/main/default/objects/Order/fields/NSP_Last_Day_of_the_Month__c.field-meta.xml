<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NSP_Last_Day_of_the_Month__c</fullName>
    <description>Captures Last day of the order start day month</description>
    <externalId>false</externalId>
    <formula>IF(Month(EffectiveDate)=12, 31, DAY(DATE(YEAR(EffectiveDate),MONTH(EffectiveDate)+1,1) - 1))</formula>
    <label>Last Day of the Month</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
