<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NSP_Only_System_Admins_to_Edit_Templates</fullName>
    <active>true</active>
    <description>Only System Admins should be able to edit Project Templates</description>
    <errorConditionFormula>AND(
NOT($Setup.NSP_Trigger_Switch__c.ProjectTaskValidations__c),
 $Profile.Name &lt;&gt; &apos;System Administrator&apos;,
 pse__Project__r.pse__Is_Template__c  = true
)</errorConditionFormula>
    <errorMessage>Project templates cannot be edited.</errorMessage>
</ValidationRule>
