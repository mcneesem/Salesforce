<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NSP_Only_System_Admins_to_Edit_Templates</fullName>
    <active>true</active>
    <description>Only System Admins should be able to edit Project Templates</description>
    <errorConditionFormula>AND(
  NOT( $User.NSP_Service_Stakeholder__c ) ,
  NOT( $Permission.Service_Stakeholder ) ,
  OR(
    pse__Project__r.pse__Is_Template__c ,
    pse__Project__r.Is_Opportunity_Template__c
  )
)</errorConditionFormula>
    <errorMessage>Project templates can not be edited.</errorMessage>
</ValidationRule>
