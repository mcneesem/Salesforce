<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Recommend_through_0_to_10</fullName>
    <active>true</active>
    <errorConditionFormula>AND($Setup.NSP_Trigger_Switch__c.NSP_CustomSurveyValidations__c = false,
OR( Recommend__c &lt; 0 , Recommend__c &gt; 10))</errorConditionFormula>
    <errorDisplayField>Recommend__c</errorDisplayField>
    <errorMessage>Recommended has to be through 0 to 10</errorMessage>
</ValidationRule>
