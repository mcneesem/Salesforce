<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NSP_Status__c</fullName>
    <description>Field to track if Tier tracking is Active</description>
    <externalId>false</externalId>
    <formula>IF( TODAY() &gt;=  NSP_Tier_Start_Date__c  &amp;&amp; TODAY() &lt;=  NSP_Tier_End_Date__c, &quot;Active&quot;, &quot;Inactive&quot; )</formula>
    <label>Status</label>
    <required>false</required>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
