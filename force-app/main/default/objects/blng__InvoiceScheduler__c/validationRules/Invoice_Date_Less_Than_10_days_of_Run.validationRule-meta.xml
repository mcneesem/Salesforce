<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Invoice_Date_Less_Than_10_days_of_Run</fullName>
    <active>true</active>
    <errorConditionFormula>ABS ( blng__InvoiceDate__c -  DATEVALUE(CreatedDate )) &gt; 10</errorConditionFormula>
    <errorMessage>Invoice Date must be within 10 days of the Invoice Scheduler Creation Date.</errorMessage>
</ValidationRule>
