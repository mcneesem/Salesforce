<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>AccrualLevel_AcceptOnlyNumbers</fullName>
    <active>true</active>
    <description>We Can enter only numbers on How many accrual levels</description>
    <errorConditionFormula>AND(NOT(ISNUMBER(NSP_How_many_accrual_levels_in_Policy__c ) ) ,  NOT( ISBLANK( NSP_How_many_accrual_levels_in_Policy__c ) ) )</errorConditionFormula>
    <errorDisplayField>NSP_How_many_accrual_levels_in_Policy__c</errorDisplayField>
    <errorMessage>Enter Number</errorMessage>
</ValidationRule>
