<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NSP_HoursWorked_NumberField</fullName>
    <active>true</active>
    <description>We can enter only Numbers on Accrual rates are based on every hours worked field.</description>
    <errorConditionFormula>AND(NOT( ISNUMBER(  NSP_AccrualRatesAreBasedOnHoursWorked__c  ) ), NOT(ISBLANK( NSP_AccrualRatesAreBasedOnHoursWorked__c) ))</errorConditionFormula>
    <errorDisplayField>NSP_AccrualRatesAreBasedOnHoursWorked__c</errorDisplayField>
    <errorMessage>Please Enter Number.</errorMessage>
</ValidationRule>
