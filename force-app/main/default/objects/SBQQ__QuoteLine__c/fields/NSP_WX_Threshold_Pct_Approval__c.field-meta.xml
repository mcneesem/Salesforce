<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NSP_WX_Threshold_Pct_Approval__c</fullName>
    <description>Used in Approval for threshold percentage change</description>
    <externalId>false</externalId>
    <formula>IF(  CONTAINS(SBQQ__ProductCode__c , &apos;WX&apos;) || CONTAINS(SBQQ__ProductCode__c , &apos;WA&apos;),true,false) &amp;&amp; NSP_Threshold_Percentage__c != 0.8</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>WX Threshold Pct Approval</label>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>
