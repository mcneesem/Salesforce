<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NSP_Total_Final_One_Time_Fees__c</fullName>
    <description>Calculates the Total One Time Fees</description>
    <externalId>false</externalId>
    <formula>IF(ISPICKVAL( SBQQ__ChargeType__c ,&apos;One-Time&apos;) &amp;&amp; NOT(ISPICKVAL(NSP_Product_Group__c,&apos;Shipping&apos;)) ,
( IF(NSP_Quoted_Quantity__c &gt; 0, NSP_Quoted_Quantity__c,SBQQ__Quantity__c) * SBQQ__NetPrice__c)
,0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Total Final One Time Fees</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Currency</type>
</CustomField>
