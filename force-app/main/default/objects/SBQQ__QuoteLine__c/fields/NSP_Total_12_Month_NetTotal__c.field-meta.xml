<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NSP_Total_12_Month_NetTotal__c</fullName>
    <description>Net total for 12 months</description>
    <externalId>false</externalId>
    <formula>IF(ISPICKVAL( SBQQ__ChargeType__c ,&apos;One-time&apos;) , 1,12 ) * 
IF(NSP_List_Minimum_Fee__c &gt; 0 &amp;&amp; NSP_Quoted_Quantity__c &lt; NSP_Max_Quantity__c,NSP_Final_Minimum_Fee__c, 
NSP_Net_Total_QQ__c)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Total 12 Month NetTotal</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Currency</type>
</CustomField>
