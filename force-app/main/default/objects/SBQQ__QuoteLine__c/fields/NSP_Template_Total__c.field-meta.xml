<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NSP_Template_Total__c</fullName>
    <description>Shows either Minimum Fee or the Net Total depending on the condition</description>
    <externalId>false</externalId>
    <formula>IF( NOT(ISNULL(NSP_Max_Quantity__c)) , 
   IF(SBQQ__Quote__r.NSP_Multiple_Companies__c &amp;&amp; SBQQ__Quote__r.Total_Employess_of_all_companies__c 
       &lt;=NSP_Max_Quantity__c &amp;&amp;  NSP_Multiple_CompaniesQuantityApplicable__c ,NSP_Final_Minimum_Fee__c,
      IF(NSP_Quoted_Quantity__c &lt;= NSP_Max_Quantity__c,NSP_Final_Minimum_Fee__c,NSP_Net_Total__c) ),NSP_Net_Total__c)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Template Total</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Currency</type>
</CustomField>
