<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NSP_Retention_Payment__c</fullName>
    <description>Holds the Retention when position is 0 which is used in docusign DO</description>
    <externalId>false</externalId>
    <formula>IF( NSP_Positions__c &gt; 0, SBQQ__NetPrice__c * SBQQ__Quote__r.NSP_Retention_Payment__c, NSP_Cost_Per_Position__c * 0.2)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Retention Payment</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Currency</type>
</CustomField>
