<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NSP_Effective_Renewed_Quantity__c</fullName>
    <description>Effective Quantity for renewal and amendment</description>
    <externalId>false</externalId>
    <formula>IF(NOT(ISNULL(NSP_Previous_Quantity__c)),IF((NSP_Quoted_Quantity__c   - NSP_Previous_Quantity__c) &gt;0,
(NSP_Quoted_Quantity__c   - NSP_Previous_Quantity__c),0),

IF(
   (NSP_Quoted_Quantity__c  - IF(NOT(ISBLANK(SBQQ__RenewedAsset__c)), SBQQ__RenewedAsset__r.NSP_Quoted_Quantity__c ,
   IF(NOT(ISBLANK(SBQQ__RenewedSubscription__c)), SBQQ__RenewedSubscription__r.NSP_Quoted_Quantity__c ,0
   ))) &gt; 0,(NSP_Quoted_Quantity__c  - IF(NOT(ISBLANK(SBQQ__RenewedAsset__c)), SBQQ__RenewedAsset__r.NSP_Quoted_Quantity__c ,
   IF(NOT(ISBLANK(SBQQ__RenewedSubscription__c)), SBQQ__RenewedSubscription__r.NSP_Quoted_Quantity__c ,0
   ))),0))</formula>
    <label>Effective Renewed Quantity</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
