<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NSP_DontAllowModificationsonTermination</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL( SBQQ__Quote__r.SBQQ__Type__c ,&apos;Termination&apos;) ,SBQQ__UpgradedSubscription__c != null, NSP_Quoted_Quantity__c != 0, NSP_Quoted_Quantity__c != SBQQ__UpgradedSubscription__r.NSP_Quoted_Quantity__c)</errorConditionFormula>
    <errorMessage>Other modifications aren&apos;t allowed in termination transaction</errorMessage>
</ValidationRule>
