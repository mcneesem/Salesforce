<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NSP_DontAllowAmendDuringSuplementalFlow</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISNEW()), SBQQ__UpgradedSubscription__c != null, ISCHANGED( NSP_Quoted_Quantity__c),ISPICKVAL(SBQQ__Quote__r.SBQQ__Type__c  , &apos;Supplemental&apos;) )</errorConditionFormula>
    <errorMessage>Amending existing subscriptions isn&apos;t allowed in Supplemental Flow.</errorMessage>
</ValidationRule>
