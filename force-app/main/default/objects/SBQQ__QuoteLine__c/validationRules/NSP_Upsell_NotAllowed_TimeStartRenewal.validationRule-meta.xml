<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NSP_Upsell_NotAllowed_TimeStartRenewal</fullName>
    <active>true</active>
    <description>User cannot increase the quantity during renewal of time start hardware</description>
    <errorConditionFormula>ISPICKVAL(SBQQ__Quote__r.SBQQ__Type__c,&apos;Renewal&apos;) &amp;&amp;  
INCLUDES(SBQQ__Quote__r.NSP_Product_Type__c ,&apos;Time and Attendance Hardware&apos;)&amp;&amp;
 NOT(ISBLANK(SBQQ__RenewedSubscription__c )) &amp;&amp;  
NSP_Quoted_Quantity__c &gt;  SBQQ__RenewedSubscription__r.NSP_Quoted_Quantity__c</errorConditionFormula>
    <errorMessage>Cannot Increase the Quantity in Renewal</errorMessage>
</ValidationRule>
