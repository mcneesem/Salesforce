<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Only_Int_User_Can_Create_WO_SubPlan</fullName>
    <active>true</active>
    <errorConditionFormula>AND(RecordType.Name =&apos;WO&apos; ,
  $User.NSP_Profile_Name__c  &lt;&gt;&apos;Integration User&apos;,
$User.NSP_Profile_Name__c &lt;&gt;&apos;System Administrator&apos;,
 $Setup.NSP_Trigger_Switch__c.NSP_Plan_Sub_Plan__c = false
)</errorConditionFormula>
    <errorMessage>Only Integration User Can Create WO SubPlan.</errorMessage>
</ValidationRule>
