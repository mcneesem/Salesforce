<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Choice_RT_Not_Equal_To_Plan_Choice_RT</fullName>
    <active>true</active>
    <errorConditionFormula>AND(RecordType.Name = &apos;Choice&apos; ,  NSP_Parent_Plan_ID__r.RecordType.Name &lt;&gt;&apos;Choice&apos;)</errorConditionFormula>
