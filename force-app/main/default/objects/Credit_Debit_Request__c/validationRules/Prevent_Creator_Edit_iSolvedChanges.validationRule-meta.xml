<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Prevent_Creator_Edit_iSolvedChanges</fullName>
    <active>true</active>
    <errorConditionFormula>NOT($Permission.Bypass_Credit_Debit_Request_Edit_iSolved_Changes_Validated) &amp;&amp;
(
  (
    ISNEW() &amp;&amp; iSolved_Changes_Validated__c
  ) ||
  (
    ISCHANGED(iSolved_Changes_Validated__c) &amp;&amp; $User.Id == CreatedById
  )
)</errorConditionFormula>
    <errorMessage>Due to SOX Compliance, an Approver must check the &quot;iSolved Changes Validated&quot; checkbox field. Please uncheck the field and save your record.</errorMessage>
</ValidationRule>
