<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NSP_FirstNameMandatory</fullName>
    <active>true</active>
    <description>This will make First Name field required</description>
    <errorConditionFormula>AND(
NOT($Profile.Name = &quot;System Administrator&quot;),
$Setup.NSP_Trigger_Switch__c.AccountValidations__c != true,
ISBLANK(FirstName) 
)</errorConditionFormula>
    <errorDisplayField>FirstName</errorDisplayField>
    <errorMessage>Please enter First Name.</errorMessage>
</ValidationRule>
