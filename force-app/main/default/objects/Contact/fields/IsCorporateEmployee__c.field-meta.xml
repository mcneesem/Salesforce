<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>IsCorporateEmployee__c</fullName>
    <description>Used to determine if the Contact is a &quot;Corporate Employee&quot;.  Primarily used for seeding Sandbox data from OwnBackup.</description>
    <externalId>false</externalId>
    <formula>AND(
  (VALUE(NSP_AIMS_Client__c)&gt;=500),
  (VALUE(NSP_AIMS_Client__c)&lt;=599)
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Is Corporate Employee</label>
    <trackHistory>false</trackHistory>
    <type>Checkbox</type>
</CustomField>
