<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>IsClientEmployee__c</fullName>
    <description>Used to determine if the Contact is a &quot;Client Employee&quot;.  Primarily used for seeding Sandbox data from OwnBackup.</description>
    <externalId>false</externalId>
    <formula>AND(
  NOT(IsCorporateEmployee__c),
  NOT(ISBLANK(NSP_AIMS_Client__c))
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Is Client Employee</label>
    <trackHistory>false</trackHistory>
    <type>Checkbox</type>
</CustomField>
