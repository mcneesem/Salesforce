<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NSP_ThresholdPercentage_Non_Negative</fullName>
    <active>true</active>
    <errorConditionFormula>(ISBLANK(NSP_Threshold_Percentage__c) || NSP_Threshold_Percentage__c &lt; 0) &amp;&amp; ISCHANGED(NSP_Threshold_Percentage__c)
&amp;&amp;
NOT($Setup.NSP_Trigger_Switch__c.QuoteValidation__c)</errorConditionFormula>
    <errorDisplayField>NSP_Threshold_Percentage__c</errorDisplayField>
    <errorMessage>Threshold Percentage should be non negative value</errorMessage>
</ValidationRule>
