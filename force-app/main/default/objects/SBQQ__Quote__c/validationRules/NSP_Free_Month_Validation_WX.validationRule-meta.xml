<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NSP_Free_Month_Validation_WX</fullName>
    <active>true</active>
    <errorConditionFormula>NSP_WX_WA_Employees__c &lt; 10 &amp;&amp;   RecordType.DeveloperName = &apos;NSP_WX_WA&apos; &amp;&amp;
(ISPICKVAL( NSP_Free_Month__c,&apos;1&apos;)
|| ISPICKVAL( NSP_Free_Month__c,&apos;2&apos;))
&amp;&amp;
NOT($Setup.NSP_Trigger_Switch__c.QuoteValidation__c)</errorConditionFormula>
    <errorDisplayField>NSP_Free_Month__c</errorDisplayField>
    <errorMessage>Free Months can not be 1 or 2 if the W2 Employee Count is less than 10.</errorMessage>
</ValidationRule>
