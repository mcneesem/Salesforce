<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NSP_ShippingAddress_Not_ValidSelection</fullName>
    <active>true</active>
    <errorConditionFormula>NSP_Shipping_Address__c != null &amp;&amp; 
NSP_Shipping_Address__r.NSP_Related_Site__c != NSP_Billing_Account__c &amp;&amp; NSP_Shipping_Address__r.NSP_Related_Site__c !=  SBQQ__Account__c
&amp;&amp; 
NOT($Setup.NSP_Trigger_Switch__c.QuoteValidation__c)</errorConditionFormula>
    <errorDisplayField>NSP_Shipping_Address__c</errorDisplayField>
    <errorMessage>Shipping address is no longer valid with your selections.</errorMessage>
</ValidationRule>
