<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NSP_Cannot_Create_Order_Validation</fullName>
    <active>false</active>
    <errorConditionFormula>AND(SBQQ__Ordered__c = TRUE,  
TEXT(SBQQ__Status__c) &lt;&gt; $Label.NSP_Customer_Signed_Status,
 NSP_Require_Signature_Flow__c = TRUE
)
&amp;&amp; 
NOT($Setup.NSP_Trigger_Switch__c.QuoteValidation__c)</errorConditionFormula>
    <errorMessage>Order cannot be created if Quote Status is not Customer Signed</errorMessage>
</ValidationRule>
