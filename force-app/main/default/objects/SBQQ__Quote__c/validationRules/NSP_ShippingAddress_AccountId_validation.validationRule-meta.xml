<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NSP_ShippingAddress_AccountId_validation</fullName>
    <active>true</active>
    <errorConditionFormula>NSP_Billing_Account__c != null &amp;&amp; NSP_Shipping_Address__c != null &amp;&amp;
NSP_Billing_Account__c != NSP_Shipping_Address__r.NSP_Related_Site__c
&amp;&amp;
NOT($Setup.NSP_Trigger_Switch__c.QuoteValidation__c)</errorConditionFormula>
    <errorDisplayField>NSP_Shipping_Address__c</errorDisplayField>
    <errorMessage>Shipping Address must be of Billing Account</errorMessage>
</ValidationRule>
