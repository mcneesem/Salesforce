<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NSP_Billing_Address_AccountId_validation</fullName>
    <active>true</active>
    <errorConditionFormula>IF((NSP_Billing_Account__c !=null &amp;&amp; NSP_Billing_Address__c != null ),
