<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Customer_Shipping_Address_validation</fullName>
    <active>true</active>
    <errorConditionFormula>NSP_Customer_Shipping_Address__c != null &amp;&amp; 
(
ISBLANK(NSP_Customer_Shipping_Address__r.NSP_Street__c)||
ISBLANK(NSP_Customer_Shipping_Address__r.NSP_State__c)||
ISBLANK(NSP_Customer_Shipping_Address__r.NSP_City__c)||
ISBLANK(NSP_Customer_Shipping_Address__r.NSP_Postal_Code__c)||
ISBLANK(TEXT(NSP_Customer_Shipping_Address__r.NSP_Country__c)) 
)
&amp;&amp; 
NOT($Setup.NSP_Trigger_Switch__c.QuoteValidation__c)</errorConditionFormula>
    <errorDisplayField>NSP_Customer_Shipping_Address__c</errorDisplayField>
    <errorMessage>Shipping Address details is missing some values, please update the Shipping address before selection.</errorMessage>
</ValidationRule>
