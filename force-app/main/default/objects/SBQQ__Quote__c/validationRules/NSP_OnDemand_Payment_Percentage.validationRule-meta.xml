<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NSP_OnDemand_Payment_Percentage</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISNEW()), OR(ISCHANGED(NSP_UpFront_Payment__c),ISCHANGED(NSP_At_Hire_Payment__c),ISCHANGED(NSP_Retention_Payment__c)) ,NSP_UpFront_Payment__c + 
 NSP_At_Hire_Payment__c + NSP_Retention_Payment__c != 1)
&amp;&amp; 
NOT($Setup.NSP_Trigger_Switch__c.QuoteValidation__c)</errorConditionFormula>
    <errorMessage>The sum of OnDemand Payment Percentage fields should always be 100%</errorMessage>
</ValidationRule>
