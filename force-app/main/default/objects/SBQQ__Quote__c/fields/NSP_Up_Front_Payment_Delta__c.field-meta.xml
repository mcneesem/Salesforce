<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NSP_Up_Front_Payment_Delta__c</fullName>
    <description>Holds the Upfront Payment Delta value which is used in approvals</description>
    <externalId>false</externalId>
    <formula>ABS(IF(NSP_UpFront_Payment__c != 0.3, (0.3 - NSP_UpFront_Payment__c) /0.3, 0))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Up Front Payment Delta</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Percent</type>
</CustomField>
