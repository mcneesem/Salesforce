<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NSP_At_Hire_Payment_Delta__c</fullName>
    <description>Holds the At Hire Payment Delta value which is used in approvals</description>
    <externalId>false</externalId>
    <formula>IF( NSP_At_Hire_Payment__c != 0.5, (0.5 - NSP_At_Hire_Payment__c) /0.5, 0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>At Hire Payment Delta</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Percent</type>
</CustomField>
