<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NSP_Total_Upfront_Fees_Non_Annual__c</fullName>
    <description>This field provides the total Upfront value for the DO Generation for Billing Frequency other than Annual.</description>
    <externalId>false</externalId>
    <formula>NSP_Total_Annual_Freq_Fees__c + 
NSP_Total_Quarterly_Freq_Fees__c + 
NSP_Total_Semi_Annual_Freq_Fees__c + 
NSP_Total_Monthly_Freq_Fees__c</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Total Upfront Fees (Non-Annual)</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
