<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Campaign_Level_required_on_Marketing_RT</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
ISPICKVAL( Campaign_Level__c, &quot;&quot;),
RecordType.DeveloperName = &apos;Marketing_Record_Type&apos;)</errorConditionFormula>
    <errorDisplayField>Campaign_Level__c</errorDisplayField>
    <errorMessage>Campaign Level must have a value</errorMessage>
</ValidationRule>
