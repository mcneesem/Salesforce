<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NSP_Term_date_is_in_the_past__c</fullName>
    <description>Formula for highlighting the term date is past.</description>
    <externalId>false</externalId>
    <formula>IF( NSP_Client_Term_Date__c  &lt;  TODAY() , IMAGE(&quot;/img/samples/color_red.gif&quot;, &quot;red&quot;, 30, 30), IMAGE(&quot;/img/samples/color_green.gif&quot;, &quot;green&quot;, 30, 30))</formula>
    <label>Term date is in the past?</label>
    <required>false</required>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
