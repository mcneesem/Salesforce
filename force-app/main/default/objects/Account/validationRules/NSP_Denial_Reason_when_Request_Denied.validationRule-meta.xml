<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NSP_Denial_Reason_when_Request_Denied</fullName>
    <active>true</active>
    <description>When Request Status is Marked as Denied then Denial Reason is Required</description>
    <errorConditionFormula>AND( ISPICKVAL(NSP_Request_Status__c , &quot;Denied&quot;) ,  ISBLANK(NSP_Denial_Reason__c),  $Setup.NSP_Trigger_Switch__c.AccountValidations__c != true )</errorConditionFormula>
    <errorDisplayField>NSP_Denial_Reason__c</errorDisplayField>
    <errorMessage>Please enter Denial Reason when Request Status is Denied</errorMessage>
</ValidationRule>
