    <active>true</active>
    <errorConditionFormula>(ISCHANGED( NSP_Sales_Division__c ) ||ISCHANGED( NSP_Sales_Region__c )) &amp;&amp;
($UserRole.DeveloperName = &apos;Associate_Business_Performance_Advisors&apos; || $UserRole.DeveloperName = &apos;Business_Performance_Advisor&apos;)
