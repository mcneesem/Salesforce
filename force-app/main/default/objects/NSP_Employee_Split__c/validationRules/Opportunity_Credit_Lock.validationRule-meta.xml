<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Opportunity_Credit_Lock</fullName>
    <active>true</active>
    <description>Opportunity credit is locked when opportunity is lock.</description>
    <errorConditionFormula>ISPICKVAL(NSP_Opportunity__r.StageName, &quot;Closed Won&quot;) &amp;&amp;
$Setup.NSP_Trigger_Switch__c.OpportunityValidations__c!=TRUE &amp;&amp; ($UserRole.DeveloperName != &quot;New_Client_Sales&quot; &amp;&amp; 
 $UserRole.DeveloperName != &quot;Sales_Compensation&quot; &amp;&amp;
 $UserRole.DeveloperName != &apos;Associate_Business_Performance_Advisors&apos; &amp;&amp; 
 $UserRole.DeveloperName != &apos;Business_Performance_Advisor&apos;&amp;&amp;
 $UserRole.DeveloperName != &quot;Sales_Administrator&quot; &amp;&amp;
 $UserRole.DeveloperName != &quot;District_Administrator&quot; 
)
&amp;&amp; (
 $Profile.Name  &lt;&gt; &apos;Data Migration&apos; &amp;&amp;
 $Profile.Name  &lt;&gt; &apos;Integration User&apos; &amp;&amp;
 $Profile.Name  &lt;&gt; &apos;System Administrator&apos; 

)</errorConditionFormula>
    <errorMessage>Once Opportunity is Closed Won it cannot be modified. Please contact Sales Operations team</errorMessage>
</ValidationRule>
