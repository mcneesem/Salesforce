<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NSP_StartDate_EndDate_validation</fullName>
    <active>true</active>
    <errorConditionFormula>NOT(ISNULL(NSP_End_Date__c )) &amp;&amp; 
NOT(ISNULL(NSP_Start_Date__c)) &amp;&amp;
NSP_End_Date__c &lt; NSP_Start_Date__c</errorConditionFormula>
    <errorMessage>End Date should be greater than Start Date</errorMessage>
</ValidationRule>
