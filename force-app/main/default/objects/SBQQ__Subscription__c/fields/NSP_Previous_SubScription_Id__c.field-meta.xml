<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NSP_Previous_SubScription_Id__c</fullName>
    <description>This will display Previous Subscription Id From Quote Line</description>
    <externalId>false</externalId>
    <formula>CASESAFEID(IF(NOT(ISBLANK(SBQQ__QuoteLine__r.SBQQ__Source__c)),
SBQQ__QuoteLine__r.SBQQ__Source__r.SBQQ__UpgradedSubscription__c,
IF(NOT(ISBLANK(SBQQ__QuoteLine__r.SBQQ__RenewedSubscription__c)),SBQQ__QuoteLine__r.SBQQ__RenewedSubscription__c,&apos;&apos;)))</formula>
    <label>Previous SubScription Id</label>
    <required>false</required>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
