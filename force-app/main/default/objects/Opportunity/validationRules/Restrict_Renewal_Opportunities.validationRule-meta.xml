<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Restrict_Renewal_Opportunities</fullName>
    <active>true</active>
    <description>Restricts Edit access for Renewal Opportunities</description>
    <errorConditionFormula>AND(
  NOT( $Permission.Bypass_Restrict_Renewal_Opportunities ) ,
  ( RecordType.DeveloperName = &quot;Renewal&quot; )
)</errorConditionFormula>
    <errorMessage>Only Renewal Specialists can modify Renewal Opportunities.</errorMessage>
</ValidationRule>
