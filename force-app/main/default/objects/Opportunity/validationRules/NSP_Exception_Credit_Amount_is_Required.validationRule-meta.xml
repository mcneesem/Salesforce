<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NSP_Exception_Credit_Amount_is_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND( ISPICKVAL(NSP_AddonType__c, &apos;Exception Credit&apos;)  , ISBLANK(NSP_Exception_Credit_Amount__c),NOT( $Setup.NSP_Trigger_Switch__c.OpportunityTrigger__c))</errorConditionFormula>
    <errorDisplayField>NSP_Exception_Credit_Amount__c</errorDisplayField>
    <errorMessage>Exception Credit Amount is required</errorMessage>
</ValidationRule>
