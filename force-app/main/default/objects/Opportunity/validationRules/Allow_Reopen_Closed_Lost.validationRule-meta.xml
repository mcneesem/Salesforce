<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Allow_Reopen_Closed_Lost</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT($Permission.Bypass_Opportunity_Allow_Reopen_Closed_Lost),
AND( ISCHANGED(StageName), ISPICKVAL(PRIORVALUE(StageName), &quot;Closed Lost&quot;) ))</errorConditionFormula>
    <errorMessage>You can&apos;t  reopen a closed lost Opportunity</errorMessage>
</ValidationRule>
