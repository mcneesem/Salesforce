<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Close_Date_Can_not_be_in_the_past</fullName>
    <active>false</active>
    <description>DEPRECATED - Updated and activated with NCS carve out and specified for Type = New Product</description>
    <errorConditionFormula>AND(CloseDate &lt; TODAY (), 
 ISPICKVAL( Type , &quot;New Product&quot;), 
 $UserRole.DeveloperName != &quot;New_Client_Sales&quot;,
 $Setup.NSP_Trigger_Switch__c.OpportunityValidations__c!=TRUE)</errorConditionFormula>
    <errorDisplayField>CloseDate</errorDisplayField>
    <errorMessage>Close date can not be in the past date.</errorMessage>
</ValidationRule>
