<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NSP_Contract_Terminating_In_Days__c</fullName>
    <description>This field tracks the number of days remaining for termination of contract</description>
    <externalId>false</externalId>
    <formula>IF(ISPICKVAL(Type, &quot;Renewal&quot;) , CloseDate -  TODAY(), 0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Contract Terminating In (Days)</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
