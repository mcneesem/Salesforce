<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NSP_Account_Segment__c</fullName>
    <description>Formula field decides if the Account segment is Midmarket, Emerging Growth or Core sales based on the number of employees</description>
    <externalId>false</externalId>
    <formula>IF(NSP_Number_of_Employees__c &gt;= 150, &quot;MidMarket&quot;, IF(NSP_Number_of_Employees__c &gt; 50 &amp;&amp; NSP_Number_of_Employees__c &lt; 150, &quot;Emerging Growth&quot;, &quot;Core Sales&quot;))</formula>
    <label>Account Segment</label>
    <required>false</required>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
