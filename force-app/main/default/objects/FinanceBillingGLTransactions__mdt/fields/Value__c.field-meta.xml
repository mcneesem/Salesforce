<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Value__c</fullName>
    <description>Compare the value of Amount field with 0.</description>
    <externalId>false</externalId>
    <fieldManageability>DeveloperControlled</fieldManageability>
    <inlineHelpText>Define if this custom metadata record is for the condition where Amount is greater/lesser than 0.</inlineHelpText>
    <label>Value</label>
    <required>true</required>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Greater</fullName>
                <default>true</default>
                <label>&gt;0</label>
            </value>
            <value>
                <fullName>Lesser</fullName>
                <default>false</default>
                <label>&lt;0</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
