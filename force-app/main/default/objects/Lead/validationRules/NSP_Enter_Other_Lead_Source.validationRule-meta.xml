<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NSP_Enter_Other_Lead_Source</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL( LeadSource,&apos;Other&apos;), ISBLANK(NSP_Other_Lead_Source__c),NOT( $Setup.NSP_Trigger_Switch__c.LeadValidations__c))</errorConditionFormula>
    <errorDisplayField>NSP_Other_Lead_Source__c</errorDisplayField>
    <errorMessage>Please enter a value if Lead Source is &apos;Other&apos;</errorMessage>
</ValidationRule>
