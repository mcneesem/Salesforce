<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NSP_Name_of_Previous_Company</fullName>
    <active>true</active>
    <description>Previous Company field should be populated if the &quot;How did you hear about Insperity?&quot; is Previous Company</description>
    <errorConditionFormula>AND(ISPICKVAL( NSP_How_did_you_hear_about_Insperity__c,&apos;Previous Company&apos;), ISBLANK(NSP_Previous_Company__c),NOT( $Setup.NSP_Trigger_Switch__c.LeadValidations__c))</errorConditionFormula>
    <errorDisplayField>NSP_Previous_Company__c</errorDisplayField>
    <errorMessage>Please enter a value</errorMessage>
</ValidationRule>
