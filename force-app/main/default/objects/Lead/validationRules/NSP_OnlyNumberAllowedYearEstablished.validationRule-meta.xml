<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NSP_OnlyNumberAllowedYearEstablished</fullName>
    <active>true</active>
    <description>You can only add Number in year established field</description>
    <errorConditionFormula>AND(
NOT(ISBLANK(NSP_Year_Established__c )),
NOT(ISNUMBER( NSP_Year_Established__c ) )
)</errorConditionFormula>
    <errorDisplayField>NSP_Year_Established__c</errorDisplayField>
    <errorMessage>Only Number is allowed</errorMessage>
</ValidationRule>
