<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NSP_SIC_validation</fullName>
    <active>false</active>
    <description>DEPRECATED - The SIC number should be exactly of 4 digits</description>
    <errorConditionFormula>IF(AND(LEN(NSP_SIC__c) &lt;&gt; 4,  $Setup.NSP_Trigger_Switch__c.LeadValidations__c != true,NOT(ISBLANK(NSP_SIC__c))), TRUE,FALSE)</errorConditionFormula>
    <errorDisplayField>NSP_SIC__c</errorDisplayField>
    <errorMessage>SIC number should be of 4 digits</errorMessage>
</ValidationRule>
