<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NSP_Enter_Other_Current_Provider</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL( NSP_Current_Provider__c,&apos;Other&apos;), ISBLANK(NSP_Other_Current_Provider__c),NOT( $Setup.NSP_Trigger_Switch__c.LeadValidations__c))</errorConditionFormula>
    <errorDisplayField>NSP_Other_Current_Provider__c</errorDisplayField>
    <errorMessage>Please enter a value if Current Provider is &apos;Other&apos;</errorMessage>
</ValidationRule>
