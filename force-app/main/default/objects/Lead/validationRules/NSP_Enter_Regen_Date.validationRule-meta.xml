<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NSP_Enter_Regen_Date</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL( Status ,&apos;Nurturing&apos;),
ISPICKVAL( NSP_Reason__c ,&apos;Regen&apos;),
ISBLANK(TEXT(NSP_Regen_Date__c)),NOT( $Setup.NSP_Trigger_Switch__c.LeadValidations__c))</errorConditionFormula>
    <errorDisplayField>NSP_Regen_Date__c</errorDisplayField>
    <errorMessage>Please enter a regen date</errorMessage>
</ValidationRule>
