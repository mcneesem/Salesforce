<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NSP_Provide_Other_Reason</fullName>
    <active>true</active>
    <description>If Reason is antrer value in Other reason field</description>
    <errorConditionFormula>AND(ISPICKVAL( NSP_Reason__c ,&apos;Other&apos;), ISBLANK(NSP_Other_Reason__c),NOT( $Setup.NSP_Trigger_Switch__c.LeadValidations__c))</errorConditionFormula>
    <errorDisplayField>NSP_Other_Reason__c</errorDisplayField>
    <errorMessage>Please enter Other Reason.</errorMessage>
</ValidationRule>
