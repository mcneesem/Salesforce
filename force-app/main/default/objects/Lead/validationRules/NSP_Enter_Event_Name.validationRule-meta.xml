<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NSP_Enter_Event_Name</fullName>
    <active>true</active>
    <description>Event Name should be populated if &quot;How did you hear about insperity?&quot; is Event</description>
    <errorConditionFormula>AND(ISPICKVAL( NSP_How_did_you_hear_about_Insperity__c,&apos;Event&apos;), ISBLANK(NSP_Event_Name__c),NOT( $Setup.NSP_Trigger_Switch__c.LeadValidations__c))</errorConditionFormula>
    <errorDisplayField>NSP_Event_Name__c</errorDisplayField>
    <errorMessage>Please enter Event Name</errorMessage>
</ValidationRule>
