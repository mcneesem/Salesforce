<?xml version="1.0" encoding="UTF-8"?>
<AutoResponseRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <autoResponseRule>
        <fullName>Case Notification</fullName>
        <active>true</active>
        <ruleEntry>
            <formula>AND(ISPICKVAL(Origin,&apos;Email&apos;), NSP_Assigned_Queue__c = &apos;Contact Center&apos;,  SuppliedEmail != Null,  $Setup.NSP_Trigger_Switch__c.NSP_CC_Cse_Creation_Notification__c = false)</formula>            
            <notifyCcRecipients>false</notifyCcRecipients>
            <senderEmail>no-reply@insperity.com</senderEmail>
            <senderName>Test Contact Center</senderName>
            <template>Services_Emails/NSP_ContactCenter_CaseCreation</template>
        </ruleEntry>
        <ruleEntry>
            <criteriaItems>
                <field>Case.Origin</field>
                <operation>equals</operation>
                <value>Email</value>
            </criteriaItems>
            <criteriaItems>
                <field>Case.NSP_Assigned_Queue__c</field>
                <operation>equals</operation>
                <value>Health &amp; Welfare Leave Admin</value>
            </criteriaItems>
            <criteriaItems>
                <field>Case.SuppliedEmail</field>
                <operation>notEqual</operation>
                <value>null</value>
            </criteriaItems>
            <notifyCcRecipients>false</notifyCcRecipients>
            <senderEmail>no-reply@insperity.com</senderEmail>
            <senderName>No reply</senderName>
            <template>NSP_Health_Welfare_Email_Templates/NSP_Health_Welfare_Leave_Admin</template>
        </ruleEntry>
