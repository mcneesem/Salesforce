<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <alerts>
        <fullName>NSP_Email_Alert_When_User_is_Added_as_Opportunity_Team_Member</fullName>
        <ccEmails>PwC_QA@insperity.com</ccEmails>
        <description>Email Alert When User is Added as Opportunity Team Member</description>
        <protected>false</protected>
        <recipients>
            <field>UserId</field>
            <type>userLookup</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>NSP_Sales/NSP_Notify_When_Added_as_Opportunity_Team_Member</template>
    </alerts>
    <rules>
        <fullName>Notify Opportunity Team Member</fullName>
        <actions>
            <name>NSP_Email_Alert_When_User_is_Added_as_Opportunity_Team_Member</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>OpportunityTeamMember.UserId</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <criteriaItems>
            <field>OpportunityTeamMember.TeamMemberRole</field>
            <operation>equals</operation>
            <value>Sales Engineer</value>
        </criteriaItems>
        <description>This workflow rule is used to send out emails to Users when they are added as Opportunity team members</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
</Workflow>
