<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <alerts>
        <fullName>NSP_Notify_Lead_Owner_Email_Alert</fullName>
        <description>Email alert to lead record owners when a record is assigned to them</description>
        <protected>false</protected>
        <recipients>
            <type>owner</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>NSP_Sales/NSP_NotificationforLeadOwner</template>
    </alerts>
	<alerts>
        <fullName>NSP_notify_to_lead_Loyalty</fullName>
        <description>Send notification to lead Loyalty</description>
        <protected>false</protected>
        <recipients>
            <field>NSP_Partner_Email__c</field>
            <type>email</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>NSP_Sales/NSP_Notify_Lead_Patners</template>
    </alerts>
    <alerts>
        <fullName>NSP_notify_to_lead_partners</fullName>
        <description>Send notification to lead partners</description>
        <protected>false</protected>
        <recipients>
            <field>NSP_Partner_Email__c</field>
            <type>email</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>NSP_Sales/NSP_Notify_Lead_Patners</template>
    </alerts>
	<alerts>
        <fullName>NSP_Email_alert_when_referral_lead_is_converted</fullName>
        <description>Email alert when referral  lead is converted</description>
        <protected>false</protected>
        <recipients>
            <type>creator</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>NSP_Sales/NSP_Lead_Conversion_Email</template>
    </alerts>

</Workflow>
