<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>Share_All_Accounts</fullName>
        <accessLevel>Read</accessLevel>
        <accountSettings>
            <caseAccessLevel>None</caseAccessLevel>
            <contactAccessLevel>Read</contactAccessLevel>
            <opportunityAccessLevel>Read</opportunityAccessLevel>
        </accountSettings>
        <label>Share All Accounts</label>
        <sharedTo>
            <roleAndSubordinates>Sales_Leader</roleAndSubordinates>
        </sharedTo>
        <criteriaItems>
            <field>NSP_Account_Id__c</field>
            <operation>notEqual</operation>
            <value></value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>NSP_Share_Segment_Accounts_to_BPC_Role_Users</fullName>
        <accessLevel>Edit</accessLevel>
        <accountSettings>
            <caseAccessLevel>None</caseAccessLevel>
            <contactAccessLevel>Edit</contactAccessLevel>
            <opportunityAccessLevel>None</opportunityAccessLevel>
        </accountSettings>
        <description>This Rule will Share Segment Accounts to BPC Role Users</description>
        <label>Share Segment Accounts to BPC Role Users</label>
        <sharedTo>
            <role>Business_Performance_Consultant</role>
        </sharedTo>
        <criteriaItems>
            <field>NSP_Account_Segment__c</field>
            <operation>equals</operation>
            <value>MidMarket</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
