<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NSP_Net_Total_QQ__c</fullName>
    <description>Net total wrt quoted quantity</description>
    <externalId>false</externalId>
    <formula>IF(OR(SBQQ__Bundled__c ,AND(SBQQ__Renewal__c, !SBQQ__Existing__c, ISBLANK(SBQQ__PriorQuantity__c))), 0,  IF(NSP_Quoted_Quantity__c &lt;= NSP_Max_Quantity__c,NSP_Final_Minimum_Fee__c, SBQQ__NetPrice__c * NSP_Quoted_Quantity__c))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Net Total QQ</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Currency</type>
</CustomField>
