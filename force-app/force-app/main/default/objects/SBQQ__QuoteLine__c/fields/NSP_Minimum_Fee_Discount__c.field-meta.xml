<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NSP_Minimum_Fee_Discount__c</fullName>
    <description>Formula to show discount on minimum fee.</description>
    <externalId>false</externalId>
    <formula>IF(NSP_List_Minimum_Fee__c &lt;&gt; 0.0,  
(NSP_List_Minimum_Fee__c - NSP_Final_Minimum_Fee__c)/ NSP_List_Minimum_Fee__c 
, 0.0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Minimum Fee Discount %</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Percent</type>
</CustomField>
